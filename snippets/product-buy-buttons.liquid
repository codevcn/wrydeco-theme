{% comment %}
  Renders buy buttons, quantity input, and product form.
  @param {product} product
  @param {variant} current_variant
  @param {string} product_form_id
{% endcomment %}

{% style %}
  .product-buy-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }
  .product-buy-buttons__primary {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  .product-buy-buttons__primary [data-add-to-cart-text] {
    font-family: var(--font-roboto);
    font-size: 1rem;
    transform: translateY(2px);
  }
  .quantity-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .product-buy-buttons__quantity-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-4);
    width: 100%;
  }
  .product-buy-buttons__price {
    margin-left: auto;
    padding-bottom: 2px;
    font-family: var(--font-roboto);
    font-size: var(--font-size-body-2xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    color: var(--text-primary);
    text-align: right;
    white-space: nowrap;
  }
  .quantity-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #111;
    font-family: var(--font-body, inherit);
  }
  .quantity-input-shell {
    display: flex;
    align-items: center;
    border: 1px solid #dcdcdc;
    border-radius: 2px;
    height: 48px;
    width: 120px;
    background-color: transparent;
  }
  .quantity-input__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    width: 40px;
    height: 100%;
    cursor: pointer;
    color: #111;
    transition: background-color 0.2s;
  }
  .quantity-input__btn:hover {
    background-color: rgba(0, 0, 0, 0.03);
  }
  .quantity-input__input {
    flex: 1;
    min-width: 0;
    text-align: center;
    border: none;
    background: none;
    font-size: 16px;
    font-family: var(--font-body, inherit);
    font-weight: 400;
    color: #111;
    padding: 0;
  }
  /* Remove number arrows */
  .quantity-input__input::-webkit-outer-spin-button,
  .quantity-input__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .quantity-input__input[type='number'] {
    -moz-appearance: textfield;
  }

  .product-buy-buttons__actions-row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }
  .product-buy-buttons__actions-row .add-to-cart-wrapper {
    flex: 1;
    min-width: 0;
  }
  .product-wishlist-wrapper {
    flex: 0 0 48px;
    width: 48px;
  }
  .product-wishlist-btn {
    width: 100%;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #25252569;
    border-radius: 6px;
    background-color: var(--color-milk);
    color: var(--color-bark);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    padding: 0;
    box-sizing: border-box;
  }
  .product-wishlist-btn:hover:not([disabled]) {
    background-color: #ece5dc;
    border-color: var(--color-bark);
  }
  .product-wishlist-btn:focus-visible {
    outline: 2px solid var(--color-earth-brown);
    outline-offset: 2px;
  }
  .product-wishlist-btn:disabled {
    cursor: wait;
  }
  .product-wishlist-btn.is-added {
    color: #e02424;
    border-color: #fca5a5;
    background-color: #fff5f5;
  }
  .product-wishlist-btn.is-added:hover:not([disabled]) {
    background-color: #fee2e2;
    border-color: #f87171;
  }
  .product-wishlist-btn__icon {
    display: block;
    width: 24px;
    height: 24px;
    pointer-events: none;
  }
  .product-wishlist-btn__icon svg {
    display: none;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .product-wishlist-btn__icon .product-wishlist-btn__icon-outline {
    display: block;
  }
  .product-wishlist-btn__icon .product-wishlist-btn__icon-filled {
    display: none;
  }
  .product-wishlist-btn.is-added .product-wishlist-btn__icon .product-wishlist-btn__icon-outline {
    display: none;
  }
  .product-wishlist-btn.is-added .product-wishlist-btn__icon .product-wishlist-btn__icon-filled {
    display: block;
    color: #e02424;
    fill: #e02424;
  }
  .product-wishlist-btn__loading {
    display: none;
    width: 20px;
    height: 20px;
    border: 2px solid currentColor;
    border-left-color: transparent;
    border-radius: var(--radius-full);
    animation: product-wishlist-spin 0.7s linear infinite;
  }
  .product-wishlist-btn[aria-busy='true'] .product-wishlist-btn__icon {
    display: none;
  }
  .product-wishlist-btn[aria-busy='true'] .product-wishlist-btn__loading {
    display: block;
  }
  @keyframes product-wishlist-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .add-to-cart-wrapper {
    width: 100%;
  }
  .add-to-cart-wrapper .flat-btn {
    width: 100%;
    color: var(--color-cream);
    background-color: var(--color-earth-brown);
    border: 1px solid var(--color-earth-brown);
    font-weight: 500;
  }
  .add-to-cart-wrapper .flat-btn:hover:not([disabled]) {
    background-color: #271a0f;
    border-color: #271a0f;
  }
  .flat-btn {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    font-family: var(--font-body, inherit);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.15em;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    box-sizing: border-box;
    transition: background-color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }
  .flat-btn[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .product-buy-buttons .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: var(--radius-full);
    animation: product-add-to-cart-spinner 0.7s linear infinite;
  }
  @keyframes product-add-to-cart-spinner {
    to {
      transform: rotate(360deg);
    }
  }

  .flat-btn .btn-icon svg {
    width: 24px;
    height: 24px;
  }

  .product-buy-buttons__secondary {
    width: 100%;
  }
  .custom-buy-it-now-wrapper {
    width: 100%;
  }
  .custom-buy-it-now-btn {
    width: 100%;
    background-color: var(--color-clay);
    color: var(--color-cream);
    font-size: 16px;
    font-weight: 900;
    border: 1px solid var(--color-clay);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .custom-buy-it-now-btn:hover:not([disabled]) {
    background-color: #79391e;
    border-color: #79391e;
  }

  /* In-button loading state: spinner shown + button locked while the express
     checkout is being triggered (page then navigates to checkout). Keep it
     full-colour (not the faded [disabled] look) so it reads as "processing". */
  .custom-buy-it-now-btn__spinner {
    display: none;
    align-items: center;
    justify-content: center;
  }
  .custom-buy-it-now-btn__spinner svg {
    width: 20px;
    height: 20px;
    animation: custom-buy-now-spin 0.7s linear infinite;
  }
  .custom-buy-it-now-btn.is-loading .custom-buy-it-now-btn__spinner {
    display: inline-flex;
  }
  .custom-buy-it-now-btn.is-loading[disabled] {
    opacity: 1;
    cursor: progress;
  }
  @keyframes custom-buy-now-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-buy-buttons .spinner,
    .custom-buy-it-now-btn__spinner svg {
      animation: none;
    }
  }
  .shopify-payment-button__button {
    border-radius: 3px !important;
    height: 48px !important;
  }
  @media screen and (max-width: 480px) {
    .product-buy-buttons__quantity-row {
      gap: var(--sp-3);
    }
    .product-buy-buttons__price {
      font-size: var(--font-size-body-xl);
    }
  }
{% endstyle %}

{%- form 'product',
  product,
  id: product_form_id,
  class: 'form',
  novalidate: 'novalidate',
  data-type: 'add-to-cart-form'
-%}
  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

  <div class="product-buy-buttons">
    <div class="product-buy-buttons__primary">
      <div class="product-buy-buttons__quantity-row">
        <div class="quantity-wrapper">
          <label class="quantity-label">QUANTITY</label>
          <div class="quantity-input-shell" data-quantity-selector>
            <button type="button" class="quantity-input__btn" aria-label="Decrease quantity" data-action="decrease">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <line x1="4" y1="12" x2="20" y2="12"></line>
              </svg>
            </button>
            <input
              type="number"
              name="quantity"
              class="quantity-input__input"
              value="1"
              min="0"
              aria-label="Quantity"
            >
            <button type="button" class="quantity-input__btn" aria-label="Increase quantity" data-action="increase">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <line x1="12" y1="4" x2="12" y2="20"></line><line x1="4" y1="12" x2="20" y2="12"></line>
              </svg>
            </button>
          </div>
        </div>
        <span class="product-buy-buttons__price" data-regular-price>{{ current_variant.price | money }}</span>
      </div>

      {% assign wishlist_variant = current_variant | default: product.selected_or_first_available_variant %}
      <div class="product-buy-buttons__actions-row">
        <div class="add-to-cart-wrapper">
        <button
          type="submit"
          name="add"
          class="flat-btn"
          {% if current_variant.available == false %}
            disabled
          {% endif %}
        >
          <span class="btn-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="currentColor"
              class="bi bi-cart-plus-fill"
              viewBox="0 0 16 16"
            >
              <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0M9 5.5V7h1.5a.5.5 0 0 1 0 1H9v1.5a.5.5 0 0 1-1 0V8H6.5a.5.5 0 0 1 0-1H8V5.5a.5.5 0 0 1 1 0"/>
            </svg>
          </span>
          <span data-add-to-cart-text>
            {%- if current_variant.available -%}
              ADD TO CART
            {%- else -%}
              SOLD OUT
            {%- endif -%}
          </span>
        </button>
      </div>

        <div class="product-wishlist-wrapper">
          <button
            type="button"
            class="product-wishlist-btn"
            data-product-wishlist
            data-wishlist-product-id="{{ product.id }}"
            data-wishlist-variant-id="{{ wishlist_variant.id }}"
            data-wishlist-product-title="{{ product.title | escape }}"
            aria-label="Add {{ product.title | escape }} to wishlist"
            aria-pressed="false"
          >
            <span class="product-wishlist-btn__icon" data-product-wishlist-icon data-icon-synced="true" aria-hidden="true">
              <svg
                class="product-wishlist-btn__icon-outline"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 512 512"
                width="24"
                height="24"
                aria-hidden="true"
              >
                <path fill="currentColor" d="M458.4 64.3C400.6 15.7 311.3 23 256 79.3C200.7 23 111.4 15.6 53.6 64.3C-21.6 127.6-10.6 230.8 43 285.5l175.4 178.7c10 10.2 23.4 15.9 37.6 15.9c14.3 0 27.6-5.6 37.6-15.8L469 285.6c53.5-54.7 64.7-157.9-10.6-221.3m-23.6 187.5L259.4 430.5c-2.4 2.4-4.4 2.4-6.8 0L77.2 251.8c-36.5-37.2-43.9-107.6 7.3-150.7c38.9-32.7 98.9-27.8 136.5 10.5l35 35.7l35-35.7c37.8-38.5 97.8-43.2 136.5-10.6c51.1 43.1 43.5 113.9 7.3 150.8"/>
              </svg>
              <svg
                class="product-wishlist-btn__icon-filled"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 512 512"
                width="24"
                height="24"
                aria-hidden="true"
              >
                <path fill="currentColor" d="M462.3 62.6C407.5 15.9 326 24.3 275.7 76.2L256 96.5l-19.7-20.3C186.1 24.3 104.5 15.9 49.7 62.6c-62.8 53.6-66.1 149.8-9.9 207.9l193.5 199.8c12.5 12.9 32.8 12.9 45.3 0l193.5-199.8c56.3-58.1 53-154.3-9.8-207.9z"/>
              </svg>
            </span>
            <span class="product-wishlist-btn__loading" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </div>

    <div class="product-buy-buttons__secondary">
      <div class="custom-buy-it-now-wrapper">
        <button
          type="button"
          class="flat-btn custom-buy-it-now-btn"
          {% if current_variant.available == false %}
            disabled
          {% endif %}
        >
          <span class="custom-buy-it-now-btn__spinner" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.25"></circle>
              <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="custom-buy-it-now-btn__label">BUY IT NOW</span>
        </button>
      </div>
      <div class="original-payment-button-wrapper" style="display: none;">
        {{ form | payment_button }}
      </div>
    </div>
  </div>

  <div class="product-form__error-message-wrapper" role="alert" hidden data-error-message-wrapper>
    <svg
      aria-hidden="true"
      focusable="false"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      style="margin-right: 8px;"
    >
      <circle cx="8" cy="8" r="7.5" fill="none" stroke="#e51a3d" stroke-width="1.5"></circle>
      <path d="M8 4V8.5" stroke="#e51a3d" stroke-width="1.5" stroke-linecap="round"></path>
      <circle cx="8" cy="11.5" r="1" fill="#e51a3d"></circle>
    </svg>
    <span class="product-form__error-message" data-error-message></span>
  </div>
{%- endform -%}

<script>
  if (!window.customBuyNowInitialized) {
    window.customBuyNowInitialized = true;
    document.addEventListener('click', (e) => {
      const customBtn = e.target.closest('.custom-buy-it-now-btn');
      if (customBtn) {
        e.preventDefault();
        // Ignore repeat clicks while it's already disabled / processing.
        if (customBtn.disabled || customBtn.classList.contains('is-loading')) return;

        // Show the in-button spinner and lock the button. The page then navigates
        // to checkout, so the loading state persists until the redirect.
        customBtn.classList.add('is-loading');
        customBtn.disabled = true;
        customBtn.setAttribute('aria-busy', 'true');

        // Safety net: if navigation never happens (blocked / error), release the
        // button so the shopper isn't stuck with a dead loading state.
        const releaseBuyNow = () => {
          customBtn.classList.remove('is-loading');
          customBtn.disabled = false;
          customBtn.removeAttribute('aria-busy');
        };
        const buyNowFallback = window.setTimeout(releaseBuyNow, 8000);
        window.addEventListener('pagehide', () => window.clearTimeout(buyNowFallback), { once: true });

        const wrapper = customBtn.closest('.product-buy-buttons__secondary');
        const dynamicButton = wrapper.querySelector('.shopify-payment-button__button');
        if (dynamicButton) {
          dynamicButton.click();
        } else {
          const form = customBtn.closest('form');
          if (form) {
            let returnInput = form.querySelector('input[name="return_to"]');
            if (!returnInput) {
              returnInput = document.createElement('input');
              returnInput.type = 'hidden';
              returnInput.name = 'return_to';
              form.appendChild(returnInput);
            }
            returnInput.value = '/checkout';
            form.submit();
          } else {
            // Nothing to submit → no navigation will occur; release immediately.
            window.clearTimeout(buyNowFallback);
            releaseBuyNow();
          }
        }
      }
    });
  }

  if (!window.quantityInputBlurInitialized) {
    window.quantityInputBlurInitialized = true;
    document.addEventListener('focusout', (e) => {
      if (e.target && e.target.classList.contains('quantity-input__input')) {
        if (e.target.value.trim() === '') {
          e.target.value = '0';
        }
      }
    });
  }

  // Keep Buy Now disabled in lockstep with Add to cart. The variant picker toggles
  // the Add to cart button's `disabled` on variant change (sold out); mirror that
  // onto Buy Now so it never checks out an unavailable variant.
  if (!window.buyNowSyncInitialized) {
    window.buyNowSyncInitialized = true;
    document.querySelectorAll('form[data-type="add-to-cart-form"]').forEach((form) => {
      const addBtn = form.querySelector('button[name="add"]');
      const buyBtn = form.querySelector('.custom-buy-it-now-btn');
      if (!addBtn || !buyBtn) return;
      const sync = () => {
        buyBtn.disabled = addBtn.hasAttribute('disabled');
      };
      sync();
      new MutationObserver(sync).observe(addBtn, { attributes: true, attributeFilter: ['disabled'] });
    });
  }

  // Wishlist logic for Product Detail Page
  (function () {
    function readCookie(name) {
      var cookies = document.cookie ? document.cookie.split('; ') : [];

      for (var index = 0; index < cookies.length; index += 1) {
        var separatorIndex = cookies[index].indexOf('=');
        if (separatorIndex === -1) continue;
        if (cookies[index].slice(0, separatorIndex) !== name) continue;

        try {
          return decodeURIComponent(cookies[index].slice(separatorIndex + 1));
        } catch (error) {
          return '';
        }
      }

      return '';
    }

    function createWishlistCustomerId() {
      if (!window.crypto || !window.crypto.getRandomValues) return '';

      var bytes = new Uint8Array(15);
      var binary = '';
      window.crypto.getRandomValues(bytes);

      bytes.forEach(function (byte) {
        binary += String.fromCharCode(byte);
      });

      return window.btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    // Read the wishlist customer id WITHOUT creating one, so simply viewing a
    // product never sets a cookie. Returns '' when the shopper has no id yet.
    function resolveWishlistCustomerId() {
      var analytics = window.ShopifyAnalytics && window.ShopifyAnalytics.meta;
      var customerId = analytics && analytics.page && analytics.page.customerId;

      if (!customerId && window.meta && window.meta.page) {
        customerId = window.meta.page.customerId;
      }
      if (!customerId && window.__st) {
        customerId = window.__st.cid;
      }
      if (customerId) return String(customerId);

      return readCookie('__v__wl__c__') || '';
    }

    function getWishlistCustomerId() {
      var existingCustomerId = resolveWishlistCustomerId();
      if (existingCustomerId) return existingCustomerId;

      var generatedCustomerId = createWishlistCustomerId();
      if (!generatedCustomerId) return '';

      document.cookie =
        '__v__wl__c__=' + encodeURIComponent(generatedCustomerId) + '; path=/; max-age=31536000; samesite=strict';
      return generatedCustomerId;
    }

    // Locally mirror wishlist item ids by variant, so the heart shows the known
    // state on load and the API item can be removed on the next click.
    var WISHLIST_ADDED_STORAGE_PREFIX = 'wrydeco_wishlist_added_';
    var VITALS_WISHLIST_STORAGE_KEY = '__v__wl__l__';

    function wishlistStorageKey(customerId) {
      return WISHLIST_ADDED_STORAGE_PREFIX + (customerId || 'anon');
    }

    function readAddedVariants(customerId) {
      try {
        var raw = window.localStorage.getItem(wishlistStorageKey(customerId));
        if (!raw) return {};
        var parsed = JSON.parse(raw);
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch (error) {
        return {};
      }
    }

    function readVitalsWishlistData() {
      try {
        var raw = window.localStorage.getItem(VITALS_WISHLIST_STORAGE_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (parsed && typeof parsed === 'object' && Array.isArray(parsed.list)) {
          return parsed;
        }
        return null;
      } catch (error) {
        return null;
      }
    }

    function writeVitalsWishlistData(data) {
      try {
        window.localStorage.setItem(VITALS_WISHLIST_STORAGE_KEY, JSON.stringify(data));
      } catch (error) {}
    }

    function getVitalsWishlistStore() {
      try {
        if (!window.rspackChunkvitalsLibrary) return null;
        var store = null;
        window.rspackChunkvitalsLibrary.push([
          ['wry_wishlist_check_' + Math.random()],
          {},
          function (req) {
            try {
              var mod = req(37127);
              if (mod && mod.jh) {
                store = mod.jh;
              }
            } catch (err) {}
          },
        ]);
        return store;
      } catch (error) {
        return null;
      }
    }

    function syncVitalsStore() {
      try {
        var store = getVitalsWishlistStore();
        if (store && typeof store.getState === 'function') {
          var actions = store.getState().P72;
          if (actions && typeof actions.T72 === 'function') {
            actions.T72();
          }
        }
      } catch (error) {}
    }

    function isVariantAdded(variantId) {
      if (!variantId) return false;
      var strId = String(variantId);
      var numId = Number(variantId);

      // 1. Check legacy local storage
      var legacyMap = readAddedVariants(resolveWishlistCustomerId());
      if (legacyMap[strId] || legacyMap[numId]) return true;

      // 2. Check Vitals canonical storage (__v__wl__l__)
      var vitalsData = readVitalsWishlistData();
      if (vitalsData) {
        if (vitalsData.items && vitalsData.items[strId] && !vitalsData.items[strId].deleted) {
          return true;
        }
        if (Array.isArray(vitalsData.list)) {
          var inList = vitalsData.list.some(function (id) {
            return Number(id) === numId;
          });
          if (inList) {
            if (!vitalsData.items || !vitalsData.items[strId] || !vitalsData.items[strId].deleted) {
              return true;
            }
          }
        }
      }

      // 3. Check Vitals in-memory store
      try {
        var store = getVitalsWishlistStore();
        if (store && typeof store.getState === 'function') {
          var state = store.getState();
          var s73 = state.T74 && state.T74.S73;
          var u49 = state.T74 && state.T74.U49;
          if (s73 && s73[numId] && !s73[numId].deleted) return true;
          if (u49 && u49.some(function (id) { return Number(id) === numId; })) return true;
        }
      } catch (error) {}

      return false;
    }

    function rememberAddedVariant(customerId, variantId, wishlistItemId) {
      if (!variantId) return;
      var strId = String(variantId);
      var numId = Number(variantId);

      // 1. Maintain legacy storage for backward compatibility
      try {
        var map = readAddedVariants(customerId);
        map[strId] = wishlistItemId || true;
        window.localStorage.setItem(wishlistStorageKey(customerId), JSON.stringify(map));
      } catch (error) {}

      // 2. Synchronize Vitals canonical storage (__v__wl__l__)
      try {
        var vitalsData = readVitalsWishlistData() || {
          version: 3,
          list: [],
          items: {},
          updatedAt: Date.now(),
        };

        if (!Array.isArray(vitalsData.list)) vitalsData.list = [];
        if (!vitalsData.items || typeof vitalsData.items !== 'object') vitalsData.items = {};

        var exists = vitalsData.list.some(function (id) {
          return Number(id) === numId;
        });
        if (!exists) {
          vitalsData.list.push(numId);
        }

        var existingItem = vitalsData.items[strId] || vitalsData.items[numId] || {};
        var resolvedItemId = wishlistItemId || existingItem.id || 0;

        vitalsData.items[strId] = {
          id: resolvedItemId,
          variantId: numId,
          deleted: false,
        };

        vitalsData.updatedAt = Date.now();
        writeVitalsWishlistData(vitalsData);
      } catch (error) {}

      // 3. Notify Vitals in-memory store to rehydrate state and re-render header badge
      syncVitalsStore();
    }

    function forgetAddedVariant(customerId, variantId) {
      if (!variantId) return;
      var strId = String(variantId);
      var numId = Number(variantId);

      // 1. Maintain legacy storage
      try {
        var map = readAddedVariants(customerId);
        delete map[strId];
        delete map[numId];

        if (Object.keys(map).length) {
          window.localStorage.setItem(wishlistStorageKey(customerId), JSON.stringify(map));
        } else {
          window.localStorage.removeItem(wishlistStorageKey(customerId));
        }
      } catch (error) {}

      // 2. Synchronize Vitals canonical storage (__v__wl__l__)
      try {
        var vitalsData = readVitalsWishlistData();
        if (vitalsData) {
          if (Array.isArray(vitalsData.list)) {
            vitalsData.list = vitalsData.list.filter(function (id) {
              return Number(id) !== numId;
            });
          }
          if (vitalsData.items) {
            if (vitalsData.items[strId]) {
              vitalsData.items[strId].deleted = true;
            }
            if (vitalsData.items[numId]) {
              vitalsData.items[numId].deleted = true;
            }
          }
          vitalsData.updatedAt = Date.now();
          writeVitalsWishlistData(vitalsData);
        }
      } catch (error) {}

      // 3. Notify Vitals in-memory store
      syncVitalsStore();
    }

    function getStoredWishlistItemId(customerId, variantId) {
      var strId = String(variantId);
      var numId = Number(variantId);

      var storedValue = readAddedVariants(customerId)[strId];
      if (storedValue && storedValue !== true) return storedValue;

      var vitalsData = readVitalsWishlistData();
      if (vitalsData && vitalsData.items) {
        var item = vitalsData.items[strId] || vitalsData.items[numId];
        if (item && item.id) return item.id;
      }

      try {
        var store = getVitalsWishlistStore();
        if (store && typeof store.getState === 'function') {
          var s73 = store.getState().T74 && store.getState().T74.S73;
          var memItem = s73 && (s73[numId] || s73[strId]);
          if (memItem && memItem.id) return memItem.id;
        }
      } catch (error) {}

      return '';
    }

    function getWishlistItemVariantId(item) {
      if (!item) return '';
      if (item.variantId) return item.variantId;
      return item.variant && item.variant.id ? item.variant.id : '';
    }

    function findWishlistItem(apiHost, shopId, customerId, variantId) {
      var query = '?sid=' + encodeURIComponent(String(shopId)) + '&cid=' + encodeURIComponent(String(customerId));

      return window
        .fetch(apiHost + '/bundle/api/v2/sf/ws' + query, {
          method: 'GET',
          headers: { Accept: 'application/json' },
          cache: 'no-store',
        })
        .then(function (response) {
          if (!response.ok) throw new Error('Wishlist lookup failed');
          return response.json();
        })
        .then(function (items) {
          if (!Array.isArray(items)) return null;

          return (
            items.find(function (item) {
              return String(getWishlistItemVariantId(item)) === String(variantId);
            }) || null
          );
        });
    }

    function removeWishlistItem(apiHost, shopId, customerId, wishlistItemId) {
      var path = [shopId, customerId, wishlistItemId]
        .map(function (value) {
          return encodeURIComponent(String(value));
        })
        .join('/');

      return window.fetch(apiHost + '/bundle/api/v2/sf/ws/' + path, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        cache: 'no-store',
      });
    }

    function applyWishlistButtonState(button, added) {
      var title = button.dataset.wishlistProductTitle || 'this piece';
      button.classList.toggle('is-added', added);
      button.setAttribute('aria-pressed', added ? 'true' : 'false');
      button.setAttribute('aria-label', added ? title + ' is in your wishlist' : 'Add ' + title + ' to wishlist');
    }

    function syncWishlistButtonForVariant(button) {
      applyWishlistButtonState(button, isVariantAdded(getWishlistVariantId(button)));
    }

    function syncWishlistIcon(button) {
      return true;
    }

    function getWishlistVariantId(button) {
      // The product form's hidden id is the live source of truth (it is what the
      // add-to-cart request submits), so trust it before the URL param, which can
      // lag behind the current selection.
      var selectedVariant = document.querySelector('form[action*="/cart/add"] [name="id"]');
      if (selectedVariant && selectedVariant.value) return selectedVariant.value;

      var urlVariantId = new URL(window.location.href).searchParams.get('variant');
      if (urlVariantId) return urlVariantId;

      return button.dataset.wishlistVariantId;
    }

    function updateWishlistHeaderCount(change) {
      var counter = document.querySelector('#vitals-wishlist-header .Vtl-WishlistHeader__HeartCounter');
      if (!counter) {
        if (change < 1) return;

        var iconWrapper = document.querySelector('#vitals-wishlist-header .Vtl-WishlistHeader__IconWrapper');
        if (!iconWrapper) return;

        counter = document.createElement('span');
        counter.className = 'Vtl-WishlistHeader__HeartCounter';
        iconWrapper.appendChild(counter);
      }

      var count = Number.parseInt(counter.textContent, 10);
      var nextCount = Math.max(0, (Number.isNaN(count) ? 0 : count) + change);

      if (nextCount === 0) {
        counter.remove();
        return;
      }

      counter.textContent = String(nextCount);
    }

    function showWishlistToast(message, type) {
      if (typeof window.showToast !== 'function') return;
      window.showToast({
        message: message,
        type: type,
        position: 'bottom-left',
        duration: 4000,
      });
    }

    function initProductWishlist() {
      document.querySelectorAll('[data-product-wishlist]').forEach(function (button) {
        if (button.dataset.wishlistInit === 'true') return;
        button.dataset.wishlistInit = 'true';


        // Reflect the known state for the initial variant, and keep it in sync
        // when the shopper switches variants — wishlist membership is per-variant,
        // so a heart added for one variant must not stay lit for another.
        syncWishlistButtonForVariant(button);
        document.addEventListener('variant:change', function () {
          syncWishlistButtonForVariant(button);
        });
        window.addEventListener('pageshow', function () {
          syncWishlistButtonForVariant(button);
        });
        window.addEventListener('vitals:AppInit', function () {
          syncWishlistButtonForVariant(button);
        });

        button.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          if (button.disabled) return;

          var wishlistData = window.vtlsLiquidData || {};
          var appId = wishlistData.shopInfo && wishlistData.shopInfo.appId;
          var apiHost = appId && wishlistData.apiHosts && wishlistData.apiHosts[appId];
          var shopId = wishlistData.shopInfo && wishlistData.shopInfo.id;
          var variantId = getWishlistVariantId(button);
          var customerId = getWishlistCustomerId();
          var isRemoving = button.getAttribute('aria-pressed') === 'true';

          if (!apiHost || !shopId || !customerId || !variantId) {
            showWishlistToast('We could not update your wishlist. Please try again.', 'error');
            return;
          }

          var idleAriaLabel = button.getAttribute('aria-label');
          var loadingAriaLabel = isRemoving ? 'Removing from wishlist' : 'Adding to wishlist';
          button.disabled = true;
          button.setAttribute('aria-busy', 'true');
          button.setAttribute('aria-label', loadingAriaLabel);

          var request;

          if (isRemoving) {
            var storedWishlistItemId = getStoredWishlistItemId(customerId, variantId);
            var wishlistItemRequest = storedWishlistItemId
              ? Promise.resolve({ id: storedWishlistItemId })
              : findWishlistItem(apiHost, shopId, customerId, variantId);

            request = wishlistItemRequest.then(function (wishlistItem) {
              if (!wishlistItem || !wishlistItem.id) return null;

              return removeWishlistItem(apiHost, shopId, customerId, wishlistItem.id).then(function (response) {
                if (!response.ok && response.status !== 404) {
                  throw new Error('Wishlist remove failed');
                }
                return response;
              });
            });
          } else {
            request = window.fetch(apiHost + '/bundle/api/v2/sf/ws', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                shop_id: shopId,
                customerId: customerId,
                productId: Number(button.dataset.wishlistProductId),
                variantId: Number(variantId),
              }),
            });
          }

          request
            .then(function (response) {
              if (isRemoving) {
                forgetAddedVariant(customerId, variantId);
                applyWishlistButtonState(button, false);
                updateWishlistHeaderCount(-1);
                showWishlistToast('Removed from your wishlist.', 'success');
                return;
              }

              if (response.status === 409) {
                rememberAddedVariant(customerId, variantId);
                applyWishlistButtonState(button, true);
                showWishlistToast('This piece is already in your wishlist.', 'info');
                return;
              }
              if (!response.ok) throw new Error('Wishlist request failed');

              return response
                .json()
                .catch(function () {
                  return null;
                })
                .then(function (wishlistItem) {
                  rememberAddedVariant(customerId, variantId, wishlistItem && wishlistItem.id);
                  applyWishlistButtonState(button, true);
                  updateWishlistHeaderCount(1);
                  showWishlistToast('Added to your wishlist.', 'success');
                });
            })
            .catch(function () {
              showWishlistToast(
                isRemoving
                  ? 'We could not remove this piece from your wishlist. Please try again.'
                  : 'We could not add this piece to your wishlist. Please try again.',
                'error'
              );
            })
            .finally(function () {
              button.disabled = false;
              button.removeAttribute('aria-busy');
              if (button.getAttribute('aria-label') === loadingAriaLabel) {
                button.setAttribute('aria-label', idleAriaLabel);
              }
            });
        });
      });
    }



    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductWishlist);
    } else {
      initProductWishlist();
    }
  })();
</script>
