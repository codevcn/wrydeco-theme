{% doc %}
  Renders the made-to-order and shipping benefits for a homepage signature card.
  @param {string} made_to_order_label - Made-to-order label from section settings.
  @param {string} shipping_label - Shipping label from section settings.
{% enddoc %}
<ul class="signature-pieces__benefits">
  <li>{% render 'signature-piece-icon', name: 'craft' %}<span>{{ made_to_order_label | escape }}</span></li>
  <li>{% render 'signature-piece-icon', name: 'shipping' %}<span>{{ shipping_label | escape }}</span></li>
</ul>
