{% doc %}
  Renders the global product search dialog with recent searches and predictive results.
{% enddoc %}

<template id="SearchPopupTemplate">
<search-popup
  class="search-popup-wrapper"
  data-currency-code="{{ localization.country.currency.iso_code | default: cart.currency.iso_code | default: shop.currency | escape }}"
  data-locale="{{ request.locale.iso_code | default: 'en' | escape }}"
>
  <div class="search-popup__overlay">
    <div class="search-popup__content" role="dialog" aria-modal="true" aria-labelledby="SearchPopupTitle">
      <div class="search-popup__header">
        <h2 class="search-popup__heading" id="SearchPopupTitle">Search the Products</h2>
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="search-popup__form"
          onsubmit="event.preventDefault();"
        >
          <input type="hidden" name="type" value="product">
          <div class="search-popup__input-group">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="search-popup__icon"
            >
              <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              name="q"
              value=""
              placeholder="Search for products, collections, or inspiration..."
              class="search-popup__input"
              aria-label="Search"
              autocomplete="off"
            >
          </div>
        </form>
        <button class="search-popup__close" type="button" aria-label="Close search">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="search-popup__body">
        <div class="search-popup__initial" style="display: none;">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="48"
            height="48"
            fill="currentColor"
            class="bi bi-search search-popup__initial-icon"
            viewBox="0 0 16 16"
          >
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
          </svg>
          <p>Search product name...</p>
        </div>

        <div class="search-popup__recent" style="display: none;">
          <h3 class="search-popup__title">Recent Searches</h3>
          <div class="search-popup__recent-list"></div>
        </div>

        <div class="search-popup__top-results" style="display: none;">
          <div class="search-popup__results-header">
            <h3 class="search-popup__title">Top Results</h3>
            <div class="search-popup__view-all">
              <a href="{{ routes.search_url }}" class="search-popup__view-all-btn">
                <span>View all results</span
                ><span aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 1024 1024">
                    <path d="M0 0h1024v1024H0z" fill="none" />
                    <path fill="currentColor" d="M754.8 480H160a32 32 0 1 0 0 64h594.8L521.3 777.3a32 32 0 0 0 45.4 45.4l288-288a32 32 0 0 0 0-45.4l-288-288a32 32 0 1 0-45.4 45.4z" />
                  </svg>
                </span>
              </a>
            </div>
          </div>
          <div class="search-popup__predictive-list search-popup__grid">
            {% for default_product in collections.all.products limit: 4 %}
              <a
                href="{{ default_product.url }}"
                class="search-product-card"
                data-title="{{ default_product.title | escape }}"
                data-url="{{ default_product.url }}"
                data-image="{{ default_product.featured_image | image_url: width: 480 }}"
              >
                <div class="search-product-card__image">
                  {{
                    default_product.featured_image
                    | image_url: width: 480
                    | image_tag:
                      loading: 'lazy',
                      widths: '240,360,480',
                      sizes: '(min-width: 769px) 190px, 44vw',
                      alt: default_product.title
                  }}
                </div>
                <div class="search-product-card__info">
                  <span class="search-product-card__type">
                    {{- default_product.type | default: 'Handcrafted furniture' | escape -}}
                  </span>
                  <span class="search-product-card__title">{{ default_product.title | escape }}</span>
                  <span class="search-product-card__price">
                    {{- default_product.price | money_without_trailing_zeros -}}
                  </span>
                </div>
              </a>
            {% endfor %}
          </div>
        </div>

        <div class="search-popup__loading" style="display: none;">
          <div class="search-popup__spinner"></div>
        </div>

        <div class="search-popup__empty">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="search-popup__empty-icon"
          >
            <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <p>No products found.</p>
        </div>
      </div>

      <div class="search-popup__footer">
        <span class="search-popup__footer-note">Handcrafted. Timeless. Yours.</span>
        <span>Need help finding something? <a href="{{ routes.root_url }}pages/contact">Contact our team</a></span>
      </div>
    </div>
  </div>
</search-popup>
</template>

<script src="{{ 'search-popup.js' | file_url }}" defer></script>
<script>
  const initSearchPopupPatch = () => {
    customElements.whenDefined('search-popup').then(() => {
      const SearchPopup = customElements.get('search-popup');
      if (!SearchPopup || SearchPopup.prototype.localizedPricePatched) return;

      const getCurrencyMeta = (element) => {
        const root = element?.closest?.('search-popup') || document.querySelector('search-popup');
        return {
          code: root?.dataset.currencyCode || window.Shopify?.currency?.active || 'VND',
          locale: root?.dataset.locale || document.documentElement.lang || 'en',
        };
      };

      const formatPrice = (rawPrice, element) => {
        const value = String(rawPrice || '').trim();
        if (!value) return '';

        const { code, locale } = getCurrencyMeta(element);
        const isVnd = code.toUpperCase() === 'VND' || value.includes('₫');
        const digits = value.replace(/[^\d]/g, '');

        if (isVnd && digits) {
          return `${Number(digits).toLocaleString('vi-VN')}₫`;
        }

        const numericValue = Number(value.replace(/[^\d.]/g, ''));
        if (!Number.isFinite(numericValue)) return value;

        return new Intl.NumberFormat(locale, {
          style: 'currency',
          currency: code,
          maximumFractionDigits: code.toUpperCase() === 'VND' ? 0 : 2,
        }).format(numericValue);
      };

      const normalizeRenderedPrices = (root) => {
        root.querySelectorAll('.search-product-card__price').forEach((price) => {
          price.textContent = formatPrice(price.textContent, price);
        });
      };

      const originalCreateProductCardHtml = SearchPopup.prototype.createProductCardHtml;
      SearchPopup.prototype.createProductCardHtml = function (product, index = 0, query = '') {
        const html = originalCreateProductCardHtml.call(this, product, index, query);
        const formattedPrice = formatPrice(product?.price, this);
        if (!formattedPrice) return html;

        return html.replace(
          /<span class="search-product-card__price">[\s\S]*?<\/span>/,
          `<span class="search-product-card__price">${this.escapeHtml(formattedPrice)}</span>`
        );
      };

      window.wrydecoNormalizeSearchQuery = function (raw) {
        return String(raw || '')
          .trim()
          .split(/\s+/)
          .filter(Boolean)
          .map((token) => (token.endsWith('*') ? token : token + '*'))
          .join(' ');
      };

      SearchPopup.prototype.performSearch = async function (query) {
        const normalized = window.wrydecoNormalizeSearchQuery(query);
        const searchPageUrl = `/search?q=${encodeURIComponent(normalized)}&type=product`;
        try {
          const response = await fetch(`${searchPageUrl}&view=ajax`);
          if (!response.ok) throw new Error('Search failed');
          const products = await response.json();
          this.renderPredictiveResults(products, query);
          if (this.viewAllBtn) this.viewAllBtn.href = searchPageUrl;
        } catch (error) {
          console.error('Search Error:', error);
          this.showEmptyState();
        }
      };

      SearchPopup.prototype.localizedPricePatched = true;
      document.querySelectorAll('search-popup').forEach(normalizeRenderedPrices);
    });
  };

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', initSearchPopupPatch);
  } else {
    initSearchPopupPatch();
  }

  // Redefine openSearchPopup to handle mount/unmount logic
  const customOpenSearchPopup = function(e) {
    if (e) e.preventDefault();
    let popup = document.querySelector('search-popup');
    
    if (!popup) {
      const template = document.getElementById('SearchPopupTemplate');
      if (!template) return;
      document.body.appendChild(template.content.cloneNode(true));
      popup = document.querySelector('search-popup');
      
      // Patch prices on newly mounted element
      if (customElements.get('search-popup')?.prototype?.localizedPricePatched) {
        const formatPrice = (rawPrice, element) => { /* simplified */ };
        popup.querySelectorAll('.search-product-card__price').forEach(p => {
            // Already handled via web component logic, but we can trigger it if needed
        });
      }
      
      // Watch for the 'open' attribute being removed to unmount
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'attributes' && mutation.attributeName === 'open') {
            if (!popup.hasAttribute('open')) {
              setTimeout(() => {
                popup.remove();
                observer.disconnect();
              }, 300); // 300ms matches the var(--timing-short) transition
            }
          }
        });
      });
      observer.observe(popup, { attributes: true });
    }
    
    // Set 'open' attribute in next frame to allow DOM to update and transition to trigger
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        popup.setAttribute('open', '');
        // Small hack for the component to focus its input
        const input = popup.querySelector('input[type="search"]');
        if (input) input.focus();
      });
    });
  };

  let _openSearchPopup = customOpenSearchPopup;
  Object.defineProperty(window, 'openSearchPopup', {
    get: function() { return _openSearchPopup; },
    set: function(val) {
      // Ignore overwrites to preserve mount/unmount logic
    },
    configurable: true
  });
</script>

{% stylesheet %}
  search-popup {
    display: block;
  }

  .search-popup__overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 6rem);
    background-color: var(--bg-overlay);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--timing-short) var(--ease-standard), visibility var(--timing-short) var(--ease-standard);
  }

  search-popup[open] .search-popup__overlay {
    opacity: 1;
    visibility: visible;
  }

  .search-popup__content {
    display: flex;
    flex-direction: column;
    width: min(calc(100vw - clamp(3rem, 8vw, 12rem)), clamp(56rem, 52vw, 96rem));
    height: min(calc(100dvh - clamp(2rem, 7vh, 4rem)), clamp(53rem, 86dvh, 58rem));
    max-height: calc(100dvh - clamp(2rem, 7vh, 4rem));
    overflow: hidden;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: radial-gradient(circle at top, var(--color-milk) 0%, var(--surface-elevated) 72%);
    box-shadow: var(--shadow-modal);
    contain: layout paint;
    will-change: transform, opacity;
    opacity: 0;
    transform: translateY(calc(var(--sp-2) * -1));
    transition: transform var(--timing-short) var(--ease-out), opacity var(--timing-short) var(--ease-standard);
  }

  search-popup[open] .search-popup__content {
    opacity: 1;
    transform: translateY(0);
  }

  .search-popup__header {
    position: relative;
    flex: 0 0 auto;
    padding: clamp(1.75rem, 3vh, 3rem) clamp(2rem, 4vw, 4.5rem) clamp(1.25rem, 2.3vh, 2rem);
    text-align: center;
  }

  .search-popup__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 2vw, 3rem);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-tight);
    color: var(--text-primary);
    margin-bottom: clamp(1rem, 1.6vh, 1.5rem);
  }

  .search-popup__form {
    width: 100%;
  }

  .search-popup__input-group {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-popup__icon {
    position: absolute;
    left: var(--sp-3);
    width: var(--sp-5);
    height: var(--sp-5);
    color: var(--color-bark);
    pointer-events: none;
  }

  .search-popup__input {
    width: 100%;
    min-height: clamp(3rem, 5.6vh, 4rem);
    padding: 0.75rem clamp(1rem, 1.4vw, 1.5rem) 0.75rem clamp(3rem, 3.2vw, 4rem);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    background-color: var(--surface-elevated);
    outline: none;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.05vw, 1.25rem);
    color: var(--text-primary);
  }

  .search-popup__input:focus {
    border-color: var(--color-earth-brown);
    box-shadow: var(--shadow-focus);
  }

  .search-popup__input::placeholder {
    color: var(--text-tertiary);
  }

  .search-popup__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .search-popup__close {
    position: absolute;
    top: clamp(1rem, 2.4vh, 2rem);
    right: clamp(1rem, 2vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--sp-7);
    height: var(--sp-7);
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-bark);
    cursor: pointer;
  }

  .search-popup__close:hover {
    background-color: var(--surface-tertiary);
  }

  .search-popup__close svg {
    width: var(--sp-5);
    height: var(--sp-5);
  }

  .search-popup__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 0 clamp(2rem, 4vw, 4.5rem) clamp(1.5rem, 2.8vh, 2.5rem);
    scrollbar-width: thin;
    scrollbar-color: var(--border-default) transparent;
  }

  .search-popup__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-earth-brown);
  }

  .search-popup__recent {
    margin-bottom: var(--sp-5);
  }

  .search-popup__recent-list {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 1vw, 1.25rem);
    margin-top: clamp(0.75rem, 1.2vh, 1.25rem);
  }

  .search-popup__recent-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: var(--sp-7);
    padding: var(--sp-1) var(--sp-3) var(--sp-1) var(--sp-1);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    background-color: var(--surface-elevated);
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    color: var(--text-primary);
    cursor: pointer;
    max-width: min(18em, 30%);
  }

  .search-popup__recent-chip img {
    width: var(--sp-6);
    height: var(--sp-6);
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .search-popup__recent-chip i {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--sp-5);
    height: var(--sp-5);
    font-style: normal;
    color: var(--text-secondary);
  }

  .search-popup__recent-chip span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-popup__top-results {
    padding-top: var(--sp-2);
    border-top: 1px solid var(--border-light);
  }

  .search-popup__results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: clamp(0.75rem, 1.4vh, 1.25rem);
  }

  .search-popup__view-all {
    display: block;
  }

  .search-popup__view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: var(--sp-7);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-bold);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .search-popup__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 1.4vw, 1.75rem);
  }

  .search-product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    background-color: var(--surface-elevated);
    color: var(--text-primary);
    text-decoration: none;
    transition: transform var(--timing-short) var(--ease-standard), box-shadow var(--timing-short) var(--ease-standard);
  }

  .search-product-card:hover {
    transform: translateY(calc(var(--sp-1) * -1));
    box-shadow: var(--shadow-card);
  }

  .search-product-card__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--surface-tertiary);
  }

  .search-product-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search-product-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: var(--font-size-caption);
    color: var(--text-tertiary);
  }

  .search-product-card__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
    padding: var(--sp-3);
  }

  .search-product-card__type {
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .search-product-card__title {
    display: -webkit-box;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-normal);
    color: var(--text-primary);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .search-product-card__price {
    margin-top: auto;
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
  }

  .search-product-card__title mark {
    background-color: var(--color-stone);
    color: inherit;
  }

  .search-popup__loading,
  .search-popup__empty,
  .search-popup__initial {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    min-height: calc(var(--sp-8) * 3);
    color: var(--text-secondary);
    text-align: center;
  }

  .search-popup__empty {
    height: 100%;
    display: none; /* Default hidden */
  }

  .search-popup__spinner {
    width: var(--sp-5);
    height: var(--sp-5);
    border: 2px solid var(--border-default);
    border-top-color: var(--color-earth-brown);
    border-radius: var(--radius-full);
    animation: search-popup-spin var(--timing-extra-long) linear infinite;
  }

  @keyframes search-popup-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .search-popup__empty-icon,
  .search-popup__initial-icon {
    margin-inline: auto;
    width: var(--sp-7);
    height: var(--sp-7);
    margin-bottom: var(--sp-4);
    color: var(--text-tertiary);
  }

  .search-popup__footer {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: clamp(2rem, 3.4vh, 3rem);
    padding-inline: clamp(2rem, 4vw, 4.5rem);
    border-top: 1px solid var(--border-light);
    background-color: var(--surface-default);
    font-size: var(--font-size-caption);
    color: var(--text-secondary);
  }

  .search-popup__footer-note {
    color: var(--color-bark);
  }

  .search-popup__footer a {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .search-popup__close {
      top: var(--sp-2);
      right: var(--sp-2);
    }

    .search-popup__footer-note {
      display: none;
    }

    .search-popup__overlay {
      padding: max(1rem, env(safe-area-inset-top)) 1rem max(1rem, env(safe-area-inset-bottom));
    }

    .search-popup__content {
      width: 100%;
      height: calc(100dvh - 2rem);
      max-height: calc(100dvh - 2rem);
    }

    .search-popup__header {
      padding: var(--sp-6) var(--sp-5) var(--sp-4);
    }

    .search-popup__heading {
      font-size: var(--font-size-display-sm);
    }

    .search-popup__body {
      padding-inline: var(--sp-5);
    }

    .search-popup__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .search-popup__footer {
      padding-inline: var(--sp-5);
    }
  }

  @media (max-width: 480px) {
    .search-popup__overlay {
      padding: 0.5rem;
    }

    .search-popup__content {
      height: calc(100dvh - 1rem);
      max-height: calc(100dvh - 1rem);
    }

    .search-popup__header {
      padding: var(--sp-6) var(--sp-4) var(--sp-4);
    }

    .search-popup__input {
      font-size: var(--font-size-body-sm);
    }

    .search-popup__body {
      padding-inline: var(--sp-4);
    }

    .search-popup__footer {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: var(--sp-1);
    }

    .search-popup__recent-chip {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-popup__content,
    .search-product-card {
      transition: none;
      animation: none;
      opacity: 1;
      transform: none;
    }

    .search-popup__spinner {
      animation: none;
