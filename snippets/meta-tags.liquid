<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

<link rel="icon" type="image/png" href="{{ 'favicon-96x96.png' | asset_url }}" sizes="96x96">
<link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
<link rel="shortcut icon" href="{{ 'favicon.ico' | asset_url }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
{%- comment -%}
  Reference the manifest WITHOUT the `.liquid` suffix: Shopify only renders a
  `.liquid` asset when it is requested by its rendered name. Linking to
  `manifest.json.liquid` serves the raw template, so the manifest shipped
  `{{ shop.name }}` as literal text and was invalid JSON.

  theme-check flags this as MissingAsset because the file on disk is named
  `manifest.json.liquid` — that is the lint reading filenames literally, not a
  broken reference, so the rule is disabled for this line only.
{%- endcomment -%}
{% # theme-check-disable MissingAsset %}
<link rel="manifest" href="{{ 'manifest.json' | asset_url }}">
{% # theme-check-enable MissingAsset %}
{%- liquid
  assign seo_page_title = page_title | default: shop.name
  assign seo_page_description = page_description

  if request.page_type == 'index'
    assign seo_page_title = 'WRYDECO | Handcrafted Sculptural Solid Wood Furniture'
    assign seo_page_description = 'Discover WRYDECO handcrafted solid wood furniture, including sculptural bookshelves, organic tables, beds and distinctive made-to-order designs.'
  elsif request.page_type == 'policy'
    if request.path contains 'shipping-policy'
      assign seo_page_description = 'Review the official WRYDECO shipping policy. Learn about our complimentary US freight delivery, secure wooden crating for sculptural furniture, and made-to-order transit timelines.'
    elsif request.path contains 'refund-policy'
      assign seo_page_description = 'Understand the WRYDECO return and refund policy. Clear guidelines on transit inspection, damaged delivery claims, and dedicated artisan support for handcrafted pieces.'
    elsif request.path contains 'privacy-policy'
      assign seo_page_description = 'Learn how WRYDECO protects your personal data, order privacy, and transaction security across our bespoke solid wood furniture services.'
    elsif request.path contains 'terms-of-service'
      assign seo_page_description = 'Read the WRYDECO terms of service covering made-to-order commitments, natural wood characteristics, warranty coverage, and purchase agreements.'
    elsif request.path contains 'contact-information'
      assign seo_page_description = 'Official contact information for WRYDECO. Reach our customer care team and studio artisans for custom commissions, order updates, and design consultations.'
    elsif request.path contains 'legal-notice'
      assign seo_page_description = 'Review legal notice and regulatory business disclosures for WRYDECO, handcrafted sculptural solid wood furniture studio.'
    elsif policy.body != blank
      assign seo_page_description = policy.body | strip_html | strip | truncatewords: 28
    endif
  endif

  assign og_title = seo_page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign schema_product_description = product.description | strip_html | strip | truncatewords: 80
    if schema_product_description == blank
      assign schema_product_description = product.title
    endif

    assign schema_review_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0
    assign schema_rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value.value | default: product.metafields.reviews.rating.value
  -%}
  <script type="application/ld+json">
    {%- if product.variants.size > 1 -%}
      {%- liquid
        assign has_color_option = false
        assign has_size_option = false
        assign opt1_type = ''
        assign opt2_type = ''
        assign opt3_type = ''

        for option in product.options
          assign opt_name_lower = option | downcase
          assign current_opt_type = ''
          if opt_name_lower contains 'color' or opt_name_lower contains 'finish'
            assign has_color_option = true
            assign current_opt_type = 'color'
          elsif opt_name_lower contains 'size' or opt_name_lower contains 'dimension'
            assign has_size_option = true
            assign current_opt_type = 'size'
          elsif opt_name_lower contains 'width' or opt_name_lower contains 'height'
            assign has_size_option = true
            assign current_opt_type = 'size'
          elsif opt_name_lower contains 'length' or opt_name_lower contains 'depth'
            assign has_size_option = true
            assign current_opt_type = 'size'
          endif

          if forloop.index == 1
            assign opt1_type = current_opt_type
          elsif forloop.index == 2
            assign opt2_type = current_opt_type
          elsif forloop.index == 3
            assign opt3_type = current_opt_type
          endif
        endfor
      -%}
      {
        "@context": "https://schema.org",
        "@type": "ProductGroup",
        "@id": {{ canonical_url | append: '#product-group' | json }},
        "name": {{ product.title | json }},
        "description": {{ schema_product_description | json }},
        "url": {{ canonical_url | json }},
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | default: shop.name | json }}
        },
        "productGroupID": {{ product.id | json }},
        {%- if schema_review_count > 0 and schema_rating_value != blank %}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ schema_rating_value | json }},
            "reviewCount": {{ schema_review_count }},
            "bestRating": "5",
            "worstRating": "1"
          },
        {%- endif %}
        {%- if product.featured_image != blank %}
          "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
        {%- endif %}
        "variesBy": [
          {%- if has_color_option and has_size_option -%}
            "https://schema.org/color",
            "https://schema.org/size"
          {%- elsif has_color_option -%}
            "https://schema.org/color"
          {%- elsif has_size_option -%}
            "https://schema.org/size"
          {%- endif -%}
        ],
        "hasVariant": [
          {%- for variant in product.variants -%}
            {%- liquid
              assign variant_color = ''
              assign variant_size = ''

              if opt1_type == 'color' and variant.option1 != blank
                assign variant_color = variant.option1
              elsif opt1_type == 'size' and variant.option1 != blank
                assign variant_size = variant.option1
              endif

              if opt2_type == 'color' and variant.option2 != blank
                if variant_color != blank
                  assign variant_color = variant_color | append: ' / ' | append: variant.option2
                else
                  assign variant_color = variant.option2
                endif
              elsif opt2_type == 'size' and variant.option2 != blank
                if variant_size != blank
                  assign variant_size = variant_size | append: ' / ' | append: variant.option2
                else
                  assign variant_size = variant.option2
                endif
              endif

              if opt3_type == 'color' and variant.option3 != blank
                if variant_color != blank
                  assign variant_color = variant_color | append: ' / ' | append: variant.option3
                else
                  assign variant_color = variant.option3
                endif
              elsif opt3_type == 'size' and variant.option3 != blank
                if variant_size != blank
                  assign variant_size = variant_size | append: ' / ' | append: variant.option3
                else
                  assign variant_size = variant.option3
                endif
              endif
            -%}
            {
              "@type": "Product",
              "@id": {{ canonical_url | append: '#variant-' | append: variant.id | json }},
              "name": {{ product.title | append: ' - ' | append: variant.title | json }},
              "description": {{ schema_product_description | json }},
              {%- if variant_color != blank %}
                "color": {{ variant_color | json }},
              {%- endif %}
              {%- if variant_size != blank %}
                "size": {{ variant_size | json }},
              {%- endif %}
              {%- if variant.sku != blank %}
                "sku": {{ variant.sku | json }},
              {%- endif %}
              {%- if variant.barcode != blank %}
                "gtin": {{ variant.barcode | json }},
              {%- endif %}
              {%- assign variant_image = variant.image | default: product.featured_image -%}
              {%- if variant_image != blank %}
                "image": {{ variant_image | image_url: width: 1200 | prepend: 'https:' | json }},
              {%- endif %}
              "offers": {
                "@type": "Offer",
                "@id": {{ canonical_url | append: '#offer-' | append: variant.id | json }},
                "url": {{ canonical_url | append: '?variant=' | append: variant.id | json }},
                "price": "{{ variant.price | money_without_currency | remove: ',' }}",
                "priceCurrency": {{ cart.currency.iso_code | default: 'USD' | json }},
                "itemCondition": "https://schema.org/NewCondition",
                "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
                "seller": {
                  "@type": "Organization",
                  "name": {{ shop.name | json }}
                },
                "hasMerchantReturnPolicy": {
                  "@type": "MerchantReturnPolicy",
                  "applicableCountry": "US",
                  "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
                  "merchantReturnDays": 30,
                  "returnMethod": "https://schema.org/ReturnByMail",
                  "returnFees": "https://schema.org/FreeReturn",
                  "merchantReturnLink": "https://wrydeco.com/policies/refund-policy"
                },
                "shippingDetails": {
                  "@type": "OfferShippingDetails",
                  "shippingRate": {
                    "@type": "MonetaryAmount",
                    "value": "0.00",
                    "currency": {{ cart.currency.iso_code | default: 'USD' | json }}
                  },
                  "shippingDestination": {
                    "@type": "DefinedRegion",
                    "addressCountry": "US"
                  },
                  "deliveryTime": {
                    "@type": "ShippingDeliveryTime",
                    "handlingTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 1,
                      "maxValue": 3,
                      "unitCode": "DAY"
                    },
                    "transitTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 3,
                      "maxValue": 7,
                      "unitCode": "DAY"
                    }
                  }
                }
              }
            }{%- unless forloop.last %},{% endunless -%}
          {%- endfor -%}
        ]
      }
    {%- else -%}
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "@id": {{ canonical_url | append: '#product' | json }},
        "name": {{ product.title | json }},
        "description": {{ schema_product_description | json }},
        "url": {{ canonical_url | json }},
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | default: shop.name | json }}
        },
        {%- if schema_review_count > 0 and schema_rating_value != blank %}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ schema_rating_value | json }},
            "reviewCount": {{ schema_review_count }},
            "bestRating": "5",
            "worstRating": "1"
          },
        {%- endif %}
        {%- if product.selected_or_first_available_variant.sku != blank %}
          "sku": {{ product.selected_or_first_available_variant.sku | json }},
        {%- endif %}
        {%- if product.selected_or_first_available_variant.barcode != blank %}
          "gtin": {{ product.selected_or_first_available_variant.barcode | json }},
        {%- endif %}
        {%- if product.featured_image != blank %}
          "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
        {%- endif %}
        "offers": {
          "@type": "Offer",
          "@id": {{ canonical_url | append: '#offer' | json }},
          "url": {{ canonical_url | json }},
          "price": "{{ product.selected_or_first_available_variant.price | default: product.price | money_without_currency | remove: ',' }}",
          "priceCurrency": {{ cart.currency.iso_code | default: 'USD' | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "seller": {
            "@type": "Organization",
            "name": {{ shop.name | json }}
          },
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "US",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": 30,
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/FreeReturn",
            "merchantReturnLink": "https://wrydeco.com/policies/refund-policy"
          },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": "0.00",
              "currency": {{ cart.currency.iso_code | default: 'USD' | json }}
            },
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "US"
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 3,
                "unitCode": "DAY"
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "minValue": 3,
                "maxValue": 7,
                "unitCode": "DAY"
              }
            }
          }
        }
      }
    {%- endif -%}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if request.page_type == 'article' -%}
  {%- liquid
    assign article_schema_description = seo_page_description | default: article.excerpt | strip_html | strip
    if article_schema_description == blank
      assign article_schema_description = article.content | strip_html | strip | truncatewords: 32
    endif

    assign article_schema_image_url = blank
    if page_image
      assign article_schema_image_url = page_image | image_url: width: 1200 | prepend: 'https:'
    elsif article.image
      assign article_schema_image_url = article.image | image_url: width: 1200 | prepend: 'https:'
    endif

    assign article_schema_author_name = article.author | default: shop.name
    assign article_schema_date_published = blank
    if article.published_at
      assign article_schema_date_published = article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z'
    elsif article.created_at
      assign article_schema_date_published = article.created_at | date: '%Y-%m-%dT%H:%M:%S%:z'
    endif
    assign article_schema_date_modified = article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z'
    assign article_schema_home_url = 'https://wrydeco.com/'
    assign article_schema_organization_id = article_schema_home_url | append: '#organization'
    assign article_schema_logo_url = 'store-logo-trans.png' | file_url | prepend: 'https:'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ canonical_url | json }}
      },
      "headline": {{ article.title | json }},
      "description": {{ article_schema_description | json }},
      {%- if article_schema_image_url != blank %}
        "image": [{{ article_schema_image_url | json }}],
      {%- endif %}
      "author": {
        "@type": "Organization",
        "name": {{ article_schema_author_name | json }}
      },
      "publisher": {
        "@type": "Organization",
        "@id": {{ article_schema_organization_id | json }},
        "name": {{ shop.name | json }},
        "logo": {
          "@type": "ImageObject",
          "url": {{ article_schema_logo_url | json }}
        }
      },
      "datePublished": {{ article_schema_date_published | json }},
      "dateModified": {{ article_schema_date_modified | json }}
    }
  </script>
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- comment -%}
  Compare the brand case-insensitively: Liquid's `contains` is case-sensitive, so
  an SEO title written as "… | WRYDECO" did not match a shop name of "Wrydeco"
  and the brand was appended a second time ("… | WRYDECO &ndash; Wrydeco").
{%- endcomment -%}
{%- liquid
  assign page_title_compare = seo_page_title | downcase
  assign shop_name_compare = shop.name | downcase
-%}
<title>
  {{ seo_page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title_compare contains shop_name_compare %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- comment -%}
  Index control. Shopify emits no robots meta of its own for these routes, so
  this is the single source of truth for the directive.

  `noindex, follow` (not `noindex, nofollow`) everywhere: the pages should stay
  out of the index but their links must still pass crawl signals.

  Internal search is the important one — /search?q=… returns 200 with a
  self-canonical URL and is not blocked in robots.txt, so every query would
  otherwise become its own thin, indexable page.
{%- endcomment -%}
{%- liquid
  assign robots_directive = 'index, follow'

  case request.page_type
    when 'search', 'cart', 'gift_card', 'password', 'captcha'
      assign robots_directive = 'noindex, follow'
    when 'customers/account', 'customers/activate_account', 'customers/addresses', 'customers/login', 'customers/order', 'customers/register', 'customers/reset_password'
      assign robots_directive = 'noindex, follow'
  endcase

  # App proxy pages (/apps/track-order, /apps/page/wishlist) render through this
  # layout with a 200 status and are personalised or thin, so keep them out too.
  if request.path contains '/apps/'
    assign robots_directive = 'noindex, follow'
  endif
-%}
<meta
  name="robots"
  content="{{ robots_directive }}"
>

{% if seo_page_description %}
  <meta
    name="description"
    content="{{ seo_page_description | escape }}"
  >
{% endif %}

{%- if request.page_type == 'index' -%}
  {%- liquid
    assign schema_home_url = 'https://wrydeco.com/'
    assign schema_organization_id = schema_home_url | append: '#organization'
    assign schema_website_id = schema_home_url | append: '#website'
    assign schema_logo_url = 'store-logo-trans.png' | file_url | prepend: 'https:'
    assign legal_info = metaobjects.legal_business_info.values | first
    assign schema_phone = legal_info.phone_number.value | default: '+1 (801) 340-6671'
    assign schema_email = legal_info.support_email.value | default: 'support@wrydeco.com'
    assign schema_address = legal_info.business_address.value | default: '1209 MOUNTAIN ROAD PL NE STE R, Albuquerque, NM 87110, United States'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ schema_organization_id | json }},
          "name": {{ shop.name | json }},
          "url": {{ schema_home_url | json }},
          "logo": {
            "@type": "ImageObject",
            "url": {{ schema_logo_url | json }}
          },
          "email": {{ schema_email | json }},
          "telephone": {{ schema_phone | json }},
          "address": {{ schema_address | json }},
          "sameAs": [
            "https://www.pinterest.com/wrydecovip",
            "https://www.facebook.com/profile.php?id=61591715281987",
            "https://www.instagram.com/wrydeco/"
          ]
        },
        {
          "@type": "WebSite",
          "@id": {{ schema_website_id | json }},
          "url": {{ schema_home_url | json }},
          "name": {{ shop.name | json }},
          "publisher": {
            "@id": {{ schema_organization_id | json }}
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://wrydeco.com/search?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{%- endif -%}
