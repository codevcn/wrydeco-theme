<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

<link rel="icon" type="image/png" href="{{ 'favicon-96x96.png' | asset_url }}" sizes="96x96">
<link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
<link rel="shortcut icon" href="{{ 'favicon.ico' | asset_url }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
{%- comment -%}
  Reference the manifest WITHOUT the `.liquid` suffix: Shopify only renders a
  `.liquid` asset when it is requested by its rendered name. Linking to
  `manifest.json.liquid` serves the raw template, so the manifest shipped
  `{{ shop.name }}` as literal text and was invalid JSON.

  theme-check flags this as MissingAsset because the file on disk is named
  `manifest.json.liquid` — that is the lint reading filenames literally, not a
  broken reference, so the rule is disabled for this line only.
{%- endcomment -%}
{% # theme-check-disable MissingAsset %}
<link rel="manifest" href="{{ 'manifest.json' | asset_url }}">
{% # theme-check-enable MissingAsset %}
{%- liquid
  assign seo_page_title = page_title | default: shop.name
  assign seo_page_description = page_description

  if request.page_type == 'index'
    assign seo_page_title = 'WRYDECO | Handcrafted Sculptural Solid Wood Furniture'
    assign seo_page_description = 'Discover WRYDECO handcrafted solid wood furniture, including sculptural bookshelves, organic tables, beds and distinctive made-to-order designs.'
  endif

  assign og_title = seo_page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- comment -%}
  Compare the brand case-insensitively: Liquid's `contains` is case-sensitive, so
  an SEO title written as "… | WRYDECO" did not match a shop name of "Wrydeco"
  and the brand was appended a second time ("… | WRYDECO &ndash; Wrydeco").
{%- endcomment -%}
{%- liquid
  assign page_title_compare = seo_page_title | downcase
  assign shop_name_compare = shop.name | downcase
-%}
<title>
  {{ seo_page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title_compare contains shop_name_compare %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- comment -%}
  Index control. Shopify emits no robots meta of its own for these routes, so
  this is the single source of truth for the directive.

  `noindex, follow` (not `noindex, nofollow`) everywhere: the pages should stay
  out of the index but their links must still pass crawl signals.

  Internal search is the important one — /search?q=… returns 200 with a
  self-canonical URL and is not blocked in robots.txt, so every query would
  otherwise become its own thin, indexable page.
{%- endcomment -%}
{%- liquid
  assign robots_directive = 'index, follow'

  case request.page_type
    when 'search', 'cart', 'gift_card', 'password', 'captcha'
      assign robots_directive = 'noindex, follow'
    when 'customers/account', 'customers/activate_account', 'customers/addresses', 'customers/login', 'customers/order', 'customers/register', 'customers/reset_password'
      assign robots_directive = 'noindex, follow'
  endcase

  # App proxy pages (/apps/track-order, /apps/page/wishlist) render through this
  # layout with a 200 status and are personalised or thin, so keep them out too.
  if request.path contains '/apps/'
    assign robots_directive = 'noindex, follow'
  endif
-%}
<meta
  name="robots"
  content="{{ robots_directive }}"
>

{% if seo_page_description %}
  <meta
    name="description"
    content="{{ seo_page_description | escape }}"
  >
{% endif %}

{%- if request.page_type == 'index' -%}
  {%- liquid
    assign schema_home_url = 'https://wrydeco.com/'
    assign schema_organization_id = schema_home_url | append: '#organization'
    assign schema_website_id = schema_home_url | append: '#website'
    assign schema_logo_url = 'store-logo-trans.png' | file_url | prepend: 'https:'
    assign legal_info = metaobjects.legal_business_info.values | first
    assign schema_phone = legal_info.phone_number.value | default: '+1 (801) 340-6671'
    assign schema_email = legal_info.support_email.value | default: 'support@wrydeco.com'
    assign schema_address = legal_info.business_address.value | default: '1209 MOUNTAIN ROAD PL NE STE R, Albuquerque, NM 87110, United States'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ schema_organization_id | json }},
          "name": {{ shop.name | json }},
          "url": {{ schema_home_url | json }},
          "logo": {
            "@type": "ImageObject",
            "url": {{ schema_logo_url | json }}
          },
          "email": {{ schema_email | json }},
          "telephone": {{ schema_phone | json }},
          "address": {{ schema_address | json }},
          "sameAs": [
            "https://www.pinterest.com/wrydecovip",
            "https://www.facebook.com/profile.php?id=61591715281987",
            "https://www.instagram.com/wrydeco/"
          ]
        },
        {
          "@type": "WebSite",
          "@id": {{ schema_website_id | json }},
          "url": {{ schema_home_url | json }},
          "name": {{ shop.name | json }},
          "publisher": {
            "@id": {{ schema_organization_id | json }}
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://wrydeco.com/search?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{%- endif -%}
