{% doc %}
  Renders a Real Homes project with a fixed-image product/client comparison slider.
  @param {metaobject} entry - Real-in-spaces project entry.
  @param {product} product - Product resolved server-side from the entry's handle.
  @param {string} description - Product description for the client gallery.
  @param {boolean} featured - Whether this entry is the featured project.
{% enddoc %}
{% liquid
  assign gallery = entry.gallery_media.value | append: ''
  assign gallery_items = gallery | split: ','
  assign client_media = gallery_items | first | strip
  assign client_media_normalized = client_media | downcase
  assign client_is_video = false
  if client_media_normalized contains '.mp4'
    assign client_is_video = true
  elsif client_media_normalized contains '.webm'
    assign client_is_video = true
  elsif client_media_normalized contains '.mov'
    assign client_is_video = true
  endif
  assign gallery_count = 0
  for item in gallery_items
    assign media_url = item | strip
    if media_url != blank
      assign gallery_count = gallery_count | plus: 1
    endif
  endfor
  assign views_label = 'Views'
  if gallery_count == 1
    assign views_label = 'View'
  endif
  assign author = entry.author.value
  assign product_url = '/products/' | append: entry.product_handle.value
  assign product_image = product.featured_image
  assign product_title = product.metafields.custom.artwork_name.value | default: product.title
%}
{% capture gallery_attributes %}
  data-lightbox-trigger
  data-gallery="{{ gallery | escape }}"
  data-title="{{ entry.title.value | escape }}"
  data-poster="{{ entry.video_poster.value | escape }}"
  data-author="{{ author.author_name.value | escape }}"
  data-author-url="{{ author.system.url | escape }}"
  data-description="{{ description | escape }}"
  data-product-url="{{ product_url | escape }}"
  data-featured="{{ featured }}"
{% endcapture %}
<article class="real-space-project" data-project-card data-product-handle="{{ entry.product_handle.value | escape }}">
  <div class="real-space-project__comparison{% if product_image == blank %} real-space-project__comparison--unavailable{% endif %}" data-project-comparison>
    {% if product_image != blank %}
      <div class="real-space-project__panel real-space-project__panel--catalog">
        {% assign product_alt = product_image.alt | default: product_title %}
        {{ product_image | image_url: width: 1440 | image_tag: class: 'real-space-project__product-image', widths: '320, 480, 640, 800, 960, 1200, 1440', sizes: '(min-width: 1920px) 420px, (min-width: 1100px) 25vw, (min-width: 750px) 35vw, 90vw', alt: product_alt, loading: 'lazy', decoding: 'async', draggable: false }}
      </div>
    {% else %}
      <div class="real-space-project__panel real-space-project__panel--catalog real-space-project__unavailable">
        <span>Product image unavailable</span>
      </div>
    {% endif %}
    <div class="real-space-project__panel real-space-project__panel--client">
      {% if client_is_video %}
        <video data-viewport-video data-src="{{ client_media | escape }}" poster="{{ entry.video_poster.value | escape }}" preload="none" muted playsinline loop aria-label="{{ entry.title.value | escape }} commissioned piece video"></video>
        <span class="real-space-project__play" aria-hidden="true">{% render 'real-space-project-icon', name: 'play' %}</span>
      {% else %}
        <img src="{{ client_media | escape }}" alt="{{ entry.title.value | escape }} commissioned piece by {{ author.author_name.value | escape }}" width="1920" height="2560" loading="lazy" decoding="async" draggable="false">
      {% endif %}
    </div>
    <div class="real-space-project__annotations real-space-project__annotations--client">
      <span class="real-space-project__panel-label real-space-project__panel-label--client">Client’s Installation</span>
    </div>
    {% if product_image != blank %}
      <input class="real-space-project__range" type="range" min="0" max="100" value="50" aria-label="Compare product and client installation for {{ entry.title.value | escape }}" aria-valuetext="50% product, 50% client installation" data-project-compare-range>
      <span class="real-space-project__handle" aria-hidden="true">
        {% render 'real-space-project-icon', name: 'compare' %}
      </span>
    {% endif %}
    <div class="real-space-project__annotations real-space-project__annotations--catalog">
      <span class="real-space-project__panel-label real-space-project__panel-label--catalog">Product on WRYDECO</span>
      <button class="real-space-project__views" type="button" {{ gallery_attributes }} aria-label="Open {{ gallery_count }} {{ views_label | downcase }} of {{ entry.title.value | escape }}">
        {% render 'real-space-project-icon', name: 'eye' %}<span>{{ gallery_count }} {{ views_label }}</span>
      </button>
    </div>
  </div>
  <div class="real-space-project__body">
    <p class="real-space-project__eyebrow">Made for your spaces</p>
    <h3 class="real-space-project__title" title="{{ entry.title.value | escape }}">{{ entry.title.value | escape }}</h3>
    <span class="real-space-project__accent" aria-hidden="true"></span>
    {% if author.author_name.value != blank %}
      <div class="real-space-project__author">
        {% if author.author_image_url.value != blank %}
          <img src="{{ author.author_image_url.value | escape }}" alt="{{ author.author_name.value | escape }}" width="56" height="56" loading="lazy" decoding="async">
        {% endif %}
        <p><span>Crafted By</span>{% if author.system.url != blank %}<a href="{{ author.system.url }}">{{ author.author_name.value | escape }}</a>{% else %}<span>{{ author.author_name.value | escape }}</span>{% endif %}</p>
      </div>
    {% endif %}
    <a class="real-space-project__product-link" href="{{ product_url | escape }}"><span>View This Product</span>{% render 'real-space-project-icon', name: 'arrow' %}</a>
  </div>
</article>

{% stylesheet %}
  .real-space-project {
    container: real-project / inline-size;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 8px;
    border: 1px solid var(--border-light);
    border-radius: 10px;
    background: var(--color-white-cream);
    box-shadow: 0 12px 32px rgb(43 29 14 / 5%);
    overflow: hidden;
  }
  .real-space-project__comparison {
    --project-split: 50%;
    position: relative;
    flex: 0 0 auto;
    width: 100%;
    container-type: inline-size;
    aspect-ratio: 9 / 10;
    border-radius: 5px;
    overflow: hidden;
    background: var(--color-cream);
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .real-space-project__panel {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 0;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-cream);
    color: var(--color-earth-brown);
    overflow: hidden;
  }
  .real-space-project__panel--catalog { clip-path: inset(0 calc(100% - var(--project-split)) 0 0); }
  .real-space-project__panel--client { left: var(--project-split); width: auto; }
  .real-space-project__panel > img,
  .real-space-project__panel > video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }
  .real-space-project__panel--client > img,
  .real-space-project__panel--client > video { left: auto; right: 0; width: 100cqi; max-width: none; }
  .real-space-project__annotations { position: absolute; inset: 0; pointer-events: none; }
  .real-space-project__annotations--catalog { z-index: 5; clip-path: inset(0 calc(100% - var(--project-split)) 0 0); }
  .real-space-project__annotations--client { z-index: 2; clip-path: inset(0 0 0 var(--project-split)); }
  .real-space-project__comparison--unavailable .real-space-project__annotations { clip-path: none; }
  .real-space-project__panel-label {
    position: absolute;
    z-index: 2;
    top: clamp(12px, 3cqw, 20px);
    width: max-content;
    max-width: calc(50% - 20px);
    padding: 8px clamp(8px, 2.5cqw, 20px);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-white-cream) 68%, transparent);
    color: var(--color-earth-brown);
    font-family: var(--font-roboto);
    font-size: clamp(10px, 2.5cqw, 13px);
    font-weight: 500;
    line-height: 1.25;
    text-align: center;
    overflow-wrap: anywhere;
    pointer-events: none;
  }
  .real-space-project__panel-label--catalog { left: 12px; }
  .real-space-project__panel-label--client { right: 12px; }
  .real-space-project__range { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; }
  .real-space-project__comparison:has(.real-space-project__range:focus-visible) { outline: 2px solid var(--color-clay); outline-offset: -3px; }
  .real-space-project__comparison::after { content: ''; position: absolute; z-index: 2; top: 0; bottom: 0; left: var(--project-split); width: 2px; background: var(--color-white-cream); transform: translateX(-1px); pointer-events: none; }
  .real-space-project__comparison--unavailable { display: grid; grid-template-columns: 1fr 1fr; }
  .real-space-project__comparison--unavailable .real-space-project__panel { position: relative; inset: auto; width: 100%; clip-path: none; }
  .real-space-project__comparison--unavailable .real-space-project__panel--client > img,
  .real-space-project__comparison--unavailable .real-space-project__panel--client > video { width: 100%; }
  .real-space-project__comparison--unavailable::after { display: none; }
  .real-space-project__handle {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: var(--project-split);
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-white-cream) 82%, transparent);
    color: var(--color-earth-brown);
    cursor: ew-resize;
    touch-action: none;
    pointer-events: none;
  }
  .real-space-project__handle svg { width: 24px; height: 24px; pointer-events: none; }
  .real-space-project__views {
    position: absolute;
    z-index: 5;
    bottom: 4px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 6px 10px;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-earth-brown);
    font-family: var(--font-roboto);
    font-size: 11px;
    cursor: pointer;
    pointer-events: auto;
  }
  .real-space-project__views::before { content: ''; position: absolute; inset: 9px 0; border-radius: inherit; background: color-mix(in srgb, var(--color-white-cream) 68%, transparent); }
  .real-space-project__views > * { position: relative; }
  .real-space-project__views svg { width: 14px; height: 14px; }
  .real-space-project__play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #fff; pointer-events: none; }
  .real-space-project__play svg { width: 36px; height: 36px; }
  .real-space-project__panel:has(video.is-playing) .real-space-project__play { opacity: 0; }
  .real-space-project__unavailable { display: grid; place-items: center; padding: 24px; font-size: 14px; text-align: center; }
  .real-space-project__body { display: flex; flex: 1; flex-direction: column; padding: clamp(14px, 4.5cqw, 24px) clamp(12px, 4.5cqw, 24px) 14px; }
  .real-space-project__eyebrow { margin: 0 0 12px; font-size: 10px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
  .real-space-project__title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin: 0; min-height: 2.2em; font-family: var(--font-display-light); font-size: clamp(20px, 6.5cqw, 32px); font-weight: 400; line-height: 1.1; letter-spacing: -.025em; overflow-wrap: anywhere; cursor: zoom-in; }
  .real-space-project__accent { display: block; width: 32px; height: 1px; margin: 18px 0; background: var(--color-clay); }
  .real-space-project__author { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; font-size: 13px; line-height: 1.4; }
  .real-space-project__author > img { width: 44px; height: 44px; flex: 0 0 44px; border-radius: var(--radius-full); object-fit: cover; }
  .real-space-project__author p { display: flex; flex-direction: column; margin: 0; }
  .real-space-project__author a { color: inherit; text-decoration: none; }
  .real-space-project__author a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .real-space-project__product-link { position: relative; display: flex; align-items: center; justify-content: center; min-height: 48px; margin-top: auto; padding: 10px 30px; border-radius: 5px; background: linear-gradient(110deg, #4a2c18, #2b1d0e); color: var(--color-white-cream); font-family: var(--font-display-light); font-size: clamp(16px, 4.8cqw, 22px); line-height: 1.2; text-align: center; text-decoration: none; }
  .real-space-project__product-link svg { position: absolute; right: 10px; width: 18px; height: 18px; }
  .real-space-project :is(a, button):focus-visible { outline: 2px solid var(--color-clay); outline-offset: -3px; }
  @media (hover: hover) {
    .real-space-project__product-link:hover svg { transform: translateX(3px); }
  }
  @media (max-width: 749px) {
    .real-space-project { flex: 0 0 min(90vw, 460px); scroll-snap-align: start; }
    .real-space-project__title { min-height: 2.2em; font-size: clamp(25px, 7cqw, 32px); }
    .real-space-project__author { font-size: 14px; }
    .real-space-project__author > img { width: 52px; height: 52px; flex-basis: 52px; }
    .real-space-project__product-link { padding-inline: 40px; font-size: clamp(18px, 5.5cqw, 22px); }
    .real-space-project__handle { width: 44px; height: 44px; }
    .real-space-project__views { bottom: 10px; left: 10px; padding: 6px 10px; }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    function initComparisons(root) {
      (root || document).querySelectorAll('[data-project-comparison]').forEach(pair => {
        const range = pair.querySelector('[data-project-compare-range]');
        if (!range || range.dataset.ready) return;
        range.dataset.ready = 'true';
        const update = () => {
          const value = Number(range.value);
          pair.style.setProperty('--project-split', `${value}%`);
          range.setAttribute('aria-valuetext', `${value}% product, ${100 - value}% client installation`);
        };
        range.addEventListener('input', update);
        update();
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => initComparisons(document));
    else initComparisons(document);
    document.addEventListener('shopify:section:load', event => initComparisons(event.target));
  })();
{% endjavascript %}
