{% doc %}
  Renders product media gallery.

  @param {product} product - The product whose media is rendered
  @param {variant} current_variant - The selected product variant
  @param {string} section_id - The parent product section ID
{% enddoc %}

{% stylesheet %}
  .product-gallery {
    --product-gallery-main-max: calc(var(--sp-12) * 9.375);
    --product-gallery-thumb-size: clamp(calc(var(--sp-10) + var(--sp-2)), 8vw, calc(var(--sp-12) + var(--sp-7)));
    width: 100%;
    margin-block-end: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .product-gallery__main {
    aspect-ratio: 1 / 1;
    height: clamp(300px, 78vw, 600px);
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background-color: var(--bg-secondary);
    position: relative;
    z-index: 99;
    width: fit-content;
    margin-inline: auto;
  }
  /* Light-blue lens marking the area shown in the zoom popup. */
  .product-gallery__zoom-lens {
    position: absolute;
    z-index: 2;
    display: none;
    pointer-events: none;
    border: 1.5px solid rgba(90, 150, 230, 0.85);
    background-color: rgba(120, 170, 235, 0.22);
    border-radius: var(--radius-sm);
  }
  .product-gallery__zoom-lens.is-active {
    display: block;
  }
  .product-gallery__wishlist {
    position: absolute;
    inset-block-start: var(--sp-4);
    inset-inline-end: var(--sp-4);
    z-index: 3;
    display: grid;
    place-items: center;
    inline-size: var(--sp-6-bigger);
    block-size: var(--sp-6-bigger);
    padding: var(--sp-0);
    border: var(--border-width) solid var(--color-bark);
    border-radius: var(--radius-full);
    background-color: var(--color-milk);
    box-shadow: var(--shadow-elevation-1);
    color: var(--color-bark);
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .product-gallery__wishlist:hover,
  .product-gallery__wishlist:focus-visible,
  .product-gallery__wishlist.is-added {
    background-color: red;
    color: var(--color-milk);
  }
  .product-gallery__wishlist:focus-visible {
    outline: var(--border-width) solid var(--color-bark);
    outline-offset: var(--sp-1);
  }
  .product-gallery__wishlist:disabled {
    cursor: wait;
  }
  .product-gallery__wishlist-icon,
  .product-gallery__wishlist-icon svg {
    display: block;
    inline-size: var(--sp-5);
    block-size: var(--sp-5);
  }
  .product-gallery__wishlist-loading {
    display: none;
    inline-size: var(--sp-5);
    block-size: var(--sp-5);
    border: calc(var(--border-width) * 2) solid currentColor;
    border-inline-start-color: transparent;
    border-radius: var(--radius-full);
    animation: product-gallery-wishlist-spin var(--timing-extra-long) linear infinite;
  }
  .product-gallery__wishlist[aria-busy='true'] .product-gallery__wishlist-icon {
    display: none;
  }
  .product-gallery__wishlist[aria-busy='true'] .product-gallery__wishlist-loading {
    display: block;
  }
  @keyframes product-gallery-wishlist-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-gallery__wishlist-loading {
      animation: none;
    }
  }
  .product-gallery__stage-loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    background-color: var(--surface-default);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .product-gallery__main.is-loading .product-gallery__stage-loading {
    opacity: 1;
    visibility: visible;
  }
  .product-gallery__stage-spinner {
    display: block;
    inline-size: var(--sp-7);
    block-size: var(--sp-7);
    border: calc(var(--border-width) * 2) solid var(--border-default);
    border-block-start-color: var(--color-clay);
    border-radius: var(--radius-full);
    animation: product-gallery-stage-spin var(--timing-extra-long) linear infinite;
  }
  @keyframes product-gallery-stage-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-gallery__stage-spinner {
      animation: none;
    }
  }
  .product-gallery__main-item {
    display: none;
    width: fit-content;
    border-radius: 6px;
    overflow: hidden;
  }
  .product-gallery__main-item.is-active {
    display: block;
  }
  .product-gallery__main-media {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .product-gallery__main-video {
    width: 100%;
    height: 100%;
    background-color: var(--color-ebony);
  }
  .product-gallery__main-video iframe,
  .product-gallery__main-video video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background-color: var(--color-ebony);
  }
  .product-gallery__main-media iframe,
  .product-gallery__main-media video,
  .product-gallery__main-media model-viewer {
    margin-inline: auto;
  }
  .product-gallery__thumbnails {
    display: flex;
    overflow-x: auto;
    gap: var(--sp-2);
    scrollbar-width: none;
    -ms-overflow-style: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }
  .product-gallery__thumbnails.is-active-drag {
    cursor: grabbing;
  }
  .product-gallery__thumbnails::-webkit-scrollbar {
    display: none;
  }
  .product-gallery__thumbnail {
    flex: 0 0 calc(35% - var(--sp-7));
    aspect-ratio: 1;
    min-width: 0;
    padding: 0;
    cursor: pointer;
    border: 3px solid transparent;
    border-radius: var(--radius-lg);
    overflow: hidden;
    opacity: 1;
    transition: border-color var(--timing-short) var(--ease-standard);
    background-color: var(--bg-secondary);
  }
  .product-gallery__thumbnail.is-active,
  .product-gallery__thumbnail:hover {
    border-color: var(--color-clay);
  }
  .product-gallery__thumbnail:focus-visible {
    outline: 2px solid var(--color-sage);
    outline-offset: var(--sp-1);
  }
  .product-gallery__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .product-gallery__thumbnail--video,
  .product-lightbox__thumbnail--video {
    position: relative;
    display: grid;
    place-items: center;
    color: var(--color-cream);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-earth-brown) 82%, transparent), rgba(0, 0, 0, 0.42)),
      var(--color-ebony);
  }
  .product-gallery__thumbnail-video-icon,
  .product-lightbox__thumbnail-video-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--sp-7);
    height: var(--sp-7);
    border: var(--border-width) solid currentColor;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--color-ebony) 28%, transparent);
  }
  .product-gallery__thumbnail-video-icon svg,
  .product-lightbox__thumbnail-video-icon svg {
    width: var(--sp-4);
    height: var(--sp-4);
  }

  @media screen and (max-width: 1320px) {
    .product-gallery__main {
      width: 100%;
      height: auto;
    }

    .product-gallery__main-item.is-active {
      width: 100%;
    }
  }

  @media screen and (max-width: 720px) {
    .product-gallery {
      margin-block-end: var(--sp-3);
    }
    .product-gallery__wishlist {
      inset-block-start: var(--sp-3);
      inset-inline-end: var(--sp-3);
    }
  }

  @media screen and (min-width: 720px) {
    .product-gallery__thumbnails {
      padding-inline: var(--sp-2);
    }
    .product-gallery__thumbnail {
      flex: 0 0 var(--product-gallery-thumb-size);
    }
    .product-gallery {
      margin-block-end: 0;
      gap: var(--sp-3);
      max-height: calc(100vh - var(--sp-3));
    }
    .product-gallery__main {
      border-radius: var(--radius-sm);
    }
    .product-gallery__main-item.is-active,
    .product-gallery__main-media {
      height: 100%;
    }
    .product-gallery__main-media iframe,
    .product-gallery__main-media video,
    .product-gallery__main-media model-viewer {
      width: 100%;
      height: 100%;
    }
    .product-gallery__thumbnails {
      padding-inline: 0;
    }
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 921px) {
    .product-gallery__zoom-popup {
      position: fixed;
      top: var(--product-gallery-zoom-top, calc(var(--sp-12) + var(--sp-3)));
      bottom: var(--sp-6);
      left: calc(50% + (var(--sp-8, 40px) / 2));
      right: 64px;
      background-color: var(--bg-primary, #fff);
      z-index: 10000;
      border-radius: var(--radius-lg, 12px);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      background-repeat: no-repeat;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }
    .product-gallery__zoom-popup.is-active {
      opacity: 1;
      visibility: visible;
    }
    .product-gallery__zoom-loading {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      background: var(--bg-primary, #fff);
    }
    .product-gallery__zoom-loading[hidden] {
      display: none;
    }
    .product-gallery__zoom-spinner {
      width: var(--sp-7);
      height: var(--sp-7);
      border: calc(var(--border-width) * 2) solid color-mix(in srgb, var(--color-earth-brown) 22%, transparent);
      border-top-color: var(--color-earth-brown);
      border-radius: var(--radius-full);
      animation: product-gallery-zoom-spin var(--timing-extra-long) linear infinite;
    }
    @keyframes product-gallery-zoom-spin {
      to {
        transform: rotate(360deg);
      }
    }
    .product-gallery__main:hover {
      cursor: crosshair;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-gallery__zoom-spinner {
      animation: none;
    }
  }

  .product-lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-6);
    background-color: var(--bg-overlay);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--timing-base) var(--ease-standard);
  }
  .product-lightbox[hidden] {
    display: none;
  }
  .product-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .product-lightbox__content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
  }
  .product-lightbox__media-list {
    display: flex;
    flex-direction: column;
    align-self: center;
    gap: var(--sp-2);
    max-height: calc(100vh - (var(--sp-6) * 2));
    overflow-y: auto;
    overscroll-behavior: contain;
    /* NOTE: no `scrollbar-width` here on purpose. In Chromium 121+ setting the
       standardized `scrollbar-width` makes the browser ignore the legacy
       `::-webkit-scrollbar` rules that the `custom-scrollbar` class relies on,
       which would fall back to the default browser scrollbar. */
    width: 100px;
  }
  .product-lightbox__thumbnail {
    flex: 0 0 auto;
    width: 100%;
    aspect-ratio: 1/1;
    padding: var(--sp-0);
    overflow: hidden;
    border: var(--border-width) solid var(--border-light);
    border-radius: var(--radius-md);
    background-color: var(--surface-elevated);
    box-shadow: var(--shadow-elevation-1);
    cursor: pointer;
    opacity: 0.72;
    transition: border-color var(--timing-short) var(--ease-standard), opacity var(--timing-short) var(--ease-standard),
      transform var(--timing-short) var(--ease-standard);
  }
  .product-lightbox__thumbnail:hover,
  .product-lightbox__thumbnail:focus-visible,
  .product-lightbox__thumbnail.is-active {
    border-color: var(--color-clay);
    opacity: 1;
  }
  .product-lightbox__thumbnail:focus-visible {
    outline: var(--border-width) solid var(--color-sage);
    outline-offset: var(--sp-1);
  }
  .product-lightbox__thumbnail.is-active {
    transform: scale(0.94);
  }
  .product-lightbox__thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-lightbox__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    height: 100%;
    min-width: 0;
    min-height: 0;
    aspect-ratio: 1/1;
  }
  .product-lightbox__img {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - (var(--sp-6) * 2));
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevation-4);
    opacity: 0;
    transform: translateY(var(--sp-3)) scale(0.98);
    transition: opacity var(--timing-base) var(--ease-standard), transform var(--timing-base) var(--ease-standard);
  }
  .product-lightbox__video {
    display: none;
    width: min(100%, calc(100vh - (var(--sp-6) * 2)));
    height: min(100%, calc(100vh - (var(--sp-6) * 2)));
    max-width: 100%;
    max-height: calc(100vh - (var(--sp-6) * 2));
    aspect-ratio: 1 / 1;
    border: 0;
    border-radius: var(--radius-lg);
    background-color: var(--color-ebony);
    box-shadow: var(--shadow-elevation-4);
    opacity: 0;
    transform: translateY(var(--sp-3)) scale(0.98);
    transition: opacity var(--timing-base) var(--ease-standard), transform var(--timing-base) var(--ease-standard);
  }
  .product-lightbox__video video,
  .product-lightbox__video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: inherit;
    background-color: var(--color-ebony);
  }
  .product-lightbox.is-open .product-lightbox__img,
  .product-lightbox.is-open .product-lightbox__video {
    opacity: 1;
    transform: translateY(var(--sp-0)) scale(1);
  }
  .product-lightbox__navigation {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
  }
  .product-lightbox__nav-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--sp-7);
    height: var(--sp-7);
    padding: var(--sp-0);
    border: var(--border-width) solid var(--border-light);
    border-radius: var(--radius-full);
    background-color: var(--color-earth-brown);
    color: var(--color-cream);
    box-shadow: var(--shadow-elevation-2);
    cursor: pointer;
    transition: background-color var(--timing-short) var(--ease-standard),
      color var(--timing-short) var(--ease-standard), transform var(--timing-short) var(--ease-standard);
  }
  .product-lightbox__nav-button:hover,
  .product-lightbox__nav-button:focus-visible {
    background-color: var(--surface-elevated);
    color: var(--color-earth-brown);
  }
  .product-lightbox__nav-button:focus-visible {
    outline: var(--border-width) solid var(--color-sage);
    outline-offset: var(--sp-1);
  }
  .product-lightbox__nav-button:active {
    transform: scale(0.94);
  }
  .product-lightbox__nav-button svg {
    width: var(--sp-5);
    height: var(--sp-5);
  }
  .product-lightbox__close {
    position: absolute;
    top: max(var(--sp-5), env(safe-area-inset-top));
    right: max(var(--sp-5), env(safe-area-inset-right));
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: var(--radius-full);
    background-color: var(--surface-elevated);
    color: var(--text-primary);
    cursor: pointer;
    box-shadow: var(--shadow-elevation-2);
    opacity: 0;
    transform: translateY(calc(var(--sp-3) * -1));
    transition: opacity var(--timing-short) var(--ease-standard), transform var(--timing-short) var(--ease-standard);
  }
  .product-lightbox.is-open .product-lightbox__close {
    opacity: 1;
    transform: translateY(var(--sp-0));
  }
  .product-lightbox__close svg {
    width: 22px;
    height: 22px;
  }

  .product-lightbox-is-open #shopify-chat,
  .product-lightbox-is-open .shopify-chat,
  .product-lightbox-is-open #chat-widget-container,
  .product-lightbox-is-open iframe[title*='chat' i],
  .product-lightbox-is-open iframe[id*='chat' i],
  .product-lightbox-is-open .scroll-to-top {
    display: none !important;
  }

  @media screen and (max-width: 720px) {
    .product-lightbox {
      align-items: center;
      padding: var(--sp-3);
    }

    .product-lightbox__content {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      height: auto;
      max-height: 100%;
      gap: var(--sp-3);
    }

    .product-lightbox__media-list {
      order: 2;
      flex-direction: row;
      align-self: stretch;
      width: 100%;
      max-height: none;
      padding-block: var(--sp-1);
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
    }

    .product-lightbox__thumbnail {
      flex-basis: var(--sp-8);
      width: var(--sp-8);
      height: var(--sp-8);
      scroll-snap-align: start;
    }

    .product-lightbox__stage {
      order: 1;
      align-self: center;
      width: min(100%, calc(100dvh - var(--sp-8) - var(--sp-7)));
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .product-lightbox__img {
      width: 100%;
      height: 100%;
      max-height: 100%;
    }
    .product-lightbox__video {
      width: 100%;
      height: 100%;
      max-height: 100%;
    }

    .product-lightbox__navigation {
      display: none;
    }

    .product-lightbox__close {
      top: max(var(--sp-3), env(safe-area-inset-top));
      right: max(var(--sp-3), env(safe-area-inset-right));
    }
  }

  .product-gallery__best-seller-badge {
    position: absolute;
    inset-block-start: var(--sp-4);
    inset-inline-start: var(--sp-4);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--sp-1) var(--sp-3);
    background-color: var(--color-milk);
    color: var(--color-clay);
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-full);
    pointer-events: none;
    box-shadow: var(--shadow-elevation-1);
  }
  .product-gallery__best-seller-badge svg {
    width: 14px;
    height: 14px;
  }
  .product-gallery__best-seller-badge svg path {
    fill: var(--color-clay);
  }

  @media screen and (max-width: 720px) {
    .product-gallery__best-seller-badge {
      inset-block-start: var(--sp-3);
      inset-inline-start: var(--sp-3);
    }
  }
{% endstylesheet %}

{%- liquid
  assign product_video_position = 5
  assign product_video_url = product.metafields.custom.product_video_media.value | default: product.metafields.custom.product_video_media | strip
  assign has_product_video = false
  if product_video_url != blank
    assign has_product_video = true
  endif

  assign product_video_media_id = 'product-video-media'
  assign product_video_alt = product.title | append: ' video'
  assign product_video_embed_url = product_video_url
  assign product_video_kind = 'iframe'
  assign product_video_youtube_id = blank

  if has_product_video
    assign product_video_url_downcase = product_video_url | downcase
    if product_video_url_downcase contains '.mp4'
      assign product_video_kind = 'video'
    endif
    if product_video_url_downcase contains '.webm'
      assign product_video_kind = 'video'
    endif
    if product_video_url_downcase contains '.ogg'
      assign product_video_kind = 'video'
    endif

    if product_video_url_downcase contains 'youtu.be/'
      assign product_video_youtube_id = product_video_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first
      assign product_video_embed_url = 'https://www.youtube.com/embed/' | append: product_video_youtube_id
    elsif product_video_url_downcase contains 'youtube.com/shorts/'
      assign product_video_youtube_id = product_video_url | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first
      assign product_video_embed_url = 'https://www.youtube.com/embed/' | append: product_video_youtube_id
    elsif product_video_url_downcase contains 'youtube.com/embed/'
      assign product_video_youtube_id = product_video_url | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first
      assign product_video_embed_url = 'https://www.youtube.com/embed/' | append: product_video_youtube_id
    elsif product_video_url_downcase contains 'youtube.com/watch'
      assign product_video_youtube_id = product_video_url | split: 'v=' | last | split: '&' | first
      assign product_video_embed_url = 'https://www.youtube.com/embed/' | append: product_video_youtube_id
    elsif product_video_url_downcase contains 'vimeo.com/'
      assign product_video_vimeo_id = product_video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | last
      assign product_video_embed_url = 'https://player.vimeo.com/video/' | append: product_video_vimeo_id
    endif
  endif
-%}

{%- capture product_video_play_icon -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
{%- endcapture -%}

{%- capture product_video_main_item -%}
  {%- if has_product_video -%}
    <div
      id="ProductMedia-{{ section_id }}-{{ product_video_media_id }}"
      class="product-gallery__main-item{% if product.media.size == 0 %} is-active{% endif %}"
      data-main-media-id="{{ product_video_media_id }}"
      data-main-media-type="video"
      data-alt="{{ product_video_alt | escape }}"
    >
      <div class="product-gallery__main-media product-gallery__main-video">
        {%- if product_video_kind == 'video' -%}
          <video controls preload="metadata" playsinline>
            <source src="{{ product_video_url | escape }}">
          </video>
        {%- else -%}
          <iframe
            src="{{ product_video_embed_url | escape }}"
            title="{{ product_video_alt | escape }}"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture product_video_thumbnail -%}
  {%- if has_product_video -%}
    <button
      type="button"
      class="product-gallery__thumbnail product-gallery__thumbnail--video{% if product.media.size == 0 %} is-active{% endif %}"
      data-thumbnail-id="{{ product_video_media_id }}"
      data-alt="{{ product_video_alt | escape }}"
      aria-controls="ProductMedia-{{ section_id }}-{{ product_video_media_id }}"
      aria-pressed="{% if product.media.size == 0 %}true{% else %}false{% endif %}"
      aria-label="View {{ product_video_alt | escape }}"
    >
      <span class="product-gallery__thumbnail-video-icon" aria-hidden="true">
        {{ product_video_play_icon }}
      </span>
    </button>
  {%- endif -%}
{%- endcapture -%}

{%- capture product_video_lightbox_thumbnail -%}
  {%- if has_product_video -%}
    <button
      type="button"
      class="product-lightbox__thumbnail product-lightbox__thumbnail--video"
      data-lightbox-thumbnail
      data-lightbox-media-id="{{ product_video_media_id }}"
      data-lightbox-type="video"
      data-lightbox-video-kind="{{ product_video_kind }}"
      data-lightbox-video-src="{{ product_video_embed_url | escape }}"
      data-lightbox-alt="{{ product_video_alt | escape }}"
      aria-label="View {{ product_video_alt | escape }}"
      aria-pressed="false"
    >
      <span class="product-lightbox__thumbnail-video-icon" aria-hidden="true">
        {{ product_video_play_icon }}
      </span>
    </button>
  {%- endif -%}
{%- endcapture -%}

<div class="product-gallery" data-product-gallery>
  <div class="product-gallery__main">
    {% assign wishlist_variant = current_variant | default: product.selected_or_first_available_variant %}
    <button
      type="button"
      class="product-gallery__wishlist"
      data-product-wishlist
      data-wishlist-product-id="{{ product.id }}"
      data-wishlist-variant-id="{{ wishlist_variant.id }}"
      data-wishlist-product-title="{{ product.title | escape }}"
      aria-label="Add {{ product.title | escape }} to wishlist"
      aria-pressed="false"
    >
      <span class="product-gallery__wishlist-icon" data-product-wishlist-icon aria-hidden="true"></span>
      <span class="product-gallery__wishlist-loading" aria-hidden="true"></span>
    </button>

    {% assign has_best_seller = false %}
    {% for coll in product.collections %}
      {% if coll.handle == 'signature-pieces' %}
        {% assign has_best_seller = true %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% if has_best_seller %}
      <div class="product-gallery__best-seller-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
          <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.12 2.12 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.12 2.12 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.12 2.12 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.12 2.12 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.12 2.12 0 0 0 1.597-1.16z"/>
        </svg>
        <span>Best Seller</span>
      </div>
    {% endif %}

    <div class="product-gallery__zoom-lens" data-zoom-lens aria-hidden="true"></div>
    {% assign featured_media = current_variant.featured_media | default: product.featured_media %}
    {% for media in product.media %}
      {%- if has_product_video -%}
        {%- if forloop.index == product_video_position -%}
          {{ product_video_main_item }}
        {%- endif -%}
      {%- endif -%}
      {% liquid
        assign is_active_media = false
        if media.id == featured_media.id
          assign is_active_media = true
        elsif featured_media == blank
          if forloop.first
            assign is_active_media = true
          endif
        endif
        assign media_alt = media.alt | default: product.title

        # Preload the first N gallery images (eager) so switching thumbnails is instant.
        # The active image keeps high priority (LCP); the rest of the preloaded set uses low.
        # Images beyond the cap stay lazy to save bandwidth on products with many images.
        assign gallery_preload_count = 5
        assign main_loading = 'lazy'
        assign main_fetchpriority = 'auto'
        if is_active_media
          assign main_loading = 'eager'
          assign main_fetchpriority = 'high'
        elsif forloop.index <= gallery_preload_count
          assign main_loading = 'eager'
          assign main_fetchpriority = 'low'
        endif
      %}
      <div
        id="ProductMedia-{{ section_id }}-{{ media.id }}"
        class="product-gallery__main-item{% if is_active_media %} is-active{% endif %}"
        data-main-media-id="{{ media.id }}"
        data-main-media-type="{{ media.media_type }}"
        data-alt="{{ media.alt | escape }}"
      >
        {% case media.media_type %}
          {% when 'image' %}
            {% assign zoom_url = media | image_url: width: 2400 %}
            {{
              media
              | image_url: width: 1200
              | image_tag:
                class: 'product-gallery__main-media',
                loading: main_loading,
                fetchpriority: main_fetchpriority,
                widths: '360, 540, 720, 900, 1200',
                sizes: '(min-width: 1024px) 56vw, (min-width: 720px) 58vw, 100vw',
                alt: media_alt,
                data-zoom-src: zoom_url
            }}
          {% when 'external_video' %}
            <div class="product-gallery__main-media">
              {{ media | external_video_tag }}
            </div>
          {% when 'video' %}
            <div class="product-gallery__main-media">
              {{ media | video_tag: controls: true, autoplay: true }}
            </div>
          {% else %}
            <div class="product-gallery__main-media">
              {{ media | media_tag }}
            </div>
        {% endcase %}
      </div>
    {% endfor %}
    {%- if has_product_video -%}
      {%- if product.media.size < product_video_position -%}
        {{ product_video_main_item }}
      {%- endif -%}
    {%- endif -%}
    <div
      class="product-gallery__stage-loading"
      data-gallery-stage-loading
      role="status"
      aria-label="Loading product image"
    >
      <span class="product-gallery__stage-spinner" aria-hidden="true"></span>
    </div>
  </div>

  {%- liquid
    assign show_product_thumbnails = false
    if product.media.size > 1
      assign show_product_thumbnails = true
    endif
    if has_product_video
      assign show_product_thumbnails = true
    endif
  -%}
  {% if show_product_thumbnails %}
    <div class="product-gallery__thumbnails">
      {% for media in product.media %}
        {%- if has_product_video -%}
          {%- if forloop.index == product_video_position -%}
            {{ product_video_thumbnail }}
          {%- endif -%}
        {%- endif -%}
        {% liquid
          assign is_active_thumbnail = false
          if media.id == featured_media.id
            assign is_active_thumbnail = true
          elsif featured_media == blank
            if forloop.first
              assign is_active_thumbnail = true
            endif
          endif
          assign thumbnail_alt = media.alt | default: product.title
        %}
        <button
          type="button"
          class="product-gallery__thumbnail{% if is_active_thumbnail %} is-active{% endif %}"
          data-thumbnail-id="{{ media.id }}"
          data-alt="{{ media.alt | escape }}"
          aria-controls="ProductMedia-{{ section_id }}-{{ media.id }}"
          aria-pressed="{% if is_active_thumbnail %}true{% else %}false{% endif %}"
          aria-label="View {{ thumbnail_alt | escape }}, media {{ forloop.index }} of {{ product.media.size }}"
        >
          {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: thumbnail_alt }}
        </button>
      {% endfor %}
      {%- if has_product_video -%}
        {%- if product.media.size < product_video_position -%}
          {{ product_video_thumbnail }}
        {%- endif -%}
      {%- endif -%}
    </div>
  {% endif %}

  <div
    class="product-lightbox"
    data-product-lightbox
    role="dialog"
    aria-modal="true"
    aria-label="{{ product.title | escape }} media gallery"
    hidden
  >
    <button type="button" class="product-lightbox__close" data-lightbox-close aria-label="Close">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    {%- liquid
      assign lightbox_images = product.media | where: 'media_type', 'image'
      assign lightbox_media_count = lightbox_images.size
      if has_product_video
        assign lightbox_media_count = lightbox_media_count | plus: 1
      endif
    -%}
    <div class="product-lightbox__content">
      <div class="product-lightbox__media-list custom-scrollbar" role="group" aria-label="Product media">
        {% for media in lightbox_images %}
          {%- if has_product_video -%}
            {%- if forloop.index == product_video_position -%}
              {{ product_video_lightbox_thumbnail }}
            {%- endif -%}
          {%- endif -%}
          {%- assign lightbox_alt = media.alt | default: product.title -%}
          <button
            type="button"
            class="product-lightbox__thumbnail"
            data-lightbox-thumbnail
            data-lightbox-media-id="{{ media.id }}"
            data-lightbox-type="image"
            data-lightbox-src="{{ media | image_url: width: 2400 }}"
            data-lightbox-alt="{{ lightbox_alt | escape }}"
            data-lightbox-width="{{ media.width }}"
            data-lightbox-height="{{ media.height }}"
            aria-label="View {{ lightbox_alt | escape }}"
            aria-pressed="false"
          >
            {{
              media
              | image_url: width: 160
              | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '64px', alt: ''
            }}
          </button>
        {% endfor %}
        {%- if has_product_video -%}
          {%- if lightbox_images.size < product_video_position -%}
            {{ product_video_lightbox_thumbnail }}
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="product-lightbox__stage">
        {% # The source is assigned at runtime from the active gallery image (already optimized via image_url) %}
        {% # theme-check-disable ImgWidthAndHeight,RemoteAsset %}
        <img class="product-lightbox__img" data-lightbox-img src="" alt="">
        <div class="product-lightbox__video" data-lightbox-video hidden></div>
        {% # theme-check-enable ImgWidthAndHeight,RemoteAsset %}
      </div>

      {% if lightbox_media_count > 1 %}
        <div class="product-lightbox__navigation" role="group" aria-label="Media navigation">
          <button
            type="button"
            class="product-lightbox__nav-button"
            data-lightbox-previous
            aria-label="View previous image"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m4.5 15.75l7.5-7.5l7.5 7.5"/>
            </svg>
          </button>
          <button
            type="button"
            class="product-lightbox__nav-button"
            data-lightbox-next
            aria-label="View next image"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m19.5 8.25l-7.5 7.5l-7.5-7.5"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="product-gallery__zoom-popup" data-zoom-popup>
    <span class="product-gallery__zoom-loading" data-zoom-loading hidden aria-hidden="true">
      <span class="product-gallery__zoom-spinner"></span>
    </span>
  </div>
</div>

<script>
  (function () {
    function initGalleryStageLoading() {
      document.querySelectorAll('[data-product-gallery]').forEach(function (gallery) {
        if (gallery.dataset.stageLoadingInit === 'true') return;

        var stage = gallery.querySelector('.product-gallery__main');
        var loadingIndicator = gallery.querySelector('[data-gallery-stage-loading]');
        var thumbnails = Array.prototype.slice.call(gallery.querySelectorAll('.product-gallery__thumbnail'));
        if (!stage || !loadingIndicator || !thumbnails.length) return;

        gallery.dataset.stageLoadingInit = 'true';
        var loadingRequestId = 0;
        var minimumLoadingDuration = 180;

        function setActiveThumbnail(selectedThumbnail) {
          thumbnails.forEach(function (thumbnail) {
            var isSelected = thumbnail === selectedThumbnail;
            thumbnail.classList.toggle('is-active', isSelected);
            thumbnail.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
          });
        }

        function setActiveItem(selectedItem) {
          gallery.querySelectorAll('.product-gallery__main-item').forEach(function (item) {
            item.classList.toggle('is-active', item === selectedItem);
            if (item !== selectedItem) {
              item.querySelectorAll('video').forEach(function (video) {
                video.pause();
              });
              item.querySelectorAll('iframe').forEach(function (iframe) {
                iframe.src = iframe.src;
              });
            }
          });
        }

        function stopLoading(requestId) {
          if (requestId !== loadingRequestId) return;
          stage.classList.remove('is-loading');
          stage.removeAttribute('aria-busy');
        }

        thumbnails.forEach(function (thumbnail) {
          thumbnail.addEventListener('click', function () {
            var selectedItem = gallery.querySelector(
              '.product-gallery__main-item[data-main-media-id="' + thumbnail.dataset.thumbnailId + '"]'
            );
            if (!selectedItem) return;

            var activeItem = gallery.querySelector('.product-gallery__main-item.is-active');
            if (selectedItem === activeItem) return;

            loadingRequestId += 1;
            var requestId = loadingRequestId;
            var selectedImage = selectedItem.querySelector('img.product-gallery__main-media');

            setActiveThumbnail(thumbnail);

            var loadingStartedAt = Date.now();
            stage.classList.add('is-loading');
            stage.setAttribute('aria-busy', 'true');
            setActiveItem(selectedItem);

            var finishLoading = function () {
              var elapsedTime = Date.now() - loadingStartedAt;
              var remainingTime = Math.max(0, minimumLoadingDuration - elapsedTime);
              window.setTimeout(function () {
                stopLoading(requestId);
              }, remainingTime);
            };

            if (!selectedImage || (selectedImage.complete && selectedImage.naturalWidth > 0)) {
              finishLoading();
              return;
            }

            selectedImage.addEventListener('load', finishLoading, { once: true });
            selectedImage.addEventListener('error', finishLoading, { once: true });
            selectedImage.loading = 'eager';

            if (selectedImage.complete) {
              finishLoading();
            }
          });
        });
      });
    }

    function initGalleryLightbox() {
      document.querySelectorAll('[data-product-gallery]').forEach(function (gallery) {
        if (gallery.dataset.lightboxInit === 'true') return;

        var zoomBtn = gallery.querySelector('[data-gallery-zoom]');
        var lightbox = gallery.querySelector('[data-product-lightbox]');
        if (!lightbox) return;

        var lightboxImg = lightbox.querySelector('[data-lightbox-img]');
        var lightboxVideo = lightbox.querySelector('[data-lightbox-video]');
        var closeBtn = lightbox.querySelector('[data-lightbox-close]');
        var lightboxThumbnails = Array.prototype.slice.call(lightbox.querySelectorAll('[data-lightbox-thumbnail]'));
        var previousBtn = lightbox.querySelector('[data-lightbox-previous]');
        var nextBtn = lightbox.querySelector('[data-lightbox-next]');
        if (!lightboxImg || !lightboxVideo || !closeBtn) return;

        gallery.dataset.lightboxInit = 'true';
        var originalParent = lightbox.parentNode;
        var originalNextSibling = lightbox.nextSibling;
        var closeTransitionHandler;
        var currentLightboxIndex = 0;
        var lightboxOpener = null;

        function getActiveMediaItem() {
          return gallery.querySelector('.product-gallery__main-item.is-active');
        }

        function getActiveMediaId() {
          var activeItem = gallery.querySelector('.product-gallery__main-item.is-active');
          return activeItem ? activeItem.dataset.mainMediaId : '';
        }

        // Map a lightbox media id back to the gallery's main <img>, so the lightbox
        // can reuse the exact frame the gallery already downloaded (a cache hit).
        function getGalleryImageByMediaId(mediaId) {
          if (!mediaId) return null;
          var item = gallery.querySelector('.product-gallery__main-item[data-main-media-id="' + mediaId + '"]');
          return item ? item.querySelector('img.product-gallery__main-media') : null;
        }

        // Preload every hi-res lightbox image once, at low priority, so after the
        // first view each thumbnail switch upgrades to full quality instantly.
        var hiResPreloaded = false;
        function preloadLightboxHiRes() {
          if (hiResPreloaded) return;
          hiResPreloaded = true;
          lightboxThumbnails.forEach(function (thumbnail) {
            if (thumbnail.dataset.lightboxType !== 'image') return;
            var src = thumbnail.dataset.lightboxSrc;
            if (!src) return;
            var img = new Image();
            img.decoding = 'async';
            try {
              img.fetchPriority = 'low';
            } catch (error) {
              /* fetchPriority unsupported — ignore */
            }
            img.src = src;
          });
        }

        function clearLightboxVideo() {
          lightboxVideo.hidden = true;
          lightboxVideo.style.display = 'none';
          lightboxVideo.innerHTML = '';
        }

        function showLightboxVideo(selectedThumbnail) {
          var videoSrc = selectedThumbnail.dataset.lightboxVideoSrc;
          if (!videoSrc) return;

          lightboxImg.style.display = 'none';
          lightboxImg.removeAttribute('src');
          lightboxImg.alt = '';
          lightboxVideo.hidden = false;
          lightboxVideo.style.display = 'block';

          if (selectedThumbnail.dataset.lightboxVideoKind === 'video') {
            var video = document.createElement('video');
            var source = document.createElement('source');
            video.controls = true;
            video.autoplay = true;
            video.playsInline = true;
            video.preload = 'metadata';
            source.src = videoSrc;
            video.appendChild(source);
            lightboxVideo.appendChild(video);
          } else {
            var iframe = document.createElement('iframe');
            iframe.src = videoSrc;
            iframe.title = selectedThumbnail.dataset.lightboxAlt || 'Product video';
            iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
            iframe.allowFullscreen = true;
            lightboxVideo.appendChild(iframe);
          }
        }

        function showLightboxImage(index) {
          if (!lightboxThumbnails.length) return;

          currentLightboxIndex = (index + lightboxThumbnails.length) % lightboxThumbnails.length;
          var requestIndex = currentLightboxIndex;
          var selectedThumbnail = lightboxThumbnails[currentLightboxIndex];
          var imageWidth = selectedThumbnail.dataset.lightboxWidth;
          var imageHeight = selectedThumbnail.dataset.lightboxHeight;
          var hiResSrc = selectedThumbnail.dataset.lightboxSrc;

          clearLightboxVideo();
          lightboxImg.style.display = 'block';

          if (selectedThumbnail.dataset.lightboxType === 'video') {
            showLightboxVideo(selectedThumbnail);
          } else {
          lightboxImg.alt = selectedThumbnail.dataset.lightboxAlt || '';
          if (imageWidth) lightboxImg.width = Number(imageWidth);
          if (imageHeight) lightboxImg.height = Number(imageHeight);

          // 1) Show instantly by reusing the gallery's already-decoded frame for
          //    this media (0 network). Fall back to the hi-res source directly if
          //    the gallery image for this media hasn't been loaded yet.
          var galleryImg = getGalleryImageByMediaId(selectedThumbnail.dataset.lightboxMediaId);
          var instantSrc =
            galleryImg && galleryImg.complete && galleryImg.naturalWidth > 0 ? galleryImg.currentSrc : '';
          var usedInstant = instantSrc && instantSrc !== hiResSrc;
          lightboxImg.src = usedInstant ? instantSrc : hiResSrc;

          // 2) Upgrade to the hi-res version in the background, then swap it in —
          //    but only if the user hasn't moved on and the lightbox is still open.
          if (usedInstant && hiResSrc) {
            var upgrade = new Image();
            upgrade.decoding = 'async';
            var swapToHiRes = function () {
              if (currentLightboxIndex === requestIndex && lightbox.dataset.open === 'true') {
                lightboxImg.src = hiResSrc;
              }
            };
            upgrade.onload = swapToHiRes;
            upgrade.src = hiResSrc;
            // Already cached (e.g. preloaded) → swap right away, no wait.
            if (upgrade.complete && upgrade.naturalWidth > 0) swapToHiRes();
          }
          }

          lightboxThumbnails.forEach(function (thumbnail, thumbnailIndex) {
            var isActive = thumbnailIndex === currentLightboxIndex;
            thumbnail.classList.toggle('is-active', isActive);
            thumbnail.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });

          var scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
          selectedThumbnail.scrollIntoView({ block: 'nearest', behavior: scrollBehavior });
        }

        function openLightbox() {
          var activeItem = getActiveMediaItem();
          if (!activeItem) return;
          if (closeTransitionHandler) {
            lightbox.removeEventListener('transitionend', closeTransitionHandler);
            closeTransitionHandler = null;
          }
          lightboxOpener = document.activeElement;
          var activeMediaId = getActiveMediaId();
          var activeIndex = lightboxThumbnails.findIndex(function (thumbnail) {
            return thumbnail.dataset.lightboxMediaId === activeMediaId;
          });
          showLightboxImage(activeIndex >= 0 ? activeIndex : 0);
          if (lightbox.parentNode !== document.body) {
            document.body.appendChild(lightbox);
          }
          lightbox.hidden = false;
          lightbox.dataset.open = 'true';
          document.body.classList.add('product-lightbox-is-open');
          // Lock scrolling AND hide the viewport scrollbar. The viewport scrollbar
          // is controlled by <html>, not <body>, so body overflow alone leaves the
          // window scrollbar visible (esp. on classic/Windows scrollbars).
          document.body.style.overflow = 'hidden';
          document.documentElement.style.overflow = 'hidden';
          window.requestAnimationFrame(function () {
            if (lightbox.dataset.open !== 'true') return;
            lightbox.classList.add('is-open');
            closeBtn.focus();
          });
          // Warm the hi-res cache for the remaining images without competing with
          // the image the user is currently looking at.
          if (window.requestIdleCallback) {
            window.requestIdleCallback(preloadLightboxHiRes, { timeout: 1500 });
          } else {
            setTimeout(preloadLightboxHiRes, 300);
          }
        }

        function closeLightbox() {
          if (lightbox.hidden || lightbox.dataset.open !== 'true') return;
          lightbox.dataset.open = 'false';
          lightbox.classList.remove('is-open');
          document.body.classList.remove('product-lightbox-is-open');
          document.body.style.overflow = '';
          document.documentElement.style.overflow = '';

          var finishClose = function (event) {
            if (event && event.target !== lightbox) return;
            lightbox.removeEventListener('transitionend', finishClose);
            closeTransitionHandler = null;
            if (lightbox.dataset.open === 'true') return;
            lightbox.hidden = true;
            lightboxImg.src = '';
            clearLightboxVideo();
            if (originalParent && lightbox.parentNode !== originalParent) {
              originalParent.insertBefore(lightbox, originalNextSibling);
            }
            if (lightboxOpener && typeof lightboxOpener.focus === 'function') {
              lightboxOpener.focus();
            }
          };

          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            finishClose();
            return;
          }

          closeTransitionHandler = finishClose;
          lightbox.addEventListener('transitionend', finishClose);
        }

        if (zoomBtn) {
          zoomBtn.addEventListener('click', openLightbox);
        }

        var mainContainer = gallery.querySelector('.product-gallery__main');
        if (mainContainer) {
          mainContainer.addEventListener('click', function (event) {
            // Ignore if clicked on the zoom button itself to prevent duplicate handling
            if (event.target.closest('[data-gallery-zoom]')) return;
            if (event.target.closest('video, iframe')) return;
            openLightbox();
          });
        }

        closeBtn.addEventListener('click', closeLightbox);
        lightboxThumbnails.forEach(function (thumbnail, index) {
          thumbnail.addEventListener('click', function () {
            showLightboxImage(index);
          });
        });
        if (previousBtn) {
          previousBtn.addEventListener('click', function () {
            showLightboxImage(currentLightboxIndex - 1);
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            showLightboxImage(currentLightboxIndex + 1);
          });
        }
        lightbox.addEventListener('click', function (event) {
          if (
            event.target === lightbox ||
            event.target.classList.contains('product-lightbox__content') ||
            event.target.classList.contains('product-lightbox__stage')
          ) {
            closeLightbox();
          }
        });
        document.addEventListener('keydown', function (event) {
          if (lightbox.hidden || lightbox.dataset.open !== 'true') return;
          if (event.key === 'Escape') closeLightbox();
          if (event.key === 'ArrowUp') {
            event.preventDefault();
            showLightboxImage(currentLightboxIndex - 1);
          }
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            showLightboxImage(currentLightboxIndex + 1);
          }
        });

        var thumbnails = gallery.querySelector('.product-gallery__thumbnails');
        if (thumbnails) {
          var isDown = false;
          var startX;
          var scrollLeft;
          var isDragging = false;

          thumbnails.addEventListener('mousedown', function (e) {
            isDown = true;
            isDragging = false;
            thumbnails.classList.add('is-active-drag');
            startX = e.pageX - thumbnails.offsetLeft;
            scrollLeft = thumbnails.scrollLeft;
          });
          thumbnails.addEventListener('mouseleave', function () {
            isDown = false;
            thumbnails.classList.remove('is-active-drag');
          });
          thumbnails.addEventListener('mouseup', function () {
            isDown = false;
            thumbnails.classList.remove('is-active-drag');
          });
          thumbnails.addEventListener('mousemove', function (e) {
            if (!isDown) return;
            e.preventDefault();
            var x = e.pageX - thumbnails.offsetLeft;
            var walk = (x - startX) * 2; // scroll speed multiplier
            if (Math.abs(walk) > 5) {
              isDragging = true;
            }
            thumbnails.scrollLeft = scrollLeft - walk;
          });
          thumbnails.addEventListener(
            'click',
            function (e) {
              if (isDragging) {
                e.stopPropagation();
                e.preventDefault();
              }
            },
            true
          );
        }
      });
    }

    function initGalleryZoom() {
      var zoomMediaQuery = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 921px)');

      document.querySelectorAll('[data-product-gallery]').forEach(function (gallery) {
        if (gallery.dataset.zoomInit === 'true') return;
        gallery.dataset.zoomInit = 'true';

        var mainContainer = gallery.querySelector('.product-gallery__main');
        var zoomPopup = gallery.querySelector('[data-zoom-popup]');
        if (!mainContainer || !zoomPopup) return;
        var lens = gallery.querySelector('[data-zoom-lens]');
        var zoomLoading = zoomPopup.querySelector('[data-zoom-loading]');
        var zoomPopupParent = zoomPopup.parentNode;
        var zoomPopupNextSibling = zoomPopup.nextSibling;
        var zoomRequestId = 0;

        // The popup zooms to 200% (background-size), so the lens covers half the
        // image in each dimension — the exact region shown in the popup.
        var ZOOM = 2;

        function getZoomTop() {
          var header = document.querySelector('.header');
          if (!header) return 24;

          var rect = header.getBoundingClientRect();
          return Math.max(24, Math.ceil(rect.bottom + 12));
        }

        function mountZoomPopup() {
          if (zoomPopup.parentNode !== document.body) {
            document.body.appendChild(zoomPopup);
          }

          zoomPopup.style.setProperty('--product-gallery-zoom-top', getZoomTop() + 'px');
        }

        function restoreZoomPopup() {
          if (zoomPopupParent && zoomPopup.parentNode !== zoomPopupParent) {
            zoomPopupParent.insertBefore(zoomPopup, zoomPopupNextSibling);
          }
        }

        function setZoomLoading(loading) {
          if (zoomLoading) zoomLoading.hidden = !loading;
        }

        function deactivateZoom() {
          zoomRequestId += 1;
          zoomPopup.classList.remove('is-active');
          zoomPopup.style.backgroundImage = 'none';
          setZoomLoading(false);
          restoreZoomPopup();
          if (lens) lens.classList.remove('is-active');
        }

        mainContainer.addEventListener('mouseenter', function () {
          if (!zoomMediaQuery.matches) return;

          var activeItem = gallery.querySelector('.product-gallery__main-item.is-active');
          if (!activeItem) return;
          var img = activeItem.querySelector('img.product-gallery__main-media');
          if (!img) return;

          var zoomSrc = img.getAttribute('data-zoom-src');
          if (zoomSrc) {
            var requestId = ++zoomRequestId;
            mountZoomPopup();
            zoomPopup.style.backgroundImage = 'none';
            zoomPopup.classList.add('is-active');
            setZoomLoading(true);
            if (lens) lens.classList.add('is-active');

            var zoomImage = new Image();
            zoomImage.addEventListener('load', function () {
              if (requestId !== zoomRequestId) return;
              zoomPopup.style.backgroundImage = 'url(' + zoomSrc + ')';
              setZoomLoading(false);
            });
            zoomImage.addEventListener('error', function () {
              if (requestId !== zoomRequestId) return;
              deactivateZoom();
            });
            zoomImage.src = zoomSrc;
          }
        });

        mainContainer.addEventListener('mousemove', function (e) {
          if (!zoomMediaQuery.matches) {
            deactivateZoom();
            return;
          }
          if (!zoomPopup.classList.contains('is-active')) return;

          var rect = mainContainer.getBoundingClientRect();
          var x = e.clientX - rect.left;
          var y = e.clientY - rect.top;

          var lensW = rect.width / ZOOM;
          var lensH = rect.height / ZOOM;

          // Center the lens on the cursor so it tracks the pointer 1:1, clamped
          // to stay inside the image.
          var lensLeft = Math.max(0, Math.min(rect.width - lensW, x - lensW / 2));
          var lensTop = Math.max(0, Math.min(rect.height - lensH, y - lensH / 2));

          if (lens) {
            lens.style.width = lensW + 'px';
            lens.style.height = lensH + 'px';
            lens.style.left = lensLeft + 'px';
            lens.style.top = lensTop + 'px';
          }

          // Keep the popup showing exactly the region under the lens.
          var rangeX = rect.width - lensW;
          var rangeY = rect.height - lensH;
          var posX = rangeX > 0 ? lensLeft / rangeX : 0;
          var posY = rangeY > 0 ? lensTop / rangeY : 0;
          zoomPopup.style.backgroundPosition = posX * 100 + '% ' + posY * 100 + '%';
          zoomPopup.style.backgroundSize = ZOOM * 100 + '%';
        });

        mainContainer.addEventListener('mouseleave', function () {
          deactivateZoom();
        });

        zoomMediaQuery.addEventListener('change', function (event) {
          if (!event.matches) deactivateZoom();
        });
      });
    }

    function readCookie(name) {
      var cookies = document.cookie ? document.cookie.split('; ') : [];

      for (var index = 0; index < cookies.length; index += 1) {
        var separatorIndex = cookies[index].indexOf('=');
        if (separatorIndex === -1) continue;
        if (cookies[index].slice(0, separatorIndex) !== name) continue;

        try {
          return decodeURIComponent(cookies[index].slice(separatorIndex + 1));
        } catch (error) {
          return '';
        }
      }

      return '';
    }

    function createWishlistCustomerId() {
      if (!window.crypto || !window.crypto.getRandomValues) return '';

      var bytes = new Uint8Array(15);
      var binary = '';
      window.crypto.getRandomValues(bytes);

      bytes.forEach(function (byte) {
        binary += String.fromCharCode(byte);
      });

      return window.btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    // Read the wishlist customer id WITHOUT creating one, so simply viewing a
    // product never sets a cookie. Returns '' when the shopper has no id yet.
    function resolveWishlistCustomerId() {
      var analytics = window.ShopifyAnalytics && window.ShopifyAnalytics.meta;
      var customerId = analytics && analytics.page && analytics.page.customerId;

      if (!customerId && window.meta && window.meta.page) {
        customerId = window.meta.page.customerId;
      }
      if (!customerId && window.__st) {
        customerId = window.__st.cid;
      }
      if (customerId) return String(customerId);

      return readCookie('__v__wl__c__') || '';
    }

    function getWishlistCustomerId() {
      var existingCustomerId = resolveWishlistCustomerId();
      if (existingCustomerId) return existingCustomerId;

      var generatedCustomerId = createWishlistCustomerId();
      if (!generatedCustomerId) return '';

      document.cookie =
        '__v__wl__c__=' + encodeURIComponent(generatedCustomerId) + '; path=/; max-age=31536000; samesite=strict';
      return generatedCustomerId;
    }

    // Locally mirror wishlist item ids by variant, so the heart shows the known
    // state on load and the API item can be removed on the next click.
    var WISHLIST_ADDED_STORAGE_PREFIX = 'wrydeco_wishlist_added_';

    function wishlistStorageKey(customerId) {
      return WISHLIST_ADDED_STORAGE_PREFIX + (customerId || 'anon');
    }

    function readAddedVariants(customerId) {
      try {
        var raw = window.localStorage.getItem(wishlistStorageKey(customerId));
        if (!raw) return {};
        var parsed = JSON.parse(raw);
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch (error) {
        return {};
      }
    }

    function isVariantAdded(variantId) {
      if (!variantId) return false;
      return Boolean(readAddedVariants(resolveWishlistCustomerId())[String(variantId)]);
    }

    function rememberAddedVariant(customerId, variantId, wishlistItemId) {
      if (!variantId) return;
      try {
        var map = readAddedVariants(customerId);
        map[String(variantId)] = wishlistItemId || true;
        window.localStorage.setItem(wishlistStorageKey(customerId), JSON.stringify(map));
      } catch (error) {
        // Non-fatal: the button still works without the local mirror.
      }
    }

    function forgetAddedVariant(customerId, variantId) {
      if (!variantId) return;
      try {
        var map = readAddedVariants(customerId);
        delete map[String(variantId)];

        if (Object.keys(map).length) {
          window.localStorage.setItem(wishlistStorageKey(customerId), JSON.stringify(map));
        } else {
          window.localStorage.removeItem(wishlistStorageKey(customerId));
        }
      } catch (error) {
        // Non-fatal: the remote wishlist is still authoritative.
      }
    }

    function getStoredWishlistItemId(customerId, variantId) {
      var storedValue = readAddedVariants(customerId)[String(variantId)];
      return storedValue === true ? '' : storedValue || '';
    }

    function getWishlistItemVariantId(item) {
      if (!item) return '';
      if (item.variantId) return item.variantId;
      return item.variant && item.variant.id ? item.variant.id : '';
    }

    function findWishlistItem(apiHost, shopId, customerId, variantId) {
      var query = '?sid=' + encodeURIComponent(String(shopId)) + '&cid=' + encodeURIComponent(String(customerId));

      return window
        .fetch(apiHost + '/bundle/api/v2/sf/ws' + query, {
          method: 'GET',
          headers: { Accept: 'application/json' },
          cache: 'no-store',
        })
        .then(function (response) {
          if (!response.ok) throw new Error('Wishlist lookup failed');
          return response.json();
        })
        .then(function (items) {
          if (!Array.isArray(items)) return null;

          return (
            items.find(function (item) {
              return String(getWishlistItemVariantId(item)) === String(variantId);
            }) || null
          );
        });
    }

    function removeWishlistItem(apiHost, shopId, customerId, wishlistItemId) {
      var path = [shopId, customerId, wishlistItemId]
        .map(function (value) {
          return encodeURIComponent(String(value));
        })
        .join('/');

      return window.fetch(apiHost + '/bundle/api/v2/sf/ws/' + path, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        cache: 'no-store',
      });
    }

    function applyWishlistButtonState(button, added) {
      var title = button.dataset.wishlistProductTitle || 'this piece';
      button.classList.toggle('is-added', added);
      button.setAttribute('aria-pressed', added ? 'true' : 'false');
      button.setAttribute('aria-label', added ? title + ' is in your wishlist' : 'Add ' + title + ' to wishlist');
    }

    function syncWishlistButtonForVariant(button) {
      applyWishlistButtonState(button, isVariantAdded(getWishlistVariantId(button)));
    }

    function syncWishlistIcon(button) {
      var iconTarget = button.querySelector('[data-product-wishlist-icon]');
      var sourceIcon = document.querySelector('#vitals-wishlist-header .Vtl-WishlistHeader__HeartIconWrapper');
      if (!iconTarget || !sourceIcon || iconTarget.firstElementChild) return false;

      var icon = sourceIcon.cloneNode(true);
      icon.removeAttribute('class');
      icon.removeAttribute('style');
      icon.setAttribute('aria-hidden', 'true');
      icon.style.setProperty('fill', 'currentColor', 'important');
      iconTarget.appendChild(icon);
      return true;
    }

    function getWishlistVariantId(button) {
      // The product form's hidden id is the live source of truth (it is what the
      // add-to-cart request submits), so trust it before the URL param, which can
      // lag behind the current selection.
      var selectedVariant = document.querySelector('form[action*="/cart/add"] [name="id"]');
      if (selectedVariant && selectedVariant.value) return selectedVariant.value;

      var urlVariantId = new URL(window.location.href).searchParams.get('variant');
      if (urlVariantId) return urlVariantId;

      return button.dataset.wishlistVariantId;
    }

    function updateWishlistHeaderCount(change) {
      var counter = document.querySelector('#vitals-wishlist-header .Vtl-WishlistHeader__HeartCounter');
      if (!counter) {
        if (change < 1) return;

        var iconWrapper = document.querySelector('#vitals-wishlist-header .Vtl-WishlistHeader__IconWrapper');
        if (!iconWrapper) return;

        counter = document.createElement('span');
        counter.className = 'Vtl-WishlistHeader__HeartCounter';
        iconWrapper.appendChild(counter);
      }

      var count = Number.parseInt(counter.textContent, 10);
      var nextCount = Math.max(0, (Number.isNaN(count) ? 0 : count) + change);

      if (nextCount === 0) {
        counter.remove();
        return;
      }

      counter.textContent = String(nextCount);
    }

    function showWishlistToast(message, type) {
      if (typeof window.showToast !== 'function') return;
      window.showToast({
        message: message,
        type: type,
        position: 'bottom-left',
        duration: 4000,
      });
    }

    function initProductWishlist() {
      document.querySelectorAll('[data-product-wishlist]').forEach(function (button) {
        if (button.dataset.wishlistInit === 'true') return;
        button.dataset.wishlistInit = 'true';

        if (!syncWishlistIcon(button)) {
          var observer = new MutationObserver(function () {
            if (syncWishlistIcon(button)) observer.disconnect();
          });
          observer.observe(document.body, { childList: true, subtree: true });
        }

        // Reflect the known state for the initial variant, and keep it in sync
        // when the shopper switches variants — wishlist membership is per-variant,
        // so a heart added for one variant must not stay lit for another.
        syncWishlistButtonForVariant(button);
        document.addEventListener('variant:change', function () {
          syncWishlistButtonForVariant(button);
        });

        button.addEventListener('click', function (event) {
          event.preventDefault();
          event.stopPropagation();
          if (button.disabled) return;

          var wishlistData = window.vtlsLiquidData || {};
          var appId = wishlistData.shopInfo && wishlistData.shopInfo.appId;
          var apiHost = appId && wishlistData.apiHosts && wishlistData.apiHosts[appId];
          var shopId = wishlistData.shopInfo && wishlistData.shopInfo.id;
          var variantId = getWishlistVariantId(button);
          var customerId = getWishlistCustomerId();
          var isRemoving = button.getAttribute('aria-pressed') === 'true';

          if (!apiHost || !shopId || !customerId || !variantId) {
            showWishlistToast('We could not update your wishlist. Please try again.', 'error');
            return;
          }

          var idleAriaLabel = button.getAttribute('aria-label');
          var loadingAriaLabel = isRemoving ? 'Removing from wishlist' : 'Adding to wishlist';
          button.disabled = true;
          button.setAttribute('aria-busy', 'true');
          button.setAttribute('aria-label', loadingAriaLabel);

          var request;

          if (isRemoving) {
            var storedWishlistItemId = getStoredWishlistItemId(customerId, variantId);
            var wishlistItemRequest = storedWishlistItemId
              ? Promise.resolve({ id: storedWishlistItemId })
              : findWishlistItem(apiHost, shopId, customerId, variantId);

            request = wishlistItemRequest.then(function (wishlistItem) {
              if (!wishlistItem || !wishlistItem.id) return null;

              return removeWishlistItem(apiHost, shopId, customerId, wishlistItem.id).then(function (response) {
                if (!response.ok && response.status !== 404) {
                  throw new Error('Wishlist remove failed');
                }
                return response;
              });
            });
          } else {
            request = window.fetch(apiHost + '/bundle/api/v2/sf/ws', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                shop_id: shopId,
                customerId: customerId,
                productId: Number(button.dataset.wishlistProductId),
                variantId: Number(variantId),
              }),
            });
          }

          request
            .then(function (response) {
              if (isRemoving) {
                forgetAddedVariant(customerId, variantId);
                applyWishlistButtonState(button, false);
                updateWishlistHeaderCount(-1);
                showWishlistToast('Removed from your wishlist.', 'success');
                return;
              }

              if (response.status === 409) {
                rememberAddedVariant(customerId, variantId);
                applyWishlistButtonState(button, true);
                showWishlistToast('This piece is already in your wishlist.', 'info');
                return;
              }
              if (!response.ok) throw new Error('Wishlist request failed');

              return response
                .json()
                .catch(function () {
                  return null;
                })
                .then(function (wishlistItem) {
                  rememberAddedVariant(customerId, variantId, wishlistItem && wishlistItem.id);
                  applyWishlistButtonState(button, true);
                  updateWishlistHeaderCount(1);
                  showWishlistToast('Added to your wishlist.', 'success');
                });
            })
            .catch(function () {
              showWishlistToast(
                isRemoving
                  ? 'We could not remove this piece from your wishlist. Please try again.'
                  : 'We could not add this piece to your wishlist. Please try again.',
                'error'
              );
            })
            .finally(function () {
              button.disabled = false;
              button.removeAttribute('aria-busy');
              if (button.getAttribute('aria-label') === loadingAriaLabel) {
                button.setAttribute('aria-label', idleAriaLabel);
              }
            });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initGalleryStageLoading();
        initGalleryLightbox();
        initGalleryZoom();
        initProductWishlist();
      });
    } else {
      initGalleryStageLoading();
      initGalleryLightbox();
      initGalleryZoom();
      initProductWishlist();
    }
  })();
</script>
