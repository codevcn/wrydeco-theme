{% doc %}
  Renders the product-information accordions at the end of the PDP purchase column.

  Product details remain server-rendered, while the native details elements provide
  progressively enhanced disclosure controls without a JavaScript dependency.

  @param {product} product - The current product
  @param {section} section - The parent main-product section

  @example
  {% render 'product-info-accordions', product: product, section: section %}
{% enddoc %}

<section class="product-info-accordions" aria-label="Product information">
  <details class="product-info-accordion">
    <summary class="product-info-accordion__summary">
      <span class="product-info-accordion__icon" aria-hidden="true">
        <svg class="product-info-accordion__icon-svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M2 6h4m-4 4h4m-4 4h4m-4 4h4"/><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M9.5 8h5m-5 4H16m-6.5 4H14"/></g></svg>
      </span>
      <span class="product-info-accordion__label">Product Details</span>
      <svg class="product-info-accordion__chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9l6 6l6-6"/></svg>
    </summary>
    <div class="product-info-accordion__content rte">
      {{ product.description }}
    </div>
  </details>

  <details class="product-info-accordion">
    <summary class="product-info-accordion__summary">
      <span class="product-info-accordion__icon" aria-hidden="true">
        <svg class="product-info-accordion__icon-svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 1-1 1h2m10 0H9m10 0h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></g></svg>
      </span>
      <span class="product-info-accordion__label">Shipping &amp; Return</span>
      <svg class="product-info-accordion__chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9l6 6l6-6"/></svg>
    </summary>
    <div class="product-info-accordion__content product-info-accordion__content--shipping">
      {{ section.settings.accordion_shipping_return_content }}
    </div>
  </details>

  <details class="product-info-accordion">
    <summary class="product-info-accordion__summary">
      <span class="product-info-accordion__icon" aria-hidden="true">
        <svg class="product-info-accordion__icon-svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.622 17.897l-10.68-2.913M18.376 2.622a1 1 0 1 1 3.002 3.002L17.36 9.643a.5.5 0 0 0 0 .707l.944.944a2.41 2.41 0 0 1 0 3.408l-.944.944a.5.5 0 0 1-.707 0L8.354 7.348a.5.5 0 0 1 0-.707l.944-.944a2.41 2.41 0 0 1 3.408 0l.944.944a.5.5 0 0 0 .707 0zM9 8c-1.804 2.71-3.97 3.46-6.583 3.948a.507.507 0 0 0-.302.819l7.32 8.883a1 1 0 0 0 1.185.204C12.735 20.405 16 16.792 16 15"/></svg>
      </span>
      <span class="product-info-accordion__label">Customization</span>
      <svg class="product-info-accordion__chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9l6 6l6-6"/></svg>
    </summary>
    <div class="product-info-accordion__content">
      <ol class="product-info-accordion__steps">
        <li class="product-info-accordion__trust-card"><span class="product-info-accordion__trust-mark" aria-hidden="true">1</span><div><strong>{{ section.settings.accordion_customization_step_one_title | escape }}</strong><p>{{ section.settings.accordion_customization_step_one_text | escape }}</p></div></li>
        <li class="product-info-accordion__trust-card"><span class="product-info-accordion__trust-mark" aria-hidden="true">2</span><div><strong>{{ section.settings.accordion_customization_step_two_title | escape }}</strong><p>{{ section.settings.accordion_customization_step_two_text | escape }}</p></div></li>
        <li class="product-info-accordion__trust-card"><span class="product-info-accordion__trust-mark" aria-hidden="true">3</span><div><strong>{{ section.settings.accordion_customization_step_three_title | escape }}</strong><p>{{ section.settings.accordion_customization_step_three_text | escape }}</p></div></li>
      </ol>
    </div>
  </details>

  <details class="product-info-accordion">
    <summary class="product-info-accordion__summary">
      <span class="product-info-accordion__icon" aria-hidden="true">
        <svg class="product-info-accordion__icon-svg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M11 12a1 1 0 1 0 2 0a1 1 0 1 0-2 0"/><path d="M12 7a5 5 0 1 0 5 5"/><path d="M13 3.055A9 9 0 1 0 20.941 11"/><path d="M15 6v3h3l3-3h-3V3zm0 3l-3 3"/></g></svg>
      </span>
      <span class="product-info-accordion__label">Why this piece works well</span>
      <svg class="product-info-accordion__chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9l6 6l6-6"/></svg>
    </summary>
    <div class="product-info-accordion__content">
      <ul class="product-info-accordion__trust-list" role="list">
        <li class="product-info-accordion__trust-card"><span class="product-info-accordion__trust-mark" aria-hidden="true">1</span><div><strong>{{ section.settings.trust_delivery_title | escape }}</strong><p>{{ section.settings.trust_delivery_text | escape }}</p></div></li>
        <li class="product-info-accordion__trust-card"><span class="product-info-accordion__trust-mark" aria-hidden="true">2</span><div><strong>{{ section.settings.trust_grain_title | escape }}</strong><p>{{ section.settings.trust_grain_text | escape }}</p></div></li>
        <li class="product-info-accordion__trust-card"><span class="product-info-accordion__trust-mark" aria-hidden="true">3</span><div><strong>{{ section.settings.trust_craft_title | escape }}</strong><p>{{ section.settings.trust_craft_text | escape }}</p></div></li>
      </ul>
    </div>
  </details>
</section>

{% stylesheet %}
  .product-info-accordions {
    width: 100%;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-default);
  }

  .product-info-accordion + .product-info-accordion {
    border-top: 1px solid var(--border-default);
  }

  .product-info-accordion__summary {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 24px;
    align-items: center;
    gap: var(--sp-4);
    min-height: 32px;
    padding: var(--sp-3) var(--sp-4);
    cursor: pointer;
    list-style: none;
    /* background-color: color-mix(in srgb, var(--color-clay) 7%, transparent); */
  }

  .product-info-accordion__summary::-webkit-details-marker { display: none; }

  .product-info-accordion__summary:focus-visible {
    outline: 2px solid var(--color-earth-brown);
    outline-offset: -2px;
  }

  .product-info-accordion__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-milk);
    color: var(--color-bark);
  }

  .product-info-accordion__icon-svg { width: 20px; height: 20px; }

  .product-info-accordion__label {
    font-family: var(--font-roboto);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-tight);
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .product-info-accordion__chevron {
    width: 24px;
    height: 24px;
    color: var(--color-ebony);
    transition: transform var(--timing-short) var(--ease-standard);
  }

  .product-info-accordion[open] .product-info-accordion__chevron { transform: rotate(180deg); }

  .product-info-accordion__content {
    padding: var(--sp-2) var(--sp-5) var(--sp-5);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-generous);
  }

  .product-info-accordion__content > :first-child { margin-top: 0; }
  .product-info-accordion__content > :last-child { margin-bottom: 0; }

  .product-info-accordion__content--shipping p { margin: 0 0 var(--sp-4); }
  .product-info-accordion__content--shipping em { display: block; }

  .product-info-accordion__steps,
  .product-info-accordion__trust-list {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-info-accordion__trust-card {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: var(--sp-3);
    align-items: start;
    padding: var(--sp-4);
    border: 1px solid color-mix(in srgb, var(--color-earth-brown) 15%, transparent);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-milk) 78%, transparent), transparent);
  }

  .product-info-accordion__trust-mark {
    display: grid;
    place-items: center;
    min-height: 32px;
    color: var(--color-earth-brown);
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    line-height: 1;
  }

  .product-info-accordion__trust-mark {
    width: 32px;
    border: 1px solid color-mix(in srgb, var(--color-earth-brown) 35%, transparent);
    border-radius: 50%;
    background: var(--surface-default);
  }

  .product-info-accordion__steps strong,
  .product-info-accordion__trust-list strong {
    display: block;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-regular);
  }

  .product-info-accordion__steps p,
  .product-info-accordion__trust-list p { margin: var(--sp-1) 0 0; }

  .product-info-accordion__steps .product-info-accordion__trust-card:nth-child(2),
  .product-info-accordion__trust-list .product-info-accordion__trust-card:nth-child(2) { background: color-mix(in srgb, var(--color-milk) 55%, transparent); }

  .product-info-accordion__steps .product-info-accordion__trust-card:nth-child(3),
  .product-info-accordion__trust-list .product-info-accordion__trust-card:nth-child(3) { background: linear-gradient(135deg, transparent, color-mix(in srgb, var(--color-milk) 78%, transparent)); }

  @media screen and (max-width: 768px) {
    .product-info-accordion__summary {
      grid-template-columns: 40px minmax(0, 1fr) 20px;
      min-height: 72px;
      gap: var(--sp-3);
      padding: var(--sp-3);
    }

    .product-info-accordion__icon { width: 40px; height: 40px; }
    .product-info-accordion__icon-svg { width: 21px; height: 21px; }
    .product-info-accordion__label { font-size: var(--font-size-body-md); }
    .product-info-accordion__chevron { width: 20px; height: 20px; }
    .product-info-accordion__content { padding: 0 var(--sp-4) var(--sp-4); }
    .product-info-accordion__trust-card { padding: var(--sp-3); }
  }
{% endstylesheet %}
