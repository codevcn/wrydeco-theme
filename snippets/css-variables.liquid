{% doc %}
  Registers the two storefront web fonts and global theme CSS variables.

  @example
  {% render 'css-variables' %}
{% enddoc %}
{% style %}
  @font-face {
    font-family: 'Fraunces Light';
    src: url('{{ "Fraunces_72pt-Light.ttf" | file_url }}') format('truetype');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Roboto';
    src: url('{{ "Roboto-VariableFont.ttf" | file_url }}') format('truetype');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-primary--family: var(--font-roboto, 'Roboto', sans-serif);
    --font-primary--style: normal;
    --font-primary--weight: 400;
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-pure-red: #ff000d;
    --color-shipping-green: #185c3d;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
