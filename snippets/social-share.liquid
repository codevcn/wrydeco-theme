{% doc %}
  Renders a compact social sharing module.

  @param {string} title - Share title
  @param {string} url - Absolute URL to share
  @param {image} [image] - Optional image used by Pinterest

  @example
  {% render 'social-share', title: article.title, url: canonical_url, image: article.image %}
{% enddoc %}

{%- liquid
  assign share_title = title | default: page_title | default: shop.name
  assign share_url = url | default: canonical_url
  assign share_media = ''

  if image != blank
    assign share_media = image | image_url: width: 1200 | prepend: 'https:'
  endif

  assign encoded_title = share_title | url_encode
  assign encoded_url = share_url | url_encode
  assign encoded_media = share_media | url_encode
-%}

<nav class="social-share" aria-label="Share this article">
  <span class="social-share__label">Share</span>
  <ul class="social-share__list" role="list">
    <li>
      <a
        class="social-share__link"
        href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on Facebook"
      >
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978c.401 0 .955.042 1.468.103a9 9 0 0 1 1.141.195v3.325a9 9 0 0 0-.653-.036a27 27 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.7 1.7 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103l-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647"/></svg>
        <span>Facebook</span>
      </a>
    </li>
    <li>
      <a
        class="social-share__link"
        href="https://twitter.com/intent/tweet?url={{ encoded_url }}&text={{ encoded_title }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on X"
      >
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M14.234 10.162L22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299l-.929-1.329L3.076 1.56h3.182l5.965 8.532l.929 1.329l7.754 11.09h-3.182z"/></svg>
        <span>X</span>
      </a>
    </li>
    <li>
      <a
        class="social-share__link"
        href="https://pinterest.com/pin/create/button/?url={{ encoded_url }}&description={{ encoded_title }}{% if share_media != blank %}&media={{ encoded_media }}{% endif %}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on Pinterest"
      >
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162c-.105-.949-.199-2.403.041-3.439c.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911c1.024 0 1.518.769 1.518 1.688c0 1.029-.653 2.567-.992 3.992c-.285 1.193.6 2.165 1.775 2.165c2.128 0 3.768-2.245 3.768-5.487c0-2.861-2.063-4.869-5.008-4.869c-3.41 0-5.409 2.562-5.409 5.199c0 1.033.394 2.143.889 2.741c.099.12.112.225.085.345c-.09.375-.293 1.199-.334 1.363c-.053.225-.172.271-.401.165c-1.495-.69-2.433-2.878-2.433-4.646c0-3.776 2.748-7.252 7.92-7.252c4.158 0 7.392 2.967 7.392 6.923c0 4.135-2.607 7.462-6.233 7.462c-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146c1.123.345 2.306.535 3.55.535c6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026z"/></svg>
        <span>Pinterest</span>
      </a>
    </li>
    <li>
      <a
        class="social-share__link"
        href="mailto:?subject={{ encoded_title }}&body={{ encoded_url }}"
        aria-label="Share by email"
      >
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m22 7l-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect width="20" height="16" x="2" y="4" rx="2"/></g></svg>
        <span>Email</span>
      </a>
    </li>
  </ul>
</nav>

{% stylesheet %}
  .social-share {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
    padding-bottom: var(--sp-8);
    color: var(--color-earth-brown);
  }

  .social-share__label {
    color: var(--color-clay);
    font-family: var(--font-roboto);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-bold);
    letter-spacing: calc(var(--letter-spacing-wide) * 4);
    line-height: var(--line-height-snug);
    text-transform: uppercase;
  }

  .social-share__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-share__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: var(--sp-7);
    padding: 0 var(--sp-4);
    border: var(--border-width) solid color-mix(in srgb, var(--color-earth-brown) 18%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-milk) 72%, transparent);
    color: var(--color-earth-brown);
    font-family: var(--font-roboto);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
    text-decoration: none;
    transition:
      background-color var(--timing-short) var(--ease-standard),
      border-color var(--timing-short) var(--ease-standard),
      color var(--timing-short) var(--ease-standard),
      transform var(--timing-short) var(--ease-standard);
  }

  .social-share__link:hover {
    border-color: var(--color-earth-brown);
    background: var(--color-earth-brown);
    color: var(--color-milk);
    transform: translateY(calc(var(--border-width) * -2));
  }

  .social-share__link svg {
    width: var(--sp-4);
    height: var(--sp-4);
    flex: none;
  }

  @media screen and (max-width: 767px) {
    .social-share {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--sp-3);
      margin-top: var(--sp-6);
    }

    .social-share__list {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(var(--sp-0), 1fr));
    }

    .social-share__link {
      width: 100%;
      padding-inline: var(--sp-3);
    }
  }
{% endstylesheet %}
