{% doc %}
  Renders a lightweight country / currency trigger.

  The full country list is intentionally not rendered with the page. The first
  trigger click fetches the shared localization panel through Shopify's section
  rendering endpoint, then all header, drawer, and footer triggers reuse it.

  @param {string} [variant] - Visual variant: 'header', 'footer' or 'drawer'. Defaults to 'header'.
  @param {string} [id] - Unique id suffix, required when rendering more than once on the same page.

  @example
  {% render 'localization-selector', variant: 'header', id: 'header' %}
{% enddoc %}

{%- liquid
  assign variant = variant | default: 'header'
  assign uid = id | default: variant
  assign current_country = localization.country
-%}

{%- if localization.available_countries.size > 1 -%}
  <button
    type="button"
    class="loc-picker loc-picker--{{ variant }} loc-picker__trigger no-select"
    aria-label="{{ 'general.localization.country_label' | t }}: {{ current_country.name | escape }}"
    aria-haspopup="dialog"
    aria-expanded="false"
    data-loc-trigger
    data-loc-trigger-id="{{ uid | escape }}"
  >
    <span class="loc-picker__flag loc-picker__flag--trigger">
      <img
        src="https://flagcdn.com/{{ current_country.iso_code | downcase }}.svg"
        width="24"
        height="18"
        loading="lazy"
        alt="{{ current_country.name | escape }} flag"
      >
    </span>
    <span class="loc-picker__code">{{ current_country.currency.iso_code }}</span>
    <svg class="loc-picker__chevron" aria-hidden="true" focusable="false" viewBox="0 0 10 6">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
    </svg>
  </button>
{%- else -%}
  <div class="loc-picker loc-picker--{{ variant }} loc-picker--static">
    <span
      class="loc-picker__trigger no-select"
      aria-label="{{ 'general.localization.country_label' | t }}: {{ current_country.name | escape }}"
    >
      <span class="loc-picker__flag loc-picker__flag--trigger">
        <img
          src="https://flagcdn.com/{{ current_country.iso_code | downcase }}.svg"
          width="24"
          height="18"
          loading="lazy"
          alt="{{ current_country.name | escape }} flag"
        >
      </span>
      <span class="loc-picker__code">{{ current_country.currency.iso_code }}</span>
    </span>
  </div>
{%- endif -%}

{% stylesheet %}
  .loc-picker {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .loc-picker__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-milk);
    cursor: pointer;
    font: inherit;
    list-style: none;
    transition: border-color var(--timing-short) var(--ease-standard),
      background-color var(--timing-short) var(--ease-standard);
  }

  .loc-picker--static .loc-picker__trigger {
    cursor: default;
  }

  .loc-picker__trigger:hover {
    border-color: color-mix(in srgb, var(--color-earth-brown) 40%, transparent);
  }

  .loc-picker__trigger:focus-visible {
    outline: 2px solid var(--color-sage);
    outline-offset: 2px;
  }

  .loc-picker__flag--trigger img {
    display: block;
    width: 24px;
    height: 18px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 var(--border-width) var(--color-border);
  }

  .loc-picker__chevron {
    width: 10px;
    height: auto;
    color: currentColor;
    opacity: 0.75;
    transition: transform var(--timing-short) var(--ease-standard);
  }

  .loc-picker__trigger[aria-expanded='true'] .loc-picker__chevron {
    transform: rotate(180deg);
  }

  .loc-picker__code {
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-medium);
    font-family: var(--font-roboto);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-milk);
  }

  .loc-picker__code.loc-picker__code-footer {
    color: var(--color-earth-brown);
  }

  .loc-picker--footer.loc-picker__trigger {
    background: transparent;
    border-color: #f5f1ed58;
    color: var(--footer-ink, var(--color-cream));
  }

  .loc-picker--footer.loc-picker__trigger:hover {
    border-color: #ffe4c97a;
  }

  .loc-picker--drawer {
    justify-content: space-between;
    width: fit-content;
  }

  @media (prefers-reduced-motion: reduce) {
    .loc-picker__chevron {
      transition: none;
    }
  }

  @media screen and (max-width: 48rem) {
    .loc-picker__trigger {
      color: var(--color-earth-brown);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (window.WrydecoLocalizationPicker) return;

    var state = {
      wrapper: null,
      panel: null,
      activeTrigger: null,
      loadingPromise: null,
      initialized: false,
      searchTimer: null,
      items: [],
      filteredItems: [],
      scrollContainer: null,
      listContainer: null,
      spacer: null,
      empty: null,
      itemHeight: 52, // initial guess
      startIndex: -1,
      endIndex: -1,
      buffer: 10
    };

    function getPanelUrl() {
      var url = new URL(window.location.href);
      url.search = '';
      url.searchParams.set('section_id', 'localization-lazy');
      return url.toString();
    }

    function setTriggersExpanded(expanded) {
      document.querySelectorAll('[data-loc-trigger]').forEach(function (trigger) {
        trigger.setAttribute('aria-expanded', expanded && trigger === state.activeTrigger ? 'true' : 'false');
      });
    }

    function buildItemHTML(item, top) {
      var searchHay = (item.name + ' ' + item.currency_iso + ' ' + item.currency_symbol).toLowerCase();
      var isSelectedClass = item.is_selected ? ' is-selected' : '';
      var ariaCurrent = item.is_selected ? ' aria-current="true"' : '';
      var flagCode = item.iso_code.toLowerCase();
      
      var flagAlt = item.name.replace(/&/g, '&amp;').replace(/"/g, '&quot;') + ' flag';

      return '<li class="loc-picker__item" style="position: absolute; top: ' + top + 'px; left: 0; right: 0;" data-search="' + searchHay + '">' +
        '<button type="submit" name="country_code" value="' + item.iso_code + '" class="loc-picker__option' + isSelectedClass + '"' + ariaCurrent + '>' +
          '<span class="loc-picker__flag"><img src="https://flagcdn.com/' + flagCode + '.svg" width="40" height="28" loading="lazy" alt="' + flagAlt + '"></span>' +
          '<span class="loc-picker__code">' + item.currency_iso + '</span>' +
          '<span class="loc-picker__symbol">' + item.currency_symbol + '</span>' +
          '<span class="loc-picker__divider" aria-hidden="true"></span>' +
          '<span class="loc-picker__name">' + item.name + '</span>' +
          '<span class="loc-picker__check" aria-hidden="true">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">' +
              '<polyline points="20 6 9 17 4 12"></polyline>' +
            '</svg>' +
          '</span>' +
        '</button>' +
      '</li>';
    }

    function renderVirtualList(force) {
      if (!state.scrollContainer || !state.listContainer) return;
      var scrollTop = state.scrollContainer.scrollTop;
      var containerHeight = state.scrollContainer.clientHeight || 440;
      var totalHeight = state.filteredItems.length * state.itemHeight;
      if (state.spacer) state.spacer.style.height = totalHeight + 'px';

      var newStartIndex = Math.floor(scrollTop / state.itemHeight) - state.buffer;
      var newEndIndex = Math.ceil((scrollTop + containerHeight) / state.itemHeight) + state.buffer;

      newStartIndex = Math.max(0, newStartIndex);
      newEndIndex = Math.min(state.filteredItems.length - 1, newEndIndex);

      if (!force && newStartIndex === state.startIndex && newEndIndex === state.endIndex) {
        return;
      }

      state.startIndex = newStartIndex;
      state.endIndex = newEndIndex;

      var html = '';
      for (var i = state.startIndex; i <= state.endIndex; i++) {
        html += buildItemHTML(state.filteredItems[i], i * state.itemHeight);
      }
      state.listContainer.innerHTML = html;
    }

    function filterItems(query) {
      var q = (query || '').trim().toLowerCase();
      state.filteredItems = state.items.filter(function(item) {
        var hay = (item.name + ' ' + item.currency_iso + ' ' + item.currency_symbol).toLowerCase();
        return !q || hay.indexOf(q) !== -1;
      });

      if (state.empty) {
        state.empty.hidden = state.filteredItems.length > 0;
      }
      
      state.startIndex = -1; // force re-render
      if (state.scrollContainer) state.scrollContainer.scrollTop = 0;
      renderVirtualList(true);
    }

    function closePanel(restoreFocus) {
      if (!state.wrapper) return;
      state.wrapper.remove(); // Unmount from DOM completely
      if (state.panel) state.panel.hidden = false;
      setTriggersExpanded(false);

      if (restoreFocus && state.activeTrigger) state.activeTrigger.focus();
      state.activeTrigger = null;
    }

    function initPanel() {
      if (!state.panel || state.initialized) return;
      state.initialized = true;

      var closeButtons = state.panel.querySelectorAll('[data-loc-close]');
      var search = state.panel.querySelector('[data-loc-search]');

      var dataScript = state.panel.querySelector('[data-loc-data]');
      if (dataScript) {
        try {
          state.items = JSON.parse(dataScript.textContent);
        } catch(e) {
          state.items = [];
        }
      }
      state.scrollContainer = state.panel.querySelector('[data-loc-scroll-container]');
      state.listContainer = state.panel.querySelector('[data-loc-list]');
      state.spacer = state.panel.querySelector('[data-loc-spacer]');
      state.empty = state.panel.querySelector('[data-loc-empty]');

      if (state.scrollContainer) {
        state.scrollContainer.addEventListener('scroll', function() {
          renderVirtualList();
        });
      }

      closeButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          closePanel(true);
        });
      });

      if (search) {
        search.addEventListener('input', function () {
          window.clearTimeout(state.searchTimer);
          state.searchTimer = window.setTimeout(function () {
            filterItems(search.value);
          }, 200);
        });

        search.addEventListener('keydown', function (event) {
          if (event.key === 'Enter') event.preventDefault();
        });
      }

      state.panel.addEventListener('click', function (event) {
        if (event.target.hasAttribute('data-loc-overlay')) closePanel(true);
      });

      document.addEventListener('keydown', function (event) {
        if (!state.wrapper || !state.wrapper.parentNode) return;
        if (event.key === 'Escape') closePanel(true);
      });
    }

    function loadPanel() {
      if (state.panel) return Promise.resolve(state.panel);
      if (state.loadingPromise) return state.loadingPromise;

      state.loadingPromise = fetch(getPanelUrl(), { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('Localization panel failed to load.');
          return response.text();
        })
        .then(function (html) {
          state.wrapper = document.createElement('div');
          state.wrapper.setAttribute('data-loc-panel-root', '');
          state.wrapper.innerHTML = html;
          state.panel = state.wrapper.querySelector('[data-loc-panel]');
          if (!state.panel) throw new Error('Localization panel markup was not found.');
          document.body.appendChild(state.wrapper);
          initPanel();
          return state.panel;
        })
        .catch(function (error) {
          state.loadingPromise = null;
          throw error;
        });

      return state.loadingPromise;
    }

    function openPanel(trigger) {
      state.activeTrigger = trigger;
      setTriggersExpanded(true);

      if (state.wrapper) {
        document.body.appendChild(state.wrapper); // Mount back to DOM
        state.panel.hidden = false;
        
        if (state.items.length > 0 && state.listContainer && state.itemHeight === 52) {
           state.listContainer.innerHTML = buildItemHTML(state.items[0], 0);
           var firstChild = state.listContainer.children[0];
           state.itemHeight = (firstChild && firstChild.offsetHeight) ? firstChild.offsetHeight : 52;
           state.listContainer.innerHTML = '';
        }

        filterItems('');
        var search = state.panel.querySelector('[data-loc-search]');
        if (search) {
          search.value = '';
          window.requestAnimationFrame(function () {
            search.focus({ preventScroll: true });
          });
        }
        return;
      }

      // Show skeleton loader immediately
      var skeleton = document.createElement('div');
      skeleton.setAttribute('data-loc-panel-root', 'skeleton');
      skeleton.innerHTML = '<div style="position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding: 16px; background: rgba(0,0,0,0.44);"><div style="position:relative; width: min(420px, 100vw - 24px); height: 200px; background: var(--color-milk, #fff); border-radius: 32px; display:flex; align-items:center; justify-content:center; box-shadow: 0 4px 20px rgba(0,0,0,0.1);"><svg style="animation: loc-spin 1s linear infinite; width: 32px; height: 32px; color: var(--color-earth-brown, #6D5E50);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle><path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="0.8"></path></svg><style>@keyframes loc-spin { 100% { transform: rotate(360deg); } }</style></div></div>';
      document.body.appendChild(skeleton);

      // Wait 2 frames before calling API to ensure UI is not blocked
      window.requestAnimationFrame(function () {
        window.requestAnimationFrame(function () {
          loadPanel()
            .then(function (panel) {
              skeleton.remove();
              panel.hidden = false;
              
              if (state.items.length > 0 && state.listContainer && state.itemHeight === 52) {
                 state.listContainer.innerHTML = buildItemHTML(state.items[0], 0);
                 var firstChild = state.listContainer.children[0];
                 state.itemHeight = (firstChild && firstChild.offsetHeight) ? firstChild.offsetHeight : 52;
                 state.listContainer.innerHTML = '';
              }

              filterItems('');
              var search = panel.querySelector('[data-loc-search]');
              if (search) {
                search.value = '';
                window.requestAnimationFrame(function () {
                  search.focus({ preventScroll: true });
                });
              }
            })
            .catch(function () {
              skeleton.remove();
              closePanel(false);
            });
        });
      });
    }

    function handleTriggerClick(event) {
      var trigger = event.target.closest('[data-loc-trigger]');
      if (!trigger) return;

      event.preventDefault();
      if (state.wrapper && state.wrapper.parentNode && state.activeTrigger === trigger) {
        closePanel(true);
        return;
      }

      openPanel(trigger);
    }

    document.addEventListener('click', handleTriggerClick);

    window.WrydecoLocalizationPicker = {
      open: openPanel,
      close: closePanel,
      load: loadPanel
    };
  })();
{% endjavascript %}
