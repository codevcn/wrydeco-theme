{% doc %}
  Renders a lightweight country / currency trigger.

  The full country list is intentionally not rendered with the page. The first
  trigger click fetches the shared localization panel through Shopify's section
  rendering endpoint, then all header, drawer, and footer triggers reuse it.

  @param {string} [variant] - Visual variant: 'header', 'footer' or 'drawer'. Defaults to 'header'.
  @param {string} [id] - Unique id suffix, required when rendering more than once on the same page.

  @example
  {% render 'localization-selector', variant: 'header', id: 'header' %}
{% enddoc %}

{%- liquid
  assign variant = variant | default: 'header'
  assign uid = id | default: variant
  assign current_country = localization.country
-%}

{%- if localization.available_countries.size > 1 -%}
  <button
    type="button"
    class="loc-picker loc-picker--{{ variant }} loc-picker__trigger no-select"
    aria-label="{{ 'general.localization.country_label' | t }}: {{ current_country.name | escape }}"
    aria-haspopup="dialog"
    aria-expanded="false"
    data-loc-trigger
    data-loc-trigger-id="{{ uid | escape }}"
  >
    <span class="loc-picker__flag loc-picker__flag--trigger">
      <img
        src="https://flagcdn.com/{{ current_country.iso_code | downcase }}.svg"
        width="24"
        height="18"
        loading="lazy"
        alt=""
      >
    </span>
    <span class="loc-picker__code">{{ current_country.currency.iso_code }}</span>
    <svg class="loc-picker__chevron" aria-hidden="true" focusable="false" viewBox="0 0 10 6">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
    </svg>
  </button>
{%- else -%}
  <div class="loc-picker loc-picker--{{ variant }} loc-picker--static">
    <span
      class="loc-picker__trigger no-select"
      aria-label="{{ 'general.localization.country_label' | t }}: {{ current_country.name | escape }}"
    >
      <span class="loc-picker__flag loc-picker__flag--trigger">
        <img
          src="https://flagcdn.com/{{ current_country.iso_code | downcase }}.svg"
          width="24"
          height="18"
          loading="lazy"
          alt=""
        >
      </span>
      <span class="loc-picker__code">{{ current_country.currency.iso_code }}</span>
    </span>
  </div>
{%- endif -%}

{% stylesheet %}
  .loc-picker {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .loc-picker__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-milk);
    cursor: pointer;
    font: inherit;
    list-style: none;
    transition: border-color var(--timing-short) var(--ease-standard),
      background-color var(--timing-short) var(--ease-standard);
  }

  .loc-picker--static .loc-picker__trigger {
    cursor: default;
  }

  .loc-picker__trigger:hover {
    border-color: color-mix(in srgb, var(--color-earth-brown) 40%, transparent);
  }

  .loc-picker__trigger:focus-visible {
    outline: 2px solid var(--color-sage);
    outline-offset: 2px;
  }

  .loc-picker__flag--trigger img {
    display: block;
    width: 24px;
    height: 18px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 var(--border-width) var(--color-border);
  }

  .loc-picker__chevron {
    width: 10px;
    height: auto;
    color: currentColor;
    opacity: 0.75;
    transition: transform var(--timing-short) var(--ease-standard);
  }

  .loc-picker__trigger[aria-expanded='true'] .loc-picker__chevron {
    transform: rotate(180deg);
  }

  .loc-picker__code {
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-medium);
    font-family: var(--font-roboto);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-milk);
  }

  .loc-picker__code.loc-picker__code-footer {
    color: var(--color-earth-brown);
  }

  .loc-picker--footer.loc-picker__trigger {
    background: transparent;
    border-color: #f5f1ed58;
    color: var(--footer-ink, var(--color-cream));
  }

  .loc-picker--footer.loc-picker__trigger:hover {
    border-color: #ffe4c97a;
  }

  .loc-picker--drawer {
    justify-content: space-between;
    width: fit-content;
  }

  @media (prefers-reduced-motion: reduce) {
    .loc-picker__chevron {
      transition: none;
    }
  }

  @media screen and (max-width: 48rem) {
    .loc-picker__trigger {
      color: var(--color-earth-brown);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (window.WrydecoLocalizationPicker) return;

    var state = {
      panel: null,
      activeTrigger: null,
      loadingPromise: null,
      initialized: false,
      searchTimer: null
    };

    function getPanelUrl() {
      var url = new URL(window.location.href);
      url.search = '';
      url.searchParams.set('section_id', 'localization-lazy');
      return url.toString();
    }

    function setTriggersExpanded(expanded) {
      document.querySelectorAll('[data-loc-trigger]').forEach(function (trigger) {
        trigger.setAttribute('aria-expanded', expanded && trigger === state.activeTrigger ? 'true' : 'false');
      });
    }

    function filterItems(query) {
      if (!state.panel) return;
      var q = (query || '').trim().toLowerCase();
      var anyVisible = false;
      state.panel.querySelectorAll('[data-loc-item]').forEach(function (item) {
        var hay = item.getAttribute('data-search') || '';
        var match = !q || hay.indexOf(q) !== -1;
        item.hidden = !match;
        if (match) anyVisible = true;
      });

      var empty = state.panel.querySelector('[data-loc-empty]');
      if (empty) empty.hidden = anyVisible;
    }

    function closePanel(restoreFocus) {
      if (!state.panel) return;
      state.panel.hidden = true;
      setTriggersExpanded(false);

      if (restoreFocus && state.activeTrigger) state.activeTrigger.focus();
      state.activeTrigger = null;
    }

    function initPanel() {
      if (!state.panel || state.initialized) return;
      state.initialized = true;

      var closeButtons = state.panel.querySelectorAll('[data-loc-close]');
      var search = state.panel.querySelector('[data-loc-search]');

      closeButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          closePanel(true);
        });
      });

      if (search) {
        search.addEventListener('input', function () {
          window.clearTimeout(state.searchTimer);
          state.searchTimer = window.setTimeout(function () {
            filterItems(search.value);
          }, 120);
        });

        search.addEventListener('keydown', function (event) {
          if (event.key === 'Enter') event.preventDefault();
        });
      }

      state.panel.addEventListener('click', function (event) {
        if (event.target.hasAttribute('data-loc-overlay')) closePanel(true);
      });

      document.addEventListener('keydown', function (event) {
        if (!state.panel || state.panel.hidden) return;
        if (event.key === 'Escape') closePanel(true);
      });
    }

    function loadPanel() {
      if (state.panel) return Promise.resolve(state.panel);
      if (state.loadingPromise) return state.loadingPromise;

      state.loadingPromise = fetch(getPanelUrl(), { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('Localization panel failed to load.');
          return response.text();
        })
        .then(function (html) {
          var wrapper = document.createElement('div');
          wrapper.setAttribute('data-loc-panel-root', '');
          wrapper.innerHTML = html;
          state.panel = wrapper.querySelector('[data-loc-panel]');
          if (!state.panel) throw new Error('Localization panel markup was not found.');
          document.body.appendChild(wrapper);
          initPanel();
          return state.panel;
        })
        .catch(function (error) {
          state.loadingPromise = null;
          throw error;
        });

      return state.loadingPromise;
    }

    function openPanel(trigger) {
      state.activeTrigger = trigger;
      setTriggersExpanded(true);

      loadPanel()
        .then(function (panel) {
          var search = panel.querySelector('[data-loc-search]');
          panel.hidden = false;
          filterItems('');
          if (search) {
            search.value = '';
            window.requestAnimationFrame(function () {
              search.focus({ preventScroll: true });
            });
          }
        })
        .catch(function () {
          closePanel(false);
        });
    }

    function handleTriggerClick(event) {
      var trigger = event.target.closest('[data-loc-trigger]');
      if (!trigger) return;

      event.preventDefault();
      if (state.panel && !state.panel.hidden && state.activeTrigger === trigger) {
        closePanel(true);
        return;
      }

      openPanel(trigger);
    }

    document.addEventListener('click', handleTriggerClick);

    window.WrydecoLocalizationPicker = {
      open: openPanel,
      close: closePanel,
      load: loadPanel
    };
  })();
{% endjavascript %}
