{% doc %}
  Renders the global lead-capture popup and submits natively to Shopify's
  customer newsletter endpoint.

  The offer title, voucher code, email field label, and email CTA come from the
  first `voucher_welcome_customer` metaobject entry. All supporting copy is
  intentionally fixed to preserve the approved campaign design.

  @example
  {% render 'lead-capture-popup' %}
{% enddoc %}

{% liquid
  assign voucher = metaobjects.voucher_welcome_customer.values | first
  assign voucher_title = voucher.voucher_title.value
  assign voucher_code = voucher.voucher_code.value
  assign email_cta_text = voucher.email_cta_text.value
  assign email_label_text = voucher.email_label_text.value
%}

<button
  type="button"
  class="lead-capture-test-toggle"
  data-lead-capture-test-toggle
  aria-controls="LeadCaptureDialog"
  aria-expanded="false"
  hidden
>
  Test lead popup
</button>

<button
  type="button"
  class="lead-capture-test-toggle lead-capture-test-toggle--success"
  data-lead-capture-test-success-toggle
  aria-controls="LeadCaptureDialog"
  aria-expanded="false"
  hidden
>
  Test success popup
</button>

<div
  class="lead-capture"
  data-lead-capture
  data-storage-key="wrydeco_lead_capture_seen_v1"
  data-reminder-key="wrydeco_lead_capture_reminder_v1"
  data-subscribed-key="wrydeco_lead_capture_subscribed_v1"
  data-auto-open="{% if request.page_type == 'index' %}true{% else %}false{% endif %}"
  aria-hidden="true"
  hidden
>
  <div
    id="LeadCaptureDialog"
    class="lead-capture__dialog"
    data-lead-capture-dialog
    role="dialog"
    aria-modal="true"
    {% if voucher_title != blank %}
      aria-labelledby="LeadCaptureTitle"
    {% else %}
      aria-label="Welcome offer"
    {% endif %}
    {% if email_cta_text != blank %}
      aria-describedby="LeadCaptureDescription"
    {% endif %}
  >
    <button
      type="button"
      class="lead-capture__close"
      data-lead-capture-close
      aria-label="Close welcome offer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M18 6L6 18M6 6l12 12"
        />
      </svg>
    </button>

    <div class="lead-capture__media">
      <img
        class="lead-capture__media-image"
        src="{{ 'lead-capture-popup-photo.webp' | file_url }}"
        alt="Sculptural wood coffee table in a warmly lit WRYDECO interior"
        width="1086"
        height="1448"
        loading="lazy"
      >
    </div>

    <div class="lead-capture__panel">
      <div class="lead-capture__content">
        <div data-lead-capture-form-state>
          <div class="lead-capture__mark" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <path d="M18.9 7a8 8 0 0 1 1.1 5v1a6 6 0 0 0 .8 3M8 11a4 4 0 0 1 8 0v1a10 10 0 0 0 2 6"/>
                <path d="M12 11v2a14 14 0 0 0 2.5 8M8 15a18 18 0 0 0 1.8 6m-4.9-2a22 22 0 0 1-.9-7v-1a8 8 0 0 1 12-6.95"/>
              </g>
            </svg>
          </div>

          <div class="lead-capture__eyebrow" aria-hidden="true">
            <span></span>
            <p>Welcome Offer</p>
            <span></span>
          </div>

          <h2
            id="LeadCaptureTitle"
            class="lead-capture__title"
            {% if voucher_title == blank %}
              hidden
            {% endif %}
          >
            {{- voucher_title -}}
          </h2>

          <div
            class="lead-capture__voucher"
            aria-label="Welcome voucher"
            {% if voucher_code == blank %}
              hidden
            {% endif %}
          >
            <strong class="lead-capture__code" data-lead-capture-code>{{ voucher_code | escape }}</strong>
            <button
              type="button"
              class="lead-capture__copy"
              data-lead-capture-copy
              data-code="{{ voucher_code | escape }}"
              aria-label="Copy voucher code"
            >
              <span class="lead-capture__copy-icon" data-lead-capture-copy-icon aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                    <path d="M8 8m-2 0a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z"/>
                    <path d="M16 6V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>
                  </g>
                </svg>
              </span>
              <span class="lead-capture__copy-icon" data-lead-capture-check-icon aria-hidden="true" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="m5 12l5 5L20 7"
                  />
                </svg>
              </span>
              <span class="lead-capture__visually-hidden" data-lead-capture-copy-status aria-live="polite"></span>
            </button>
          </div>

          <h3
            class="lead-capture__form-heading"
            {% if email_label_text == blank %}
              hidden
            {% endif %}
          >
            {{- email_label_text | escape -}}
          </h3>
          <p
            id="LeadCaptureDescription"
            class="lead-capture__description"
            {% if email_cta_text == blank %}
              hidden
            {% endif %}
          >
            {{- email_cta_text | escape -}}
          </p>

          {% form 'customer', class: 'lead-capture__form', id: 'LeadCaptureForm' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {% if form.posted_successfully? %}
              <span data-lead-capture-response-success hidden></span>
            {% elsif form.errors %}
              <div data-lead-capture-response-error hidden>{{ form.errors | default_errors }}</div>
            {% endif %}

            <div class="lead-capture__form-row">
              <div class="lead-capture__field">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                    <path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <path d="m3 7l9 6l9-6"/>
                  </g>
                </svg>
                <label class="lead-capture__visually-hidden" for="LeadCaptureEmail">Email address</label>
                <input
                  id="LeadCaptureEmail"
                  class="lead-capture__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email | escape }}"
                  placeholder="Enter your email"
                  autocomplete="email"
                  inputmode="email"
                  aria-describedby="LeadCaptureError"
                  required
                >
              </div>
              <button class="lead-capture__submit" type="submit" data-lead-capture-submit>
                <span data-lead-capture-submit-label>Keep me updated</span>
                <span class="lead-capture__spinner" aria-hidden="true"></span>
              </button>
            </div>
            <p id="LeadCaptureError" class="lead-capture__error" data-lead-capture-error role="alert" hidden></p>
          {% endform %}

          <div class="lead-capture__divider" aria-hidden="true">
            <span></span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <path d="M5 21c.5-4.5 2.5-8 7-10"/>
                <path d="M9 18c6.218 0 10.5-3.288 11-12V4h-4.014c-9 0-11.986 4-12 9c0 1 0 3 2 5z"/>
              </g>
            </svg>
            <span></span>
          </div>

          <button type="button" class="lead-capture__decline" data-lead-capture-close>
            No thanks, I'll explore on my own.
          </button>
        </div>

        <div class="lead-capture__success" data-lead-capture-success hidden>
          <div class="lead-capture__mark" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
              <path d="M0 0h24v24H0z" fill="none" />
              <g fill="none">
              	<path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z" />
              	<path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m3.535 6.381l-4.95 4.95l-2.12-2.121a1 1 0 0 0-1.415 1.414l2.758 2.758a1.1 1.1 0 0 0 1.556 0l5.586-5.586a1 1 0 0 0-1.415-1.415" />
              </g>
            </svg>
          </div>

          <div class="lead-capture__eyebrow" aria-hidden="true">
            <span></span>
            <p>Welcome Offer</p>
            <span></span>
          </div>

          <h2 id="LeadCaptureSuccessTitle" class="lead-capture__title">You're on the list.</h2>
          <p id="LeadCaptureSuccessDescription" class="lead-capture__description lead-capture__description--success">
            We'll send future studio offers to your inbox.
          </p>

          <div
            class="lead-capture__voucher lead-capture__voucher--success"
            aria-label="Welcome voucher"
            {% if voucher_code == blank %}
              hidden
            {% endif %}
          >
            <strong class="lead-capture__code">{{ voucher_code | escape }}</strong>
            <button
              type="button"
              class="lead-capture__copy"
              data-lead-capture-copy
              data-code="{{ voucher_code | escape }}"
              aria-label="Copy voucher code"
            >
              <span class="lead-capture__copy-icon" data-lead-capture-copy-icon aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                    <path d="M8 8m-2 0a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z"/>
                    <path d="M16 6V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>
                  </g>
                </svg>
              </span>
              <span class="lead-capture__copy-icon" data-lead-capture-check-icon aria-hidden="true" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="m5 12l5 5L20 7"
                  />
                </svg>
              </span>
              <span class="lead-capture__visually-hidden" data-lead-capture-copy-status aria-live="polite"></span>
            </button>
          </div>

          <button type="button" class="lead-capture__shop" data-lead-capture-shop data-lead-capture-close>
            Continue exploring
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<div
  class="lead-capture-reminder"
  data-lead-capture-reminder
  hidden
  style="background-image: url('{{ 'ic-wood-type-6.webp' | file_url }}')"
>
  <button
    type="button"
    class="lead-capture-reminder__open"
    data-lead-capture-reminder-open
    aria-haspopup="dialog"
    aria-controls="LeadCaptureDialog"
  >
    <span class="lead-capture-reminder__label">
      <span class="value-10">10%</span>
      <span class="value-text">OFF</span>
    </span>
  </button>
  <button
    type="button"
    class="lead-capture-reminder__close"
    data-lead-capture-reminder-close
    aria-label="Dismiss gift reminder"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M18 6L6 18M6 6l12 12"
      />
    </svg>
  </button>
</div>

{% stylesheet %}
  .lead-capture-test-toggle[hidden],
  .lead-capture-reminder[hidden],
  .lead-capture[hidden],
  .lead-capture__title[hidden],
  .lead-capture__voucher[hidden],
  .lead-capture__form-heading[hidden],
  .lead-capture__description[hidden] {
    display: none;
  }

  .lead-capture-test-toggle {
    position: fixed;
    z-index: calc(var(--z-drawer) + 11);
    bottom: var(--sp-12);
    left: var(--sp-4);
    min-height: var(--sp-7);
    padding: var(--sp-2) var(--sp-4);
    border: var(--border-width) solid var(--color-clay);
    border-radius: var(--radius-full);
    background: var(--color-brown-dark);
    box-shadow: var(--shadow-elevation-2);
    color: var(--text-inverse);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-semibold);
  }

  .lead-capture-test-toggle--success {
    bottom: calc(var(--sp-4) * 2 + var(--sp-7));
  }

  .lead-capture-test-toggle:hover {
    background: var(--color-brown);
  }

  .lead-capture-test-toggle:focus-visible,
  .lead-capture-reminder__open:focus-visible,
  .lead-capture-reminder__close:focus-visible,
  .lead-capture__close:focus-visible,
  .lead-capture__decline:focus-visible,
  .lead-capture__submit:focus-visible,
  .lead-capture__shop:focus-visible {
    outline: var(--border-width) solid var(--color-sage);
    outline-offset: var(--sp-1);
  }

  .lead-capture-reminder {
    position: fixed;
    z-index: calc(var(--z-drawer) + 9);
    bottom: 50%;
    left: calc(clamp(4.25rem, 4.8vw, 9rem) * -0.18);
    display: flex;
    width: clamp(4.25rem, 4.8vw, 9rem);
    height: clamp(4.75rem, 5.4vw, 8rem);
    align-items: stretch;
    border: var(--sp-0);
    border-radius: var(--sp-0) var(--radius-lg) var(--radius-lg) var(--sp-0);
    background-color: var(--color-brown-dark);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    box-shadow: var(--shadow-elevation-2);
    opacity: 0;
    transform: translateY(50%);
    transition: left var(--timing-short) var(--ease-standard), opacity var(--timing-short) var(--ease-standard);
  }

  .lead-capture-reminder.is-visible {
    opacity: 1;
  }

  .lead-capture-reminder:hover,
  .lead-capture-reminder:focus-within {
    left: calc(clamp(4.25rem, 4.8vw, 9rem) * -0.06);
    box-shadow: var(--shadow-elevation-3);
  }

  .lead-capture-reminder__open {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: clamp(0.65rem, 0.8vw, 1.25rem) clamp(0.45rem, 0.6vw, 0.9rem);
    border: var(--sp-0);
    background: transparent;
    color: var(--text-inverse);
    cursor: pointer;
    font-family: var(--font-roboto);
    font-weight: var(--font-weight-bold);
  }

  .lead-capture-reminder__label {
    line-height: var(--line-height-tight);
    text-align: center;
    transform: translateX(clamp(0.2rem, 0.28vw, 0.5rem));
  }

  .lead-capture-reminder__label .value-10 {
    display: block;
    font-size: clamp(1.35rem, 1.45vw, 2.7rem);
  }

  .lead-capture-reminder__label .value-text {
    display: block;
    font-size: clamp(0.9rem, 1vw, 1.85rem);
    letter-spacing: var(--letter-spacing-wide);
  }

  .lead-capture-reminder__close {
    position: absolute;
    top: calc(clamp(0.5rem, 0.65vw, 1rem) * -1);
    right: calc(clamp(0.5rem, 0.65vw, 1rem) * -1);
    display: grid;
    width: clamp(1.25rem, 1.4vw, 2.5rem);
    height: clamp(1.25rem, 1.4vw, 2.5rem);
    place-items: center;
    padding: var(--sp-1);
    border: var(--border-width) solid var(--color-cream);
    border-radius: var(--radius-full);
    background: var(--color-brown-dark);
    color: var(--text-inverse);
    cursor: pointer;
    opacity: 0;
    transition: var(--transition-fast);
  }

  .lead-capture-reminder:hover .lead-capture-reminder__close,
  .lead-capture-reminder:focus-within .lead-capture-reminder__close {
    opacity: 1;
  }

  .lead-capture-reminder__close svg {
    width: 100%;
    height: 100%;
  }

  html.lead-capture-is-open,
  body.lead-capture-is-open {
    overflow: hidden;
  }

  .lead-capture {
    position: fixed;
    inset: var(--sp-0);
    z-index: calc(var(--z-drawer) + 10);
    display: grid;
    place-items: center;
    overflow-y: auto;
    padding: var(--sp-7);
    background: color-mix(in srgb, var(--color-ebony) 78%, transparent);
    backdrop-filter: blur(var(--sp-1));
    opacity: 0;
    transition: opacity var(--timing-base) var(--ease-standard);
  }

  .lead-capture.is-open {
    opacity: 1;
  }

  .lead-capture__dialog {
    position: relative;
    display: grid;
    grid-template-columns: minmax(var(--sp-0), 0.9fr) minmax(var(--sp-0), 1.1fr);
    width: min(var(--layout-showcase-max-width), 80vw);
    height: calc(100dvh - 200px);
    max-height: calc(100dvh - 64px);
    overflow: hidden;
    border: var(--border-width) solid color-mix(in srgb, var(--color-clay) 42%, transparent);
    border-radius: var(--radius-xl);
    background: var(--color-bg);
    box-shadow: var(--shadow-modal);
    color: var(--color-text);
    transform: translateY(var(--sp-3)) scale(0.98);
    transition: transform var(--timing-base) var(--ease-out);
  }

  .lead-capture.is-open .lead-capture__dialog {
    transform: translateY(var(--sp-0)) scale(1);
  }

  .lead-capture__media {
    min-width: var(--sp-0);
    overflow: hidden;
    background: var(--color-bg-warm);
  }

  .lead-capture__media-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lead-capture__panel {
    min-width: var(--sp-0);
    overflow-y: auto;
    background: var(--color-milk);
  }

  .lead-capture__content {
    display: grid;
    min-height: 100%;
    align-items: start;
    align-content: center;
    padding: var(--sp-7) var(--sp-8) var(--sp-6);
    text-align: center;
  }

  .lead-capture__close {
    position: absolute;
    z-index: 2;
    top: var(--sp-5);
    right: var(--sp-5);
    display: grid;
    width: var(--sp-7);
    height: var(--sp-7);
    place-items: center;
    padding: var(--sp-3);
    border: var(--border-width) solid var(--color-clay);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface-elevated) 82%, transparent);
    color: var(--color-brown-dark);
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .lead-capture__close:hover {
    background: var(--surface-elevated);
    transform: rotate(6deg);
  }

  .lead-capture__close svg,
  .lead-capture__mark svg,
  .lead-capture__field svg,
  .lead-capture__divider svg {
    width: 100%;
    height: 100%;
  }

  .lead-capture__mark {
    display: grid;
    width: var(--sp-6);
    height: var(--sp-6);
    margin: var(--sp-0) auto var(--sp-4);
    place-items: center;
    color: var(--color-brown-dark);
  }

  .lead-capture__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-5);
    margin-bottom: var(--sp-5);
    color: var(--color-brown-dark);
  }

  .lead-capture__eyebrow span {
    width: var(--sp-8);
    height: var(--border-width);
    background: color-mix(in srgb, var(--color-clay) 54%, transparent);
  }

  .lead-capture__eyebrow p {
    margin: var(--sp-0);
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.24em;
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .lead-capture__title {
    max-width: calc(var(--sp-12) * 4);
    margin: var(--sp-0) auto;
    color: var(--color-brown-dark);
    font-family: var(--font-body);
    font-size: clamp(var(--font-size-display-md), 4.2vw, var(--font-size-display-xl));
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-snug);
    line-height: var(--line-height-display);
  }

  .lead-capture__title:not([hidden]):has(+ .lead-capture__voucher[hidden]) {
    margin-bottom: var(--sp-4);
  }

  .lead-capture__voucher-title-strong {
    font-weight: var(--font-weight-bold);
  }

  .lead-capture__voucher {
    position: relative;
    display: grid;
    min-height: var(--sp-8);
    place-items: center;
    gap: var(--sp-2);
    margin: var(--sp-5) auto var(--sp-4);
    padding: var(--sp-4) var(--sp-9);
    border: var(--border-width) solid color-mix(in srgb, var(--color-clay) 62%, transparent);
    border-radius: var(--radius-md);
    background: var(--color-dark-clay);
  }

  .lead-capture__code {
    color: var(--color-cream);
    font-family: var(--font-body);
    font-size: clamp(var(--font-size-body-3xl), 3vw, var(--font-size-body-6xl));
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    line-height: var(--line-height-tight);
  }

  .lead-capture__copy {
    position: absolute;
    top: 50%;
    right: var(--sp-3);
    display: grid;
    width: var(--sp-7);
    height: var(--sp-7);
    place-items: center;
    padding: var(--sp-3);
    border: var(--border-width) solid color-mix(in srgb, var(--color-cream) 56%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-cream) 10%, transparent);
    color: var(--color-cream);
    cursor: pointer;
    transform: translateY(-50%);
    transition: var(--transition-fast);
  }

  .lead-capture__copy:hover {
    background: color-mix(in srgb, var(--color-cream) 18%, transparent);
  }

  .lead-capture__copy:focus-visible {
    outline: var(--border-width) solid var(--color-cream);
    outline-offset: var(--sp-1);
  }

  .lead-capture__copy-icon {
    display: grid;
    width: var(--sp-5);
    height: var(--sp-5);
    place-items: center;
  }

  .lead-capture__copy-icon[hidden] {
    display: none;
  }

  .lead-capture__copy-icon svg {
    width: 100%;
    height: 100%;
  }

  .lead-capture__clipboard-proxy {
    position: fixed;
    top: var(--sp-0);
    left: var(--sp-0);
    width: var(--border-width);
    height: var(--border-width);
    opacity: 0;
    pointer-events: none;
  }

  .lead-capture__form-heading {
    margin: var(--sp-0);
    color: var(--color-brown-dark);
    font-family: var(--font-body);
    font-size: var(--font-size-display-sm);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-tight);
  }

  .lead-capture__form-heading:not([hidden]):has(+ .lead-capture__description[hidden]) {
    margin-bottom: var(--sp-4);
  }

  .lead-capture__description {
    margin: var(--sp-2) auto var(--sp-5);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-relaxed);
  }

  .lead-capture__form {
    margin: var(--sp-0) auto;
  }

  .lead-capture__form-row {
    display: grid;
    grid-template-columns: minmax(var(--sp-0), 1.45fr) minmax(var(--sp-12), 1fr);
  }

  .lead-capture__field {
    display: flex;
    min-width: var(--sp-0);
    min-height: var(--sp-7);
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border: var(--border-width) solid var(--color-clay);
    border-right: var(--sp-0);
    border-radius: var(--radius-md) var(--radius-none) var(--radius-none) var(--radius-md);
    background: color-mix(in srgb, var(--surface-elevated) 72%, transparent);
    color: var(--color-brown-dark);
  }

  .lead-capture__field:focus-within {
    border-color: var(--color-sage);
    box-shadow: var(--shadow-focus);
  }

  .lead-capture__field:has(.lead-capture__input[aria-invalid='true']) {
    border-color: var(--color-error);
  }

  .lead-capture__field svg {
    flex: 0 0 var(--sp-5);
    width: var(--sp-5);
    height: var(--sp-5);
  }

  .lead-capture__input {
    width: 100%;
    min-width: var(--sp-0);
    padding: var(--sp-0);
    border: var(--sp-0);
    outline: var(--sp-0);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-normal);
  }

  .lead-capture__input::placeholder {
    color: var(--color-muted);
    opacity: 0.82;
  }

  .lead-capture__submit,
  .lead-capture__shop {
    display: flex;
    min-height: var(--sp-7);
    align-items: center;
    justify-content: center;
    padding: var(--sp-3) var(--sp-5);
    border: var(--border-width) solid var(--color-brown-dark);
    border-radius: var(--radius-none) var(--radius-md) var(--radius-md) var(--radius-none);
    background: var(--color-brown-dark);
    color: var(--text-inverse);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    line-height: var(--line-height-normal);
    text-align: center;
    text-transform: uppercase;
    transition: var(--transition-fast);
  }

  .lead-capture__submit:hover {
    background: var(--color-brown);
  }

  .lead-capture__submit[aria-busy='true'] {
    cursor: wait;
  }

  .lead-capture__submit[aria-busy='true'] [data-lead-capture-submit-label] {
    opacity: 0.72;
  }

  .lead-capture__spinner {
    display: none;
    width: var(--sp-4);
    height: var(--sp-4);
    margin-left: var(--sp-3);
    border: var(--border-width) solid color-mix(in srgb, var(--text-inverse) 35%, transparent);
    border-top-color: var(--text-inverse);
    border-radius: var(--radius-full);
    animation: lead-capture-spin var(--timing-extra-long) linear infinite;
  }

  .lead-capture__submit[aria-busy='true'] .lead-capture__spinner {
    display: block;
  }

  .lead-capture__error {
    margin: var(--sp-2) var(--sp-0) var(--sp-0);
    color: var(--color-error);
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-normal);
    text-align: left;
  }

  .lead-capture__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    margin: var(--sp-4) auto var(--sp-2);
    color: var(--color-clay);
  }

  .lead-capture__divider span {
    width: 100%;
    height: var(--border-width);
    background: color-mix(in srgb, var(--color-clay) 42%, transparent);
  }

  .lead-capture__divider svg {
    flex: 0 0 var(--sp-4);
    width: var(--sp-4);
    height: var(--sp-4);
  }

  .lead-capture__decline {
    padding: var(--sp-1);
    border: var(--sp-0);
    background: transparent;
    color: var(--color-brown-dark);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-normal);
    text-decoration: underline;
    text-underline-offset: var(--sp-1);
  }

  .lead-capture__success .lead-capture__description--success {
    max-width: calc(var(--sp-12) * 3);
    margin-top: var(--sp-4);
  }

  .lead-capture__voucher--success {
    margin-top: var(--sp-5);
  }

  .lead-capture__shop {
    width: 100%;
    border-radius: var(--radius-md);
    background-color: var(--color-cream);
    color: var(--color-brown-dark);
    font-weight: var(--font-weight-bold);
  }
  .lead-capture__shop:hover {
    letter-spacing: 0.1rem;
  }

  .lead-capture__visually-hidden {
    position: absolute;
    width: var(--border-width);
    height: var(--border-width);
    overflow: hidden;
    clip: rect(var(--sp-0), var(--sp-0), var(--sp-0), var(--sp-0));
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes lead-capture-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 64rem) {
    .lead-capture {
      padding: var(--sp-5);
    }

    .lead-capture__dialog {
      width: min(92vw, var(--layout-max-width));
    }

    .lead-capture__content {
      padding: var(--sp-6);
    }

    .lead-capture__title {
      font-size: var(--font-size-display-lg);
    }

    .lead-capture__voucher {
      margin-block: var(--sp-5) var(--sp-4);
      padding: var(--sp-4) var(--sp-8);
    }

    .lead-capture__form-row {
      grid-template-columns: minmax(var(--sp-0), 1.3fr) minmax(var(--sp-12), 1fr);
    }
  }

  @media (max-width: 48rem) {
    .lead-capture {
      padding: var(--sp-3);
    }

    .lead-capture__dialog {
      grid-template-columns: minmax(var(--sp-0), 1fr);
      width: min(100%, calc(var(--sp-12) * 4));
      height: auto;
      max-height: calc(100dvh - var(--sp-5));
      overflow-y: auto;
    }

    .lead-capture__media {
      height: calc(var(--sp-12) + var(--sp-8));
    }

    .lead-capture__panel {
      overflow: visible;
    }

    .lead-capture__content {
      min-height: auto;
      align-content: start;
      padding: var(--sp-5);
    }

    .lead-capture__close {
      top: var(--sp-4);
      right: var(--sp-4);
      background: color-mix(in srgb, var(--surface-elevated) 92%, transparent);
    }

    .lead-capture__mark {
      margin-bottom: var(--sp-3);
    }

    .lead-capture__eyebrow {
      gap: var(--sp-3);
      margin-bottom: var(--sp-4);
    }

    .lead-capture__eyebrow span {
      width: var(--sp-7);
    }

    .lead-capture__title {
      font-size: var(--font-size-display-md);
    }

    .lead-capture__form-row {
      grid-template-columns: minmax(var(--sp-0), 1fr);
      gap: var(--sp-3);
    }

    .lead-capture__field,
    .lead-capture__submit {
      border: var(--border-width) solid var(--color-clay);
      border-radius: var(--radius-md);
    }
  }

  @media (max-width: 30rem) {
    .lead-capture__dialog {
      max-height: calc(100dvh - var(--sp-4));
    }

    .lead-capture__media {
      height: calc(var(--sp-12) + var(--sp-5));
    }

    .lead-capture__content {
      padding: var(--sp-5) var(--sp-4);
    }

    .lead-capture__close {
      width: var(--sp-6);
      height: var(--sp-6);
      padding: var(--sp-2);
    }

    .lead-capture__eyebrow {
      margin-bottom: var(--sp-3);
    }

    .lead-capture__eyebrow p {
      letter-spacing: 0.16em;
    }

    .lead-capture__eyebrow span {
      width: var(--sp-6);
    }

    .lead-capture__title {
      font-size: var(--font-size-display-sm);
    }

    .lead-capture__voucher {
      gap: var(--sp-1);
      margin-block: var(--sp-4);
      padding: var(--sp-3) var(--sp-8);
    }

    .lead-capture__code {
      font-size: var(--font-size-body-3xl);
    }

    .lead-capture__form-heading {
      font-size: var(--font-size-body-2xl);
    }

    .lead-capture__description {
      margin-bottom: var(--sp-4);
      font-size: var(--font-size-body-sm);
    }

    .lead-capture__divider {
      margin-top: var(--sp-4);
    }
  }

  @media (min-width: 48.0625rem) and (max-height: 52rem) {
    .lead-capture {
      padding: var(--sp-5);
    }

    .lead-capture__content {
      padding-block: var(--sp-5);
    }

    .lead-capture__mark {
      margin-bottom: var(--sp-3);
    }

    .lead-capture__eyebrow {
      margin-bottom: var(--sp-4);
    }

    .lead-capture__title {
      font-size: var(--font-size-display-lg);
    }

    .lead-capture__voucher {
      gap: var(--sp-1);
      margin-block: var(--sp-4);
      padding: var(--sp-3) var(--sp-8);
    }

    .lead-capture__code {
      font-size: var(--font-size-body-5xl);
    }

    .lead-capture__form-heading {
      font-size: var(--font-size-body-4xl);
    }

    .lead-capture__description {
      margin-bottom: var(--sp-4);
      font-size: var(--font-size-body-lg);
    }

    .lead-capture__divider {
      margin-top: var(--sp-3);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var root = document.querySelector('[data-lead-capture]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    var testToggle = document.querySelector('[data-lead-capture-test-toggle]');
    var testSuccessToggle = document.querySelector('[data-lead-capture-test-success-toggle]');
    var dialog = root.querySelector('[data-lead-capture-dialog]');
    var form = root.querySelector('form');
    var emailInput = root.querySelector('input[type="email"]');
    var submitButton = root.querySelector('[data-lead-capture-submit]');
    var submitLabel = root.querySelector('[data-lead-capture-submit-label]');
    var submitLabelText = submitLabel ? submitLabel.textContent.trim() : '';
    var copyButtons = Array.prototype.slice.call(root.querySelectorAll('[data-lead-capture-copy]'));
    var errorMessage = root.querySelector('[data-lead-capture-error]');
    var formState = root.querySelector('[data-lead-capture-form-state]');
    var successState = root.querySelector('[data-lead-capture-success]');
    var storageKey = root.dataset.storageKey;
    var reminderKey = root.dataset.reminderKey;
    var subscribedKey = root.dataset.subscribedKey;
    var autoOpen = root.dataset.autoOpen === 'true';
    var reminder = document.querySelector('[data-lead-capture-reminder]');
    var reminderOpenButton = reminder ? reminder.querySelector('[data-lead-capture-reminder-open]') : null;
    var reminderCloseButton = reminder ? reminder.querySelector('[data-lead-capture-reminder-close]') : null;
    var reminderMemoryState = '';
    var subscribedMemoryState = false;
    var isSubmitting = false;
    var isOpen = false;
    var isSubscribed = false;
    var lastFocusedElement = null;
    var closeTimer = null;
    var copyResetTimers = new WeakMap();

    function getReminderState() {
      try {
        return window.localStorage.getItem(reminderKey) || '';
      } catch (error) {
        return reminderMemoryState;
      }
    }

    function setReminderState(state) {
      reminderMemoryState = state;
      try {
        window.localStorage.setItem(reminderKey, state);
      } catch (error) {
        return;
      }
    }

    function hasSubscribed() {
      try {
        return window.localStorage.getItem(subscribedKey) === 'true';
      } catch (error) {
        return subscribedMemoryState;
      }
    }

    function rememberSubscription() {
      subscribedMemoryState = true;
      try {
        window.localStorage.setItem(subscribedKey, 'true');
      } catch (error) {
        return;
      }
    }

    function showReminder() {
      if (!reminder) return;
      if (isSubscribed || hasSubscribed()) {
        hideReminder();
        return;
      }
      reminder.hidden = false;
      window.requestAnimationFrame(function () {
        reminder.classList.add('is-visible');
      });
    }

    function hideReminder() {
      if (!reminder) return;
      reminder.classList.remove('is-visible');
      reminder.hidden = true;
    }

    function hasBeenSeen() {
      try {
        return window.localStorage.getItem(storageKey) === 'true';
      } catch (error) {
        return false;
      }
    }

    function rememberVisit() {
      try {
        window.localStorage.setItem(storageKey, 'true');
      } catch (error) {
        return;
      }
    }

    function focusableElements() {
      return Array.prototype.slice
        .call(
          dialog.querySelectorAll(
            'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        )
        .filter(function (element) {
          return !element.hidden && element.offsetParent !== null;
        });
    }

    function setError(message) {
      errorMessage.textContent = message || '';
      errorMessage.hidden = !message;
      emailInput.setAttribute('aria-invalid', message ? 'true' : 'false');
    }

    function setLoading(loading) {
      isSubmitting = loading;
      submitButton.disabled = loading;
      if (loading) {
        submitButton.setAttribute('aria-busy', 'true');
        submitLabel.textContent = 'Joining...';
      } else {
        submitButton.removeAttribute('aria-busy');
        submitLabel.textContent = submitLabelText;
      }
    }

    function openPopup(forceOpen) {
      if ((!forceOpen && hasBeenSeen()) || isOpen) return;
      window.clearTimeout(closeTimer);
      rememberVisit();
      isOpen = true;
      if (testToggle) testToggle.setAttribute('aria-expanded', 'true');
      lastFocusedElement = document.activeElement;
      root.hidden = false;
      root.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('lead-capture-is-open');
      document.body.classList.add('lead-capture-is-open');
      window.requestAnimationFrame(function () {
        root.classList.add('is-open');
        var initialFocus = successState.hidden ? emailInput : root.querySelector('[data-lead-capture-shop]');
        initialFocus.focus({ preventScroll: true });
      });
    }

    function closePopup() {
      if (!isOpen) return;
      isOpen = false;
      if (testToggle) testToggle.setAttribute('aria-expanded', 'false');
      root.classList.remove('is-open');
      root.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('lead-capture-is-open');
      document.body.classList.remove('lead-capture-is-open');
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(function () {
        root.hidden = true;
      }, 300);
      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus({ preventScroll: true });
      }
      if (!isSubscribed && getReminderState() !== 'dismissed') {
        setReminderState('active');
        showReminder();
      }
    }

    function showSuccess() {
      setLoading(false);
      setError('');
      form.reset();
      isSubscribed = true;
      rememberSubscription();
      setReminderState('dismissed');
      hideReminder();
      formState.hidden = true;
      successState.hidden = false;
      dialog.setAttribute('aria-labelledby', 'LeadCaptureSuccessTitle');
      dialog.setAttribute('aria-describedby', 'LeadCaptureSuccessDescription');
    }

    function handleKeydown(event) {
      if (!isOpen) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closePopup();
        return;
      }
      if (event.key !== 'Tab') return;

      var focusable = focusableElements();
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    function hasValidEmail() {
      emailInput.value = emailInput.value.trim();
      return Boolean(emailInput.value) && emailInput.validity.valid;
    }

    function rejectSubmission() {
      setLoading(false);
      setError('Enter a valid email address.');
      emailInput.focus();
    }

    function fallbackCopy(value) {
      var temporaryInput = document.createElement('textarea');
      temporaryInput.value = value;
      temporaryInput.setAttribute('readonly', '');
      temporaryInput.className = 'lead-capture__clipboard-proxy';
      document.body.appendChild(temporaryInput);
      temporaryInput.select();
      var copied = document.execCommand('copy');
      temporaryInput.remove();
      return copied;
    }

    function copyVoucherCode(value) {
      if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
        return navigator.clipboard.writeText(value).catch(function () {
          if (fallbackCopy(value)) return;
          throw new Error('Copy failed');
        });
      }

      return fallbackCopy(value) ? Promise.resolve() : Promise.reject(new Error('Copy failed'));
    }

    function resetCopyIndicator(copyButton) {
      var copyIcon = copyButton.querySelector('[data-lead-capture-copy-icon]');
      var checkIcon = copyButton.querySelector('[data-lead-capture-check-icon]');
      var copyStatus = copyButton.querySelector('[data-lead-capture-copy-status]');
      if (!copyIcon || !checkIcon) return;
      copyButton.classList.remove('is-copied');
      copyButton.setAttribute('aria-label', 'Copy voucher code');
      copyIcon.hidden = false;
      checkIcon.hidden = true;
      if (copyStatus) copyStatus.textContent = '';
      copyResetTimers.delete(copyButton);
    }

    function showCopyIndicator(copyButton) {
      var copyIcon = copyButton.querySelector('[data-lead-capture-copy-icon]');
      var checkIcon = copyButton.querySelector('[data-lead-capture-check-icon]');
      var copyStatus = copyButton.querySelector('[data-lead-capture-copy-status]');
      if (!copyIcon || !checkIcon) return;
      window.clearTimeout(copyResetTimers.get(copyButton));
      copyButton.classList.add('is-copied');
      copyButton.setAttribute('aria-label', 'Voucher code copied');
      copyIcon.hidden = true;
      checkIcon.hidden = false;
      if (copyStatus) copyStatus.textContent = 'Voucher code copied.';
      copyResetTimers.set(
        copyButton,
        window.setTimeout(function () {
          resetCopyIndicator(copyButton);
        }, 2000)
      );
    }

    root.addEventListener('click', function (event) {
      if (event.target === root || event.target.closest('[data-lead-capture-close]')) {
        closePopup();
      }
    });

    emailInput.addEventListener('input', function () {
      if (emailInput.validity.valid) setError('');
    });

    emailInput.addEventListener('invalid', function (event) {
      event.preventDefault();
      rejectSubmission();
    });

    copyButtons.forEach(function (copyButton) {
      copyButton.addEventListener('click', function () {
        var voucherCode = copyButton.dataset.code || '';
        if (!voucherCode) return;

        copyVoucherCode(voucherCode)
          .then(function () {
            showCopyIndicator(copyButton);
            if (window.showToast) {
              window.showToast({
                message: 'Voucher code copied.',
                type: 'success',
                position: 'bottom-left',
                duration: 2000,
              });
            }
          })
          .catch(function () {
            if (window.showToast) {
              window.showToast({
                message: 'Unable to copy the voucher code.',
                type: 'error',
                position: 'bottom-left',
              });
            }
          });
      });
    });

    submitButton.addEventListener(
      'click',
      function (event) {
        if (isSubmitting || !hasValidEmail()) {
          event.preventDefault();
          event.stopImmediatePropagation();
          if (!isSubmitting) rejectSubmission();
        }
      },
      true
    );

    form.addEventListener('submit', function (event) {
      if (isSubmitting) {
        event.preventDefault();
        return;
      }

      if (!hasValidEmail()) {
        event.preventDefault();
        rejectSubmission();
        return;
      }

      setError('');
      setLoading(true);
    });

    document.addEventListener('keydown', handleKeydown);

    if (reminderOpenButton) {
      reminderOpenButton.addEventListener('click', function () {
        hideReminder();
        openPopup(true);
      });
    }

    if (reminderCloseButton) {
      reminderCloseButton.addEventListener('click', function () {
        setReminderState('dismissed');
        hideReminder();
      });
    }

    if (testToggle && new URLSearchParams(window.location.search).get('lead_popup_test') === '1') {
      testToggle.hidden = false;
      testToggle.addEventListener('click', function () {
        if (isOpen) {
          closePopup();
        } else {
          openPopup(true);
        }
      });

      if (testSuccessToggle) {
        testSuccessToggle.hidden = false;
        testSuccessToggle.addEventListener('click', function () {
          showSuccess();
          if (!isOpen) openPopup(true);
        });
      }
    }

    var responseParameters = new URLSearchParams(window.location.search);
    var redirectedSuccessfully =
      responseParameters.get('customer_posted') === 'true' && window.location.hash === '#LeadCaptureForm';
    var postedSuccessfully =
      Boolean(root.querySelector('[data-lead-capture-response-success]')) || redirectedSuccessfully;
    var serverError = root.querySelector('[data-lead-capture-response-error]');

    if (postedSuccessfully) {
      showSuccess();
      openPopup(true);
    } else if (serverError) {
      setError(serverError.textContent.trim());
      openPopup(true);
    } else if (autoOpen && !hasBeenSeen()) {
      var navigationElapsed =
        window.performance && typeof window.performance.now === 'function' ? window.performance.now() : 0;
      window.setTimeout(openPopup, Math.max(0, 2000 - navigationElapsed));
    } else if (getReminderState() === 'active') {
      showReminder();
    }
  })();
{% endjavascript %}
