{% doc %}
  Renders the complimentary consultation link on the product page.

  Preserves the existing consultation form properties and hidden schedule trigger.
  The visible link opens the customization inquiry page.

  @param {product} product - The current product.
{% enddoc %}

{% stylesheet %}
  .product-guidance-wrapper {
    width: 100%;
    margin-top: var(--sp-2);
  }

  .product-guidance__trigger {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .product-guidance__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    width: 100%;
    min-height: 44px;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--color-clay);
    border-radius: var(--radius-lg);
    background-color: transparent;
    color: var(--color-earth-brown);
    font-family: var(--font-roboto);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
    letter-spacing: normal;
    text-align: center;
    text-decoration: none;
    text-transform: none;
    transition: background-color var(--timing-short) var(--ease-standard),
      border-color var(--timing-short) var(--ease-standard);
  }

  .product-guidance__cta:hover {
    border-color: var(--color-earth-brown);
    background-color: var(--bg-secondary);
  }

  .product-guidance__cta:focus-visible {
    outline: 2px solid var(--color-earth-brown);
    outline-offset: 3px;
  }

  .product-guidance__cta svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
  }

  .product-guidance__label {
    min-width: 0;
  }

  @media screen and (max-width: 480px) {
    .product-guidance__cta {
      gap: var(--sp-2);
      padding-inline: var(--sp-3);
    }
  }
{% endstylesheet %}

<div class="product-guidance-wrapper">
  {% comment %} Hidden field keeps the consultation line-item property on the product form {% endcomment %}
  <input
    type="hidden"
    name="properties[_Private design consultation]"
    value="No"
    form="{{ 'ProductForm-' | append: section.id }}"
  >
  <input
    type="checkbox"
    id="Consultation-{{ section.id }}"
    name="properties[Private design consultation]"
    value="Yes"
    class="product-guidance__trigger"
    aria-label="Add private design guidance"
    data-consultation-trigger="true"
    form="{{ 'ProductForm-' | append: section.id }}"
  >

  <a href="/pages/customization#custom-inquiry__story-telling" class="product-guidance__cta">
    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M8 2v3m8-3v3"/><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 15l2 2l4-4"/></g></svg>
    <span class="product-guidance__label">Request a complimentary consultation</span>
    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-7-7l7 7l-7 7"/></svg>
  </a>
</div>
