{% doc %}
  Renders WRYDECO marketplace links for the header or footer.

  @param {string} placement - header for icons, footer for labelled buttons.
{% enddoc %}
<div class="marketplace-links marketplace-links--{{ placement }}">
  <a
    href="https://www.amazon.com/stores/page/4C9B7557-3277-471F-AEAB-03C34C4284F7"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Visit our Amazon Store (opens in a new tab)"
    title="Visit our Amazon Store"
    data-marketplace-direct
  >
    {% render 'icon-marketplace', marketplace: 'amazon' %}
    {% if placement == 'footer' -%}
      <span>Visit our Amazon Store</span>
    {%- endif %}
  </a>
  <a
    href="https://etsy.com/shop/BeaconfieldGroup"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Visit our Etsy Store (opens in a new tab)"
    title="Visit our Etsy Store"
    data-marketplace-direct
  >
    {% render 'icon-marketplace', marketplace: 'etsy' %}
    {% if placement == 'footer' -%}
      <span>Visit our Etsy Store</span>
    {%- endif %}
  </a>
</div>

{% stylesheet %}
  .marketplace-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .marketplace-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 44px;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-full, 999px);
  }
  .marketplace-links a:hover {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }
  .marketplace-links a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  .marketplace-links svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .marketplace-links--header a {
    width: 44px;
    height: 44px;
    background-color: rgba(247, 242, 236, 0.14);
    border: 1px solid rgba(247, 242, 236, 0.28);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .marketplace-links--header a:hover {
    background-color: rgba(247, 242, 236, 0.24);
    border-color: rgba(247, 242, 236, 0.5);
  }
  @media (prefers-reduced-motion: reduce) {
    .marketplace-links--header a {
      transition: none;
    }
  }
  .marketplace-links--footer {
    flex-wrap: wrap;
    gap: 12px;
    color: var(--color-milk, #f7f2ec);
  }
  .marketplace-links--footer a {
    padding: 10px 18px;
    border: 1px solid color-mix(in srgb, var(--color-milk) 28%, transparent);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
  }
  .marketplace-links--footer a:hover {
    border-color: currentColor;
  }
  @media (max-width: 480px) {
    .marketplace-links--footer {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
  }
{% endstylesheet %}
