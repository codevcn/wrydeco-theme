{% doc %}
  Renders the PDP trust-benefit grid and its accessible detail drawer.

  @param {string} section_id - Unique section identifier used for ARIA relationships.

  @example
  {% render 'product-trust-benefits', section_id: section.id %}
{% enddoc %}

{%- capture icon_truck -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 17a2 2 0 1 0 4 0a2 2 0 1 0-4 0m10 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0"/><path d="M5 17H3v-4M2 5h11v12m-4 0h6m4 0h2v-6h-8m0-5h5l3 5M3 9h4"/></g></svg>
{%- endcapture -%}
{%- capture icon_shield -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.46 20.846A12 12 0 0 1 3.5 6A12 12 0 0 0 12 3a12 12 0 0 0 8.5 3a12 12 0 0 1-.09 7.06M15 19l2 2l4-4"/></svg>
{%- endcapture -%}
{%- capture icon_return -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 11A8.1 8.1 0 0 0 4.5 9M4 5v4h4m-4 4a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/></svg>
{%- endcapture -%}
{%- capture icon_package_shield -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 21l-8-4.5v-9L12 3l8 4.5V12m-8 0l8-4.5M12 12v9m0-9L4 7.5M15 18h7m-3-3l3 3l-3 3"/></svg>
{%- endcapture -%}
{%- capture icon_arrow -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 48 48">
    <path d="M0 0h48v48H0z" fill="none" />
    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="m19 12l12 12l-12 12" />
  </svg>
{%- endcapture -%}
{%- capture icon_close -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12"/></svg>
{%- endcapture -%}
{%- capture icon_box -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 3l8 4.5v9L12 21l-8-4.5v-9zm0 9l8-4.5M12 12v9m0-9L4 7.5m12-2.25l-8 4.5"/></svg>
{%- endcapture -%}
{%- capture icon_chair -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 11a2 2 0 0 1 2 2v2h10v-2a2 2 0 1 1 4 0v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2"/><path d="M5 11V6a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v5M6 19v2m12-2v2"/></g></svg>
{%- endcapture -%}
{%- capture icon_tag -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M6.5 7.5a1 1 0 1 0 2 0a1 1 0 1 0-2 0"/><path d="M3 6v5.172a2 2 0 0 0 .586 1.414l7.71 7.71a2.41 2.41 0 0 0 3.408 0l5.592-5.592a2.41 2.41 0 0 0 0-3.408l-7.71-7.71A2 2 0 0 0 11.172 3H6a3 3 0 0 0-3 3"/></g></svg>
{%- endcapture -%}
{%- capture icon_info -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0-18 0m9-3h.01"/><path d="M11 12h1v4h1"/></g></svg>
{%- endcapture -%}
{%- capture icon_calendar -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm12-4v4M8 3v4m-4 4h16m-9 4h1m0 0v3"/></svg>
{%- endcapture -%}
{%- capture icon_blocked -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.042 16.045A9 9 0 0 0 7.955 3.958M5.637 5.635a9 9 0 1 0 12.725 12.73M3 3l18 18"/></svg>
{%- endcapture -%}
{%- capture icon_support -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0m12 3l3.35 3.35M9 15l-3.35 3.35m0-12.7L9 9m9.35-3.35L15 9"/></g></svg>
{%- endcapture -%}
{%- capture icon_tools -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 21h4L20 8a1.5 1.5 0 0 0-4-4L3 17zM14.5 5.5l4 4"/><path d="M12 8L7 3L3 7l5 5M7 8L5.5 9.5M16 12l5 5l-4 4l-5-5m4 1l-1.5 1.5"/></g></svg>
{%- endcapture -%}
{%- capture icon_phone -%}
  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
{%- endcapture -%}

<section class="product-trust-benefits" aria-label="Purchase benefits" data-product-benefits>
  <div class="product-trust-benefits__grid">
    <button
      type="button"
      class="product-trust-benefits__trigger"
      aria-controls="ProductBenefitDrawer-{{ section_id }}"
      aria-expanded="false"
      data-benefit-open="delivery"
    >
      <span class="product-trust-benefits__icon">{{ icon_truck }}</span>
      <span class="product-trust-benefits__copy">
        <strong>Free Delivery</strong>
      </span>
      <span class="product-trust-benefits__arrow">{{ icon_arrow }}</span>
    </button>

    <button
      type="button"
      class="product-trust-benefits__trigger"
      aria-controls="ProductBenefitDrawer-{{ section_id }}"
      aria-expanded="false"
      data-benefit-open="warranty"
    >
      <span class="product-trust-benefits__icon">{{ icon_shield }}</span>
      <span class="product-trust-benefits__copy">
        <strong>5-Year Warranty</strong>
      </span>
      <span class="product-trust-benefits__arrow">{{ icon_arrow }}</span>
    </button>

    <button
      type="button"
      class="product-trust-benefits__trigger"
      aria-controls="ProductBenefitDrawer-{{ section_id }}"
      aria-expanded="false"
      data-benefit-open="damage"
    >
      <span class="product-trust-benefits__icon">{{ icon_return }}</span>
      <span class="product-trust-benefits__copy">
        <strong>Damage & Defect Support</strong>
      </span>
      <span class="product-trust-benefits__arrow">{{ icon_arrow }}</span>
    </button>

    <button
      type="button"
      class="product-trust-benefits__trigger"
      aria-controls="ProductBenefitDrawer-{{ section_id }}"
      aria-expanded="false"
      data-benefit-open="protection"
    >
      <span class="product-trust-benefits__icon">{{ icon_package_shield }}</span>
      <span class="product-trust-benefits__copy">
        <strong>Protected Delivery</strong>
      </span>
      <span class="product-trust-benefits__arrow">{{ icon_arrow }}</span>
    </button>
  </div>

  <div
    id="ProductBenefitDrawer-{{ section_id }}"
    class="product-benefit-drawer"
    data-benefit-drawer
    aria-hidden="true"
    hidden
  >
    <button
      type="button"
      class="product-benefit-drawer__overlay"
      aria-label="Close benefit details"
      data-benefit-close
    ></button>

    <aside class="product-benefit-drawer__panel" role="dialog" aria-modal="true" tabindex="-1" data-benefit-panel>
      <button
        type="button"
        class="product-benefit-drawer__close"
        aria-label="Close benefit details"
        data-benefit-close
      >
        {{ icon_close }}
      </button>

      <div class="product-benefit-drawer__scroll">
        <p class="product-benefit-drawer__eyebrow">Benefits</p>

        <article class="product-benefit-drawer__view" data-benefit-view="delivery" hidden>
          <header class="product-benefit-drawer__header">
            <span class="product-benefit-drawer__title-icon">{{ icon_truck }}</span>
            <h2 id="BenefitDeliveryTitle-{{ section_id }}">Free Delivery</h2>
          </header>
          <p class="product-benefit-drawer__lead">
            We offer complimentary Standard Delivery and an optional Delivery &amp; Assembly Service.
          </p>

          <div class="product-benefit-drawer__cards">
            <section class="product-benefit-drawer__card">
              <span class="product-benefit-drawer__card-icon">{{ icon_box }}</span>
              <div>
                <h3>Standard Delivery</h3>
                <p>
                  Complimentary on orders delivered to eligible United States addresses. Delivery is made to the ground
                  floor, lobby, or first accessible dry area and does not include unpacking or assembly.
                </p>
              </div>
            </section>
            <section class="product-benefit-drawer__card">
              <span class="product-benefit-drawer__card-icon">{{ icon_chair }}</span>
              <div>
                <h3>Delivery &amp; Assembly Service</h3>
                <p>
                  Available by arrangement for selected pieces requiring specialist placement or setup. Scope, access
                  requirements, and any additional service fee are confirmed before booking.
                </p>
              </div>
            </section>
          </div>

          <div class="product-benefit-drawer__inline-note">
            <span>{{ icon_tag }}</span>
            <p>Optional installation, storage, redelivery, or specialized handling may carry a separate charge.</p>
          </div>
          <div class="product-benefit-drawer__notice">
            <span>{{ icon_info }}</span>
            <p>
              <strong>Note:</strong> Assembly is scheduled in advance. Please prepare a clear, accessible space before
              the delivery team arrives.
            </p>
          </div>
        </article>

        <article class="product-benefit-drawer__view" data-benefit-view="warranty" hidden>
          <header class="product-benefit-drawer__hero-header">
            <span class="product-benefit-drawer__hero-icon">{{ icon_package_shield }}</span>
            <div>
              <h2 id="BenefitWarrantyTitle-{{ section_id }}">5-Year Warranty</h2>
              <p>
                WRYDECO offers a <strong>5-year structural warranty</strong> covering the integrity of the joinery and
                construction from the date of delivery.
              </p>
            </div>
          </header>

          <div class="product-benefit-drawer__divider" aria-hidden="true"></div>
          <div class="product-benefit-drawer__cards">
            <section class="product-benefit-drawer__card">
              <span class="product-benefit-drawer__card-icon product-benefit-drawer__card-icon--outline">
                {{ icon_shield }}
              </span>
              <div>
                <h3>What’s Covered</h3>
                <p>Structural failures in the joinery and construction that hold the piece together.</p>
              </div>
            </section>
            <section class="product-benefit-drawer__card">
              <span class="product-benefit-drawer__card-icon product-benefit-drawer__card-icon--outline">
                {{ icon_blocked }}
              </span>
              <div>
                <h3>Not Covered</h3>
                <p>
                  Natural wood movement, tonal shifts, patina, surface wear, misuse, unsuitable environments, harsh
                  cleaning, accidents, or alterations made after delivery.
                </p>
              </div>
            </section>
          </div>

          <div class="product-benefit-drawer__inline-note">
            <span>{{ icon_support }}</span>
            <p>Contact our team with clear photographs if you believe the structure of your piece has failed.</p>
          </div>
          <div class="product-benefit-drawer__notice">
            <span>{{ icon_info }}</span>
            <p>Natural variations in solid wood and signs of regular use are characteristics, not defects.</p>
          </div>
          <a class="product-benefit-drawer__text-link" href="{{ pages.faq.url | default: '/pages/faq' }}">
            See full warranty details {{ icon_arrow }}
          </a>
        </article>

        <article class="product-benefit-drawer__view" data-benefit-view="damage" hidden>
          <header class="product-benefit-drawer__header">
            <span class="product-benefit-drawer__title-icon product-benefit-drawer__title-icon--large">
              {{ icon_return }}
            </span>
            <h2 id="BenefitDamageTitle-{{ section_id }}">Damage &amp; Defect Support</h2>
          </header>
          <div class="product-benefit-drawer__ornament" aria-hidden="true"><span></span></div>

          <div class="product-benefit-drawer__cards">
            <section class="product-benefit-drawer__card">
              <span class="product-benefit-drawer__card-icon product-benefit-drawer__card-icon--outline">
                {{ icon_calendar }}
              </span>
              <div>
                <h3>Claim Window</h3>
                <p>Contact us within 7 calendar days of delivery with your order number and clear photographs.</p>
              </div>
            </section>
            <section class="product-benefit-drawer__card">
              <span class="product-benefit-drawer__card-icon product-benefit-drawer__card-icon--outline">
                {{ icon_tag }}
              </span>
              <div>
                <h3>Eligibility</h3>
                <p>Claims apply to manufacturing defects or damage that occurred during shipping.</p>
              </div>
            </section>
            <section class="product-benefit-drawer__card">
              <span class="product-benefit-drawer__card-icon product-benefit-drawer__card-icon--outline">
                {{ icon_shield }}
              </span>
              <div>
                <h3>Important Note</h3>
                <p>
                  Keep all original packaging and wait for written instructions before returning or disposing of any
                  part of the shipment.
                </p>
              </div>
            </section>
          </div>

          <div class="product-benefit-drawer__policy-footer">
            <a
              class="product-benefit-drawer__text-link"
              href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}"
            >
              See full Return &amp; Refund Policy {{ icon_arrow }}
            </a>
          </div>
        </article>

        <article
          class="product-benefit-drawer__view product-benefit-drawer__view--protection"
          data-benefit-view="protection"
          hidden
        >
          <header class="product-benefit-drawer__header product-benefit-drawer__header--centered">
            <span class="product-benefit-drawer__hero-icon">{{ icon_package_shield }}</span>
            <h2 id="BenefitProtectionTitle-{{ section_id }}">Protected Delivery</h2>
          </header>
          <div class="product-benefit-drawer__ornament" aria-hidden="true"><span></span></div>
          <p class="product-benefit-drawer__lead">
            We take great care in packaging and delivering your WRYDECO piece safely to your door.
          </p>

          <div class="product-benefit-drawer__cards">
            <section class="product-benefit-drawer__card product-benefit-drawer__card--compact">
              <span class="product-benefit-drawer__card-icon">{{ icon_package_shield }}</span>
              <div>
                <h3>Lost or Missing Packages</h3>
                <p>If an order is confirmed lost in transit, we will arrange an appropriate resolution.</p>
              </div>
              <span class="product-benefit-drawer__card-arrow">{{ icon_arrow }}</span>
            </section>
            <section class="product-benefit-drawer__card product-benefit-drawer__card--compact">
              <span class="product-benefit-drawer__card-icon">{{ icon_box }}</span>
              <div>
                <h3>Damaged or Defective Items</h3>
                <p>Contact us with clear photographs so we can assess a repair, replacement, or refund.</p>
              </div>
              <span class="product-benefit-drawer__card-arrow">{{ icon_arrow }}</span>
            </section>
            <section class="product-benefit-drawer__card product-benefit-drawer__card--compact">
              <span class="product-benefit-drawer__card-icon">{{ icon_tools }}</span>
              <div>
                <h3>Missing Parts or Assembly Tools</h3>
                <p>Tell us what is missing and our team will help arrange the required parts or next steps.</p>
              </div>
              <span class="product-benefit-drawer__card-arrow">{{ icon_arrow }}</span>
            </section>
          </div>

          <div class="product-benefit-drawer__notice">
            <span>{{ icon_info }}</span>
            <p>
              <strong>Important:</strong> Inspect your order upon arrival and contact us within 7 days if you encounter
              an issue.
            </p>
          </div>

          <footer class="product-benefit-drawer__contact">
            <p>Questions? Our team is here to help.</p>
            <a href="{{ pages.contact.url | default: '/pages/contact' }}">
              {{ icon_phone }} Contact Us {{ icon_arrow }}
            </a>
          </footer>
        </article>
      </div>
    </aside>
  </div>
</section>

{% stylesheet %}
  .product-trust-benefits {
    display: none; /* tạm, sửa sau */
    width: 100%;
  }

  .product-trust-benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: var(--border-width) solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-white-cream);
  }

  .product-trust-benefits__trigger {
    display: grid;
    grid-template-columns: var(--sp-7) minmax(0, 1fr) var(--sp-5);
    align-items: center;
    gap: var(--sp-3);
    min-height: calc(var(--sp-9) + var(--sp-4));
    padding: var(--sp-4);
    border: 0;
    border-inline-end: var(--border-width) solid var(--border-light);
    border-block-end: var(--border-width) solid var(--border-light);
    background: transparent;
    color: var(--text-primary);
    text-align: start;
    cursor: pointer;
    transition: background-color var(--timing-short) var(--ease-standard);
  }

  .product-trust-benefits__trigger:nth-child(2n) {
    border-inline-end: 0;
  }

  .product-trust-benefits__trigger:nth-last-child(-n + 2) {
    border-block-end: 0;
  }

  .product-trust-benefits__trigger:hover,
  .product-trust-benefits__trigger:focus-visible {
    background: color-mix(in srgb, var(--color-clay) 7%, transparent);
    outline: none;
  }

  .product-trust-benefits__icon,
  .product-benefit-drawer__card-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--sp-7);
    height: var(--sp-7);
    border-radius: var(--radius-full);
    background: var(--color-milk);
    color: var(--color-clay);
  }

  .product-trust-benefits svg,
  .product-benefit-drawer svg {
    width: var(--sp-5);
    height: var(--sp-5);
    fill: none;
    stroke-width: calc(var(--border-width) * 1.5);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .product-trust-benefits__copy {
    display: grid;
    gap: var(--sp-1);
    min-width: 0;
  }

  .product-trust-benefits__copy strong {
    font-family: var(--font-body);
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
  }

  .product-trust-benefits__arrow,
  .product-benefit-drawer__card-arrow {
    display: grid;
    place-items: center;
    color: var(--color-clay);
  }
  .product-trust-benefits__arrow .icon-arrow-drawer {
    stroke: none;
  }

  .product-trust-benefits__arrow svg,
  .product-benefit-drawer__card-arrow svg,
  .product-benefit-drawer__text-link svg {
    width: 22px;
    height: 22px;
  }

  .product-benefit-drawer[hidden] {
    display: none;
  }

  .product-benefit-drawer {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-drawer) + 2);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--timing-base) var(--ease-standard);
  }

  .product-benefit-drawer.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .product-benefit-drawer__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--bg-overlay);
    cursor: pointer;
  }

  .product-benefit-drawer__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    display: flex;
    flex-direction: column;
    width: min(100%, var(--cart-drawer-width));
    background: radial-gradient(circle at top right, var(--color-white-cream), transparent 58%), var(--surface-elevated);
    color: var(--text-primary);
    box-shadow: var(--shadow-modal);
    outline: none;
    transform: translateX(100%);
    transition: transform var(--timing-long) var(--ease-out);
  }

  .product-benefit-drawer.is-open .product-benefit-drawer__panel {
    transform: translateX(0);
  }

  .product-benefit-drawer__close {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--sp-5);
    inset-inline-end: var(--sp-5);
    display: grid;
    place-items: center;
    width: var(--sp-7);
    height: var(--sp-7);
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-earth-brown);
    cursor: pointer;
  }

  .product-benefit-drawer__close:hover,
  .product-benefit-drawer__close:focus-visible {
    background: var(--color-milk);
    outline: none;
  }

  .product-benefit-drawer__scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--sp-6) var(--sp-6) var(--sp-6);
  }

  .product-benefit-drawer__eyebrow {
    margin: 0 0 var(--sp-4);
    color: var(--color-clay);
    font: var(--type-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .product-benefit-drawer__view {
    min-height: calc(100dvh - var(--sp-12));
  }

  .product-benefit-drawer__view[hidden] {
