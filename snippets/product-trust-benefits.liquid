  .product-benefit-drawer__inline-note {
    display: grid;
    grid-template-columns: var(--sp-6) minmax(0, 1fr);
    gap: var(--sp-3);
    margin: var(--sp-5) 0;
    padding-block: var(--sp-5);
    border-block: var(--border-width) solid var(--border-light);
  }

  .product-benefit-drawer__inline-note > span,
  .product-benefit-drawer__notice > span {
    display: grid;
    place-items: start center;
    color: var(--color-earth-brown);
  }

  .product-benefit-drawer__notice {
    display: grid;
    grid-template-columns: var(--sp-6) minmax(0, 1fr);
    gap: var(--sp-3);
    margin-top: var(--sp-5);
    padding: var(--sp-4);
    border: var(--border-width) solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--color-milk);
  }

  .product-benefit-drawer__text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
    color: var(--color-earth-brown);
    font: var(--type-body-small);
    text-decoration: underline;
    text-underline-offset: var(--sp-1);
  }

  .product-benefit-drawer__policy-footer {
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: var(--border-width) solid var(--border-light);
    text-align: center;
  }

  .product-benefit-drawer__contact {
    margin: var(--sp-6) calc(var(--sp-6) * -1) calc(var(--sp-6) * -1);
    padding: var(--sp-6);
    background: var(--color-earth-brown);
    color: var(--color-cream);
    text-align: center;
  }

  .product-benefit-drawer__contact p {
    margin: 0 0 var(--sp-3);
    font: var(--type-body-small);
  }

  .product-benefit-drawer__contact a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: var(--sp-7);
    color: inherit;
    font: var(--type-body-small);
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
    text-transform: uppercase;
  }

  html.product-benefit-drawer-is-open,
  body.product-benefit-drawer-is-open {
    overflow: hidden;
  }

  @media screen and (max-width: 719px) {
    .product-trust-benefits__grid {
      grid-template-columns: 1fr;
    }

    .product-trust-benefits__trigger {
      min-height: var(--sp-9);
      border-inline-end: 0;
      border-block-end: var(--border-width) solid var(--border-light);
    }

    .product-trust-benefits__trigger:nth-last-child(-n + 2) {
      border-block-end: var(--border-width) solid var(--border-light);
    }

    .product-trust-benefits__trigger:last-child {
      border-block-end: 0;
    }

    .product-benefit-drawer__panel {
      width: 100%;
    }

    .product-benefit-drawer__scroll {
      padding: var(--sp-6) var(--sp-4) var(--sp-4);
    }

    .product-benefit-drawer__close {
      inset-block-start: var(--sp-3);
      inset-inline-end: var(--sp-3);
    }

    .product-benefit-drawer__header,
    .product-benefit-drawer__hero-header {
      padding-inline-end: var(--sp-6);
    }

    .product-benefit-drawer__header h2,
    .product-benefit-drawer__hero-header h2 {
      font: var(--type-display-small);
    }

    .product-benefit-drawer__hero-header {
      display: grid;
    }

    .product-benefit-drawer__hero-icon {
      width: var(--sp-8);
      height: var(--sp-8);
    }

    .product-benefit-drawer__hero-icon svg,
    .product-benefit-drawer__title-icon svg,
    .product-benefit-drawer__title-icon--large svg {
      width: var(--sp-6);
      height: var(--sp-6);
    }

    .product-benefit-drawer__card,
    .product-benefit-drawer__card--compact {
      grid-template-columns: var(--sp-7) minmax(0, 1fr);
      padding: var(--sp-4);
    }

    .product-benefit-drawer__card-icon {
      width: var(--sp-7);
      height: var(--sp-7);
    }

    .product-benefit-drawer__card-arrow {
      display: none;
    }

    .product-benefit-drawer__contact {
      margin-inline: calc(var(--sp-4) * -1);
      margin-block-end: calc(var(--sp-4) * -1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-benefit-drawer,
    .product-benefit-drawer__panel {
      transition-duration: var(--timing-micro);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const initializedRoots = new WeakSet();

    const initializeBenefitDrawer = (root) => {
      if (initializedRoots.has(root)) return;
      initializedRoots.add(root);

      const drawer = root.querySelector('[data-benefit-drawer]');
      const panel = root.querySelector('[data-benefit-panel]');
      const triggers = [...root.querySelectorAll('[data-benefit-open]')];
      const views = [...root.querySelectorAll('[data-benefit-view]')];
      let activeTrigger = null;
      let closeTimer = null;

      if (!drawer || !panel || !triggers.length || !views.length) return;

      const closeDrawer = () => {
        if (drawer.hidden) return;
        window.clearTimeout(closeTimer);
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('product-benefit-drawer-is-open');
        document.body.classList.remove('product-benefit-drawer-is-open');
        triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));

        closeTimer = window.setTimeout(() => {
          drawer.hidden = true;
          views.forEach((view) => {
            view.hidden = true;
          });
          if (activeTrigger instanceof HTMLElement) activeTrigger.focus();
          activeTrigger = null;
        }, 300);
      };

      const openDrawer = (trigger) => {
        const name = trigger.dataset.benefitOpen;
        const view = views.find((candidate) => candidate.dataset.benefitView === name);
        if (!view) return;

        window.clearTimeout(closeTimer);
        activeTrigger = trigger;
        views.forEach((candidate) => {
          candidate.hidden = candidate !== view;
        });
        triggers.forEach((candidate) => {
          candidate.setAttribute('aria-expanded', candidate === trigger ? 'true' : 'false');
        });

        const title = view.querySelector('h2[id]');
        if (title) panel.setAttribute('aria-labelledby', title.id);
        drawer.hidden = false;
        drawer.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('product-benefit-drawer-is-open');
        document.body.classList.add('product-benefit-drawer-is-open');
        window.requestAnimationFrame(() => {
          drawer.classList.add('is-open');
          panel.focus();
        });
      };

      root.addEventListener('click', (event) => {
        const trigger = event.target.closest('[data-benefit-open]');
        if (trigger && root.contains(trigger)) {
          openDrawer(trigger);
          return;
        }

        if (event.target.closest('[data-benefit-close]')) closeDrawer();
      });

      drawer.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          closeDrawer();
          return;
        }

        if (event.key !== 'Tab') return;
        const focusable = [
          ...panel.querySelectorAll(
            'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
          ),
        ].filter((element) => !element.closest('[hidden]'));
        if (!focusable.length) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    };

    const initializeBenefitDrawers = () => {
      document.querySelectorAll('[data-product-benefits]').forEach(initializeBenefitDrawer);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeBenefitDrawers, { once: true });
    } else {
      initializeBenefitDrawers();
    }
  })();
{% endjavascript %}
