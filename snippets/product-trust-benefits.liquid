  .product-benefit-drawer__card--compact {
    grid-template-columns: var(--sp-9) minmax(0, 1fr) var(--sp-5);
    align-items: center;
  }

  .product-benefit-drawer__card-icon {
    width: var(--sp-9);
    height: var(--sp-9);
  }

  .product-benefit-drawer__card-icon--outline {
    border: var(--border-width) solid var(--border-light);
    background: transparent;
  }

  .product-benefit-drawer__card h3 {
    margin: 0 0 var(--sp-2);
    color: var(--color-earth-brown);
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .product-benefit-drawer__card p,
  .product-benefit-drawer__inline-note p,
  .product-benefit-drawer__notice p {
    margin: 0;
    color: var(--text-secondary);
    font: var(--type-body-small);
