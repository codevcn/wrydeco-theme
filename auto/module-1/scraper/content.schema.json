{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wrydeco scraper content",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "description_html", "seo_product_title", "seo_title", "seo_description", "handle"],
  "properties": {
    "title": {"type": "string", "minLength": 50, "maxLength": 70},
    "description_html": {"type": "string", "pattern": "^<div\\s+class=[\\\"']wrydeco-product-description[\\\"']>"},
    "seo_product_title": {"type": "string", "minLength": 50, "maxLength": 70},
    "seo_title": {"type": "string", "minLength": 50, "maxLength": 60, "pattern": " \\| Wrydeco$"},
    "seo_description": {"type": "string", "minLength": 150, "maxLength": 160},
    "handle": {"type": "string", "minLength": 50, "maxLength": 60, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
  }
}
