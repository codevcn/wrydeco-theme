<section
  class="loox-product-reviews-heading"
  data-loox-reviews-section
  aria-busy="true"
  aria-labelledby="LooxProductReviewsHeading-{{ section.id }}"
  style="background-image: url({{ 'reviews-widget-background-3-4.png' | file_url  }}); background-repeat: no-repeat; background-position: center; background-size: cover;"
>
  <div class="loox-product-reviews-heading__inner">
    <div class="loox-product-reviews-heading__ornament" aria-hidden="true">
      <span></span>
      <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32">
        <path d="M0 0h32v32H0z" fill="none" />
        <g fill="currentColor">
        	<path d="M12.5 15a.5.5 0 0 0-.5.5v4a.5.5 0 0 0 1 0v-4a.5.5 0 0 0-.5-.5M16 8c2.761 0 5-.84 5-1.875S18.76 4.25 16 4.25s-5 .84-5 1.875S13.239 8 16 8m0-1c-1.657 0-3-.448-3-1s1.343-1 3-1s3 .448 3 1s-1.343 1-3 1" />
        	<path d="M28.06 7.232a3 3 0 0 0-2.063-.878c-.043-1.078-.564-1.961-1.188-2.606c-.643-.665-1.476-1.173-2.35-1.555C20.702 1.425 18.418 1 15.998 1c-2.417 0-4.702.425-6.458 1.193c-.874.382-1.708.89-2.35 1.555C6.539 4.422 6 5.355 6 6.5v8.386a3 3 0 0 0-2.56.846l-.708.707a3 3 0 0 0 0 4.243L6 23.95v1.55c0 1.145.539 2.078 1.19 2.753c.643.664 1.477 1.171 2.351 1.554C11.297 30.575 13.581 31 16 31c2.08 0 4.047-.314 5.662-.88c.972-.341 1.888-.799 2.627-1.394C25.163 28.022 26 26.939 26 25.5V14.95l2.768-2.768a3 3 0 0 0 0-4.243zM8 18.88V9.945c.314.226.651.427 1 .606V14.5a.5.5 0 0 0 1 0v-3.505c1.686.65 3.787 1.005 6 1.005c2.418 0 4.703-.425 6.458-1.193c.875-.383 1.709-.89 2.351-1.555c.212-.219.412-.465.585-.737a1 1 0 0 1 1.252.131l.708.708a1 1 0 0 1 0 1.414L24 14.12V25.5c0 .604-.35 1.172-.966 1.668q-.435.35-1.034.647V23.5a.5.5 0 1 0-1 0v4.732c-1.37.48-3.108.768-5 .768c-4.418 0-8-1.567-8-3.5v-2.379l-3.854-3.853a1 1 0 0 1 0-1.415l.708-.707a1 1 0 0 1 1.414 0zM24 6.5c0 1.933-3.582 3.5-8 3.5S8 8.433 8 6.5S11.582 3 16 3s8 1.567 8 3.5" />
        </g>
      </svg>
      <span></span>
    </div>

    <p class="loox-product-reviews-heading__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="loox-product-reviews-heading__title" id="LooxProductReviewsHeading-{{ section.id }}">
      {{ section.settings.title | escape }}
    </h2>

    <div class="loox-product-reviews-heading__loading" data-loox-reviews-loading role="status" aria-live="polite">
      <div class="loox-product-reviews-heading__loading-header">
        <span class="loox-product-reviews-heading__loading-kicker" data-loox-reviews-loading-message>
          Loading customer reviews
        </span>
        <span class="loox-product-reviews-heading__loading-line" aria-hidden="true"></span>
      </div>

      <div class="loox-product-reviews-heading__loading-grid" aria-hidden="true">
        {%- for index in (1..3) -%}
          <div class="loox-product-reviews-heading__loading-card">
            <span class="loox-product-reviews-heading__loading-stars">
              <span></span><span></span><span></span><span></span><span></span>
            </span>
            <span class="loox-product-reviews-heading__loading-copy loox-product-reviews-heading__loading-copy--wide"></span>
            <span class="loox-product-reviews-heading__loading-copy"></span>
            <span class="loox-product-reviews-heading__loading-meta"></span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="loox-product-reviews-heading__app" data-loox-reviews-app>
    {% for block in section.blocks %}
      {% render block %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .loox-product-reviews-heading {
    padding: var(--sp-8) var(--layout-padding-desktop) var(--sp-4);
    background: var(--color-cream);
    color: var(--color-earth-brown);
  }

  .loox-product-reviews-heading__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, var(--layout-max-width));
    margin-inline: auto;
    text-align: center;
  }

  .loox-product-reviews-heading__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(176px, 48vw);
    color: var(--color-clay);
  }

  .loox-product-reviews-heading__ornament span {
    flex: 1;
    border-block-start: var(--border-width) solid var(--border-dark);
  }

  .loox-product-reviews-heading__ornament svg {
    width: var(--sp-5);
    height: var(--sp-5);
    margin-inline: var(--sp-3);
  }

  .loox-product-reviews-heading__eyebrow {
    margin: var(--sp-5) 0 0;
    font: var(--type-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 5);
    text-transform: uppercase;
    color: var(--color-bark);
  }

  .loox-product-reviews-heading__title {
    max-width: var(--layout-max-width);
    margin: var(--sp-3) 0 0;
    font-family: var(--font-display);
    font-size: var(--font-size-display-xl);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    text-wrap: balance;
    color: var(--color-earth-brown);
  }

  .loox-product-reviews-heading__app {
    width: min(100%, 1080px);
    margin: var(--sp-2) auto 0;
  }

  .loox-product-reviews-heading__loading {
    width: min(100%, 960px);
    margin-block-start: var(--sp-6);
    padding: var(--sp-5);
    border: var(--border-width) solid rgba(74, 44, 24, 0.14);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgba(255, 249, 242, 0.9), rgba(245, 241, 237, 0.72)),
      rgba(255, 249, 242, 0.82);
    box-shadow: 0 18px 44px rgba(42, 38, 34, 0.08);
    backdrop-filter: blur(6px);
  }

  .loox-product-reviews-heading__loading[hidden] {
    display: none;
  }

  .loox-product-reviews-heading__loading-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    margin-block-end: var(--sp-5);
  }

  .loox-product-reviews-heading__loading-kicker {
    flex: none;
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 3);
    text-transform: uppercase;
    color: var(--color-bark);
  }

  .loox-product-reviews-heading__loading-line {
    position: relative;
    display: block;
    width: min(220px, 30vw);
    height: var(--border-width);
    overflow: hidden;
    background: rgba(74, 44, 24, 0.16);
  }

  .loox-product-reviews-heading__loading-line::after {
    content: '';
    position: absolute;
    inset-block: 0;
    width: 42%;
    background: linear-gradient(90deg, transparent, rgba(138, 93, 55, 0.65), transparent);
    animation: loox-reviews-loading-line 1.35s ease-in-out infinite;
  }

  .loox-product-reviews-heading__loading-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4);
  }

  .loox-product-reviews-heading__loading-card {
    display: flex;
    min-height: 152px;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-5);
    border: var(--border-width) solid rgba(74, 44, 24, 0.11);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.5);
  }

  .loox-product-reviews-heading__loading-stars {
    display: flex;
    gap: var(--sp-1);
  }

  .loox-product-reviews-heading__loading-stars span {
    width: 12px;
    height: 12px;
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 56%, 79% 91%, 50% 70%, 21% 91%, 32% 56%, 2% 35%, 39% 35%);
    background: linear-gradient(90deg, rgba(138, 93, 55, 0.24), rgba(138, 93, 55, 0.54), rgba(138, 93, 55, 0.24));
    background-size: 220% 100%;
    animation: loox-reviews-loading-shimmer 1.45s ease-in-out infinite;
  }

  .loox-product-reviews-heading__loading-copy,
  .loox-product-reviews-heading__loading-meta {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, rgba(74, 44, 24, 0.08), rgba(255, 255, 255, 0.58), rgba(74, 44, 24, 0.08));
    background-size: 220% 100%;
    animation: loox-reviews-loading-shimmer 1.45s ease-in-out infinite;
  }

  .loox-product-reviews-heading__loading-copy {
    width: 72%;
    height: 10px;
  }

  .loox-product-reviews-heading__loading-copy--wide {
    width: 100%;
  }

  .loox-product-reviews-heading__loading-meta {
    width: 42%;
    height: 8px;
    margin-block-start: auto;
  }

  .loox-product-reviews-heading__loading--slow .loox-product-reviews-heading__loading-line::after,
  .loox-product-reviews-heading__loading--slow .loox-product-reviews-heading__loading-stars span,
  .loox-product-reviews-heading__loading--slow .loox-product-reviews-heading__loading-copy,
  .loox-product-reviews-heading__loading--slow .loox-product-reviews-heading__loading-meta {
    animation-duration: 1.9s;
  }

  @keyframes loox-reviews-loading-line {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(260%);
    }
  }

  @keyframes loox-reviews-loading-shimmer {
    0% {
      background-position: 120% 0;
    }
    100% {
      background-position: -120% 0;
    }
  }

  .loox-product-reviews-heading__app [data-block-handle='loox-dynamic-section'] {
    background: transparent;
  }

  @media (max-width: 1279px) {
    .loox-product-reviews-heading {
      padding: var(--sp-8) var(--layout-padding-tablet) var(--sp-4);
    }

    .loox-product-reviews-heading__title {
      font-size: var(--font-size-display-lg);
    }
  }

  @media (max-width: 719px) {
    .loox-product-reviews-heading {
      padding: var(--sp-7) var(--layout-padding-mobile) var(--sp-3);
    }

    .loox-product-reviews-heading__ornament {
      width: min(128px, 42vw);
    }

    .loox-product-reviews-heading__ornament svg {
      width: var(--sp-5);
      height: var(--sp-5);
      margin-inline: var(--sp-2);
    }

    .loox-product-reviews-heading__eyebrow {
      margin-block-start: var(--sp-4);
      letter-spacing: calc(var(--letter-spacing-wide) * 3);
    }

    .loox-product-reviews-heading__title {
      max-width: 100%;
      margin-block-start: var(--sp-2);
      font-size: clamp(var(--font-size-body-2xl), 7vw, var(--font-size-display-sm));
      overflow-wrap: anywhere;
    }

    .loox-product-reviews-heading__app {
      margin-block-start: var(--sp-2);
    }

    .loox-product-reviews-heading__loading {
      margin-block-start: var(--sp-5);
      padding: var(--sp-4);
    }

    .loox-product-reviews-heading__loading-header {
      flex-direction: column;
      gap: var(--sp-3);
      margin-block-end: var(--sp-4);
    }

    .loox-product-reviews-heading__loading-kicker {
      letter-spacing: calc(var(--letter-spacing-wide) * 2);
      text-align: center;
    }

    .loox-product-reviews-heading__loading-line {
      width: min(180px, 60vw);
    }

    .loox-product-reviews-heading__loading-grid {
      grid-template-columns: 1fr;
    }

    .loox-product-reviews-heading__loading-card {
      min-height: 128px;
      padding: var(--sp-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loox-product-reviews-heading__loading-line::after,
    .loox-product-reviews-heading__loading-stars span,
    .loox-product-reviews-heading__loading-copy,
    .loox-product-reviews-heading__loading-meta {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initLooxReviewsLoading() {
      document.querySelectorAll('[data-loox-reviews-section]').forEach(function (section) {
        if (section.dataset.looxLoadingInit === 'true') return;

        var loader = section.querySelector('[data-loox-reviews-loading]');
        var app = section.querySelector('[data-loox-reviews-app]');
        if (!loader || !app) return;

        section.dataset.looxLoadingInit = 'true';

        function isVisibleElement(element) {
          if (!element) return false;
          var rect = element.getBoundingClientRect();
          return rect.width > 0 && rect.height > 0;
        }

        function hasLoadedReviews() {
          var reviewNodes = app.querySelectorAll(
            'iframe, article, [role="article"], .loox-review, .loox-review-card, [class*="review"], [data-testid*="review"]'
          );

          for (var i = 0; i < reviewNodes.length; i += 1) {
            var node = reviewNodes[i];
            if (isVisibleElement(node) || node.textContent.trim().length > 24) return true;
          }

          return app.children.length > 0 && app.scrollHeight > 180 && app.textContent.trim().length > 24;
        }

        function hideLoader() {
          loader.hidden = true;
          section.setAttribute('aria-busy', 'false');
        }

        function checkLoaded() {
          if (loader.hidden) return;
          if (hasLoadedReviews()) {
            hideLoader();
          }
        }

        var observer = new MutationObserver(checkLoaded);
        observer.observe(app, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['class', 'style', 'hidden', 'aria-hidden'],
        });

        window.addEventListener('load', checkLoaded, { once: true });
        window.setTimeout(checkLoaded, 600);
        window.setTimeout(function () {
          if (loader.hidden) return;
          loader.classList.add('loox-product-reviews-heading__loading--slow');
          var message = loader.querySelector('[data-loox-reviews-loading-message]');
          if (message) message.textContent = 'Reviews are taking a little longer to appear';
        }, 8000);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLooxReviewsLoading);
    } else {
      initLooxReviewsLoading();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Loox Reviews Heading",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Product Reviews"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What people tell about this product"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "max_blocks": 1,
  "presets": [
    {
      "name": "Loox Reviews Heading"
    }
  ]
}
{% endschema %}
