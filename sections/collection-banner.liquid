{% comment %}
  Collection hero banner.

  Full-width banner shown at the top of the collection page: a background image
  (defaults to the bundled `collection-top-banner.png`) with a breadcrumb,
  the collection title (rendered as the page H1) and a short intro paragraph
  overlaid on the left.

  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% liquid
  assign heading = section.settings.heading | default: collection.title
  assign banner_image = collection.image
  if banner_image == blank
    assign banner_image = section.settings.background_image
  endif

  if banner_image != blank
    assign bg_alt = banner_image.alt | default: heading
  else
    assign bg_alt = heading
  endif

  assign banner_description = collection.description | default: section.settings.description
%}

<section class="col-banner" id="CollectionBanner-{{ section.id }}">
  {% if section.settings.show_breadcrumb %}
    <nav class="col-banner__crumbs" aria-label="Breadcrumb">
      <ol class="col-banner__crumbs-list">
        <li class="col-banner__crumb">
          <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t | default: 'Home' }}</a>
        </li>
        <li class="col-banner__crumb-sep" aria-hidden="true">/</li>
        <li class="col-banner__crumb">
          <a href="{{ routes.collections_url }}">
            {{- 'general.breadcrumbs.collections' | t | default: 'Collections' -}}
          </a>
        </li>
        <li class="col-banner__crumb-sep" aria-hidden="true">/</li>
        <li class="col-banner__crumb col-banner__crumb--current" aria-current="page">
          {{ heading | escape }}
        </li>
      </ol>
    </nav>
  {% endif %}

  <div class="col-banner__media">
    {% if banner_image != blank %}
      {{
        banner_image
        | image_url: width: 2400
        | image_tag:
          class: 'col-banner__bg',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '768, 1024, 1440, 1920, 2400',
          sizes: '100vw',
          alt: bg_alt
      }}
    {% else %}
      <img
        class="col-banner__bg"
        src="{{ 'hero-bg-explore-all-pieces.png' | file_url }}"
        alt="{{ bg_alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="2169"
        height="725"
      >
    {% endif %}

    <div class="col-banner__shade" aria-hidden="true"></div>
    <div class="col-banner__shade-front" aria-hidden="true"></div>
  </div>

  <div class="col-banner__inner">
    <h1 class="col-banner__title">{{ heading | escape }}</h1>
    {%- if banner_description != blank -%}
      <div class="col-banner__subtitle rte">
        {{ banner_description }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  body:has(.col-banner) .header__heading-logo {
    filter: brightness(0) invert(1);
  }

  body:has(.col-banner) .header__heading-link,
  body:has(.col-banner) .header__nav-item,
  body:has(.col-banner) .header__icon,
  body:has(.col-banner) .header__icon--search,
  body:has(.col-banner) .header__icon--cart,
  body:has(.col-banner) .header__icon--menu,
  body:has(.col-banner) .header__icon--account,
  body:has(.col-banner) .header__localization .loc-picker__code,
  body:has(.col-banner) .header__localization .loc-picker__chevron {
    color: var(--color-cream) !important;
  }

  body:has(.col-banner) .header__nav-item:hover,
  body:has(.col-banner) .header__icon:hover {
    color: var(--color-stone);
  }

  body:has(.col-banner) .header__consultation-link {
    border-color: color-mix(in srgb, var(--color-cream) 64%, transparent);
    background-color: transparent;
    color: var(--color-cream);
  }

  body:has(.col-banner) .header__consultation-link:hover {
    background-color: var(--color-cream);
    color: var(--color-earth-brown);
  }

  .loc-picker__option .loc-picker__code {
    color: var(--color-earth-brown) !important;
  }

  .col-banner {
    position: relative;
    isolation: isolate;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 42px;
    padding-left: var(--sp-9);
    padding-right: var(--sp-9);
    min-height: clamp(520px, 42vw, 680px);
    overflow: hidden;
    background-color: var(--color-cream);
    font-family: var(--font-body);
  }

  .col-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .col-banner__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    position: relative;
    z-index: 0;
  }

  .col-banner__shade,
  .col-banner__shade-front {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .col-banner__shade {
    z-index: 2;
    background-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.42) 28%,
      rgba(0, 0, 0, 0.28) 60%,
      rgba(0, 0, 0, 0.12) 100%
    );
  }

  .col-banner__shade-front {
    z-index: 3;
    background-color: rgba(0, 0, 0, 0.1);
  }

  .col-banner__crumbs {
    position: relative;
    z-index: 10;
    margin-top: 65px;
  }

  .col-banner__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 880px;
    height: fit-content;
    padding: 0;
    margin: 0;
  }

  .col-banner__crumbs-list {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(247, 242, 236, 0.85);
    position: relative;
  }
  .col-banner__crumb a {
    color: rgba(247, 242, 236, 0.75);
    text-decoration: none;
    transition: color var(--timing-short) var(--ease-standard);
  }
  .col-banner__crumb a:hover {
    color: var(--color-cream);
  }
  .col-banner__crumb-sep {
    color: rgba(247, 242, 236, 0.45);
  }
  .col-banner__crumb--current {
    color: var(--color-cream);
  }

  .col-banner__title {
    margin: 0;
    font-family: var(--font-display-light);
    font-size: clamp(2.25rem, 2.8vw, 3.5rem);
    font-weight: 600;
    line-height: var(--line-height-display);
    letter-spacing: 0.01rem;
    color: var(--color-cream);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
    text-align: left;
  }
  .col-banner__subtitle {
    color: rgba(247, 242, 236, 0.9);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
    padding-block: var(--sp-3) var(--sp-3);
    margin: 0;
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-generous);
    text-align: left;
    max-width: 68ch;
  }
  .col-banner__subtitle p {
    margin: 0 0 var(--sp-2);
  }
  .col-banner__subtitle p:last-child {
    margin-bottom: 0;
  }
  .col-banner__subtitle a {
    color: var(--color-cream);
    text-decoration: underline;
  }

  @media screen and (max-width: 1024px) {
    .col-banner__inner {
      max-width: 90%;
    }
  }

  @media screen and (max-width: 768px) {
    .col-banner {
      padding-left: var(--layout-padding-mobile);
      padding-right: var(--layout-padding-mobile);
    }

    .col-banner__crumb {
      font-size: 10px;
    }
    .col-banner__title {
      font-size: var(--font-size-display-sm);
      text-align: left;
    }

    .col-banner__subtitle {
      font-size: var(--font-size-body-sm);
      padding-block: var(--sp-1) var(--sp-1);
      text-align: left;
    }
    .col-banner__subtitle p {
      margin-bottom: var(--sp-1);
    }
    .col-banner__inner {
      max-width: 100%;
      padding: 0;
      gap: var(--sp-3);
      align-items: flex-start;
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.collection_banner_heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:labels.show_breadcrumb",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_banner"
    }
  ]
}
{% endschema %}
