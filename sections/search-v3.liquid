{% comment %}
  Search results page.

  Hero (heading + search field) over a lifestyle background image,
  a sort/view toolbar, a 4-column product grid (flat cards, no border/shadow)
  and pill pagination reusing the same paginate logic as the collection page.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{% liquid
  assign per_page = 24
  assign q_param = search.terms | url_param_escape
  comment
    Queries reach this page with a trailing `*` per word (prefix matching) so the
    native Storefront Search engine matches the same items the popup dropdown
    shows. Strip the `*` for anything shown back to the shopper.
  endcomment
  assign display_terms = search.terms | remove: '*' | strip
  assign current_sort = search.sort_by | default: 'relevance'
  assign popular_collection = collections['best-sellers']
  capture search_base_url
    echo routes.search_url | append: '?q=' | append: q_param | append: '&type=product'
  endcapture
%}

<section class="srp" id="Search-{{ section.id }}">
  <div class="srp-hero">
    <div class="srp-hero__media">
      <img
        class="srp-hero__bg"
        src="{{ 'hero-bg-search.png' | file_url }}"
        alt=""
        width="2169"
        height="725"
        loading="eager"
        fetchpriority="high"
      >
      <div class="srp-hero__shade" aria-hidden="true"></div>
      <div class="srp-hero__shade-front" aria-hidden="true"></div>
    </div>

    <div class="srp-hero__inner">
      <h1 class="srp-hero__title">{{ section.settings.heading | escape }}</h1>
      <p class="srp-hero__subtitle">{{ section.settings.subtitle | escape }}</p>
    </div>
  </div>

  <div class="srp-discovery">
    <div class="srp-search">
      <form action="{{ routes.search_url }}" method="get" role="search" class="srp-search__form">
        <input type="hidden" name="type" value="product">
        <svg
          class="srp-search__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          name="q"
          value="{{ display_terms | escape }}"
          placeholder="{{ 'search.search_placeholder' | t }}"
          class="srp-search__input"
          aria-label="{{ 'search.title' | t }}"
          autocomplete="off"
        >
        <button type="submit" class="srp-search__submit">
          <span>Search</span>
        </button>
      </form>
    </div>

    <nav class="srp-quick-links" aria-label="Search shortcuts">
      <a class="srp-quick-links__item" href="{{ routes.collections_url }}">
        <span class="srp-quick-links__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
              <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
              <path d="m6.08 9.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/>
              <path d="m6.08 14.5l-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"/>
            </g>
          </svg>
        </span>
        <span>Collections</span>
      </a>
      <a class="srp-quick-links__item" href="/collections/new-arrivals">
        <span class="srp-quick-links__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
              <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594zM20 2v4m2-2h-4"/>
              <circle cx="4" cy="20" r="2"/>
            </g>
          </svg>
        </span>
        <span>New Arrivals</span>
      </a>
      <a class="srp-quick-links__item" href="/collections/signature-pieces">
        <span class="srp-quick-links__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294zM5 21h14"/>
          </svg>
        </span>
        <span>Signature Pieces</span>
      </a>
    </nav>
  </div>

  {% if search.performed == false or search.terms == blank %}
    <div class="srp-state">
      <svg
        class="srp-state__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <h2 class="srp-state__heading">{{ 'search.initial_heading' | t }}</h2>
      <p class="srp-state__text">{{ 'search.initial_text' | t }}</p>
    </div>
  {% elsif search.results_count == 0 %}
    <div class="srp-state">
      <svg
        class="srp-state__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <h2 class="srp-state__heading">{{ 'search.no_results_heading' | t }}</h2>
      <p class="srp-state__text">{{ 'search.no_results_text_html' | t: terms: display_terms }}</p>
    </div>
  {% else %}
    <div class="srp-toolbar">
      <div class="srp-sort">
        <span class="srp-sort__label">{{ 'search.sort_label' | t }}</span>
        <div class="srp-sort__list" data-sort-pills>
          <a
            href="{{ search_base_url }}"
            data-sort="relevance"
            class="srp-sort__pill{% if current_sort == 'relevance' %} is-active{% endif %}"
          >
            {{- 'search.sort_relevance' | t -}}
          </a>
          <a
            href="{{ search_base_url }}&sort_by=price-ascending"
            data-sort="price-ascending"
            class="srp-sort__pill{% if current_sort == 'price-ascending' %} is-active{% endif %}"
          >
            {{- 'search.sort_price_low_high' | t -}}
          </a>
          <a
            href="{{ search_base_url }}&sort_by=price-descending"
            data-sort="price-descending"
            class="srp-sort__pill{% if current_sort == 'price-descending' %} is-active{% endif %}"
          >
            {{- 'search.sort_price_high_low' | t -}}
          </a>
        </div>
      </div>

      <div class="srp-meta">
        <span class="srp-meta__count">{{ 'search.results_count' | t: count: search.results_count }}</span>
        <div
          class="srp-view"
          data-view-toggle
          role="group"
          aria-label="{{ 'search.grid_view' | t }} / {{ 'search.list_view' | t }}"
        >
          <button
            type="button"
            class="srp-view__btn is-active"
            data-view="grid"
            aria-pressed="true"
            aria-label="{{ 'search.grid_view' | t }}"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
            </svg>
          </button>
          <button
            type="button"
            class="srp-view__btn"
            data-view="list"
            aria-pressed="false"
            aria-label="{{ 'search.list_view' | t }}"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="srp-grid-wrap">
      {% paginate search.results by per_page %}
        <div class="srp-grid" data-srp-grid>
          {% for result in search.results %}
            {% if result.object_type != 'product' %}
              {% continue %}
            {% endif %}
            {% liquid
              assign card_variant = result.selected_or_first_available_variant | default: result.variants.first
              assign artist = ''
              assign author = result.metafields.custom.author_info.value
              if author != blank and author.author_name.value != blank
                assign artist = author.author_name.value
              endif

              assign is_new = false
              for coll in result.collections
                if coll.handle == 'new-arrivals'
                  assign is_new = true
                  break
                endif
              endfor
            %}
            <article class="srp-card">
              <div class="srp-card__media-wrap">
                <a
                  class="srp-card__media"
                  href="{{ result.url }}"
                  aria-label="{{ result.title | escape }}"
                  data-hover-gallery
                >
                  {% if result.media.size > 0 %}
                    {% assign img_count = 0 %}
                    {% for media in result.media %}
                      {% if media.media_type == 'image' %}
                        {% assign img_class = 'srp-card__image' %}
                        {% if img_count == 0 %}{% assign img_class = 'srp-card__image is-active' %}{% endif %}
                        {% assign card_alt = media.alt | default: result.title %}
                        {{
                          media.preview_image
                          | image_url: width: 720
                          | image_tag:
                            class: img_class,
                            loading: 'lazy',
                            widths: '280, 420, 560, 720',
                            sizes: '(min-width: 1024px) 24vw, (min-width: 768px) 33vw, 90vw',
                            alt: card_alt
                        }}
                        {% assign img_count = img_count | plus: 1 %}
                        {% if img_count >= 5 %}{% break %}{% endif %}
                      {% endif %}
                    {% endfor %}
                  {% elsif result.featured_image %}
                    {{
                      result.featured_image
                      | image_url: width: 720
                      | image_tag:
                        class: 'srp-card__image is-active',
                        loading: 'lazy',
                        widths: '280, 420, 560, 720',
                        sizes: '(min-width: 1024px) 24vw, (min-width: 768px) 33vw, 90vw',
                        alt: result.featured_image.alt
                      | default: result.title
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'srp-card__image is-active placeholder-svg' }}
                  {% endif %}
                </a>

                {% render 'wishlist-card-button', product: result %}

                <button
                  type="button"
                  class="srp-card__add"
                  data-add-to-cart
                  data-variant-id="{{ card_variant.id }}"
                  aria-label="Add {{ result.title | escape }} to cart"
                  {% unless result.available %}
                    disabled aria-disabled="true"
                  {% endunless %}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="currentColor"
                    class="bi bi-cart-plus-fill"
                    viewBox="0 0 16 16"
                    aria-hidden="true"
                  >
                    <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0M9 5.5V7h1.5a.5.5 0 0 1 0 1H9v1.5a.5.5 0 0 1-1 0V8H6.5a.5.5 0 0 1 0-1H8V5.5a.5.5 0 0 1 1 0"/>
                  </svg>
                </button>

                {%- if is_new -%}
                  <span class="srp-card__badge srp-card__badge--new">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 36 36">
                      <path d="M0 0h36v36H0z" fill="none" />
                      <path fill="currentColor" d="m34.11 24.49l-3.92-6.62l3.88-6.35a1 1 0 0 0-.85-1.52H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h31.25a1 1 0 0 0 .86-1.51m-23.6-3.31H9.39l-3.26-4.34v4.35H5V15h1.13l3.27 4.35V15h1.12ZM16.84 16h-3.53v1.49h3.2v1h-3.2v1.61h3.53v1h-4.66V15h4.65Zm8.29 5.16H24l-1.55-4.59l-1.55 4.61h-1.12l-2-6.18H19l1.32 4.43L21.84 15h1.22l1.46 4.43L25.85 15h1.23Z" class="clr-i-solid clr-i-solid-path-1" />
                      <path fill="none" d="M0 0h36v36H0z" />
                    </svg>
                    <span class="srp-card__badge-text">New</span>
                  </span>
                {%- endif -%}
              </div>

              <div class="srp-card__info">
                <h2 class="srp-card__title">
                  <a class="srp-card__title-link" href="{{ result.url }}">
                    {{- result.title | split: ',' | first | split: ' - ' | first | strip | escape -}}
                  </a>
                </h2>

                <hr class="srp-card__divider">

                {% if artist != blank %}
                  <p class="srp-card__artist">Crafted By {{ artist | escape }}</p>
                {% endif %}

                <p class="srp-card__price">
                  <span style="font-weight: var(--font-weight-light);">From</span> {{ result.price | money }}
                </p>

                <div class="srp-card__badges-row">
                  <span class="srp-card__freeshipping">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24">
                      <path d="M0 0h24v24H0z" fill="none" />
                      <path fill="currentColor" d="M18 8h-2V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10h2a3 3 0 1 0 6 0h4a3 3 0 1 0 6 0h2v-5zM7 18.5a1.5 1.5 0 1 1 .001-3.001A1.5 1.5 0 0 1 7 18.5M4 14V7h10v7zm13 4.5a1.5 1.5 0 1 1 .001-3.001A1.5 1.5 0 0 1 17 18.5" />
                    </svg>
                    <span class="srp-card__freeshipping-text">Free Shipping</span>
                  </span>

                  <span class="srp-card__warranty">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24">
                      <path fill="currentColor" d="m10 17l-4-4l1.41-1.41L10 14.17l6.59-6.59L18 9m-6-8L3 5v6c0 5.55 3.84 10.74 9 12c5.16-1.26 9-6.45 9-12V5z" />
                    </svg>
                    <span class="srp-card__warranty-text">1-Year Warranty</span>
                  </span>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="srp-pagination" role="navigation" aria-label="Pagination">
            <div class="srp-pagination__inner">
              {% if paginate.previous %}
                <a
                  href="{{ paginate.previous.url }}"
                  class="srp-pagination__prev"
                  aria-label="{{ 'search.pagination_previous' | t }}"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                  <span>{{ 'search.pagination_previous' | t }}</span>
                </a>
              {% else %}
                <span class="srp-pagination__prev is-disabled">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                  <span>{{ 'search.pagination_previous' | t }}</span>
                </span>
              {% endif %}

              <div class="srp-pagination__sep"></div>

              <div class="srp-pagination__numbers">
                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <a href="{{ part.url }}" class="srp-pagination__num" aria-label="Page {{ part.title }}">
                      {{- part.title -}}
                    </a>
                  {% else %}
                    {% if part.title == paginate.current_page %}
                      <span class="srp-pagination__num is-current" aria-current="page">{{ part.title }}</span>
                    {% else %}
                      <span class="srp-pagination__num is-deco">{{ part.title }}</span>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>

              <div class="srp-pagination__sep"></div>

              {% if paginate.next %}
                <a
                  href="{{ paginate.next.url }}"
                  class="srp-pagination__next"
                  aria-label="{{ 'search.pagination_next' | t }}"
                >
                  <span>{{ 'search.pagination_next' | t }}</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              {% else %}
                <span class="srp-pagination__next is-disabled">
                  <span>{{ 'search.pagination_next' | t }}</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </span>
              {% endif %}
            </div>
          </nav>
        {% endif %}
      {% endpaginate %}
    </div>
  {% endif %}

  {% if popular_collection != blank and popular_collection.products.size > 0 %}
    <section class="srp-popular" aria-labelledby="SrpPopular-{{ section.id }}">
      <div class="divider"></div>

      <div class="srp-popular__head">
        <h2 id="SrpPopular-{{ section.id }}" class="srp-popular__title">Explore Popular Collection</h2>
      </div>

      <div
        class="srp-popular__grid srp-popular__grid--fixed"
      >
        {% for popular_product in popular_collection.products limit: 12 %}
          {% liquid
            assign artist = ''
            assign author = popular_product.metafields.custom.author_info.value
            if author != blank and author.author_name.value != blank
              assign artist = author.author_name.value
            endif

            assign material = popular_product.metafields.custom.product_material
            assign ptype = popular_product.type
            assign is_new = false
            for coll in popular_product.collections
              if coll.handle == 'new-arrivals'
                assign is_new = true
                break
              endif
            endfor
          %}
          <article class="srp-popular-card">
            <div class="srp-popular-card__media-wrap">
              <a
                class="srp-popular-card__media"
                href="{{ popular_product.url }}"
                aria-label="{{ popular_product.title | escape }}"
                data-hover-gallery
              >
                {% if popular_product.media.size > 0 %}
                  {% assign img_count = 0 %}
                  {% for media in popular_product.media %}
                    {% if media.media_type == 'image' %}
                      {% assign img_class = 'srp-popular-card__image' %}
                      {% if img_count == 0 %}{% assign img_class = 'srp-popular-card__image is-active' %}{% endif %}
                      {% assign card_alt = media.alt | default: popular_product.title %}
                      {{
                        media.preview_image
                        | image_url: width: 720
                        | image_tag:
                          class: img_class,
                          loading: 'lazy',
                          widths: '280, 420, 560, 720',
                          sizes: '(min-width: 1200px) 16vw, (min-width: 768px) 30vw, 78vw',
                          alt: card_alt
                      }}
                      {% assign img_count = img_count | plus: 1 %}
                      {% if img_count >= 5 %}{% break %}{% endif %}
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'srp-popular-card__image is-active placeholder-svg' }}
                {% endif %}
              </a>

              {% if is_new %}
                <span class="srp-card__badge srp-card__badge--new">
                  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 36 36">
                    <path d="M0 0h36v36H0z" fill="none" />
                    <path fill="currentColor" d="m34.11 24.49l-3.92-6.62l3.88-6.35a1 1 0 0 0-.85-1.52H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h31.25a1 1 0 0 0 .86-1.51m-23.6-3.31H9.39l-3.26-4.34v4.35H5V15h1.13l3.27 4.35V15h1.12ZM16.84 16h-3.53v1.49h3.2v1h-3.2v1.61h3.53v1h-4.66V15h4.65Zm8.29 5.16H24l-1.55-4.59l-1.55 4.61h-1.12l-2-6.18H19l1.32 4.43L21.84 15h1.22l1.46 4.43L25.85 15h1.23Z" class="clr-i-solid clr-i-solid-path-1" />
                    <path fill="none" d="M0 0h36v36H0z" />
                  </svg>
                  <span class="srp-card__badge-text">New</span>
                </span>
              {% endif %}

              {% render 'wishlist-card-button', product: popular_product %}

              {% assign popular_variant = popular_product.selected_or_first_available_variant | default: popular_product.variants.first %}
              <button
                type="button"
                class="srp-card__add"
                data-add-to-cart
                data-variant-id="{{ popular_variant.id }}"
                aria-label="Add {{ popular_product.title | escape }} to cart"
                {% unless popular_product.available %}
                  disabled aria-disabled="true"
                {% endunless %}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  fill="currentColor"
                  class="bi bi-cart-plus-fill"
                  viewBox="0 0 16 16"
                  aria-hidden="true"
                >
                  <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0M9 5.5V7h1.5a.5.5 0 0 1 0 1H9v1.5a.5.5 0 0 1-1 0V8H6.5a.5.5 0 0 1 0-1H8V5.5a.5.5 0 0 1 1 0"/>
                </svg>
              </button>
            </div>

            <div class="srp-popular-card__info">
              <h3 class="srp-popular-card__name">
                <a class="srp-popular-card__name-link" href="{{ popular_product.url }}">
                  {{- popular_product.title | split: ',' | first | split: ' - ' | first | strip | escape -}}
                </a>
              </h3>

              <hr class="srp-popular-card__divider">

              {% if artist != blank %}
                <p class="srp-popular-card__artist">Crafted By {{ artist | escape }}</p>
              {% endif %}

              <p class="srp-popular-card__price"><span style="font-weight: var(--font-weight-light);">From</span> {{ popular_product.price | money }}</p>

              <div class="srp-card__badges-row">
                <span class="srp-card__freeshipping">
                  <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <path fill="currentColor" d="M18 8h-2V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10h2a3 3 0 1 0 6 0h4a3 3 0 1 0 6 0h2v-5zM7 18.5a1.5 1.5 0 1 1 .001-3.001A1.5 1.5 0 0 1 7 18.5M4 14V7h10v7zm13 4.5a1.5 1.5 0 1 1 .001-3.001A1.5 1.5 0 0 1 17 18.5" />
                  </svg>
                  <span class="srp-card__freeshipping-text">Free Shipping</span>
                </span>

                <span class="srp-card__warranty">
                  <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24">
                    <path fill="currentColor" d="m10 17l-4-4l1.41-1.41L10 14.17l6.59-6.59L18 9m-6-8L3 5v6c0 5.55 3.84 10.74 9 12c5.16-1.26 9-6.45 9-12V5z" />
                  </svg>
                  <span class="srp-card__warranty-text">1-Year Warranty</span>
                </span>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</section>

{% stylesheet %}
  .srp {
    width: 100%;
    background-color: var(--color-cream);
    font-family: var(--font-body);
    color: var(--text-primary);
  }

  body:has(.srp-hero) .header__heading-logo {
    filter: brightness(0) invert(1);
  }

  body:has(.srp-hero) .header__heading-link,
  body:has(.srp-hero) .header__nav-item,
  body:has(.srp-hero) .header__icon,
  body:has(.srp-hero) .header__icon--search,
  body:has(.srp-hero) .header__icon--cart,
  body:has(.srp-hero) .header__icon--menu,
  body:has(.srp-hero) .header__icon--account,
  body:has(.srp-hero) .header__localization .loc-picker__code,
  body:has(.srp-hero) .header__localization .loc-picker__chevron {
    color: var(--color-cream) !important;
  }

  body:has(.srp-hero) .header__nav-item:hover,
  body:has(.srp-hero) .header__icon:hover {
    color: var(--color-stone);
  }

  body:has(.srp-hero) .header__consultation-link {
    border-color: color-mix(in srgb, var(--color-cream) 64%, transparent);
    background-color: transparent;
    color: var(--color-cream);
  }

  body:has(.srp-hero) .header__consultation-link:hover {
    background-color: var(--color-cream);
    color: var(--color-earth-brown);
  }

  /* Hero */
  .srp-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(calc(var(--sp-12) * 3), 50vh, calc(var(--sp-12) * 5));
    overflow: hidden;
    background-color: var(--color-cream);
  }
  .srp-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .srp-hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    display: block;
    position: relative;
    z-index: 0;
  }
  .srp-hero__shade,
  .srp-hero__shade-front {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .srp-hero__shade {
    z-index: 2;
    background-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.42) 28%,
      rgba(0, 0, 0, 0.28) 60%,
      rgba(0, 0, 0, 0.12) 100%
    );
  }
  .srp-hero__shade-front {
    z-index: 3;
    background-color: rgba(0, 0, 0, 0.1);
  }
  .srp-hero__inner {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    width: 100%;
    max-width: calc(var(--layout-hero-copy-width) - var(--sp-12));
    padding: var(--sp-7) var(--layout-padding-desktop) var(--sp-7) var(--sp-9);
  }
  .srp-hero__title {
    margin: 0;
    font-family: var(--font-display-light);
    font-size: clamp(var(--font-size-display-md), 3.2vw, var(--font-size-display-xl));
    font-weight: 500;
    line-height: var(--line-height-display);
    color: var(--color-cream);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
  }
  .srp-hero__subtitle {
    margin: 0;
    max-width: 48ch;
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-generous);
    color: rgba(247, 242, 236, 0.9);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5);
  }

  .srp-discovery {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
    width: min(calc(100% - (var(--layout-padding-desktop) * 2)), var(--layout-max-width));
    margin: calc(var(--sp-6) * -1) auto 0;
  }

  .srp-search {
    width: min(100%, calc(var(--layout-max-width) - var(--sp-12)));
  }
  .srp-search__form {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: var(--sp-8);
    padding: var(--sp-1);
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-lg);
    background-color: var(--surface-elevated);
    box-shadow: var(--shadow-elevation-1);
  }
  .srp-search__icon {
    flex: 0 0 auto;
    width: var(--sp-5);
    height: var(--sp-5);
    margin-left: var(--sp-5);
    color: var(--text-secondary);
    pointer-events: none;
  }
  .srp-search__input {
    width: 100%;
    min-width: 0;
    min-height: calc(var(--sp-7) + var(--sp-1));
    padding: 0 var(--sp-5);
    border: 0;
    background-color: transparent;
    outline: none;
    font-family: var(--font-body);
    font-size: var(--font-size-body-md);
    color: var(--text-primary);
  }
  .srp-search__input:focus {
    box-shadow: none;
  }
  .srp-search__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .srp-search__submit {
    flex: 0 0 auto;
    min-width: calc(var(--sp-12) - var(--sp-4));
    min-height: calc(var(--sp-7) + var(--sp-1));
    padding: 0 var(--sp-6);
    border: 0;
    border-radius: var(--radius-md);
    background-color: var(--color-earth-brown);
    color: var(--color-milk);
    font-family: var(--font-body);
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .srp-search__submit:hover {
    background-color: var(--color-brown-dark);
  }

  .srp-quick-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
    width: 100%;
  }
  .srp-quick-links__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    min-height: calc(var(--sp-7) - var(--sp-1));
    min-width: calc(var(--sp-12) + var(--sp-6));
    padding: 0 var(--sp-5);
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-md);
    background-color: var(--surface-elevated);
    color: var(--text-primary);
    text-decoration: none;
    font-size: var(--font-size-body-md);
    box-shadow: var(--shadow-elevation-1);
    transition: var(--transition-fast);
  }
  .srp-quick-links__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--sp-4);
    height: var(--sp-4);
    flex: 0 0 auto;
  }
  .srp-quick-links__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .srp-quick-links__item:hover {
    border-color: var(--color-earth-brown);
    color: var(--color-earth-brown);
  }

  /* Empty / no-results state */
  .srp-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    width: min(calc(100% - (var(--layout-padding-desktop) * 2)), calc(var(--layout-max-width) + var(--sp-12)));
    margin: var(--sp-5) auto 0;
    padding: var(--sp-6) var(--sp-5);
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--surface-elevated) 72%, transparent);
    text-align: center;
    color: var(--text-secondary);
  }
  .srp-state__icon {
    width: var(--sp-7);
    height: var(--sp-7);
    color: var(--text-tertiary);
    padding: var(--sp-2);
    border: var(--border-width) solid currentColor;
    border-radius: var(--radius-full);
  }
  .srp-state__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-display-sm);
    font-weight: var(--font-weight-regular);
    color: var(--text-primary);
  }
  .srp-state__text {
    margin: 0;
    max-width: 48ch;
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-generous);
  }

  .srp-popular {
    padding: var(--sp-6) 64px var(--section-spacing-desktop);
    margin: 0;
    margin-top: var(--sp-6);
  }
  .srp-popular__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }
  .srp-popular__title {
    margin: 0;
    font-family: var(--font-body);
    word-spacing: 0.2rem;
    font-size: var(--font-size-body-4xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--text-primary);
    text-align: center;
    width: 100%;
  }
  .srp-popular__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--text-primary);
    text-decoration: none;
    font-size: var(--font-size-body-sm);
    transition: var(--transition-fast);
  }
  .srp-popular__view-all:hover {
    color: var(--color-earth-brown);
  }
  .srp-popular__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-4);
  }
  .srp-popular__grid--fixed {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, calc((var(--sp-12) * 2) + var(--sp-5))), 1fr));
  }

  .srp-popular-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--sp-3);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background-color: var(--color-milk);
    box-shadow: var(--shadow-elevation-1);
  }
  .srp-popular-card__media-wrap {
    position: relative;
  }
  .srp-popular-card__media {
    position: relative;
    display: block;
    aspect-ratio: 6 / 5;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--bg-secondary);
  }
  .srp-popular-card__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: transform var(--timing-long) var(--ease-standard), opacity var(--timing-base) var(--ease-standard);
  }
  .srp-popular-card__image.is-prev,
  .srp-popular-card__image.is-active {
    opacity: 1;
  }
  .srp-popular-card__image.is-active {
    z-index: 2;
  }
  .srp-popular-card__media:hover .srp-popular-card__image {
    transform: scale(1.03);
  }
  .srp-popular-card__info {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--sp-5) var(--sp-0) var(--sp-2);
  }
  .srp-popular-card__name {
    margin: var(--sp-2) 0 0;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-body-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    color: var(--text-primary);
  }
  .srp-popular-card__name-link {
    display: -webkit-box;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.01em;
  }
  .srp-popular-card__divider {
    width: 20px;
    height: 2px;
    margin: var(--sp-4) 0 0;
    border: none;
    background-color: var(--color-orange);
  }
  .srp-popular-card__artist {
    margin: var(--sp-2) 0 0;
    color: var(--color-clay);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-normal);
  }
  .srp-popular-card__price {
    margin: var(--sp-2) 0 0;
    font-family: var(--font-body);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
  }
  .srp-popular-card__price span {
    font-weight: var(--font-weight-light);
  }

  /* Toolbar */
  .srp-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-4);
    padding: var(--sp-4) 64px;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    margin-top: var(--sp-4);
  }
  .srp-sort {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
  .srp-sort__label {
    font-family: var(--font-roboto);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .srp-sort__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .srp-sort__pill {
    display: inline-flex;
    align-items: center;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    background-color: var(--surface-elevated);
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-medium);
    color: var(--text-primary);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-fast);
  }
  .srp-sort__pill:hover {
    border-color: var(--color-earth-brown);
    color: var(--color-earth-brown);
  }
  .srp-sort__pill.is-active {
    background-color: var(--color-earth-brown);
    border-color: var(--color-earth-brown);
    color: var(--text-inverse);
  }
  .srp-sort__pill.is-active:hover {
    color: var(--text-inverse);
  }

  .srp-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .srp-meta__count {
    font-family: var(--font-roboto);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .srp-view {
    display: flex;
    align-items: center;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .srp-view__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    background-color: var(--surface-elevated);
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .srp-view__btn + .srp-view__btn {
    border-left: 1px solid var(--border-default);
  }
  .srp-view__btn svg {
    width: 16px;
    height: 16px;
  }
  .srp-view__btn.is-active {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }

  /* Grid */
  .srp-grid-wrap {
    padding: var(--sp-6) 64px var(--section-spacing-desktop);
  }
  .srp-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--sp-5);
    row-gap: var(--sp-7);
  }
  .srp-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--sp-3);
    background-color: var(--color-milk);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-elevation-1);
  }
  .srp-card__media-wrap {
    position: relative;
  }
  .srp-card__media {
    display: block;
    aspect-ratio: 6 / 5;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--bg-secondary);
    position: relative;
  }
  .srp-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    z-index: 0;
    transition: transform var(--timing-long) var(--ease-standard), opacity var(--timing-base) var(--ease-standard);
  }
  .srp-card__image.is-prev {
    opacity: 1;
    z-index: 1;
  }
  .srp-card__image.is-active {
    opacity: 1;
    z-index: 2;
  }
  .srp-card__media:hover .srp-card__image,
  .srp-card__media:hover img {
    transform: scale(1.03);
  }
  .srp-card__add {
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-3);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: var(--radius-full);
    background-color: var(--surface-elevated);
    color: var(--color-earth-brown);
    box-shadow: var(--shadow-elevation-2);
    cursor: pointer;
    transition: transform var(--timing-short) var(--ease-standard),
      background-color var(--timing-short) var(--ease-standard);
  }
  .srp-card__add svg {
    width: 18px;
    height: 18px;
  }
  .srp-card__add:hover {
    transform: translateY(-2px);
    background-color: var(--color-cream);
  }
  .srp-card__add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .srp-card__add.is-loading {
    pointer-events: none;
    opacity: 0.6;
  }

  .srp-card__badge {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    z-index: 3;
    display: flex;
    align-items: center;
    padding: 0 8px;
    border-radius: 99px;
    background: var(--color-milk, #fffdf9);
    color: var(--color-earth-brown, #4a2c18);
    font-family: var(--font-body);
    font-weight: var(--font-weight-bold);
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .srp-card__badge svg {
    display: flex;
    width: 24px;
    height: 24px;
    margin-right: 4px;
    fill: currentColor;
  }
  .srp-card__badge--best {
    min-height: 24px;
  }
  .srp-card__badge--best svg {
    width: 18px;
    height: 18px;
    color: var(--color-star-rating, #8a5d37);
  }

  .srp-card__info {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--sp-5) var(--sp-0) var(--sp-0);
  }
  .srp-card__title {
    margin: var(--sp-2) 0 0;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-body-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    color: var(--text-primary);
  }
  .srp-card__title-link,
  .srp-card__title a {
    color: inherit;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    letter-spacing: 0.01em;
  }
  .srp-card__artist {
    margin: var(--sp-2) 0 0;
    font-size: var(--font-size-body-sm);
    font-family: var(--font-body);
    color: var(--color-clay);
  }
  .srp-card__divider {
    width: 20px;
    height: 2px;
    margin: var(--sp-4) 0 0;
    border: none;
    background-color: var(--color-orange);
  }
  .srp-card__price {
    margin: var(--sp-1) 0 0;
    font-family: var(--font-body);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
  }

  .srp-card__badges-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }
  .srp-card__freeshipping,
  .srp-card__warranty {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 2px var(--sp-3);
    background-color: #f8e9cb;
    color: var(--color-earth-brown);
    white-space: nowrap;
  }
  .srp-card__freeshipping-text,
  .srp-card__warranty-text {
    font-size: var(--font-size-body-sm);
  }

  .srp-card .loox-rating,
  .srp-card [class*='rating' i],
  .srp-popular-card .loox-rating,
  .srp-popular-card [class*='rating' i] {
    display: none !important;
  }

  /* List view */
  .srp-grid.is-list {
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--sp-5);
  }
  .srp-grid.is-list .srp-card {
    flex-direction: row;
    gap: var(--sp-5);
    align-items: flex-start;
  }
  .srp-grid.is-list .srp-card__media-wrap {
    flex: 0 0 220px;
    width: 220px;
  }
  .srp-grid.is-list .srp-card__info {
    flex: 1 1 auto;
    padding-top: 0;
  }

  /* Pagination (same logic/markup pattern as the collection page) */
  .srp-pagination {
    margin-top: var(--sp-8);
    display: flex;
    justify-content: center;
  }
  .srp-pagination__inner {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    height: 52px;
    background-color: transparent;
  }
  .srp-pagination__prev,
  .srp-pagination__next {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0 var(--sp-5);
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-fast);
  }
  .srp-pagination__prev:not(.is-disabled):hover,
  .srp-pagination__next:not(.is-disabled):hover {
    color: var(--color-earth-brown);
  }
  .srp-pagination__prev svg,
  .srp-pagination__next svg {
    width: 14px;
    height: 14px;
  }
  .srp-pagination__prev.is-disabled,
  .srp-pagination__next.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .srp-pagination__sep {
    width: 1px;
    height: 24px;
    background-color: var(--border-default);
  }
  .srp-pagination__numbers {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0 var(--sp-4);
  }
  .srp-pagination__num {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 var(--sp-2);
    border-radius: var(--radius-lg);
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    text-decoration: none;
    border: 1px solid var(--border-default);
    background-color: transparent;
    transition: var(--transition-fast);
  }
  .srp-pagination__num:not(.is-current):not(.is-deco):hover {
    background-color: var(--bg-secondary);
  }
  .srp-pagination__num.is-current {
    background-color: var(--color-earth-brown);
    color: var(--color-milk);
    border-color: var(--color-earth-brown);
  }
  .srp-pagination__num.is-deco {
    border-color: transparent;
  }

  @media screen and (max-width: 1440px) {
    .srp-grid:not(.is-list) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 1084px) {
    .srp-grid:not(.is-list) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 1024px) {
    .srp-grid:not(.is-list) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .srp-popular__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .srp-grid.is-list .srp-card {
      flex-direction: column;
    }
    .srp-grid.is-list .srp-card__media-wrap {
      width: 100%;
    }
  }

  @media screen and (max-width: 900px) {
    .srp-hero__inner {
      width: 62%;
      padding-left: var(--layout-padding-tablet);
    }
  }

  @media screen and (max-width: 768px) {
    .srp-popular-card__new {
      display: none;
    }

    .srp-state {
      padding-block: var(--sp-6);
    }
    .srp-hero__title {
      text-align: left;
    }
    .srp-hero {
      min-height: 220px;
    }
    .srp-hero__inner {
      width: 100%;
      max-width: 100%;
      padding: var(--sp-10) var(--layout-padding-mobile) var(--sp-6);
      gap: var(--sp-2);
    }
    .srp-hero__subtitle {
      font-size: var(--font-size-body-sm);
    }
    .srp-discovery {
      width: calc(100% - (var(--layout-padding-mobile) * 2));
      margin-top: calc(var(--sp-5) * -1);
      gap: var(--sp-3);
    }
    .srp-search {
      width: 100%;
    }
    .srp-search__form {
      min-height: auto;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      padding: var(--sp-2);
    }
    .srp-search__icon {
      align-self: center;
      margin-left: var(--sp-3);
    }
    .srp-search__input {
      min-height: var(--sp-7);
      padding-inline: var(--sp-3);
      font-size: var(--font-size-body-lg);
    }
    .srp-search__submit {
      grid-column: 1 / -1;
      width: 100%;
      margin-top: var(--sp-2);
      min-height: 38px;
    }
    .srp-quick-links {
      justify-content: flex-start;
      flex-wrap: nowrap;
      gap: var(--sp-3);
      overflow-x: auto;
      padding-bottom: var(--sp-1);
      scrollbar-width: none;
    }
    .srp-quick-links::-webkit-scrollbar {
      display: none;
    }
    .srp-quick-links__item {
      flex: 0 0 auto;
      min-width: auto;
      min-height: var(--sp-7);
      padding-inline: var(--sp-4);
      font-size: var(--font-size-body-sm);
    }
    .srp-state,
    .srp-popular {
      width: 100%;
    }
    .srp-state {
      margin-top: var(--sp-4);
    }
    .srp-toolbar {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--sp-4) var(--layout-padding-mobile);
    }
    .srp-meta {
      width: 100%;
      justify-content: space-between;
    }
    .srp-grid-wrap {
      padding: var(--sp-5) calc(var(--layout-padding-mobile) - 6px) var(--section-spacing-tablet);
    }
    .srp-grid {
      column-gap: var(--sp-4);
      row-gap: var(--sp-6);
    }
    .srp-popular {
      margin-bottom: var(--section-spacing-mobile);
      margin-top: var(--sp-4);
      border-top: 1px solid var(--border-light);
      padding: var(--sp-4) calc(var(--layout-padding-mobile) - 6px) var(--section-spacing-mobile);
    }
    .srp-popular__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-3);
    }
    .srp-popular-card {
      padding: var(--sp-2);
    }
    .srp-popular-card__name {
      font-size: var(--font-size-body-md);
    }
    .srp-popular-card__artist,
    .srp-popular-card__material {
      display: none;
    }
    .srp-popular__title {
      text-align: center;
      width: 100%;
      font-size: var(--font-size-body-lg);
    }
    .srp .srp-popular__head,
    .srp .srp-popular__grid--fixed {
      position: relative;
      left: 50%;
      width: auto;
      min-width: calc(100vw - (var(--layout-padding-mobile) * 2));
      transform: translateX(-50%);
    }
    .srp .srp-popular__grid--fixed {
      grid-template-columns: 1fr;
      margin-inline: 0;
      padding-inline: 0;
      overflow-x: visible;
      scroll-snap-type: none;
    }
    .srp .srp-popular-card {
      width: 100%;
      min-width: 0;
      max-width: 100%;
      flex: initial;
      scroll-snap-align: initial;
    }
    .srp-popular__view-all {
      width: 100%;
      justify-content: flex-end;
    }
  }

  @media screen and (max-width: 480px) {
    .srp-grid,
    .srp-grid:not(.is-list) {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
    .srp-grid.is-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .srp-sort__list {
      gap: var(--sp-2);
      place-content: center;
    }
    .srp-hero__title {
      font-size: var(--font-size-display-sm);
      text-align: center;
    }
    .srp-hero__subtitle {
      text-align: center;
    }
    .srp-popular__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .srp-pagination {
      margin-top: var(--sp-6);
    }
    .srp-pagination__inner {
      border-radius: 0;
    }
    .srp-card__info,
    .srp-popular-card__info {
      padding-top: var(--sp-3);
    }
    .srp-card__title,
    .srp-popular-card__name {
      margin: var(--sp-2) 0 0;
      font-size: var(--font-size-body-md);
    }
    .srp-card__price,
    .srp-popular-card__price {
      margin: var(--sp-1) 0 0;
      font-size: var(--font-size-body-md);
    }
    .srp-card__artist {
      font-size: var(--font-size-body-sm);
    }
    .srp-card__add {
      width: 40px;
      height: 40px;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    function normalizeSearchQuery(raw) {
      if (window.wrydecoNormalizeSearchQuery) return window.wrydecoNormalizeSearchQuery(raw);
      return String(raw || '')
        .trim()
        .split(/\s+/)
        .filter(Boolean)
        .map(function (token) {
          return token.charAt(token.length - 1) === '*' ? token : token + '*';
        })
        .join(' ');
    }

    function initSearchPage() {
      // Rewrite the query to prefix-match form (`console table` -> `console* table*`)
      // on submit, so this page uses the same matching as the popup dropdown.
      document.querySelectorAll('.srp-search__form').forEach(function (form) {
        if (form.dataset.normInit === 'true') return;
        form.dataset.normInit = 'true';
        form.addEventListener('submit', function (e) {
          var input = form.querySelector('input[name="q"]');
          if (!input) return;
          var norm = normalizeSearchQuery(input.value);
          if (!norm) return; // empty query: let the browser submit as-is
          e.preventDefault();
          var params = new URLSearchParams();
          params.set('q', norm);
          params.set('type', 'product');
          window.location.assign('/search?' + params.toString());
        });
      });

      // Wishlist (Wishlist by Square / Vtl app): ask the app to (re)render the
      // heart icons into the card wrappers, and re-render on click. The app only
      // hydrates over HTTPS.
      function requestWishlistRender() {
        document.dispatchEvent(new CustomEvent('vitals:ProductCardsDetected'));
        document.dispatchEvent(new CustomEvent('vitals:RenderWishlistIcons'));
        window.dispatchEvent(new CustomEvent('vitals:ProductCardsDetected'));
        window.dispatchEvent(new CustomEvent('vitals:RenderWishlistIcons'));
      }
      document.querySelectorAll('[data-card-wishlist]').forEach(function (btn) {
        if (btn.dataset.init === 'true') return;
        btn.dataset.init = 'true';
        btn.addEventListener('click', function () {
          requestWishlistRender();
        });
      });
      requestWishlistRender();

      function updateCartBubble() {
        fetch(window.Shopify.routes.root + 'cart.js')
          .then(function (res) {
            return res.json();
          })
          .then(function (cart) {
            var cartIcon = document.querySelector('.header__icon--cart');
            if (!cartIcon) return;
            var bubble = cartIcon.querySelector('.cart-count-bubble');
            if (cart.item_count > 0) {
              if (!bubble) {
                bubble = document.createElement('div');
                bubble.className = 'cart-count-bubble';
                bubble.innerHTML = '<span></span>';
                cartIcon.appendChild(bubble);
              }
              bubble.querySelector('span').textContent = cart.item_count;
            } else if (bubble) {
              bubble.remove();
            }
          });
      }

      document.querySelectorAll('[data-add-to-cart]').forEach(function (btn) {
        if (btn.dataset.init === 'true') return;
        btn.dataset.init = 'true';
        btn.addEventListener('click', function () {
          if (btn.disabled || btn.classList.contains('is-loading')) return;
          var variantId = btn.dataset.variantId;
          if (!variantId) return;

          btn.classList.add('is-loading');
          fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/javascript' },
            body: JSON.stringify({ id: variantId, quantity: 1 }),
          })
            .then(function (res) {
              return res.json();
            })
            .then(function (data) {
              if (data.status) {
                throw new Error(data.description || 'Could not add to cart');
              }
              if (window.showToast) {
                window.showToast({ message: 'Item added to your cart.', type: 'success', position: 'bottom-left' });
              }
              updateCartBubble();
              document.dispatchEvent(new CustomEvent('cart:updated', { detail: { open: true } }));
            })
            .catch(function (err) {
              if (window.showToast) {
                window.showToast({ message: err.message, type: 'error', position: 'bottom-left' });
              }
            })
            .finally(function () {
              btn.classList.remove('is-loading');
            });
        });
      });

      document.querySelectorAll('[data-hover-gallery]').forEach(function (gallery) {
        if (gallery.dataset.initHover === 'true') return;
        gallery.dataset.initHover = 'true';

        var images = gallery.querySelectorAll('.srp-card__image, .srp-popular-card__image');
        if (images.length <= 1) return;

        var intervalId = null;
        var currentIndex = 0;

        function showImage(index) {
          images.forEach(function (img) {
            img.classList.remove('is-prev');
            if (img.classList.contains('is-active')) {
              img.classList.remove('is-active');
              img.classList.add('is-prev');
            }
          });
          images[index].classList.add('is-active');
        }

        gallery.addEventListener('mouseenter', function () {
          currentIndex = 1;
          showImage(currentIndex);

          intervalId = setInterval(function () {
            currentIndex = (currentIndex + 1) % images.length;
            showImage(currentIndex);
          }, 2000);
        });

        gallery.addEventListener('mouseleave', function () {
          clearInterval(intervalId);
          currentIndex = 0;
          showImage(0);
        });
      });

      document.querySelectorAll('[data-view-toggle]').forEach(function (toggle) {
        if (toggle.dataset.init === 'true') return;
        toggle.dataset.init = 'true';

        var grid = toggle.closest('.srp').querySelector('[data-srp-grid]');
        if (!grid) return;
        var buttons = toggle.querySelectorAll('[data-view]');

        function setView(view) {
          grid.classList.toggle('is-list', view === 'list');
          buttons.forEach(function (btn) {
            var active = btn.dataset.view === view;
            btn.classList.toggle('is-active', active);
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          try {
            window.localStorage.setItem('srpView', view);
          } catch (e) {}
        }

        var stored = null;
        try {
          stored = window.localStorage.getItem('srpView');
        } catch (e) {}
        if (stored === 'list') setView('list');

        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            setView(btn.dataset.view);
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearchPage);
    } else {
      initSearchPage();
    }
  })();
</script>

