<div class="about-new" id="about-new-{{ section.id }}">
  <section class="about-new-hero" aria-labelledby="about-new-title-{{ section.id }}">
    <div class="about-new-hero__media">
      <img
        src="{{ 'about-us-M-1.png' | file_url }}"
        width="1672"
        height="941"
        alt="{{ section.settings.hero_image_alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    </div>

    <div class="about-new-hero__inner">
      <div class="about-new-hero__copy">
        <p class="about-new__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        <h1 id="about-new-title-{{ section.id }}">{{ section.settings.hero_heading | escape }}</h1>
        <p class="about-new-hero__tagline">{{ section.settings.hero_tagline | escape }}</p>
        <div class="about-new-hero__text rte">{{ section.settings.hero_text }}</div>
      </div>
    </div>
  </section>

  <section class="about-new-story" aria-labelledby="about-new-story-title-{{ section.id }}">
    <div class="about-new-story__inner">
      <div class="about-new-story__content">
        <header class="about-new-story__header">
          <p class="about-new__eyebrow">{{ section.settings.story_eyebrow | escape }}</p>
          <span class="about-new-story__eyebrow-rule" aria-hidden="true"></span>
          <h2 id="about-new-story-title-{{ section.id }}">
            <span>{{ section.settings.story_heading_first_line | escape }}</span>
            <span>{{ section.settings.story_heading_second_line | escape }}</span>
          </h2>
          <div class="about-new-story__intro rte">{{ section.settings.story_intro }}</div>
        </header>

        <div class="about-new-story__divider" aria-hidden="true">
          <span></span>
          <span class="about-new-story__divider-icon">
            {%- render 'about-craft-icon', icon: 'story-ornament' -%}
          </span>
          <span></span>
        </div>

        <div class="about-new-story__insight">
          <span class="about-new-story__insight-icon" aria-hidden="true">
            {%- render 'about-craft-icon', icon: 'story-leaf' -%}
          </span>
          <div class="about-new-story__insight-copy">
            <div class="rte">{{ section.settings.story_statement_one }}</div>
            <div class="rte">{{ section.settings.story_statement_two }}</div>
          </div>
        </div>
      </div>

      <div class="about-new-story__media">
        <img
          src="{{ 'about-us-M-2.png' | file_url }}"
          width="884"
          height="941"
          alt="{{ section.settings.story_image_alt | escape }}"
          loading="lazy"
        >
      </div>
    </div>
  </section>

  <section class="about-new-purpose" aria-labelledby="about-new-purpose-title-{{ section.id }}">
    <div class="about-new-purpose__inner">
      <div class="about-new-purpose__media">
        <img
          src="{{ 'about-us-M-3.png' | file_url }}"
          width="1028"
          height="941"
          alt="{{ section.settings.purpose_image_alt | escape }}"
          loading="lazy"
        >
      </div>

      <div class="about-new-purpose__content">
        <div class="about-new-purpose__copy">
          <header class="about-new-purpose__header">
            <p class="about-new__eyebrow">{{ section.settings.purpose_eyebrow | escape }}</p>
            <span class="about-new-purpose__eyebrow-rule" aria-hidden="true"></span>
            <h2 id="about-new-purpose-title-{{ section.id }}">
              <span>{{ section.settings.purpose_heading_first_line | escape }}</span>
              <span>{{ section.settings.purpose_heading_second_line | escape }}</span>
            </h2>
          </header>

          <div class="about-new-purpose__divider" aria-hidden="true">
            <span></span>
            <span class="about-new-purpose__divider-icon">
              {%- render 'about-craft-icon', icon: 'story-leaf' -%}
            </span>
            <span></span>
          </div>

          <div class="about-new-purpose__statements">
            <div class="about-new-purpose__statement">
              <span class="about-new-purpose__statement-icon" aria-hidden="true">
                {%- render 'about-craft-icon', icon: 'purpose-wood' -%}
              </span>
              <div class="rte">{{ section.settings.purpose_statement_one }}</div>
            </div>
            <div class="about-new-purpose__statement">
              <span class="about-new-purpose__statement-icon" aria-hidden="true">
                {%- render 'about-craft-icon', icon: 'purpose-craft' -%}
              </span>
              <div class="rte">{{ section.settings.purpose_statement_two }}</div>
            </div>
          </div>

          <footer class="about-new-purpose__signature">
            <span>{{ section.settings.purpose_signature | escape }}</span>
          </footer>
        </div>
      </div>
    </div>
  </section>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": {{ section.settings.hero_heading | append: ' — ' | append: section.settings.hero_tagline | json }},
    "description": {{ section.settings.hero_text | strip_html | strip | json }},
    "url": {{ canonical_url | json }}
  }
</script>

{% stylesheet %}
  body:has(.about-new) .header__icon--search,
  body:has(.about-new) .header__icon--cart,
  body:has(.about-new) .header__icon--menu,
  body:has(.about-new) .header__icon--account,
  body:has(.about-new) .header__nav-item,
  body:has(.about-new) .header__localization .loc-picker__code,
  body:has(.about-new) .header__localization .loc-picker__chevron {
    color: var(--text-inverse);
  }
  body:has(.about-new) .header__heading-logo {
    filter: brightness(var(--blog-header-logo-brightness)) invert(var(--blog-header-logo-invert));
  }
  body:has(.about-new) .loc-picker__option .loc-picker__code {
    color: var(--color-earth-brown) !important;
  }

  .about-new {
    --about-new-max-width: var(--layout-showcase-max-width);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
  }

  .about-new__eyebrow {
    margin: var(--sp-0) var(--sp-0) var(--sp-3);
    color: var(--color-earth-brown);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 4);
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .about-new-hero {
    position: relative;
    display: grid;
    min-block-size: var(--layout-hero-wide-height);
    block-size: 100svh;
    overflow: hidden;
    background: var(--color-ebony);
  }

  .about-new-hero__media {
    position: absolute;
    inset: var(--sp-0);
  }

  .about-new-hero__media::after {
    position: absolute;
    inset: var(--sp-0);
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-ebony) 18%, transparent),
        color-mix(in srgb, var(--color-ebony) 34%, transparent)
      ),
      color-mix(in srgb, var(--color-ebony) 20%, transparent);
    content: '';
  }

  .about-new-hero__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-new-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    inline-size: min(calc(100% - (var(--sp-8) * 2)), var(--about-new-max-width));
    margin-inline: auto;
    padding-block: calc(var(--sp-12) + var(--sp-8)) var(--sp-8);
  }

  .about-new-hero__copy {
    inline-size: min(100%, calc(var(--layout-hero-copy-width) + (var(--sp-12) * 2)));
    text-align: center;
  }

  .about-new-hero h1,
  .about-new-story h2,
  .about-new-purpose h2 {
    color: var(--color-ebony);
    font-family: var(--font-display-light);
    font-weight: var(--font-weight-light);
  }

  .about-new-hero h1 {
    margin: var(--sp-0);
    color: var(--text-inverse);
    font-size: clamp(
      var(--font-size-display-2xl),
      calc(var(--font-size-display-2xl) + 2.5vw),
      calc(var(--font-size-display-2xl) * 1.6)
    );
    letter-spacing: var(--letter-spacing-snug);
    line-height: var(--line-height-display);
    text-shadow: var(--blog-hero-text-shadow);
  }

  .about-new-story h2 span {
    display: block;
  }

  .about-new-hero .about-new__eyebrow {
    margin-block-end: var(--sp-5);
    color: var(--color-linen);
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-regular);
    letter-spacing: calc(var(--letter-spacing-wide) * 8);
    text-shadow: var(--blog-hero-text-shadow);
  }

  .about-new-hero__tagline {
    margin: var(--sp-2) var(--sp-0) var(--sp-0);
    color: var(--text-inverse);
    font-family: var(--font-display-light);
    font-size: clamp(var(--font-size-display-sm), 3vw, var(--font-size-display-lg));
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-snug);
    line-height: var(--line-height-tight);
    text-shadow: var(--blog-hero-text-shadow);
  }

  .about-new-hero__text {
    max-inline-size: 76ch;
    margin: var(--sp-4) auto var(--sp-0);
    color: var(--color-linen);
    font-size: var(--font-size-body-xl);
    line-height: var(--line-height-relaxed);
    text-shadow: var(--blog-hero-text-shadow);
  }

  .about-new-hero__text p,
  .about-new-story__intro p,
  .about-new-story__insight-copy p,
  .about-new-purpose__statement p {
    margin: var(--sp-0);
  }

  .about-new-story {
    min-block-size: var(--layout-hero-wide-height);
    border-block-end: var(--border-width) solid var(--border-light);
    background: var(--bg-primary);
  }

  .about-new-story__inner {
    display: grid;
    grid-template-columns: minmax(0, 47%) minmax(0, 53%);
    min-block-size: inherit;
    inline-size: 100%;
    margin-inline: auto;
  }

  .about-new-story__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: calc(var(--sp-10) + var(--sp-4)) calc(var(--sp-10) - var(--sp-4));
    padding-inline: calc(var(--sp-12) - var(--sp-5)) var(--sp-8);
  }

  .about-new-story__header .about-new__eyebrow {
    margin-block-end: var(--sp-5);
    font-size: var(--font-size-body-md);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 8);
  }

  .about-new-story__eyebrow-rule {
    display: block;
    inline-size: calc(var(--sp-7) + var(--sp-1));
    block-size: var(--border-width);
    margin-block-end: var(--sp-6);
    background: var(--color-bark);
  }

  .about-new-story h2 {
    margin: var(--sp-0);
    font-size: clamp(var(--font-size-display-lg), 3.25vw, var(--font-size-display-xl));
    letter-spacing: var(--letter-spacing-snug);
    line-height: var(--line-height-tight);
  }

  .about-new-story h2 span {
    display: block;
  }

  .about-new-story__intro {
    max-inline-size: 50ch;
    margin-block-start: var(--sp-6);
    color: var(--color-charcoal);
    font-size: var(--font-size-body-xl);
    line-height: var(--line-height-relaxed);
  }

  .about-new-story__divider {
    display: grid;
    grid-template-columns: minmax(var(--sp-8), 1fr) auto minmax(var(--sp-8), 1fr);
    align-items: center;
    gap: var(--sp-4);
    inline-size: calc(100% - (var(--sp-11) + var(--sp-5)));
    margin-block: var(--sp-8);
    color: var(--color-clay);
  }

  .about-new-story__divider > span:not(.about-new-story__divider-icon) {
    block-size: var(--border-width);
    background: currentColor;
    opacity: var(--cart-drawer-overlay-opacity);
  }

  .about-new-story__divider-icon {
    display: inline-flex;
    inline-size: var(--sp-6);
    block-size: var(--sp-6);
  }

  .about-new-story__divider-icon svg,
  .about-new-story__insight-icon svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .about-new-story__insight {
    display: grid;
    grid-template-columns: var(--sp-7) minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-5);
  }

  .about-new-story__insight-icon {
    display: inline-flex;
    inline-size: var(--sp-7);
    block-size: calc(var(--sp-7) * 2);
    color: var(--color-clay);
    transform: rotate(-45deg);
  }

  .about-new-story__insight-copy {
    display: grid;
    gap: var(--sp-5);
    max-inline-size: calc(var(--layout-hero-copy-width) - (var(--sp-12) * 2) - var(--sp-8));
    color: var(--color-ebony);
    font-family: var(--font-display-light);
    font-size: var(--font-size-body-4xl);
    line-height: var(--line-height-normal);
  }

  .about-new-story__media {
    min-block-size: inherit;
    overflow: hidden;
  }

  .about-new-story__media img,
  .about-new-purpose__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .about-new-purpose {
    min-block-size: var(--layout-hero-wide-height);
    background: var(--color-cream);
    color: var(--color-ebony);
  }

  .about-new-purpose__inner {
    display: grid;
    grid-template-columns: minmax(0, 47%) minmax(0, 53%);
    min-block-size: inherit;
  }

  .about-new-purpose__content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-9) var(--sp-8);
  }

  .about-new-purpose__copy {
    inline-size: min(100%, calc(var(--layout-hero-copy-width) - (var(--sp-12) * 2)));
  }

  .about-new-purpose__header .about-new__eyebrow {
    margin-block-end: var(--sp-6);
    color: var(--color-ebony);
    font-size: var(--font-size-body-md);
    letter-spacing: calc(var(--letter-spacing-wide) * 8);
  }

  .about-new-purpose__eyebrow-rule {
    display: block;
    inline-size: calc(var(--sp-7) + var(--sp-1));
    block-size: var(--border-width);
    margin-block-end: var(--sp-6);
    background: var(--color-ebony);
  }

  .about-new-purpose h2 {
    margin: var(--sp-0);
    font-size: clamp(var(--font-size-display-lg), 4vw, var(--font-size-display-xl));
    letter-spacing: var(--letter-spacing-snug);
    line-height: var(--line-height-tight);
  }

  .about-new-purpose h2 span {
    display: block;
  }

  .about-new-purpose__divider {
    display: grid;
    grid-template-columns: minmax(var(--sp-8), 1fr) auto minmax(var(--sp-8), 1fr);
    align-items: center;
    gap: var(--sp-4);
    margin-block: var(--sp-6);
  }

  .about-new-purpose__divider > span:not(.about-new-purpose__divider-icon) {
    block-size: var(--border-width);
    background: currentColor;
    opacity: var(--cart-drawer-overlay-opacity);
  }

  .about-new-purpose__divider-icon {
    display: inline-flex;
    inline-size: var(--sp-6);
    block-size: var(--sp-6);
    transform: rotate(-45deg);
  }

  .about-new-purpose__divider-icon svg,
  .about-new-purpose__statement-icon svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .about-new-purpose__statements {
    display: grid;
    gap: var(--sp-6);
  }

  .about-new-purpose__statement {
    display: grid;
    grid-template-columns: var(--sp-8) minmax(0, 1fr);
    align-items: start;
    gap: var(--sp-5);
  }

  .about-new-purpose__statement-icon {
    display: inline-flex;
    inline-size: var(--sp-8);
    block-size: var(--sp-8);
  }

  .about-new-purpose__statement .rte {
    font-family: var(--font-display-light);
    font-size: var(--font-size-body-2xl);
    line-height: var(--line-height-normal);
  }

  .about-new-purpose__signature {
    margin-block-start: var(--sp-6);
    padding-block-start: var(--sp-4);
    border-block-start: var(--border-width) solid var(--border-dark);
  }

  .about-new-purpose__signature span {
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 6);
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .about-new-purpose__media {
    min-block-size: inherit;
    overflow: hidden;
  }

  @media screen and (max-width: 75rem) {
    .about-new-hero__inner {
      inline-size: min(calc(100% - (var(--layout-padding-desktop) * 2)), var(--about-new-max-width));
    }

    .about-new-story__content {
      padding-inline: var(--sp-8);
    }

    .about-new-purpose__content {
      padding-inline: var(--sp-6);
    }
  }

  @media screen and (max-width: 64rem) {
    .about-new-story__inner,
    .about-new-purpose__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-new-story__media {
      aspect-ratio: 16 / 10;
      min-block-size: auto;
    }

    .about-new-story__content {
      padding: var(--sp-9) var(--layout-padding-tablet);
    }

    .about-new-purpose__content {
      padding: var(--sp-9) var(--layout-padding-tablet);
    }

    .about-new-purpose__copy {
      inline-size: min(100%, var(--layout-hero-copy-width));
    }

    .about-new-purpose__media {
      aspect-ratio: 16 / 10;
      min-block-size: auto;
    }
  }

  @media screen and (max-width: 48rem) {
    .about-new-hero {
      min-block-size: calc(var(--sp-12) * 5);
      block-size: 100svh;
    }

    .about-new-hero__media::after {
      background:
        linear-gradient(
          to bottom,
          color-mix(in srgb, var(--color-ebony) 26%, transparent),
          color-mix(in srgb, var(--color-ebony) 48%, transparent)
        ),
        color-mix(in srgb, var(--color-ebony) 28%, transparent);
    }

    .about-new-hero__media img {
      object-position: center;
    }

    .about-new-hero__inner {
      inline-size: min(calc(100% - (var(--layout-padding-mobile) * 2)), var(--about-new-max-width));
    }

    .about-new-hero__inner {
      align-items: center;
      padding-block: var(--sp-10) var(--sp-6);
    }

    .about-new-hero__copy {
      inline-size: 100%;
    }

    .about-new-story h2,
    .about-new-purpose h2 {
      font-size: var(--font-size-display-md);
    }

    .about-new-hero h1 {
      font-size: var(--font-size-display-xl);
    }

    .about-new-hero .about-new__eyebrow {
      margin-block-end: var(--sp-4);
      font-size: var(--font-size-caption);
      letter-spacing: calc(var(--letter-spacing-wide) * 6);
    }

    .about-new-hero__tagline {
      margin-block-start: var(--sp-3);
      font-size: var(--font-size-display-sm);
      line-height: var(--line-height-snug);
    }

    .about-new-hero__text {
      max-inline-size: 36ch;
      margin-block-start: var(--sp-4);
      font-size: var(--font-size-body-sm);
    }

    .about-new-story__media {
      aspect-ratio: 4 / 5;
    }

    .about-new-story__content {
      padding: var(--sp-7) var(--layout-padding-mobile);
    }

    .about-new-story__header .about-new__eyebrow {
      margin-block-end: var(--sp-4);
      font-size: var(--font-size-caption);
      letter-spacing: calc(var(--letter-spacing-wide) * 6);
    }

    .about-new-story__eyebrow-rule {
      margin-block-end: var(--sp-5);
    }

    .about-new-story h2 {
      font-size: var(--font-size-display-md);
    }

    .about-new-story__intro {
      margin-block-start: var(--sp-5);
      font-size: var(--font-size-body-md);
    }

    .about-new-story__divider {
      margin-block: var(--sp-7);
    }

    .about-new-story__insight {
      grid-template-columns: var(--sp-6) minmax(0, 1fr);
      align-items: start;
      gap: var(--sp-4);
    }

    .about-new-story__insight-icon {
      inline-size: var(--sp-6);
      block-size: var(--sp-8);
    }

    .about-new-story__insight-copy {
      font-size: var(--font-size-body-lg);
    }

    .about-new-purpose__content {
      padding: var(--sp-7) var(--layout-padding-mobile);
    }

    .about-new-purpose__header .about-new__eyebrow {
      margin-block-end: var(--sp-4);
      font-size: var(--font-size-caption);
      letter-spacing: calc(var(--letter-spacing-wide) * 6);
    }

    .about-new-purpose__eyebrow-rule {
      margin-block-end: var(--sp-5);
    }

    .about-new-purpose__divider {
      margin-block: var(--sp-6);
    }

    .about-new-purpose__statements {
      gap: var(--sp-6);
    }

    .about-new-purpose__statement {
      grid-template-columns: var(--sp-7) minmax(0, 1fr);
      gap: var(--sp-4);
    }

    .about-new-purpose__statement-icon {
      inline-size: var(--sp-7);
      block-size: var(--sp-7);
    }

    .about-new-purpose__statement .rte {
      font-size: var(--font-size-body-lg);
    }

    .about-new-purpose__signature {
      margin-block-start: var(--sp-6);
    }

    .about-new-purpose__media {
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main About page",
  "tag": "section",
  "class": "section-main-about-page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "WRYDECO" },
    {
      "type": "text",
      "id": "hero_tagline",
      "label": "Tagline",
      "default": "Where Nature Becomes Functional Art."
    },
    {
      "type": "richtext",
