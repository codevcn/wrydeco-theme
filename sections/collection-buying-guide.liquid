{% comment %}
  Collection Buying Guide / SEO Content Section
  Ultra-clean architecture: Renders full semantic HTML directly from collection.metafields.custom.buying_guide.
  Adheres strictly to Wrydeco Luxury Woodcraft Design System.
{% endcomment %}

{%- if section.settings.enable_guide and collection.metafields.custom.buying_guide.value != blank -%}
  <section
    class="col-guide"
    id="CollectionGuide-{{ section.id }}"
    aria-labelledby="CollectionGuideHeading"
    style="--guide-bg: {{ section.settings.bg_color }};"
  >
    <div class="col-guide__inner page-width">
      {{ collection.metafields.custom.buying_guide.value }}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .col-guide {
    display: block;
    width: 100%;
    background-color: var(--guide-bg, #fbf9f5);
    padding-block: clamp(48px, 6vw, 84px);
    color: var(--text-primary, #2b231d);
    font-family: var(--font-body, system-ui, sans-serif);
    border-top: 1px solid rgba(130, 94, 56, 0.12);
  }

  .col-guide__inner {
    max-width: var(--page-width, 1320px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 40px);
  }

  .col-guide__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 4vw, 56px);
  }

  @media (min-width: 990px) {
    .col-guide__layout {
      grid-template-columns: 340px 1fr;
      align-items: start;
    }
  }

  /* Sidebar */
  .col-guide__sidebar {
    position: relative;
  }

  @media (min-width: 990px) {
    .col-guide__sidebar-sticky {
      position: sticky;
      top: 100px;
    }
  }

  .col-guide__badge-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .col-guide__badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8c6843;
  }

  .col-guide__badge-line {
    flex: 1;
    height: 1px;
    background-color: rgba(140, 104, 67, 0.25);
  }

  .col-guide__title {
    font-family: var(--font-heading, 'Playfair Display', Georgia, serif);
    font-size: clamp(1.45rem, 2.2vw, 1.85rem);
    font-weight: 600;
    line-height: 1.28;
    color: #1f1813;
    margin: 0 0 24px 0;
  }

  /* Curation Card */
  .col-guide__card {
    background-color: #ffffff;
    border: 1px solid rgba(140, 104, 67, 0.18);
    border-radius: 8px;
    padding: 24px 20px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }

  .col-guide__card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid rgba(140, 104, 67, 0.12);
  }

  .col-guide__card-icon {
    color: #8c6843;
    flex-shrink: 0;
  }

  .col-guide__card-title {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #2b231d;
    margin: 0;
  }

  .col-guide__card-list {
    margin: 0 0 20px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .col-guide__card-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .col-guide__card-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c6843;
  }

  .col-guide__card-val {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: #3e332a;
  }

  .col-guide__card-cta {
    padding-top: 14px;
    border-top: 1px solid rgba(140, 104, 67, 0.12);
  }

  .col-guide__card-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: 0.84rem;
    font-weight: 600;
    color: #8c6843;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .col-guide__card-link:hover {
    color: #5c3f21;
    text-decoration: underline;
  }

  /* Content Column */
  .col-guide__content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .col-guide__lead {
    font-family: var(--font-heading, 'Playfair Display', Georgia, serif);
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.68;
    color: #33271e;
    font-style: italic;
    margin: 0;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(140, 104, 67, 0.15);
  }

  .col-guide__block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col-guide__h2 {
    font-family: var(--font-heading, 'Playfair Display', Georgia, serif);
    font-size: clamp(1.2rem, 1.6vw, 1.42rem);
    font-weight: 600;
    line-height: 1.35;
    color: #211913;
    margin: 0;
  }

  .col-guide__p {
    font-size: 0.96rem;
    line-height: 1.78;
    color: #4a3e35;
    margin: 0;
  }

  /* FAQs */
  .col-guide__faqs {
    margin-top: 16px;
    padding-top: 28px;
    border-top: 1px solid rgba(140, 104, 67, 0.15);
  }

  .col-guide__faqs-title {
    font-family: var(--font-heading, 'Playfair Display', Georgia, serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: #211913;
    margin: 0 0 16px 0;
  }

  .col-guide__faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col-guide__faq-item {
    background-color: #ffffff;
    border: 1px solid rgba(140, 104, 67, 0.16);
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .col-guide__faq-item[open] {
    border-color: #8c6843;
  }

  .col-guide__faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #2b231d;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .col-guide__faq-summary::-webkit-details-marker {
    display: none;
  }

  .col-guide__faq-icon {
    font-size: 1.25rem;
    line-height: 1;
    color: #8c6843;
    transition: transform 0.25s ease;
  }

  .col-guide__faq-item[open] .col-guide__faq-icon {
    transform: rotate(45deg);
  }

  .col-guide__faq-answer {
    padding: 0 20px 18px 20px;
    font-size: 0.92rem;
    line-height: 1.72;
    color: #4a3e35;
  }

  .col-guide__faq-answer p {
    margin: 0;
  }

  /* Footer Internal Links */
  .col-guide__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
    padding-top: 20px;
    border-top: 1px solid rgba(140, 104, 67, 0.12);
  }

  .col-guide__footer-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8c6843;
  }

  .col-guide__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .col-guide__tag {
    display: inline-block;
    padding: 5px 12px;
    background-color: rgba(140, 104, 67, 0.08);
    border: 1px solid rgba(140, 104, 67, 0.18);
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 500;
    color: #3b2c20;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .col-guide__tag:hover {
    background-color: #8c6843;
    color: #ffffff;
    border-color: #8c6843;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Buying Guide",
  "tag": "section",
  "class": "section-collection-buying-guide",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_guide",
      "label": "Enable Buying Guide Section",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fbf9f5"
    }
  ],
  "presets": [
    {
      "name": "Collection Buying Guide"
    }
  ]
}
{% endschema %}
