{%- assign customer_testimonials = shop.metaobjects.customer_testimonial.values -%}
{%- assign first_testimonial = customer_testimonials | first -%}

{%- if customer_testimonials != blank -%}
<div class="client-reviews" data-client-reviews>
  <div class="client-reviews__inner">
    <!-- Left Column: Fixed Text -->
    <div class="client-reviews__left">
      <div class="client-reviews__eyebrow-wrapper">
        <div class="client-reviews__eyebrow-line"></div>
        <span class="client-reviews__eyebrow">TESTIMONIALS</span>
      </div>

      <h2 class="client-reviews__heading">
        What Our<br>
        Clients Say
      </h2>

      <div class="client-reviews__quote-mark">&ldquo;</div>

      <p class="client-reviews__quote-text" data-client-review-text>
        {{- first_testimonial.customer_comment.value | escape -}}
      </p>

      <div class="client-reviews__author-box">
        <p class="client-reviews__author-name" data-client-review-author>
          {{- first_testimonial.customer_name.value | escape -}}
        </p>
        <p class="client-reviews__author-location" data-client-review-location>
          {{- first_testimonial.customer_location.value | escape -}}
        </p>
      </div>
    </div>

    <!-- Right Column: Image Slider -->
    <div class="client-reviews__right">
      <div class="client-reviews__slider-shell" data-client-reviews-carousel>
        <button
          type="button"
          class="client-reviews__nav client-reviews__nav--prev"
          data-client-reviews-prev
          aria-label="View previous testimonial"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6"/>
          </svg>
        </button>

        <div class="client-reviews__slider" data-client-reviews-slider>
          {%- for testimonial in customer_testimonials -%}
            {%- assign customer_name = testimonial.customer_name.value -%}
            {%- assign customer_comment = testimonial.customer_comment.value -%}
            {%- assign customer_location = testimonial.customer_location.value -%}
            {%- assign review_image_url = testimonial.review_image_url.value -%}
            {%- assign product_type = testimonial.product_type_to_review.value -%}
            {%- assign review_image_alt = 'WRYDECO customer testimonial' -%}
            {%- if product_type != blank -%}
              {%- capture review_image_alt -%}{{ product_type }} reviewed by {{ customer_name }}{%- endcapture -%}
            {%- elsif customer_name != blank -%}
              {%- capture review_image_alt -%}WRYDECO customer testimonial from {{ customer_name }}{%- endcapture -%}
            {%- endif -%}
            <div
              class="client-reviews__card{% if forloop.first %} slider-focused{% endif %}"
              data-review="{{ customer_comment | escape }}"
              data-author="{{ customer_name | escape }}"
              data-location="{{ customer_location | escape }}"
              data-product-type="{{ product_type | escape }}"
            >
              {%- if review_image_url != blank -%}
                <img
                  src="{{ review_image_url | escape }}"
                  alt="{{ review_image_alt | escape }}"
                  class="client-reviews__img"
                  loading="lazy"
                  draggable="false"
                  width="900"
                  height="1100"
                >
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="client-reviews__nav client-reviews__nav--next"
          data-client-reviews-next
          aria-label="View next testimonial"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .client-reviews {
    padding: var(--section-padding-y, 80px) var(--container-padding-x, 48px);
    background:
      radial-gradient(circle at 88% 8%, rgba(255, 255, 255, 0.7), transparent 36%),
      linear-gradient(180deg, #f5efe8 0%, #f7f3ee 100%);
    color: var(--color-text, #1a1815);
  }

  .client-reviews__inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-7, 48px);
    width: min(100%, calc(var(--page-max-width, 1440px) - var(--container-padding-x, 48px) * 2));
    margin: 0 auto;
  }

  @media screen and (min-width: 900px) {
    .client-reviews__inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 3vw;
    }
  }

  /* Left Column */
  .client-reviews__left {
    display: flex;
    flex-direction: column;
    max-width: 420px;
  }

  .client-reviews__eyebrow-wrapper {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }

  .client-reviews__eyebrow-line {
    height: 1px;
    width: 24px;
    background-color: rgba(74, 44, 24, 0.72);
  }

  .client-reviews__eyebrow {
    font-family: var(--font-body);
    font-size: var(--eyebrow-size, 12px);
    letter-spacing: var(--eyebrow-tracking, 0.3em);
    font-weight: 600;
    color: var(--color-brown, #4a2c18);
  }

  .client-reviews__heading {
    font-family: var(--font-heading);
    font-size: var(--section-heading-size, 48px);
    font-weight: var(--font-weight-light, 300);
    line-height: var(--section-heading-line, 1.02);
    margin: 0 0 16px 0;
    letter-spacing: var(--section-heading-tracking, -0.02em);
    color: var(--color-text, #2b1a11);
  }

  .client-reviews__subtitle {
    font-family: var(--font-body);
    font-size: var(--section-subtitle-size, 16px);
    line-height: 1.6;
    color: var(--color-muted, #6b5d52);
    margin: 0 0 var(--sp-6, 32px) 0;
  }

  .client-reviews__quote-mark {
    font-family: var(--font-display);
    font-size: 80px;
    line-height: 0.6;
    color: rgba(107, 93, 82, 0.4);
    margin-bottom: 6px;
    transform: translateY(18px); /* Adjust vertical alignment */
  }

  .client-reviews__quote-text {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.5vw, 24px);
    line-height: 1.4;
    font-weight: var(--font-weight-regular, 400);
    margin: 0 0 0 0;
    min-height: 120px; /* Prevent layout jump */
    transition: opacity 0.3s ease;
  }

  .client-reviews__author-name {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 4px 0;
  }

  .client-reviews__author-location {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-secondary, #6b5d52);
    margin: 0 0 var(--sp-5, 20px) 0;
  }

  /* Right Column (Slider) */
  .client-reviews__right {
    flex: 1.4;
    width: 100%;
    min-width: 0; /* Important for flex-child overflow */
  }

  .client-reviews__slider-shell {
    position: relative;
  }

  .client-reviews__slider {
    display: flex;
    gap: var(--sp-4, 16px);
    overflow-x: auto;
    padding-bottom: var(--sp-4, 16px);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
  }

  .client-reviews__slider::-webkit-scrollbar {
    display: none;
  }

  .client-reviews__slider.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .client-reviews__slider.is-dragging .client-reviews__card {
    user-select: none;
    pointer-events: none;
  }

  .client-reviews__card {
    flex: 0 0 calc((100% - var(--sp-4, 16px)) / 2);
    max-width: none;
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    position: relative;
    aspect-ratio: 3 / 4; /* Tall portrait images like the screenshot */
    opacity: 1;
  }

  .client-reviews__card::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.56), rgba(255, 255, 255, 0.18)),
      rgba(255, 255, 255, 0.18);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
    content: '';
  }

  .client-reviews__card.is-comment-preview::after {
    opacity: 1;
  }

  .client-reviews__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
    user-select: none;
  }

  .client-reviews__nav {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(74, 44, 24, 0.18);
    border-radius: 999px;
    background: rgba(255, 252, 248, 0.86);
    color: var(--color-brown, #4a2c18);
    box-shadow: 0 14px 30px rgba(59, 31, 15, 0.12);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background-color var(--timing-short, 0.2s) var(--ease-standard, ease),
      border-color var(--timing-short, 0.2s) var(--ease-standard, ease),
      color var(--timing-short, 0.2s) var(--ease-standard, ease),
      opacity var(--timing-short, 0.2s) var(--ease-standard, ease),
      transform var(--timing-short, 0.2s) var(--ease-standard, ease);
  }

  .client-reviews__nav--prev {
    left: calc(var(--sp-5, 24px) * -1);
  }

  .client-reviews__nav--next {
    right: calc(var(--sp-5, 24px) * -1);
  }

  .client-reviews__nav svg {
    width: 20px;
    height: 20px;
  }

  .client-reviews__nav:disabled {
    opacity: 0.36;
    cursor: default;
    pointer-events: none;
  }

  /* Footer Section */
  .client-reviews__footer {
    margin: 40px 0 20px;
    display: flex;
    justify-content: center;
  }

  .client-reviews__footer-content {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    color: var(--text-secondary, #6b5d52);
  }

  .client-reviews__footer-sep {
    font-size: 8px;
    opacity: 0.5;
  }

  .client-reviews__footer-icon {
    opacity: 0.8;
  }

  @media screen and (min-width: 900px) {
    .client-reviews__left {
      flex: 0 0 clamp(320px, 30vw, 420px);
    }

    .client-reviews__quote-text {
      font-size: clamp(24px, 1.8vw, 30px);
      font-weight: 300;
      line-height: 1.2;
      letter-spacing: -0.03em;
    }

    .client-reviews__author-box::before {
      display: block;
      width: 38px;
      height: 1px;
      margin-bottom: 16px;
      background: rgba(107, 93, 82, 0.42);
      content: '';
    }

    .client-reviews__author-name {
      font-family: var(--font-display);
      font-size: 21px;
      font-weight: 300;
      letter-spacing: -0.025em;
      line-height: 1.1;
    }

    .client-reviews__card {
      flex-basis: calc((100% - var(--sp-4, 16px)) / 2);
    }
  }

  .client-reviews__footer {
    position: relative;
    justify-content: center;
  }

  @media screen and (min-width: 900px) {
    .client-reviews__footer::before,
    .client-reviews__footer::after {
      position: absolute;
      top: 50%;
      width: min(20vw, 320px);
      height: 1px;
      background: rgba(107, 93, 82, 0.24);
      content: '';
    }

    .client-reviews__footer::before {
      left: 0;
    }

    .client-reviews__footer::after {
      right: 0;
    }

    .client-reviews__footer-text {
      color: var(--color-brown, #4a2c18);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.22em;
    }
  }

  @media screen and (max-width: 640px) {
    .client-reviews__nav {
      width: 40px;
      height: 40px;
    }

    .client-reviews__nav--prev {
      left: var(--sp-2, 8px);
    }

    .client-reviews__nav--next {
      right: var(--sp-2, 8px);
    }
  }

  @media (hover: hover) {
    .client-reviews__nav:not(:disabled):hover {
      background: var(--color-brown, #4a2c18);
      border-color: var(--color-brown, #4a2c18);
      color: #fff8f0;
      transform: translateY(-50%) scale(1.04);
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const sectionRoot = document.querySelector('[data-client-reviews]');
    if (!sectionRoot) return;

    const carousel = sectionRoot.querySelector('[data-client-reviews-carousel]');
    const slider = sectionRoot.querySelector('[data-client-reviews-slider]');
    if (!slider) return;

    const cards = Array.from(slider.querySelectorAll('.client-reviews__card'));
    const prev = carousel ? carousel.querySelector('[data-client-reviews-prev]') : null;
    const next = carousel ? carousel.querySelector('[data-client-reviews-next]') : null;
    const textEl = sectionRoot.querySelector('[data-client-review-text]');
    const authorEl = sectionRoot.querySelector('[data-client-review-author]');
    const locationEl = sectionRoot.querySelector('[data-client-review-location]');

    let currentCommentCard = null;
    let textUpdateTimer = null;

    function updateText(card) {
      if (!card || card === currentCommentCard) return;
      currentCommentCard = card;
      window.clearTimeout(textUpdateTimer);

      // Slight fade effect
      textEl.style.opacity = '0';
      authorEl.style.opacity = '0';

      textUpdateTimer = window.setTimeout(() => {
        textEl.textContent = card.dataset.review;
        authorEl.textContent = card.dataset.author;
        if (locationEl) locationEl.textContent = card.dataset.location || '';
        textEl.style.opacity = '1';
        authorEl.style.opacity = '1';
      }, 150);
    }

    function cardStep() {
      const card = cards[0];
      if (!card) return slider.clientWidth;

      const styles = getComputedStyle(slider);
      const gap = parseFloat(styles.columnGap || styles.gap) || 16;
      return card.getBoundingClientRect().width + gap;
    }

    function updateTrailingSpace() {
      if (cards.length === 0) return;

      cards.forEach((card) => {
        card.style.marginRight = '';
      });

      const lastCard = cards[cards.length - 1];
      const extraSpace = slider.clientWidth - lastCard.getBoundingClientRect().width;
      if (extraSpace > 0) {
        lastCard.style.marginRight = `${extraSpace}px`;
      }
    }

    function firstCardInViewport() {
      if (cards.length === 0) return;

      const sliderRect = slider.getBoundingClientRect();
      const sliderLeft = sliderRect.left;

      let closestCard = cards[0];
      let minDistance = Infinity;

      cards.forEach((card) => {
        const cardRect = card.getBoundingClientRect();
        const distance = Math.abs(sliderLeft - cardRect.left);

        if (distance < minDistance) {
          minDistance = distance;
          closestCard = card;
        }
      });

      return closestCard;
    }

    function updateCommentFromViewport() {
      const sourceCard = firstCardInViewport();
      const sourceIndex = cards.indexOf(sourceCard);

      cards.forEach((card) => {
        card.classList.remove('is-comment-source', 'is-comment-preview');
      });

      if (sourceCard) {
        sourceCard.classList.add('is-comment-source');
      }

      if (sourceIndex >= 0 && cards[sourceIndex + 1]) {
        cards[sourceIndex + 1].classList.add('is-comment-preview');
      }

      updateText(sourceCard);
    }

    function updateNav() {
      const maxScroll = slider.scrollWidth - slider.clientWidth;
      const hasOverflow = maxScroll > 1;
      if (prev) prev.disabled = !hasOverflow || slider.scrollLeft <= 1;
      if (next) next.disabled = !hasOverflow || slider.scrollLeft >= maxScroll - 1;
    }

    function scrollByCard(direction) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      slider.scrollBy({
        left: cardStep() * direction,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    }

    // Initial check
    updateTrailingSpace();
    updateCommentFromViewport();
    updateNav();

    if (prev) {
      prev.addEventListener('click', () => {
        scrollByCard(-1);
      });
    }

    if (next) {
      next.addEventListener('click', () => {
        scrollByCard(1);
      });
    }

    // Listen for scroll events on the slider to update the comment from the
    // first card in the viewport.
    let ticking = false;
    slider.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateCommentFromViewport();
            updateNav();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true }
    );

    // Also update on window resize since layout might change
    window.addEventListener('resize', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateTrailingSpace();
          updateCommentFromViewport();
          updateNav();
          ticking = false;
        });
        ticking = true;
      }
    });

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => {
        updateTrailingSpace();
        updateCommentFromViewport();
        updateNav();
      });
      resizeObserver.observe(slider);
    }

    // Press-and-drag to scroll (mouse). Matches the PDP "Pairs Beautifully With"
    // carousel: threshold protects simple clicks, real drags suppress click.
    let isDown = false;
    let startX = 0;
    let isDragging = false;
    let dragDirection = 0;
    const THRESHOLD = 5;

    slider.addEventListener('dragstart', (e) => {
      e.preventDefault();
    });

    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      isDragging = false;
      dragDirection = 0;
      startX = e.pageX - slider.offsetLeft;
    });

    function endDrag() {
      const shouldScroll = isDragging && dragDirection !== 0;
      isDown = false;
      slider.classList.remove('is-dragging');
      if (shouldScroll) {
        scrollByCard(dragDirection);
      }
      updateNav();
    }

    slider.addEventListener('mouseleave', endDrag);
    slider.addEventListener('mouseup', endDrag);

    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      const x = e.pageX - slider.offsetLeft;
      const distance = x - startX;
      if (!isDragging && Math.abs(distance) > THRESHOLD) {
        isDragging = true;
        slider.classList.add('is-dragging');
      }
      if (!isDragging) return;

      e.preventDefault();
      dragDirection = distance < 0 ? 1 : -1;
    });

    slider.addEventListener(
      'click',
      (e) => {
        if (isDragging) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true
    );
  });
{% endjavascript %}

