      {%- if section.settings.show_payment -%}
        {%- assign wrydeco_payment_types = 'visa,master,american_express,discover,diners_club,elo,jcb,unionpay,shopify_pay,paypal,google_pay,venmo' | split: ',' -%}
        <div class="footer-custom__payments" aria-label="Accepted payment methods">
          {%- for type in wrydeco_payment_types -%}
            {%- if shop.enabled_payment_types contains type -%}
              <span class="footer-custom__payment-icon">
                {{ type | payment_type_svg_tag }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
