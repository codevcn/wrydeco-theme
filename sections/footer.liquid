  </div>
</footer>

{% stylesheet %}
  .footer-custom {
    --footer-bg: #2d190d;
    --footer-bg-deep: #1b1009;
    --footer-ink: var(--color-milk);
    --footer-muted: color-mix(in srgb, var(--color-milk) 70%, transparent);
    --footer-soft: color-mix(in srgb, var(--color-milk) 54%, transparent);
    --footer-gold: #d6a15f;
    --footer-line: color-mix(in srgb, var(--color-milk) 13%, transparent);
    position: relative;
    isolation: isolate;
    border-top: 0;
    background:
      radial-gradient(circle at 10% 12%, rgba(126, 73, 35, 0.34), transparent 28%),
      radial-gradient(circle at 78% 78%, rgba(112, 73, 40, 0.18), transparent 30%),
      linear-gradient(90deg, rgba(74, 44, 24, 0.98), rgba(74, 44, 24, 0.98)),
      var(--footer-bg);
    color: var(--footer-ink);
    font-family: var(--font-body);
  }

  .footer-custom::before,
  .footer-custom::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .footer-custom::before {
    opacity: 0.22;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 72px),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.018) 0 1px, transparent 1px 138px);
  }

  .footer-custom::after {
    top: auto;
    height: min(18vw, 260px);
    opacity: 0.23;
    background:
      radial-gradient(ellipse at 50% 100%, transparent 0 16%, rgba(213, 143, 74, 0.5) 16.4% 16.9%, transparent 17.3% 24%, rgba(213, 143, 74, 0.32) 24.4% 24.9%, transparent 25.3% 32%, rgba(213, 143, 74, 0.22) 32.4% 32.8%, transparent 33.2%),
      radial-gradient(ellipse at 50% 115%, transparent 0 31%, rgba(213, 143, 74, 0.34) 31.4% 31.8%, transparent 32.2%);
  }

  .footer-custom__inner {
    width: min(100%, 1680px);
    margin-inline: auto;
    padding-inline: clamp(40px, 5.2vw, 104px);
  }

  .footer-custom__main {
    display: grid;
