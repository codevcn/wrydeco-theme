{%- liquid
  assign legal_info = null
  for entry in metaobjects.store_legal_info.values limit: 1
    assign legal_info = entry
  endfor

  assign legal_slogan = legal_info.slogan.value | default: 'Bespoke wooden furniture, handcrafted for timeless spaces and meaningful living.'
  assign legal_phone = legal_info.phone_number.value | default: '+1 (801) 340-6671'
  assign legal_email = legal_info.support_email.value | default: 'support@wrydeco.com'
  assign legal_address = legal_info.business_address.value | default: '1209 MOUNTAIN ROAD PL NE STE R, Albuquerque, NM 87110, United States'
  assign legal_hours = legal_info.support_hours.value | default: '24/7 online support, Central Time (CT)'
  assign legal_phone_href = legal_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}

<footer class="footer-custom">
  <div class="footer-custom__inner footer-custom__main">
    <section class="footer-custom__brand-panel" aria-label="WRYDECO contact details">
      {%- assign footer_logo_alt = section.settings.logo.alt | default: shop.name -%}
      <h2 class="footer-custom__wordmark">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 360
            | image_tag:
              class: 'footer-custom__logo',
              widths: '160, 240, 320, 360',
              height: section.settings.logo.height,
              width: section.settings.logo.width,
              alt: footer_logo_alt
          }}
        {%- elsif section.settings.logo_asset != blank -%}
          <img
            src="{{ section.settings.logo_asset | file_url }}"
            class="footer-custom__logo"
            alt="{{ shop.name | escape }}"
            loading="lazy"
            width="186"
            height="90"
          >
        {%- else -%}
          <span class="footer-custom__wordmark-text">{{ shop.name }}</span>
        {%- endif -%}
      </h2>

      {%- if legal_slogan != blank -%}
        <p class="footer-custom__tagline">{{ legal_slogan | escape }}</p>
      {%- endif -%}
      <h3 class="footer-custom__contact-title">Contact Us</h3>
      <ul class="footer-custom__contact" aria-label="Contact information">
        {%- if legal_phone != blank -%}
          <li>
            <span class="footer-custom__contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384"/></svg>
            </span>
            <span><strong>Hotline:</strong> <a href="tel:{{ legal_phone_href }}">{{ legal_phone | escape }}</a></span>
          </li>
        {%- endif -%}
        {%- if legal_email != blank -%}
          <li>
            <span class="footer-custom__contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m22 7l-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect width="20" height="16" x="2" y="4" rx="2"/></g></svg>
            </span>
            <span><strong>Email:</strong> <a href="mailto:{{ legal_email }}">{{ legal_email | escape }}</a></span>
          </li>
        {%- endif -%}
        {%- if legal_address != blank -%}
          <li>
            <span class="footer-custom__contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></g></svg>
            </span>
            <span><strong>Registered Business Address:</strong> {{ legal_address | escape }}</span>
          </li>
        {%- endif -%}
        {%- if legal_hours != blank -%}
          <li>
            <span class="footer-custom__contact-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></g></svg>
            </span>
            <span><strong>Support Hours:</strong> {{ legal_hours | escape }}</span>
          </li>
        {%- endif -%}
      </ul>
    </section>

    <nav class="footer-custom__nav" aria-label="Footer navigation">
      <div class="footer-custom__column">
        <h3 class="footer-custom__heading">Shop</h3>
        {%- comment -%}
          Keep the footer Shop menu curated to about seven representative collections.
          Avoid turning this column into a full collection index so the footer stays scannable
          and internal link focus remains concentrated on the most important collection pages.
        {%- endcomment -%}
        <ul class="footer-custom__menu">
          <li><a href="/collections/tree-bookshelves" target="_blank">Tree Bookshelves</a></li>
          <li><a href="/collections/bookshelf-modern" target="_blank">Sculptural & Curved Wood Bookshelves</a></li>
          <li><a href="/collections/wall-mounted-tree-bookshelves" target="_blank">Wall-Mounted Tree Bookshelves</a></li>
          <li><a href="/collections/floating-shelves" target="_blank">Floating Wood Shelves</a></li>
          <li><a href="/collections/coffee-tables" target="_blank">Coffee Tables</a></li>
          <li><a href="/collections/signature-pieces" target="_blank">Signature Pieces</a></li>
          <li><a href="/collections/new-arrivals" target="_blank">New Arrivals</a></li>
        </ul>
      </div>

      <div class="footer-custom__column">
        <h3 class="footer-custom__heading">Discover</h3>
        <ul class="footer-custom__menu">
          <li><a href="{{ pages['about-us'].url | default: '/pages/about-us' }}" target="_blank">About Us</a></li>
          <li><a href="/pages/customization" target="_blank">Consultation</a></li>
          <li><a href="/pages/care-guide" target="_blank">Care Guide</a></li>
          <li><a href="/apps/track-order" target="_blank">Track Your Order</a></li>
          <li><a href="/blogs/news" target="_blank">Blogs</a></li>
        </ul>
      </div>

      <div class="footer-custom__column">
        <h3 class="footer-custom__heading">Support</h3>
        <ul class="footer-custom__menu">
          <li><a href="{{ pages['faq'].url | default: '/pages/faq' }}" target="_blank">FAQs</a></li>
          <li><a href="{{ pages['contact'].url | default: '/pages/contact' }}" target="_blank">Contact Us</a></li>
          <li><a href="{{ pages['warranty-policy'].url | default: '/pages/warranty-policy' }}" target="_blank">Warranty Policy</a></li>
          <li><a href="/policies/shipping-policy" target="_blank">Shipping Policy</a></li>
          <li><a href="/policies/refund-policy" target="_blank">Returns & Refunds</a></li>
          <li><a href="/policies/terms-of-service" target="_blank">Terms of Service</a></li>
          <li><a href="/policies/privacy-policy" target="_blank">Privacy Policy</a></li>
        </ul>
      </div>
    </nav>

    <section class="footer-custom__newsletter" aria-labelledby="footer-newsletter-title">
      <h3 id="footer-newsletter-title" class="footer-custom__newsletter-title">Stay Inspired</h3>
      <p class="footer-custom__newsletter-copy">Join our newsletter for new collections, design stories, and occasional offers.</p>

      {% form 'customer', class: 'footer-custom__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="footer-custom__input-group">
          <input
            type="email"
            name="contact[email]"
            class="footer-custom__input"
            placeholder="Your email address"
            aria-label="Your email address"
            autocomplete="email"
            required
          >
          <button type="submit" class="footer-custom__submit" data-newsletter-submit>
            <span class="footer-custom__submit-label">Subscribe</span>
            <span class="footer-custom__submit-spinner" aria-hidden="true"></span>
          </button>
        </div>
      {% endform %}

      {%- if section.settings.show_currency -%}
        <div class="footer-custom__localization">
          {% render 'localization-selector', variant: 'footer', id: 'footer' %}
        </div>
      {%- endif -%}

      <div class="footer-custom__follow-on-shop">
        {{ shop | login_button: action: 'follow' }}
      </div>
    </section>
  </div>

