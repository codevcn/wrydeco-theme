{% javascript %}
  (function () {
    var form = document.querySelector('.footer-custom__form');
    if (!form || form.dataset.newsletterAjax === 'true') return;
    form.dataset.newsletterAjax = 'true';

    var btn = form.querySelector('[data-newsletter-submit]');
    if (!btn) return;

    function toast(message, type) {
      if (window.showToast) {
        window.showToast({ message: message, type: type, position: 'bottom-left' });
      }
    }

    function setLoading(state) {
      if (state) {
        btn.setAttribute('aria-busy', 'true');
        btn.disabled = true;
      } else {
        btn.removeAttribute('aria-busy');
        btn.disabled = false;
      }
    }

    form.addEventListener('submit', function (event) {
      // Let the browser's native validation handle empty/invalid emails first.
      if (typeof form.checkValidity === 'function' && !form.checkValidity()) return;
      if (btn.getAttribute('aria-busy') === 'true') return;

      event.preventDefault();
      setLoading(true);

      var action = (form.getAttribute('action') || '/contact').split('#')[0];
      var data = new FormData(form);

      fetch(action, { method: 'POST', body: data, redirect: 'follow' })
        .then(function (res) {
          if (!res.ok) {
            form.submit();
            return null;
          }

          return res.text().then(function (html) {
            return {
              url: res.url,
              redirected: res.redirected,
              html: html,
            };
          });
        })
        .then(function (result) {
          if (!result) return;

          var success =
            result.redirected ||
            /customer_posted=true/.test(result.url) ||
            /customer_posted=true/.test(result.html) ||
            /posted_successfully\?/.test(result.html);

          if (!success) {
            setLoading(false);
            toast('We could not subscribe that email. Please try again.', 'error');
            return;
          }

          setLoading(false);
          form.reset();
          if (window.WrydecoDiscountAutoApply) {
            window.WrydecoDiscountAutoApply.unlockAndSync();
          } else {
            document.dispatchEvent(new CustomEvent('wry:newsletter-signup-success'));
          }
          toast('Thanks for subscribing.', 'success');
        })
        .catch(function () {
          form.submit();
        });
    });
  })();
{% endjavascript %}

