<div class="custom-section-divider"></div>

{%- assign makers_authors = metaobjects.product_author.values -%}

<div class="meet-makers">
  <div class="meet-makers__inner">
  <div class="meet-makers__header">
    <h2 class="meet-makers__heading">{{ section.settings.heading | escape }}</h2>
    <p class="meet-makers__subtitle">
      {{ section.settings.subtitle | default: 'Each maker brings a lifetime of dedication to every curve, grain, and detail.' | escape }}
    </p>
  </div>

  <div class="meet-makers__carousel" data-maker-carousel>
    <button class="meet-makers__nav meet-makers__nav--prev" type="button" aria-label="Previous makers" data-maker-prev>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="meet-makers__track">
      <div class="meet-makers__slider" data-maker-slider>
        {%- for author in makers_authors limit: 6 -%}
          {% render 'maker-card', author: author %}
        {%- endfor -%}
      </div>

      <div class="meet-makers__dots" aria-label="Maker slides">
        {%- for author in makers_authors limit: 6 -%}
          <button
            class="meet-makers__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            aria-label="Go to maker {{ forloop.index }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            data-maker-dot
            data-maker-frame="{{ forloop.index0 }}"
          ></button>
        {%- endfor -%}
      </div>
    </div>

    <button class="meet-makers__nav meet-makers__nav--next" type="button" aria-label="Next makers" data-maker-next>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="meet-makers__footer">
    <p class="meet-makers__quote" aria-label="Maker statement">
      <span class="meet-makers__quote-mark" aria-hidden="true">“</span>
      <span>{{ section.settings.footer_quote | default: "We don't just build furniture. We create pieces that carry stories forward." | escape }}</span>
      <span class="meet-makers__quote-mark" aria-hidden="true">”</span>
    </p>
    <p class="meet-makers__credit">{{ section.settings.footer_credit | default: 'The WRYDECO Makers' | escape }}</p>
  </div>
  </div>
</div>

{% stylesheet %}
  .meet-makers {
    position: relative;
    isolation: isolate;
    margin: 0;
    padding: var(--section-padding-y, 80px) var(--container-padding-x, 48px);
    overflow: hidden;
    background:
      radial-gradient(circle at 16% 12%, rgba(255, 255, 255, 0.84), transparent 34%),
      radial-gradient(circle at 88% 26%, rgba(184, 180, 175, 0.13), transparent 30%),
      linear-gradient(180deg, #f8f3ed 0%, #f3ece5 100%);
    color: var(--color-earth-brown, #4a2c18);
  }

  .meet-makers::before {
    position: absolute;
    left: -48px;
    bottom: -48px;
    z-index: -1;
    width: min(320px, 26vw);
    aspect-ratio: 1;
    background:
      radial-gradient(ellipse at 20% 78%, transparent 0 42%, rgba(107, 93, 82, 0.12) 43% 43.6%, transparent 44%),
      radial-gradient(ellipse at 36% 62%, transparent 0 48%, rgba(107, 93, 82, 0.1) 49% 49.6%, transparent 50%),
      radial-gradient(ellipse at 54% 50%, transparent 0 52%, rgba(107, 93, 82, 0.08) 53% 53.6%, transparent 54%);
    content: '';
    opacity: 0.55;
    transform: rotate(-22deg);
  }

  .meet-makers__inner {
    width: min(100%, calc(var(--page-max-width, 1440px) - var(--container-padding-x, 48px) * 2));
    margin: 0 auto;
  }

  .meet-makers__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(32px, 3.5vw, 48px);
    text-align: center;
  }

  .meet-makers__heading {
    max-width: 820px;
    margin: 0 0 18px;
    color: var(--color-text, #2b1a11);
    font-family: var(--font-heading);
    font-size: var(--section-heading-size, 48px);
    font-weight: 300;
    line-height: var(--section-heading-line, 1.02);
    letter-spacing: var(--section-heading-tracking, -0.02em);
    text-wrap: balance;
  }

  .meet-makers__subtitle {
    max-width: 690px;
    margin: 0 auto;
    color: var(--color-muted, #5f5852);
    font-family: var(--font-body);
    font-size: var(--section-subtitle-size, 16px);
    line-height: 1.6;
    text-wrap: balance;
  }

  .meet-makers__carousel,
  .meet-makers__track {
    position: relative;
  }

  .meet-makers__slider {
    display: flex;
    gap: clamp(20px, 4vw, 56px);
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .meet-makers__slider::-webkit-scrollbar {
    display: none;
  }

  .meet-makers__slider.is-dragging {
    cursor: grabbing;
  }

  .meet-makers__slider.is-dragging .maker-card {
    user-select: none;
    pointer-events: none;
  }

  .maker-card {
    flex: 0 0 min(88vw, 720px);
    min-width: 0;
    scroll-snap-align: start;
  }

  .maker-card__body {
    display: flex;
    flex-direction: column;
    gap: clamp(22px, 3vw, 42px);
  }

  .maker-card__image-col {
    overflow: hidden;
    background: transparent;
  }

  .maker-card__img-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .maker-card__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 0.76;
    object-fit: cover;
    border-radius: var(--radius-md, 8px);
    user-select: none;
    -webkit-user-drag: none;
    transition: transform var(--timing-long, 0.4s) var(--ease-out, ease-out);
  }

  .maker-card__img-link:hover .maker-card__img,
  .maker-card__img-link:focus-visible .maker-card__img {
    transform: scale(1.04);
  }

  .maker-card__text-col {
    display: flex;
    flex-direction: column;
    color: var(--color-earth-brown, #4a2c18);
  }

  .maker-card__name {
    margin: 0 0 clamp(14px, 1.7svh, 18px);
    color: var(--color-earth-brown, #4a2c18);
    font-family: var(--font-display-light, var(--font-display));
    font-size: clamp(31px, 2.35vw, 44px);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .maker-card__role {
    margin: 0 0 clamp(20px, 2.8svh, 34px);
    color: var(--color-earth-brown, #4a2c18);
    font-family: var(--font-body);
    font-size: clamp(11px, 0.8vw, 14px);
    font-weight: 600;
    letter-spacing: 0.1em;
    word-spacing: 0.2em;
  }

  .maker-card__slogan {
    margin: 0 0 clamp(16px, 2svh, 22px);
    color: var(--color-earth-brown, #4a2c18);
    font-family: var(--font-display-light, var(--font-display));
    font-size: clamp(15px, 1.1vw, 18px);
    font-style: italic;
    line-height: 1.35;
  }

  .maker-card__features {
    display: grid;
    gap: clamp(18px, 2.3svh, 24px);
    margin-top: auto;
    padding-top: clamp(20px, 3svh, 32px);
    border-top: 1px solid rgba(74, 44, 24, 0.2);
  }

  .maker-feature {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
    color: var(--color-earth-brown, #4a2c18);
    text-align: left;
  }

  .maker-feature span {
    color: var(--color-earth-brown, #4a2c18);
    font-family: var(--font-body);
    font-size: clamp(12px, 0.88vw, 15px);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.28;
  }

  .maker-feature span::first-line {
    font-weight: 600;
  }

  .meet-makers__nav,
  .meet-makers__dots {
    display: none;
  }

  .meet-makers__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: clamp(16px, 3svh, 24px);
    text-align: center;
  }

  .meet-makers__quote {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 1.5vw, 22px);
    max-width: 760px;
    margin: 0 auto clamp(10px, 1.3svh, 16px);
    color: var(--color-earth-brown, #4a2c18);
    font-family: var(--font-display-light, var(--font-display));
    font-size: clamp(25px, 2.1vw, 38px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .meet-makers__quote-mark {
    color: rgba(74, 44, 24, 0.2);
    font-family: var(--font-display);
    font-size: 1.55em;
    line-height: 0.8;
  }

  .meet-makers__credit {
    margin: 0 0 clamp(18px, 2.4svh, 28px);
    color: var(--color-earth-brown, #4a2c18);
    font-size: clamp(10px, 0.72vw, 13px);
    font-weight: 600;
    letter-spacing: 0.34em;
  }

  .meet-makers__credit::before {
    content: '- ';
  }

  @media screen and (min-width: 700px) {
    .maker-card__body {
      display: grid;
      grid-template-columns: minmax(230px, 0.98fr) minmax(230px, 0.75fr);
      align-items: stretch;
      min-height: clamp(300px, 39svh, 485px);
    }

    .maker-card__img-link,
    .maker-card__img {
      height: 100%;
    }

    .maker-card__img {
      aspect-ratio: auto;
    }

    .maker-card__text-col {
      justify-content: center;
      min-height: 0;
      padding: clamp(16px, 2.5svh, 30px) 0;
    }
  }

  @media screen and (min-width: 1200px) {
    .meet-makers__slider {
      gap: clamp(26px, 4vw, 72px);
      cursor: default;
    }

    .maker-card {
      flex-basis: calc((100% - clamp(26px, 4vw, 72px)) / 2);
    }

    .meet-makers__nav {
      position: absolute;
      z-index: 3;
      top: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid rgba(107, 93, 82, 0.36);
      border-radius: var(--radius-full);
      background: color-mix(in srgb, var(--bg-primary, #f5f1ed) 82%, white);
      color: var(--color-earth-brown, #4a2c18);
      cursor: pointer;
      transform: translateY(-50%);
      transition: background-color var(--timing-short) var(--ease-standard),
        border-color var(--timing-short) var(--ease-standard), opacity var(--timing-short) var(--ease-standard),
        transform var(--timing-short) var(--ease-standard);
    }

    .meet-makers__nav:hover {
      border-color: rgba(74, 44, 24, 0.65);
      background: var(--color-milk, #f7f2ec);
      transform: translateY(-50%) scale(1.04);
    }

    .meet-makers__nav[disabled] {
      opacity: 0.34;
      cursor: default;
      pointer-events: none;
    }

    .meet-makers__nav--prev {
      left: var(--sp-3);
    }

    .meet-makers__nav--next {
      right: var(--sp-3);
    }

    .meet-makers__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--sp-2);
      margin-top: var(--sp-5);
      margin-bottom: var(--sp-4);
    }

    .meet-makers__dot {
      width: 8px;
      height: 8px;
      padding: 0;
      border: 1px solid rgba(107, 93, 82, 0.46);
      border-radius: var(--radius-full);
      background: transparent;
      cursor: pointer;
      transition: width var(--timing-short) var(--ease-standard),
        background-color var(--timing-short) var(--ease-standard), border-color var(--timing-short) var(--ease-standard);
    }

    .meet-makers__dot.is-active {
      width: 24px;
      background: var(--color-earth-brown, #4a2c18);
      border-color: var(--color-earth-brown, #4a2c18);
    }

    .meet-makers__nav:focus-visible,
    .meet-makers__dot:focus-visible {
      outline: 2px solid var(--color-sage);
      outline-offset: var(--sp-1);
    }
  }

  @media screen and (max-width: 749px) {
    .meet-makers {
      padding: 48px 16px 52px;
    }

    .meet-makers__subtitle {
      font-size: 15px;
    }

    .maker-card__features {
      display: flex;
      margin-top: 8px;
    }

    .maker-feature {
      flex: 1 1 0;
      justify-content: center;
      text-align: center;
    }

    .maker-feature--border {
      border-left: 1px solid rgba(74, 44, 24, 0.2);
      padding-left: 12px;
    }

    .meet-makers__quote {
      align-items: flex-start;
      font-size: 28px;
    }

    .meet-makers__carousel {
      margin-bottom: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meet-makers__slider {
      scroll-behavior: auto;
    }

    .maker-card__img,
    .meet-makers__nav,
    .meet-makers__dot {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function renderFallbackFeatures(root) {
      root.querySelectorAll('[data-maker-features]').forEach(function (container) {
        if (container.dataset.makerFeaturesInit === 'true') return;
        container.dataset.makerFeaturesInit = 'true';

        try {
          var data = JSON.parse(container.getAttribute('data-maker-features') || '[]');
          if (typeof data === 'string') data = JSON.parse(data);
          var features = Array.isArray(data) ? data : data.features;
          if (!Array.isArray(features)) return;

          features.forEach(function (feature, index) {
            var item = document.createElement('div');
            item.className = 'maker-feature' + (index > 0 ? ' maker-feature--border' : '');

            var label = document.createElement('span');
            label.append(document.createTextNode(feature.value || ''));
            label.append(document.createElement('br'));
            label.append(document.createTextNode(feature.label || ''));
            item.append(label);
            container.append(item);
          });
        } catch (error) {
          container.hidden = true;
        }
      });
    }

    function initCarousel(carousel) {
      if (!carousel || carousel.dataset.makerInit === 'true') return;
      carousel.dataset.makerInit = 'true';
      renderFallbackFeatures(carousel);

      var slider = carousel.querySelector('[data-maker-slider]');
      if (!slider) return;

      var prevButton = carousel.querySelector('[data-maker-prev]');
      var nextButton = carousel.querySelector('[data-maker-next]');
      var dots = Array.prototype.slice.call(carousel.querySelectorAll('[data-maker-dot]'));
      var cards = Array.prototype.slice.call(slider.querySelectorAll('.maker-card'));
      var activeFrame = 0;
      var scrollFrame = null;
      var resizeTimer = null;
      var lockedActiveFrame = null;

      function getFrameCount() {
        return Math.max(1, cards.length);
      }

      function getFrameLeft(frame) {
        var targetCard = cards[Math.min(frame, cards.length - 1)];
        var maxLeft = Math.max(0, slider.scrollWidth - slider.clientWidth);
        var targetLeft = targetCard ? targetCard.offsetLeft - slider.offsetLeft : 0;
        return Math.min(Math.max(0, targetLeft), maxLeft);
      }

      function updateCarouselState() {
        var frameCount = getFrameCount();
        activeFrame = Math.min(Math.max(activeFrame, 0), frameCount - 1);

        if (prevButton) prevButton.disabled = activeFrame === 0;
        if (nextButton) nextButton.disabled = activeFrame >= frameCount - 1;

        dots.forEach(function (dot, index) {
          var isActive = index === activeFrame;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          dot.hidden = index >= frameCount;
        });
      }

      function goToFrame(frame, behavior) {
        activeFrame = Math.min(Math.max(frame, 0), getFrameCount() - 1);
        lockedActiveFrame = activeFrame;
        slider.scrollTo({ left: getFrameLeft(activeFrame), behavior: behavior || 'smooth' });
        updateCarouselState();
        window.setTimeout(function () {
          lockedActiveFrame = null;
          syncActiveFrameFromScroll();
        }, behavior === 'auto' ? 0 : 700);
      }

      function syncActiveFrameFromScroll() {
        scrollFrame = null;
        if (lockedActiveFrame !== null) return;

        var frameCount = getFrameCount();
        var closestFrame = 0;
        var closestDistance = Infinity;
        for (var frame = 0; frame < frameCount; frame += 1) {
          var distance = Math.abs(slider.scrollLeft - getFrameLeft(frame));
          if (distance <= closestDistance) {
            closestDistance = distance;
            closestFrame = frame;
          }
        }
        activeFrame = closestFrame;
        updateCarouselState();
      }

      carousel.addEventListener('click', function (event) {
        var dot = event.target.closest('[data-maker-dot]');
        if (dot) {
          goToFrame(Number(dot.dataset.makerFrame || 0));
          return;
        }

        if (event.target.closest('[data-maker-prev]')) {
          goToFrame(activeFrame - 1);
          return;
        }

        if (event.target.closest('[data-maker-next]')) {
          goToFrame(activeFrame + 1);
        }
      });

      slider.addEventListener(
        'scroll',
        function () {
          if (scrollFrame !== null) return;
          scrollFrame = window.requestAnimationFrame(syncActiveFrameFromScroll);
        },
        { passive: true }
      );

      function handleResize() {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(function () {
          goToFrame(activeFrame, 'auto');
        }, 120);
      }

      window.addEventListener('resize', handleResize);
      carousel.addEventListener('dragstart', function (event) {
        if (event.target.closest('.maker-card__img-link, .maker-card__img')) event.preventDefault();
      });

      var isDown = false;
      var startX = 0;
      var scrollLeft = 0;
      var isDragging = false;
      var dragThreshold = 5;

      slider.addEventListener('mousedown', function (event) {
        isDown = true;
        isDragging = false;
        startX = event.pageX - slider.offsetLeft;
        scrollLeft = slider.scrollLeft;
      });

      function endDrag() {
        isDown = false;
        slider.classList.remove('is-dragging');
      }

      slider.addEventListener('mouseleave', endDrag);
      slider.addEventListener('mouseup', endDrag);

      slider.addEventListener('mousemove', function (event) {
        if (!isDown) return;
        var x = event.pageX - slider.offsetLeft;
        if (!isDragging && Math.abs(x - startX) > dragThreshold) {
          isDragging = true;
          slider.classList.add('is-dragging');
        }
        if (!isDragging) return;
        event.preventDefault();
        slider.scrollLeft = scrollLeft - (x - startX) * 2;
      });

      slider.addEventListener('click', function (event) {
        if (isDragging) event.preventDefault();
      });

      updateCarouselState();
    }

    function scheduleCarousel(carousel) {
      if (!('IntersectionObserver' in window)) {
        initCarousel(carousel);
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            observer.unobserve(entry.target);
            initCarousel(entry.target);
          });
        },
        { rootMargin: '400px 0px' }
      );

      observer.observe(carousel);
    }

    function initMeetMakers(scope) {
      var root = scope || document;
      root.querySelectorAll('[data-maker-carousel]').forEach(scheduleCarousel);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initMeetMakers(document);
      });
    } else {
      initMeetMakers(document);
    }

    document.addEventListener('shopify:section:load', function (event) {
      initMeetMakers(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
