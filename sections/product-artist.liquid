{% comment %}
  Product artist portrait, biography and craftsmanship recognition.
  Identity and experience come from custom.author_info; presentation is
  configurable through the section settings and recognition blocks.
{% endcomment %}

{% liquid
  assign author = blank
  assign author_name = blank
  assign author_bio = blank
  assign author_image_url = blank
  assign author_exp_years = blank
  assign author_role = blank
  assign has_author_info = false
  assign recognition_blocks = section.blocks | where: 'type', 'recognition'
  assign finish_color_entry = metaobjects.variant_finish_color.values | first
  assign portrait_backdrop_url = finish_color_entry.oak.value
  if section.settings.backdrop_image != blank
    assign portrait_backdrop_url = section.settings.backdrop_image | image_url: width: 800
  endif

  if product != blank
    assign author = product.metafields.custom.author_info.value
  endif

  if author != blank
    assign author_name = author.author_name.value
    assign author_bio = author.author_bio.value
    assign author_image_url = author.author_image_url.value
    assign author_role = author.role.value

    # Years of experience come from the author metaobject. `append: ''` coerces a
    # numeric field to a string so it can be inspected; merchants sometimes type
    # the "+" themselves, so only add it when it isn't already there.
    assign author_exp_years = author.exp_years.value | append: '' | strip
    if author_exp_years != blank
      unless author_exp_years contains '+'
        assign author_exp_years = author_exp_years | append: '+'
      endunless
    endif

    if author_name != blank or author_bio != blank or author_image_url != blank or author_role != blank or author_exp_years != blank
      assign has_author_info = true
    endif
  endif
%}

{% if has_author_info %}
  <div class="product-artist">
    <div class="product-artist__card">
      <section
        class="product-artist__inner{% if author_image_url == blank %} product-artist__inner--no-media{% endif %}{% if recognition_blocks.size == 0 %} product-artist__inner--no-recognition{% endif %}"
        aria-labelledby="ProductArtistHeading-{{ section.id }}"
        data-product-author
      >
        {% if author_image_url != blank %}
          <div class="product-artist__media"{% if portrait_backdrop_url != blank %} style="--artist-backdrop: url('{{ portrait_backdrop_url | escape }}');"{% endif %}>
            <img
              class="product-artist__portrait"
              src="{{ author_image_url | escape }}"
              alt="{{ author_name | escape }}"
              width="800"
              height="1200"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            >
          </div>
        {% endif %}

        <div class="product-artist__profile">
          <div class="product-artist__profile-main">
            {% if section.settings.heading != blank %}
              <p class="product-artist__eyebrow">{{ section.settings.heading | escape }}</p>
            {% endif %}
            {% if author_name != blank %}
              <h2 class="product-artist__name" id="ProductArtistHeading-{{ section.id }}">{{ author_name | escape }}</h2>
            {% else %}
              <h2 class="product-artist__sr-only" id="ProductArtistHeading-{{ section.id }}">Meet the artisan</h2>
            {% endif %}
            {% if author_role != blank %}
              <p class="product-artist__role">{{ author_role | escape }}</p>
            {% endif %}
            {% if author_bio != blank %}
              <div class="product-artist__bio">{% render 'product-artist-bio', bio: author_bio %}</div>
            {% endif %}
          </div>

          {% if author_name != blank %}
            <div class="product-artist__signature" aria-hidden="true">{{ author_name | escape }}</div>
          {% endif %}

          {% if section.settings.show_view_profile %}
            {% liquid
              assign author_handle = author_name | handleize
              assign default_profile_link = '/pages/product-author/' | append: author_handle
              assign final_profile_link = author.system.url | default: default_profile_link
              if section.settings.view_profile_link != blank and section.settings.view_profile_link != '#'
                assign final_profile_link = section.settings.view_profile_link
              endif
            %}
            {% if final_profile_link != '/pages/product-author/' %}
              <a class="product-artist__profile-link" href="{{ final_profile_link | escape }}">
                <span>{{ section.settings.view_profile_label | default: 'View profile' | escape }}</span>
                {% render 'product-artist-icon', icon: 'arrow' %}
              </a>
            {% endif %}
          {% endif %}
        </div>

        {% if recognition_blocks.size > 0 %}
          <div class="product-artist__recognition-panel"{% if section.settings.recognition_heading != blank %} aria-label="{{ section.settings.recognition_heading | escape }}"{% endif %}>
            <div class="product-artist__recognition-body">
              <ul class="product-artist__recognition" role="list">
                {% for block in recognition_blocks %}
                  <li class="product-artist__recognition-item" {{ block.shopify_attributes }}>
                    {% assign recognition_icon_id = section.id | append: '-' | append: block.id %}
                    <span class="product-artist__recognition-icon product-artist__recognition-icon--{{ block.settings.icon | escape }}" aria-hidden="true">{% render 'product-artist-icon', icon: block.settings.icon, id: recognition_icon_id %}</span>
                    <span class="product-artist__recognition-text">{{ block.settings.text | escape }}</span>
                    {% if block.settings.description != blank %}
                      <span class="product-artist__recognition-description">{{ block.settings.description | escape }}</span>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
              {% if recognition_blocks.size == 4 %}
                <span class="product-artist__recognition-ornament" aria-hidden="true">{% render 'product-artist-icon', icon: 'ornament' %}</span>
              {% endif %}
            </div>
            <div class="product-artist__recognition-summary{% if author_exp_years == blank %} product-artist__recognition-summary--single{% endif %}">
              {% if author_exp_years != blank %}
                <div class="product-artist__summary-cell">
                  <span class="product-artist__summary-value">{{ author_exp_years | escape }}</span>
                  {% if section.settings.recognition_heading != blank %}
                    <span class="product-artist__summary-label">{{ section.settings.recognition_heading | escape }}</span>
                  {% endif %}
                </div>
              {% endif %}
              <div class="product-artist__summary-cell product-artist__summary-cell--maker">
                {% if author_name != blank %}<span class="product-artist__summary-signature">{{ author_name | escape }}</span>{% endif %}
                {% if author_role != blank %}<span class="product-artist__summary-label">{{ author_role | escape }}</span>{% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </section>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .product-artist {
    --artist-border: color-mix(in srgb, var(--color-clay) 30%, transparent);
    --artist-surface: color-mix(in srgb, var(--color-white-cream) 48%, #fff);
    --artist-circle: color-mix(in srgb, var(--color-milk) 65%, #eadccc);
    --artist-signature-font: "Segoe Script", "Apple Chancery", "Brush Script MT", cursive;
    width: 100%;
    padding: 88px 48px 88px 64px;
    background: var(--artist-surface);
    color: var(--text-primary);
    font-family: var(--font-roboto);
  }
  .product-artist__card {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    background: transparent;
  }
  .product-artist__inner {
    display: grid;
    grid-template-columns: minmax(0, 420fr) minmax(0, 292fr) minmax(0, 616fr);
    gap: 48px;
    align-items: stretch;
    min-height: 0;
    height: auto;
  }
  .product-artist__inner--no-media {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
  }
  .product-artist__inner--no-recognition {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    max-width: 1000px;
    margin-inline: auto;
  }
  .product-artist__inner--no-media.product-artist__inner--no-recognition {
    grid-template-columns: minmax(0, 1fr);
    max-width: 680px;
  }
  .product-artist__media {
    position: relative;
    isolation: isolate;
    min-width: 0;
    min-height: 864px;
    height: 100%;
    padding-block: 32px;
    background: transparent;
  }
  .product-artist__media::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 36px 0 64px;
    border-radius: 4px;
    background-color: #e8d7c4;
    background-image: var(--artist-backdrop, none);
    background-size: cover;
    background-position: center;
    opacity: .3;
    filter: saturate(.5);
  }
  .product-artist__portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 6px;
    filter: grayscale(1) sepia(.1);
  }
  .product-artist__profile {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-width: 0;
    padding: 34px 0 16px;
    border: 0;
  }
  .product-artist__profile-main { min-width: 0; }
  .product-artist__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 8px;
    color: var(--color-earth-brown);
    font-family: var(--font-roboto);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: .3em;
    text-transform: uppercase;
  }
  .product-artist__eyebrow::after {
    content: '';
    flex: 0 1 88px;
    width: 88px;
    min-width: 24px;
    height: 1px;
    background: var(--artist-border);
  }
  .product-artist__name {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-display-light);
    font-size: 76px;
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -.035em;
    text-align: left;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .product-artist__role {
    margin: 10px 0 0;
    color: var(--color-earth-brown);
    font-family: var(--font-roboto);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: .26em;
    text-transform: uppercase;
    text-align: left;
    overflow-wrap: anywhere;
  }
  .product-artist__bio {
    position: relative;
    margin-top: 24px;
    padding-top: 30px;
    border: 0;
    color: var(--color-earth-brown);
    font-family: var(--font-roboto);
    font-size: 18px;
    line-height: 1.42;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .product-artist__bio::before,
  .product-artist__signature::after {
    content: '';
    position: absolute;
    left: 0;
    width: 48px;
    height: 1px;
    background: var(--color-clay);
  }
  .product-artist__bio::before { top: 0; }
  .product-artist__bio p { margin: 0 0 18px; }
  .product-artist__bio p:last-child { margin-bottom: 0; }
  .product-artist__signature {
    position: relative;
    display: block;
    margin-top: auto;
    padding-top: 18px;
    padding-bottom: 14px;
    color: var(--color-earth-brown);
    font-family: var(--artist-signature-font);
    font-size: 46px;
    font-weight: 400;
    font-style: normal;
    line-height: 1.35;
    letter-spacing: -.08em;
    overflow-wrap: anywhere;
  }
  .product-artist__signature::after { bottom: 0; }
  .product-artist__profile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 58px;
    margin: 20px 0 0;
    padding: 12px 28px;
    border-radius: 6px;
    background: var(--color-earth-brown);
    color: var(--color-white-cream);
    font-family: var(--font-display-light);
    font-size: 24px;
    font-weight: 300;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color .2s ease;
  }
  .product-artist__profile-link svg {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    stroke-width: 1;
    transition: transform .2s ease;
  }
  .product-artist__profile-link svg [stroke-width] { stroke-width: 1; }
  .product-artist__profile-link:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 4px;
  }
  .product-artist__recognition-panel {
    display: grid;
    grid-template-rows: minmax(min-content, 1fr) auto;
    min-width: 0;
    margin-block: 4px 16px;
    padding: 0;
    border: 1px solid var(--artist-border);
    border-radius: 9px;
    background: transparent;
  }
  .product-artist__recognition-body { position: relative; min-width: 0; }
  .product-artist__recognition {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(min-content, 1fr));
    gap: 44px 24px;
    height: 100%;
    margin: 0;
    padding: 34px 28px 26px;
    list-style: none;
  }
  .product-artist__recognition::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 28px;
    right: 28px;
    height: 1px;
    background: var(--artist-border);
  }
  .product-artist__recognition-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    min-width: 0;
    margin: 0;
    padding: 16px 6px 24px;
    border: 0;
    text-align: center;
  }
  .product-artist__recognition-item:nth-child(odd) {
    border-right: 0;
  }
  .product-artist__recognition-item:nth-child(odd)::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: -12px;
    width: 1px;
    background: var(--artist-border);
  }
  .product-artist__recognition-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 112px;
    height: 112px;
    margin-bottom: 18px;
    border: 0;
    border-radius: 50%;
    background: var(--artist-circle);
    color: var(--color-earth-brown);
  }
  .product-artist__recognition-icon svg {
    width: 64px;
    height: 64px;
  }
  .product-artist__recognition-icon [stroke-width] { stroke-width: 1.1; }
  .product-artist__recognition-icon:is(.product-artist__recognition-icon--award, .product-artist__recognition-icon--leaf, .product-artist__recognition-icon--check) svg {
    width: 130px;
    height: 130px;
  }
  .product-artist__recognition-icon svg > [class$='-cls-1'] { display: none; }
  .product-artist__recognition-icon--hand [stroke-width] { stroke-width: .7; }
  .product-artist__recognition-text {
    color: var(--color-earth-brown);
    font-family: var(--font-display-light);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: .045em;
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .product-artist__recognition-text::after {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    margin: 17px auto 18px;
    background: var(--color-clay);
  }
  .product-artist__recognition-description {
    max-width: 24ch;
    color: var(--color-earth-brown);
    font-family: var(--font-roboto);
    font-size: 16px;
    line-height: 1.5;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .product-artist__recognition-ornament {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--artist-surface);
    color: var(--color-clay);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .product-artist__recognition-ornament svg { width: 22px; height: 22px; }
  .product-artist__recognition-ornament svg [stroke-width] { stroke-width: 1; }
  .product-artist__recognition-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-height: 152px;
    margin: 0;
    padding-block: 28px;
    border: 0;
    border-top: 1px solid var(--artist-border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-milk) 65%, #e8d9c8);
  }
  .product-artist__recognition-summary--single { grid-template-columns: minmax(0, 1fr); }
  .product-artist__summary-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 0;
    padding: 0 20px;
    text-align: center;
  }
  .product-artist__summary-cell + .product-artist__summary-cell { border-left: 1px solid var(--artist-border); }
  .product-artist__summary-value {
    color: var(--color-earth-brown);
    font-family: var(--font-display-light);
    font-size: 56px;
    font-weight: 300;
    line-height: 1;
  }
  .product-artist__summary-signature {
    display: block;
    max-width: 100%;
    overflow: visible;
    color: var(--color-earth-brown);
    font-family: var(--artist-signature-font);
    font-size: 40px;
    font-weight: 400;
    font-style: normal;
    line-height: 1.35;
    letter-spacing: -.08em;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .product-artist__summary-label {
    color: var(--color-earth-brown);
    font-family: var(--font-roboto);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: .2em;
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .product-artist__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (hover: hover) {
    .product-artist__profile-link:hover { background: var(--color-dark-clay); }
    .product-artist__profile-link:hover svg { transform: translateX(3px); }
  }
  @media (max-width: 1399px) {
    .product-artist { padding: 64px 32px; }
    .product-artist__inner { gap: 32px; }
    .product-artist__name { font-size: 64px; }
    .product-artist__bio { font-size: 17px; }
    .product-artist__media { min-height: 820px; }
    .product-artist__recognition { padding-inline: 20px; gap: 36px 20px; }
    .product-artist__recognition::before { left: 20px; right: 20px; }
    .product-artist__recognition-item:nth-child(odd)::after { right: -10px; }
    .product-artist__recognition-icon { width: 96px; height: 96px; }
    .product-artist__recognition-icon svg { width: 58px; height: 58px; }
    .product-artist__recognition-icon:is(.product-artist__recognition-icon--award, .product-artist__recognition-icon--leaf, .product-artist__recognition-icon--check) svg { width: 112px; height: 112px; }
    .product-artist__recognition-text { font-size: 15px; }
    .product-artist__recognition-description { font-size: 15px; }
    .product-artist__summary-signature { font-size: 34px; }
    .product-artist__summary-label { letter-spacing: .14em; }
  }
  @media (max-width: 1279px) {
    .product-artist__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px 32px; }
    .product-artist__inner--no-media { grid-template-columns: minmax(0, 1fr); }
    .product-artist__media { min-height: 620px; }
    .product-artist__profile { padding: 24px 0; }
    .product-artist__name { font-size: 68px; }
    .product-artist__bio { font-size: 18px; }
    .product-artist__recognition-panel { grid-column: 1 / -1; margin: 0; }
    .product-artist__recognition { padding: 28px; gap: 40px 32px; }
    .product-artist__recognition-item { padding: 24px 12px; border: 0; }
    .product-artist__recognition-item:nth-child(odd)::after { right: -16px; }
    .product-artist__recognition-icon { width: 104px; height: 104px; }
    .product-artist__recognition-text { font-size: 16px; }
    .product-artist__recognition-description { font-size: 16px; }
    .product-artist__summary-signature { font-size: 40px; }
  }
  @media (max-width: 849px) {
    .product-artist__name { font-size: 58px; }
    .product-artist__bio { font-size: 17px; line-height: 1.5; }
    .product-artist__recognition-icon { width: 96px; height: 96px; }
  }
  @media (max-width: 699px) {
    .product-artist { padding: 32px var(--layout-padding-mobile, 16px); }
    .product-artist__inner,
    .product-artist__inner--no-media,
    .product-artist__inner--no-recognition { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .product-artist__media { min-height: 0; height: auto; padding-block: 24px; aspect-ratio: auto; margin: 0; }
    .product-artist__media::before { inset-inline: 40px 24px; }
    .product-artist__portrait { height: auto; aspect-ratio: 2 / 3; object-position: center; }
    .product-artist__profile { padding: 0; border: 0; }
    .product-artist__profile-main { display: block; }
    .product-artist__eyebrow { margin-bottom: 8px; font-size: 13px; letter-spacing: .26em; text-align: left; }
    .product-artist__name { font-size: 56px; text-align: left; }
    .product-artist__role { font-size: 13px; letter-spacing: .18em; }
    .product-artist__bio { margin-top: 24px; padding-top: 24px; font-size: 16px; line-height: 1.6; }
    .product-artist__signature { display: block; margin-top: 18px; padding-top: 0; font-size: 42px; }
    .product-artist__profile-link { min-height: 56px; padding-inline: 24px; font-size: 22px; }
    .product-artist__recognition-panel { padding: 0; }
    .product-artist__recognition { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 20px 16px; gap: 32px 16px; }
    .product-artist__recognition::before { left: 16px; right: 16px; }
    .product-artist__recognition-item { min-height: 0; padding: 12px 2px 20px; border: 0; }
    .product-artist__recognition-item:nth-child(odd) { border-right: 0; }
    .product-artist__recognition-item:nth-child(odd)::after { right: -8px; }
    .product-artist__recognition-icon { width: 80px; height: 80px; margin-bottom: 16px; }
    .product-artist__recognition-icon svg { width: 48px; height: 48px; }
    .product-artist__recognition-icon:is(.product-artist__recognition-icon--award, .product-artist__recognition-icon--leaf, .product-artist__recognition-icon--check) svg { width: 94px; height: 94px; }
    .product-artist__recognition-text { font-size: 14px; letter-spacing: .025em; }
    .product-artist__recognition-text::after { margin-block: 14px; }
    .product-artist__recognition-description { font-size: 15px; line-height: 1.5; }
    .product-artist__recognition-summary { margin: 0; min-height: 144px; padding-block: 24px; }
    .product-artist__summary-cell { gap: 10px; padding-inline: 12px; }
    .product-artist__summary-value { font-size: 48px; }
    .product-artist__summary-signature { font-size: 30px; }
    .product-artist__summary-label { font-size: 13px; letter-spacing: .1em; }
  }
  @media (max-width: 359px) {
    .product-artist__name { font-size: 48px; }
    .product-artist__recognition { padding-inline: 12px; }
    .product-artist__recognition-icon { width: 72px; height: 72px; }
    .product-artist__recognition-icon:is(.product-artist__recognition-icon--award, .product-artist__recognition-icon--leaf, .product-artist__recognition-icon--check) svg { width: 84px; height: 84px; }
    .product-artist__recognition-description { font-size: 14px; }
    .product-artist__summary-signature { font-size: 27px; }
    .product-artist__summary-label { letter-spacing: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-artist__profile-link,
    .product-artist__profile-link svg { transition: none; }
  }
{% endstylesheet %}

