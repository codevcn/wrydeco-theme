{% javascript %}
  (() => {
    const roots = document.querySelectorAll('[data-real-spaces]:not([data-real-spaces-ready])');

    roots.forEach((root) => {
      root.dataset.realSpacesReady = 'true';

      root.querySelectorAll('[data-project-grid]').forEach((slider) => {
        const cards = Array.from(slider.querySelectorAll('[data-project-card]'));
        const controls = root.querySelector('[data-project-controls]');
        const previous = controls && controls.querySelector('[data-project-previous]');
        const next = controls && controls.querySelector('[data-project-next]');
        const dots = controls ? Array.from(controls.querySelectorAll('[data-project-dot]')) : [];
        const status = controls && controls.querySelector('[data-project-carousel-status]');
        const mobile = window.matchMedia('(max-width: 749px)');
        let activeIndex = 0;
        let updateFrame = null;
        let pointerId = null;
        let startX = 0;
        let startScrollLeft = 0;
        let wasDragged = false;

        const positions = () => {
          const left = slider.getBoundingClientRect().left;
          return cards.map(card => card.getBoundingClientRect().left - left + slider.scrollLeft);
        };
        const updateControls = () => {
          if (!controls) return;
          const hasOverflow = mobile.matches && slider.scrollWidth > slider.clientWidth + 1;
          controls.hidden = !hasOverflow;
          if (!hasOverflow) return;
          const offsets = positions();
          activeIndex = offsets.reduce((closest, offset, index) => Math.abs(offset - slider.scrollLeft) < Math.abs(offsets[closest] - slider.scrollLeft) ? index : closest, 0);
          if (slider.scrollLeft >= slider.scrollWidth - slider.clientWidth - 1) activeIndex = cards.length - 1;
          previous.disabled = activeIndex === 0;
          next.disabled = activeIndex === cards.length - 1;
          dots.forEach((dot, index) => {
            if (index === activeIndex) dot.setAttribute('aria-current', 'true');
            else dot.removeAttribute('aria-current');
          });
          const activeDot = dots[activeIndex];
          if (activeDot) {
            const strip = activeDot.parentElement;
            const offset = activeDot.getBoundingClientRect().left - strip.getBoundingClientRect().left + strip.scrollLeft;
            if (offset < strip.scrollLeft) strip.scrollLeft = offset;
            else if (offset + activeDot.offsetWidth > strip.scrollLeft + strip.clientWidth) strip.scrollLeft = offset + activeDot.offsetWidth - strip.clientWidth;
          }
          const text = `Project ${activeIndex + 1} of ${cards.length}`;
          if (status.textContent !== text) status.textContent = text;
        };
        const scheduleUpdate = () => {
          if (updateFrame !== null) return;
          updateFrame = requestAnimationFrame(() => { updateFrame = null; updateControls(); });
        };
        const goTo = index => {
          if (!mobile.matches) return;
          const target = Math.max(0, Math.min(cards.length - 1, index));
          slider.scrollTo({ left: Math.min(positions()[target], slider.scrollWidth - slider.clientWidth), behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        };
        if (controls) {
          previous.addEventListener('click', () => goTo(activeIndex - 1));
          next.addEventListener('click', () => goTo(activeIndex + 1));
          dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));
        }
        slider.addEventListener('scroll', scheduleUpdate, { passive: true });
        window.addEventListener('resize', scheduleUpdate);
        mobile.addEventListener('change', scheduleUpdate);
        if ('ResizeObserver' in window) new ResizeObserver(scheduleUpdate).observe(slider);

        slider.addEventListener('pointerdown', (event) => {
          if (!mobile.matches || event.target.closest('[data-project-compare-range]')) return;
          if (event.pointerType !== 'mouse' || event.button !== 0) return;
          pointerId = event.pointerId;
          startX = event.clientX;
          startScrollLeft = slider.scrollLeft;
          wasDragged = false;
        });
        slider.addEventListener('pointermove', (event) => {
          if (event.pointerId !== pointerId) return;
          const distance = event.clientX - startX;
          if (Math.abs(distance) > 5) {
            wasDragged = true;
            slider.classList.add('is-dragging');
            if (!slider.hasPointerCapture(pointerId)) slider.setPointerCapture(pointerId);
          }
          if (wasDragged) slider.scrollLeft = startScrollLeft - distance;
        });
        const endDrag = (event) => {
          if (event.pointerId !== pointerId) return;
          if (slider.hasPointerCapture(pointerId)) slider.releasePointerCapture(pointerId);
          pointerId = null;
          slider.classList.remove('is-dragging');
          scheduleUpdate();
        };
        slider.addEventListener('pointerup', endDrag);
        slider.addEventListener('pointercancel', endDrag);
        slider.addEventListener('lostpointercapture', () => { pointerId = null; slider.classList.remove('is-dragging'); });
        slider.addEventListener('dragstart', (event) => event.preventDefault());
        slider.addEventListener('click', (event) => {
          if (event.target.closest('[data-project-compare-range]') || !wasDragged) return;
          event.preventDefault();
          event.stopPropagation();
          wasDragged = false;
        }, true);
        updateControls();
      });

      root.querySelectorAll('[data-project-card]').forEach((card) => {
        card.addEventListener('click', (event) => {
          if (event.target.closest('a, button, input, [data-project-comparison]')) return;
          const trigger = card.querySelector('[data-lightbox-trigger]');
          if (trigger) trigger.click();
        });
      });

      let viewportVideoObserver = null;
      const prepareViewportVideo = (video) => {
        if (!video.dataset.viewportReady) {
          video.dataset.viewportReady = 'true';
          video.addEventListener('playing', () => video.classList.add('is-playing'));
          video.addEventListener('pause', () => video.classList.remove('is-playing'));
        }
        if (viewportVideoObserver) viewportVideoObserver.observe(video);
      };
      const startViewportVideos = () => {
        if (!('IntersectionObserver' in window)) return;
        viewportVideoObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const video = entry.target;
              if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
                if (!video.src && video.dataset.src) {
                  video.src = video.dataset.src;
                  video.load();
                }
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { threshold: [0, 0.5, 1] }
        );
        root.querySelectorAll('[data-viewport-video]').forEach(prepareViewportVideo);
      };

      if (document.readyState === 'complete') startViewportVideos();
      else window.addEventListener('load', startViewportVideos, { once: true });

      const hero = root.querySelector('[data-hero-gallery]');
      if (hero) {
        const heroStage = hero.querySelector('[data-hero-stage]');
        const slides = Array.from(hero.querySelectorAll('[data-hero-slide]'));
        const heroCounter = hero.querySelector('[data-hero-counter]');
        let heroIndex = 0;
        const showHeroSlide = (direction) => {
          if (slides.length < 2) return;
          const outgoingVideo = heroStage.querySelector('video');
          if (outgoingVideo) {
            outgoingVideo.pause();
            if (viewportVideoObserver) viewportVideoObserver.unobserve(outgoingVideo);
          }
          heroIndex = (heroIndex + direction + slides.length) % slides.length;
          heroStage.replaceChildren(slides[heroIndex].content.cloneNode(true));
          heroStage.dataset.galleryIndex = String(heroIndex);
          heroCounter.textContent = `${String(heroIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
          const incomingVideo = heroStage.querySelector('video');
          if (incomingVideo) prepareViewportVideo(incomingVideo);
        };
        hero.querySelector('[data-hero-previous]').addEventListener('click', () => showHeroSlide(-1));
        hero.querySelector('[data-hero-next]').addEventListener('click', () => showHeroSlide(1));
        hero.querySelector('.real-spaces__hero-controls').addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          showHeroSlide(event.key === 'ArrowLeft' ? -1 : 1);
        });
      }

      const lightbox = root.querySelector('[data-lightbox]');
      const dialog = root.querySelector('.real-spaces-lightbox__dialog');
      const lightboxContent = root.querySelector('.real-spaces-lightbox__content');
      const stage = root.querySelector('[data-lightbox-stage]');
      const counter = root.querySelector('[data-lightbox-counter]');
      const title = root.querySelector('[data-lightbox-title]');
      const projectLabel = root.querySelector('[data-lightbox-label]');
      const projectAuthor = root.querySelector('[data-lightbox-author]');
      const projectDescription = root.querySelector('[data-lightbox-description]');
      const productLink = root.querySelector('[data-lightbox-product]');
      const thumbnails = root.querySelector('[data-lightbox-thumbnails]');
      const previousButton = root.querySelector('[data-lightbox-previous]');
      const nextButton = root.querySelector('[data-lightbox-next]');
      const closeButton = root.querySelector('.real-spaces-lightbox__close');
      let mediaItems = [];
      let currentIndex = 0;
      let poster = '';
      let returnFocus = null;
      let touchStartX = 0;

      const isVideo = (url) => /\.(mp4|webm|mov)(?:$|\?)/i.test(url);

      const renderLightbox = () => {
        const url = mediaItems[currentIndex];
        const outgoingVideo = stage.querySelector('video');
        if (outgoingVideo) outgoingVideo.pause();
        stage.replaceChildren();

        let media;
        if (isVideo(url)) {
          media = document.createElement('video');
          media.src = url;
          media.poster = poster;
          media.controls = true;
          media.playsInline = true;
          media.preload = 'none';
          media.muted = true;
          media.autoplay = true;
        } else {
          media = document.createElement('img');
          media.src = url;
          media.alt = title.textContent;
        }
        stage.append(media);
        counter.textContent = `${currentIndex + 1} / ${mediaItems.length}`;
        thumbnails.querySelectorAll('button').forEach((button, index) => {
          button.setAttribute('aria-pressed', String(index === currentIndex));
        });
        const activeThumbnail = thumbnails.children[currentIndex];
        if (activeThumbnail) {
          const left = activeThumbnail.offsetLeft - thumbnails.offsetLeft;
          if (left < thumbnails.scrollLeft) thumbnails.scrollLeft = left;
          else if (left + activeThumbnail.offsetWidth > thumbnails.scrollLeft + thumbnails.clientWidth) {
            thumbnails.scrollLeft = left + activeThumbnail.offsetWidth - thumbnails.clientWidth;
          }
        }
      };

      const buildThumbnails = () => {
        thumbnails.replaceChildren();
        mediaItems.forEach((url, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'real-spaces-lightbox__thumbnail';
          button.setAttribute('aria-label', `View ${isVideo(url) ? 'video' : 'image'} ${index + 1}`);
          const thumbnailUrl = isVideo(url) ? poster : url;
          if (thumbnailUrl) {
            const thumbnail = document.createElement('img');
            thumbnail.src = thumbnailUrl;
            thumbnail.alt = '';
            thumbnail.loading = 'lazy';
            thumbnail.decoding = 'async';
            button.append(thumbnail);
          }
          if (isVideo(url)) {
            const videoLabel = document.createElement('span');
            videoLabel.textContent = 'Video';
            button.append(videoLabel);
          }
          button.addEventListener('click', () => {
            currentIndex = index;
            renderLightbox();
          });
          thumbnails.append(button);
        });
        previousButton.disabled = mediaItems.length < 2;
        nextButton.disabled = mediaItems.length < 2;
      };

      const move = (direction) => {
        currentIndex = (currentIndex + direction + mediaItems.length) % mediaItems.length;
        renderLightbox();
      };

      const closeLightbox = () => {
        const activeVideo = stage.querySelector('video');
        if (activeVideo) activeVideo.pause();
        lightbox.hidden = true;
        document.body.classList.remove('real-spaces-lightbox-open');
        if (returnFocus) returnFocus.focus();
      };

      root.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          mediaItems = trigger.dataset.gallery
            .split(',')
            .map((item) => item.trim())
            .filter(Boolean);
          if (!mediaItems.length) return;
          const requestedIndex = Number(trigger.dataset.galleryIndex || 0);
          currentIndex = Number.isInteger(requestedIndex) && requestedIndex >= 0 && requestedIndex < mediaItems.length ? requestedIndex : 0;
          poster = trigger.dataset.poster || '';
          title.textContent = trigger.dataset.title || 'Project gallery';
          projectLabel.textContent = trigger.dataset.featured === 'true' ? 'Featured project' : 'Client project';
          projectAuthor.replaceChildren();
          projectAuthor.hidden = !trigger.dataset.author;
          if (trigger.dataset.author) {
            projectAuthor.append('Crafted by ');
            if (trigger.dataset.authorUrl) {
              const authorLink = document.createElement('a');
              authorLink.href = trigger.dataset.authorUrl;
              authorLink.textContent = trigger.dataset.author;
              projectAuthor.append(authorLink);
            } else projectAuthor.append(trigger.dataset.author);
          }
          projectDescription.textContent = trigger.dataset.description ||
            'Explore the images and videos documenting this WRYDECO piece, handcrafted to order.';
          productLink.hidden = !trigger.dataset.productUrl;
          if (trigger.dataset.productUrl) productLink.href = trigger.dataset.productUrl;
          buildThumbnails();
          returnFocus = trigger;
          lightbox.hidden = false;
          dialog.scrollTop = 0;
          lightboxContent.scrollTop = 0;
          thumbnails.scrollLeft = 0;
          document.body.classList.add('real-spaces-lightbox-open');
          renderLightbox();
          closeButton.focus();
        });
      });

      root
        .querySelectorAll('[data-lightbox-close]')
        .forEach((control) => control.addEventListener('click', closeLightbox));
      previousButton.addEventListener('click', () => move(-1));
      nextButton.addEventListener('click', () => move(1));

      stage.addEventListener(
        'touchstart',
        (event) => {
          touchStartX = event.changedTouches[0].clientX;
        },
        { passive: true }
      );
      stage.addEventListener(
        'touchend',
        (event) => {
          const delta = event.changedTouches[0].clientX - touchStartX;
          if (Math.abs(delta) > 48) move(delta > 0 ? -1 : 1);
        },
        { passive: true }
      );

      lightbox.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeLightbox();
        if (event.key === 'ArrowLeft') move(-1);
        if (event.key === 'ArrowRight') move(1);
        if (event.key === 'Tab') {
          const focusable = Array.from(lightbox.querySelectorAll('button:not([disabled]), a[href], video[controls]'))
            .filter((element) => element.getClientRects().length > 0);
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });
    });
  })();
{% endjavascript %}

