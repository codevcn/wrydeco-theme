{%- liquid
  assign real_space_entries = metaobjects.real_in_spaces.values
  assign featured_entry = blank

  for entry in real_space_entries
    if entry.is_featured.value == true
      assign featured_entry = entry
      break
    endif
  endfor

  if featured_entry == blank
    assign featured_entry = real_space_entries | first
  endif

  assign featured_gallery = featured_entry.gallery_media.value | append: ''
  assign featured_gallery_items = featured_gallery | split: ','
  assign featured_media = featured_gallery_items | first | strip
  assign featured_media_normalized = featured_media | downcase
  assign featured_media_is_video = false
  if featured_media_normalized contains '.mp4'
    assign featured_media_is_video = true
  elsif featured_media_normalized contains '.webm'
    assign featured_media_is_video = true
  elsif featured_media_normalized contains '.mov'
    assign featured_media_is_video = true
  endif
  assign featured_gallery_count = 0
  for gallery_item in featured_gallery_items
    assign normalized_gallery_item = gallery_item | strip
    if normalized_gallery_item != blank
      assign featured_gallery_count = featured_gallery_count | plus: 1
    endif
  endfor
  assign featured_product_url = '/products/' | append: featured_entry.product_handle.value
  assign featured_author = featured_entry.author.value
  assign featured_product = all_products[featured_entry.product_handle.value]
  assign featured_description = featured_product.description | strip_html | strip | truncate: 380
-%}

<section class="real-spaces" id="RealSpaces-{{ section.id }}" data-real-spaces>
  {%- if featured_entry != blank -%}
    <header class="real-spaces__hero" aria-labelledby="RealSpacesTitle-{{ section.id }}" style="--real-spaces-botanical: url('{{ 'real-spaces-botanical.webp' | asset_url }}');">
      <div class="real-spaces__hero-copy">
        <p class="real-spaces__eyebrow">The WRYDECO Journal</p>
        <h1 id="RealSpacesTitle-{{ section.id }}">Wrydeco in Real Spaces</h1>
        <p class="real-spaces__intro">
          An evolving archive of WRYDECO pieces chosen by clients, handcrafted to order, and documented on their
          journey into real spaces.
        </p>

        <div class="real-spaces__featured-meta">
          <p class="real-spaces__featured-label">Featured project</p>
          <h2>{{ featured_entry.title.value | escape }}</h2>
          {%- if featured_author != blank -%}
            <p>
              Crafted by
              <a href="{{ featured_author.system.url }}">{{ featured_author.author_name.value | escape }}</a>
            </p>
          {%- endif -%}
          <a class="real-spaces__text-link" href="{{ featured_product_url }}"><span>View the Piece</span>{% render 'real-space-project-icon', name: 'arrow' %}</a>
          <div class="real-spaces__hero-benefits">
            <div><span class="real-spaces__hero-benefit-icon">{% render 'signature-piece-icon', name: 'craft' %}</span><p><strong>Made to Order</strong><span>Handcrafted by Artisans</span></p></div>
            <div><span class="real-spaces__hero-benefit-icon">{% render 'signature-piece-icon', name: 'shipping' %}</span><p><strong>Ships Worldwide</strong><span>Secure &amp; Insured Delivery</span></p></div>
          </div>
        </div>
      </div>

      <div class="real-spaces__hero-visual" data-hero-gallery>
      <button
        class="real-spaces__hero-media"
        data-hero-stage
        type="button"
        data-lightbox-trigger
        data-gallery="{{ featured_gallery | escape }}"
        data-title="{{ featured_entry.title.value | escape }}"
        data-poster="{{ featured_entry.video_poster.value | escape }}"
        data-author="{{ featured_author.author_name.value | escape }}"
        data-author-url="{{ featured_author.system.url | escape }}"
        data-description="{{ featured_description | escape }}"
        data-product-url="{{ featured_product_url | escape }}"
        data-featured="true"
        aria-label="Open {{ featured_entry.title.value | escape }} gallery"
      >
        {%- if featured_media_is_video -%}
          <video
            data-viewport-video
            data-src="{{ featured_media | escape }}"
            poster="{{ featured_entry.video_poster.value | escape }}"
            preload="none"
            muted
            playsinline
            loop
            aria-label="{{ featured_entry.title.value | escape }} featured project video"
          ></video>
          <span class="real-space-card__play" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/>
            </svg>
          </span>
        {%- else -%}
          <img
            src="{{ featured_media | escape }}"
            alt="{{ featured_entry.title.value | escape }} handcrafted WRYDECO piece"
            width="1920"
            height="2560"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </button>
        {% for gallery_item in featured_gallery_items %}
          {% assign hero_slide_url = gallery_item | strip %}
          {% if hero_slide_url != blank %}
            {% liquid
              assign hero_slide_normalized = hero_slide_url | downcase
              assign hero_slide_video = false
              if hero_slide_normalized contains '.mp4'
                assign hero_slide_video = true
              elsif hero_slide_normalized contains '.webm'
                assign hero_slide_video = true
              elsif hero_slide_normalized contains '.mov'
                assign hero_slide_video = true
              endif
            %}
            <template data-hero-slide>
              {% if hero_slide_video %}
                <video data-viewport-video data-src="{{ hero_slide_url | escape }}" poster="{{ featured_entry.video_poster.value | escape }}" preload="none" muted playsinline loop aria-label="{{ featured_entry.title.value | escape }} featured project video"></video>
                <span class="real-space-card__play" aria-hidden="true">{% render 'real-space-project-icon', name: 'play' %}</span>
              {% else %}
                <img src="{{ hero_slide_url | escape }}" alt="{{ featured_entry.title.value | escape }} handcrafted WRYDECO piece" width="1920" height="2560" loading="lazy" decoding="async">
              {% endif %}
            </template>
          {% endif %}
        {% endfor %}
        <div class="real-spaces__hero-controls" role="group" aria-label="Featured project media">
          <button type="button" data-hero-previous aria-label="Previous featured media"{% if featured_gallery_count < 2 %} disabled{% endif %}>{% render 'real-space-project-icon', name: 'arrow' %}</button>
          <span data-hero-counter aria-live="polite" aria-atomic="true">01 / {{ featured_gallery_count | prepend: '0' | slice: -2, 2 }}</span>
          <button type="button" data-hero-next aria-label="Next featured media"{% if featured_gallery_count < 2 %} disabled{% endif %}>{% render 'real-space-project-icon', name: 'arrow' %}</button>
        </div>
      </div>
    </header>
  {%- endif -%}

  <section class="real-spaces__projects" aria-labelledby="RealProjectsTitle-{{ section.id }}">
    <div class="real-spaces__section-heading">
      <div>
        <p class="real-spaces__eyebrow">Made for real spaces</p>
        <h2 id="RealProjectsTitle-{{ section.id }}">Crafted for Our Clients</h2>
      </div>
      <p>
        A growing archive of WRYDECO designs chosen by clients—each one handcrafted to order and documented as it
        comes to life.
      </p>
    </div>

    {% paginate metaobjects.real_in_spaces.values by 19 %}
      {% assign carousel_count = 0 %}
      <div class="real-spaces__project-grid" id="RealProjectsCarousel-{{ section.id }}" data-project-grid="projects">
        {% for entry in metaobjects.real_in_spaces.values %}
          {% assign card_media = entry.gallery_media.value | split: ',' | first | strip %}
          {% if card_media != blank %}
            {% assign carousel_count = carousel_count | plus: 1 %}
            {% liquid
              assign card_featured = false
              assign card_product = blank
              if entry.product_handle.value == featured_entry.product_handle.value
                assign card_product = featured_product
              else
                assign card_product = all_products[entry.product_handle.value]
              endif
              assign card_description = card_product.description | strip_html | strip | truncate: 380
              if entry.system.id == featured_entry.system.id
                assign card_featured = true
              endif
            %}
            {% render 'real-space-project-card', entry: entry, product: card_product, description: card_description, featured: card_featured %}
          {% endif %}
        {% endfor %}
      </div>
      {% if carousel_count > 1 %}
        <div class="real-spaces__carousel-controls" data-project-controls role="group" aria-label="Project carousel navigation" hidden>
          <button class="real-spaces__carousel-button real-spaces__carousel-button--previous" type="button" data-project-previous aria-controls="RealProjectsCarousel-{{ section.id }}" aria-label="Previous project" disabled>{% render 'real-space-project-icon', name: 'arrow' %}</button>
          <div class="real-spaces__carousel-dots" data-project-dots role="group" aria-label="Choose a project">
            {% for index in (1..carousel_count) %}
              <button class="real-spaces__carousel-dot" type="button" data-project-dot="{{ index | minus: 1 }}" aria-controls="RealProjectsCarousel-{{ section.id }}" aria-label="Go to project {{ index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
            {% endfor %}
          </div>
          <button class="real-spaces__carousel-button" type="button" data-project-next aria-controls="RealProjectsCarousel-{{ section.id }}" aria-label="Next project">{% render 'real-space-project-icon', name: 'arrow' %}</button>
          <span class="real-spaces__carousel-status" data-project-carousel-status aria-live="polite" aria-atomic="true"></span>
        </div>
      {% endif %}
      {% if paginate.pages > 1 %}
        <nav class="real-spaces__pagination" aria-label="Project pages">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endpaginate %}

  </section>

  <div class="real-spaces-lightbox" data-lightbox hidden>
    <div class="real-spaces-lightbox__backdrop" data-lightbox-close></div>
    <div
      class="real-spaces-lightbox__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="RealSpacesLightboxTitle-{{ section.id }}"
    >
      <button class="real-spaces-lightbox__close" type="button" data-lightbox-close aria-label="Close gallery">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
          <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
      <div class="real-spaces-lightbox__media-panel">
        <div class="real-spaces-lightbox__stage" data-lightbox-stage></div>
        <button class="real-spaces-lightbox__arrow real-spaces-lightbox__arrow--previous" type="button" data-lightbox-previous aria-label="Previous media">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18l-6-6l6-6"/>
          </svg>
        </button>
        <button class="real-spaces-lightbox__arrow real-spaces-lightbox__arrow--next" type="button" data-lightbox-next aria-label="Next media">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18l6-6l-6-6"/>
          </svg>
        </button>
      </div>
      <div class="real-spaces-lightbox__content custom-scrollbar">
        <div class="real-spaces-lightbox__project-info">
          <p class="real-spaces-lightbox__eyebrow" data-lightbox-label>Client project</p>
          <h2 id="RealSpacesLightboxTitle-{{ section.id }}" data-lightbox-title>Project gallery</h2>
          <p class="real-spaces-lightbox__author" data-lightbox-author></p>
          <p class="real-spaces-lightbox__description" data-lightbox-description></p>
          <a class="real-spaces-lightbox__product-link" data-lightbox-product><span>View the Piece</span>{% render 'real-space-project-icon', name: 'arrow' %}</a>
        </div>
        <div class="real-spaces-lightbox__gallery">
          <p data-lightbox-counter aria-live="polite">1 / 1</p>
          <div class="real-spaces-lightbox__thumbnails" data-lightbox-thumbnails role="group" aria-label="Project media"></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  body:has(.real-spaces) .header__icon--search,
  body:has(.real-spaces) .header__icon--wishlist,
  body:has(.real-spaces) .header__icon--cart,
  body:has(.real-spaces) .header__icon--menu,
  body:has(.real-spaces) .header__icon--account,
  body:has(.real-spaces) .header__localization .loc-picker__code,
  body:has(.real-spaces) .header__localization .loc-picker__chevron {
    color: var(--color-earth-brown);
  }

  body:has(.real-spaces) .Vtl-WishlistHeader__HeartIconWrapper {
    fill: var(--color-earth-brown) !important;
  }

  body:has(.real-spaces) .loc-picker__option .loc-picker__code {
    color: var(--color-earth-brown) !important;
  }

  .real-spaces {
    --rs-ink: var(--color-earth-brown, #4a2c18);
    --rs-cream: var(--color-cream, #f7f2ec);
    --rs-line: rgba(74, 44, 24, 0.2);
    background-color: #fefbf7;
    color: var(--rs-ink);
    font-family: var(--font-roboto);
    padding-top: calc(var(--gap-main-content-to-header) + 20px);
  }

  .real-spaces button,
  .real-spaces a {
    -webkit-tap-highlight-color: transparent;
  }

  .real-spaces__hero {
    display: grid;
    grid-template-columns: minmax(350px, 0.385fr) minmax(0, 0.615fr);
    margin: 0 16px;
    border: 1px solid var(--rs-line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--rs-cream);
  }

  .real-spaces__hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(40px, 4.5vw, 80px) clamp(32px, 3.9vw, 72px) 40px;
    background: #faf7f2;
    overflow: hidden;
  }
  .real-spaces__hero-copy::before { content: ''; position: absolute; top: 32px; right: -34px; width: min(58%, 280px); aspect-ratio: 992 / 1586; background: var(--real-spaces-botanical) center / contain no-repeat; mask-image: radial-gradient(ellipse at 70% 50%, #000 48%, transparent 75%); opacity: .5; mix-blend-mode: multiply; pointer-events: none; }
  .real-spaces__hero-copy > * { position: relative; }
  .real-spaces__hero-copy > .real-spaces__eyebrow { margin-bottom: 22px; font-size: 11px; letter-spacing: .3em; }
  .real-spaces__hero-copy > .real-spaces__eyebrow::after { content: ''; display: block; width: 32px; height: 2px; margin-top: 18px; background: #c49870; }

  .real-spaces__eyebrow {
    margin: 0 0 22px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .real-spaces__hero h1 {
    max-width: 620px;
    margin: 0;
    font-family: var(--font-display-light);
    font-size: clamp(52px, 5.4vw, 96px);
    font-weight: 400;
    letter-spacing: -.05em;
    line-height: .98;
    text-wrap: balance;
  }
  .real-spaces__intro { margin: 28px 0 0; color: #654b3b; font-size: clamp(17px, 1.4vw, 23px); line-height: 1.6; }
  .real-spaces__featured-meta { margin-top: 30px; padding-top: 28px; border-top: 1px solid var(--rs-line); }

  .real-spaces__featured-label {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .real-spaces__featured-meta h2 { margin: 0 0 12px; font-family: var(--font-display-light); font-size: clamp(28px, 2.7vw, 46px); font-weight: 400; letter-spacing: -.04em; line-height: 1.08; }
  .real-spaces__featured-meta p:not(.real-spaces__featured-label),
  .real-space-card__details p {
    margin: 0;
    color: rgba(74, 44, 24, 0.72);
    font-size: 14px;
  }

  .real-spaces__featured-meta a,
  .real-space-card__details p a {
    color: inherit;
    text-decoration-color: rgba(74, 44, 24, 0.35);
    text-underline-offset: 3px;
  }
  .real-spaces__hero .real-spaces__featured-meta > p:not(.real-spaces__featured-label) { font-size: clamp(14px, 1.2vw, 20px); }

  .real-spaces__hero .real-spaces__text-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(100%, 390px);
    min-height: 56px;
    margin-top: 22px;
    padding: 12px 26px;
    border: 1px solid #63452f;
    border-radius: 8px;
    background: linear-gradient(110deg, #4a2c18, #64452f);
    box-shadow: 0 12px 24px rgb(74 44 24 / 12%);
    color: var(--color-white-cream);
    font-family: var(--font-display-light);
    font-size: clamp(22px, 1.9vw, 30px);
    line-height: 1.2;
    text-decoration: none;
    transition: transform var(--timing-short) var(--ease-standard),
                box-shadow var(--timing-short) var(--ease-standard),
                filter var(--timing-short) var(--ease-standard);
  }
  .real-spaces__hero .real-spaces__text-link > * {
    pointer-events: none;
  }
  .real-spaces__text-link svg {
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    transition: transform var(--timing-short) var(--ease-standard);
  }
  .real-spaces__hero-benefits { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 28px; }
  .real-spaces__hero-benefits > div { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .real-spaces__hero-benefits > div + div { border-left: 1px solid var(--rs-line); padding-left: 18px; }
  .real-spaces__hero-benefit-icon { display: grid; place-items: center; flex: 0 0 44px; height: 44px; border-radius: var(--radius-full); background: #efe4d6; color: #67452f; }
  .real-spaces__hero-benefit-icon svg { width: 26px; height: 26px; stroke-width: 1.5; }
  .real-spaces__hero-benefits p { display: flex; flex-direction: column; gap: 4px; min-width: 0; line-height: 1.3; }
  .real-spaces__hero-benefits p strong { color: var(--rs-ink); font-size: clamp(12px, .95vw, 16px); font-weight: 500; }
  .real-spaces__hero-benefits p span { color: #947b68; font-size: clamp(10px, .8vw, 13px); }
  .real-spaces__hero-visual { position: relative; min-width: 0; min-height: 740px; }
  .real-spaces__hero-visual .real-spaces__hero-media { position: absolute; inset: 0; height: 100%; }
  .real-spaces__hero-controls { position: absolute; z-index: 3; right: 28px; bottom: 28px; display: flex; align-items: center; border-radius: var(--radius-full); background: rgb(255 249 242 / 92%); color: var(--rs-ink); }
  .real-spaces__hero-controls button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: var(--radius-full); background: transparent; color: inherit; cursor: pointer; }
  .real-spaces__hero-controls button:disabled { opacity: .4; cursor: default; }
  .real-spaces__hero-controls svg { width: 18px; height: 18px; }
  .real-spaces__hero-controls [data-hero-previous] svg { transform: rotate(180deg); }
  .real-spaces__hero-controls span { min-width: 62px; text-align: center; font-size: 12px; font-weight: 600; letter-spacing: .08em; font-variant-numeric: tabular-nums; }
  .real-spaces__hero :is(a, button):focus-visible { outline: 2px solid #c49870; outline-offset: -4px; }
  @media (hover: hover) {
    .real-spaces__hero .real-spaces__text-link:hover {
      filter: brightness(0.92);
      box-shadow: 0 14px 28px rgb(74 44 24 / 20%);
    }
    .real-spaces__hero .real-spaces__text-link:hover svg {
      transform: translateX(4px);
    }
    .real-spaces__hero-controls button:hover { background: #e9dbca; }
  }

  .real-spaces__hero .real-spaces__text-link:active {
    transform: translateY(1px);
    box-shadow: 0 6px 14px rgb(74 44 24 / 16%);
  }

  .real-spaces__hero-media,
  .real-space-card__media {
    position: relative;
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: #ded7ce;
    color: inherit;
    cursor: zoom-in;
  }

  .real-spaces__hero-media img,
  .real-spaces__hero-media video,
  .real-space-card__media img,
  .real-space-card__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .real-spaces__hero-media img,
  .real-spaces__hero-media video {
    position: absolute;
    inset: 0;
  }

  .real-spaces__hero-media:hover img,
  .real-spaces__hero-media:hover video,
  .real-space-card__media:hover img,
  .real-space-card__media:hover video {
    transform: scale(1.025);
  }

  .real-spaces__media-index,
  .real-space-card__count {
    position: absolute;
    z-index: 2;
    right: 18px;
    bottom: 18px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.88);
    color: var(--rs-ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .real-spaces__projects {
    max-width: var(--layout-showcase-max-width, 1720px);
    margin: 0 auto;
    padding: 86px var(--layout-padding-desktop, 48px) 84px;
  }

  .real-spaces__section-heading {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: end;
    gap: 72px;
    margin-bottom: 48px;
  }

  .real-spaces__section-heading .real-spaces__eyebrow {
    margin-bottom: 14px;
  }

  .real-spaces__section-heading h2 {
    margin: 0;
    font-family: var(--font-heading, var(--font-roboto));
    font-size: clamp(46px, 5vw, 76px);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .real-spaces__section-heading > p {
    max-width: 480px;
    margin: 0 0 5px auto;
    font-size: 17px;
    line-height: 1.65;
  }

  .real-spaces__project-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: stretch;
    gap: 24px;
    padding: 4px 0 10px;
  }

  .real-spaces__project-grid::-webkit-scrollbar {
    display: none;
  }

  .real-spaces__project-grid.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    scroll-snap-type: none;
    user-select: none;
  }

  .real-spaces__carousel-controls { display: none; }
  .real-spaces__carousel-controls[hidden] { display: none; }
  .real-spaces__carousel-button { display: grid; place-items: center; flex: 0 0 44px; width: 44px; height: 44px; padding: 0; border: 1px solid var(--border-default); border-radius: var(--radius-full); background: var(--color-white-cream); color: var(--color-earth-brown); cursor: pointer; }
  .real-spaces__carousel-button svg { width: 20px; height: 20px; }
  .real-spaces__carousel-button--previous svg { transform: rotate(180deg); }
  .real-spaces__carousel-button:disabled { opacity: .35; cursor: default; }
  .real-spaces__carousel-dots { display: flex; min-width: 0; flex: 1; justify-content: safe center; overflow-x: auto; scrollbar-width: none; }
  .real-spaces__carousel-dots::-webkit-scrollbar { display: none; }
