<section class="mto" aria-labelledby="MadeToOrderHeading-{{ section.id }}" id="MadeToOrder-{{ section.id }}">
  <div class="mto__inner">
    <header class="mto__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mto__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="mto__heading" id="MadeToOrderHeading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    </header>

    <ol class="mto__steps" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks limit: 5 -%}
        <li class="mto__step" {{ block.shopify_attributes }}>
          <div class="mto__step-head">
            <div class="mto__icon-wrap" aria-hidden="true">
              <span class="mto__step-icon">
                {%- case block.settings.icon -%}
                  {%- when 'consult' -%}
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
                      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                        <path d="M20 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v3"/>
                        <path d="M2 16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v1.5a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5V11a2 2 0 0 0-4 0zm2 2v2m16-2v2M12 4v9"/>
                      </g>
                    </svg>
                  {%- when 'wood' -%}
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
                      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                        <path d="M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0m-3 6v6m6-3v3"/>
                        <path d="M12 19h8.3a1 1 0 0 0 .7-1.7L18 14h.3a1 1 0 0 0 .7-1.7L16 9h.2a1 1 0 0 0 .8-1.7L13 3l-1.4 1.5"/>
                      </g>
                    </svg>
                  {%- when 'ruler' -%}
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
                      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                        <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
                        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2m4 7h4m-4 5h4m-8-5h.01M8 16h.01"/>
                      </g>
                    </svg>
                  {%- when 'artisan' -%}
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
                      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                        <path d="m15 12-9.373 9.373a1 1 0 0 1-3.001-3L12 9m6 6 4-4"/>
                        <path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"/>
                      </g>
                    </svg>
                  {%- else -%}
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
                      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                        <path d="M5 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0m10 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/>
                        <path d="M5 17H3v-4M2 5h11v12m-4 0h6m4 0h2v-6h-8m0-5h5l3 5M3 9h4"/>
                      </g>
                    </svg>
                {%- endcase -%}
              </span>
            </div>
            <span class="mto__step-num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          </div>
          <h3 class="mto__step-title">{{ block.settings.title | escape }}</h3>
        </li>
      {%- endfor -%}
    </ol>

    <div class="mto__footer">
      {%- if section.settings.button_label != blank -%}
        <a class="mto__btn" href="{{ section.settings.button_link | default: routes.root_url }}">
          <span>{{ section.settings.button_label | escape }}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .mto {
    width: 100%;
    padding: var(--section-padding-y, 80px) 24px;
    background: radial-gradient(circle at 82% 0%, rgba(255, 255, 255, 0.72), transparent 38%),
      linear-gradient(180deg, #f6f1ea 0%, #f3ece3 100%);
    color: var(--color-text, #2f2118);
    overflow: hidden;
  }

  .mto__inner {
    width: min(100%, calc(var(--page-max-width, 1440px) - var(--container-padding-x, 48px) * 2));
    margin-inline: auto;
  }

  .mto__intro {
    display: block;
    max-width: 900px;
    margin: 0 0 clamp(32px, 3.5vw, 48px);
  }

  .mto__eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: var(--eyebrow-size, 12px);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--eyebrow-tracking, 0.3em);
    text-transform: uppercase;
    color: var(--color-brown);
  }

  .mto__heading {
    margin: 0 0 18px;
    font-family: var(--font-heading);
    font-size: var(--section-heading-size, 48px);
    font-weight: var(--font-weight-light);
    line-height: var(--section-heading-line, 1.02);
    letter-spacing: var(--section-heading-tracking, -0.02em);
    color: var(--color-text, #2d1c13);
    text-wrap: balance;
  }

  .mto__subtext {
    max-width: 560px;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--section-subtitle-size, 16px);
    line-height: 1.6;
    color: var(--color-muted, #3e3732);
    text-wrap: pretty;
  }

  .mto__steps {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(190px, 70vw);
    gap: 18px;
    margin: 0;
    padding: 0 0 12px;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .mto__steps::-webkit-scrollbar {
    display: none;
  }

  .mto__step {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    text-align: left;
    scroll-snap-align: start;
    padding-left: clamp(14px, 1.3vw, 22px);
    border-left: 1px solid var(--color-border, rgba(74, 44, 24, 0.16));
  }

  .mto__step-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .mto__icon-wrap {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgba(91, 60, 39, 0.4);
    border-radius: 999px;
    background: rgba(255, 252, 248, 0.55);
    color: #6b4a33;
    transition: background-color var(--timing-short) var(--ease-standard),
      border-color var(--timing-short) var(--ease-standard), color var(--timing-short) var(--ease-standard);
  }

  .mto__step:hover .mto__icon-wrap {
    border-color: var(--color-brown, #4a2c18);
    background: #fffcf8;
    color: var(--color-brown, #4a2c18);
  }

  .mto__step-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }

  .mto__step-icon svg {
    width: 32px;
    height: 32px;
  }

  .mto__step-num {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(34px, 2.6vw, 44px);
    font-weight: var(--font-weight-light, 300);
    line-height: 1;
    color: rgba(74, 44, 24, 0.88);
    font-variant-numeric: tabular-nums;
  }

  .mto__step-title {
    max-width: 230px;
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(16px, 1.15vw, 19px);
    font-weight: var(--font-weight-regular);
    line-height: 1.12;
    letter-spacing: 0;
    color: var(--color-text, #2d1c13);
    text-wrap: balance;
  }

  .mto__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: clamp(32px, 3.5vw, 48px);
    padding-top: clamp(22px, 2.2vw, 30px);
    border-top: 1px solid var(--color-border, rgba(74, 44, 24, 0.16));
  }

  .mto__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-width: min(100%, 260px);
    min-height: var(--btn-height, 52px);
    padding: 0 var(--btn-padding-x, 32px);
    border-radius: var(--btn-radius, 4px);
    background: var(--color-brown, #4a2c18);
    color: #fff8f0;
    font-family: var(--font-body);
    font-size: var(--btn-font-size, 14px);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    box-shadow: 0 14px 30px rgba(59, 31, 15, 0.12);
    transition: transform var(--timing-short) var(--ease-standard),
      background-color var(--timing-short) var(--ease-standard), box-shadow var(--timing-short) var(--ease-standard);
  }

  .mto__btn svg {
    width: 16px;
    height: 16px;
    transition: transform var(--timing-short) var(--ease-standard);
  }

  .mto__btn:focus-visible {
    outline: 3px solid rgba(122, 137, 104, 0.38);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .mto__btn:hover {
      color: #fff8f0;
      background: var(--color-brown-dark, #2f1a0d);
      transform: translateY(-2px);
      box-shadow: 0 18px 34px rgba(59, 31, 15, 0.18);
    }

    .mto__btn:hover svg {
      transform: translateX(4px);
    }
  }

  @media screen and (min-width: 48rem) {
    .mto {
      padding-inline: 40px;
    }

    .mto__steps {
      grid-auto-columns: minmax(196px, 32vw);
      gap: 22px;
    }
  }

  @media screen and (min-width: 75rem) {
    .mto {
      padding-inline: var(--container-padding-x, 64px);
    }

    .mto__heading {
      white-space: nowrap;
    }

    .mto__steps {
      grid-auto-flow: initial;
      grid-auto-columns: initial;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(20px, 2vw, 32px);
      overflow: visible;
      padding-bottom: 0;
    }
  }

  @media screen and (max-width: 40rem) {
    .mto {
      padding-inline: 18px;
    }

    .mto__intro {
      display: block;
      margin-bottom: 32px;
    }

    .mto__eyebrow {
      margin: 0 0 14px;
    }

    .mto__subtext {
      max-width: none;
    }

    .mto__step {
      padding-left: 16px;
    }

    .mto__btn {
      width: 100%;
      min-width: 0;
      min-height: 56px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mto__btn,
    .mto__btn svg {
      transition-duration: 0s;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Made-to-Order Steps",
  "tag": "section",
  "class": "section section-mto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Custom Orders Work" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Your Custom Request" },
    { "type": "url", "id": "button_link", "label": "Button link" },
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "consult", "label": "Choose / consult" },
            { "value": "ruler", "label": "Finish & size" },
            { "value": "artisan", "label": "Handcraft" },
            { "value": "truck", "label": "Delivery" },
            { "value": "wood", "label": "Wood" }
          ],
          "default": "consult"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Step description." }
      ]
    }
  ],
  "presets": []
}
{% endschema %}
