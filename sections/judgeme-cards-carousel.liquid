<section
  class="collector-reviews"
  aria-labelledby="CollectorReviewsTitle-{{ section.id }}"
  style="--collector-reviews-background: url({{ 'cards-carousel-background.png' | file_url }})"
>
  <header class="collector-reviews__header">
    <div class="collector-reviews__ornament" aria-hidden="true">
      <span></span>
      <svg viewBox="0 0 48 48" role="presentation">
        <path d="M29.75 24c0 .41-.04.81-.13 1.2-.14.7-.42 1.35-.8 1.93-.43.68-1.01 1.26-1.69 1.69-.58.38-1.23.66-1.93.8-.39.09-.79.13-1.2.13s-.81-.04-1.2-.13c-.7-.14-1.35-.42-1.93-.8a5.45 5.45 0 0 1-1.69-1.69c-.38-.58-.66-1.23-.8-1.93-.09-.39-.13-.79-.13-1.2s.04-.81.13-1.2c.14-.7.42-1.35.8-1.93.43-.68 1.01-1.26 1.69-1.69.58-.38 1.23-.66 1.93-.8.39-.09.79-.13 1.2-.13s.81.04 1.2.13c.7.14 1.35.42 1.93.8.68.43 1.26 1.01 1.69 1.69.38.58.66 1.23.8 1.93.09.39.13.79.13 1.2Z"></path>
        <path d="M25.2 29.62c.11 2.2 1.39 4.84 3.61 7.06.22.22.46.43.7.6-.6 4.61-5.51 8.22-5.51 8.22s-4.91-3.61-5.51-8.22c-.04-.3-.06-.6-.06-.91 0-3.14.97-5.91 2.44-7.55m-2.49-3.62c-2.2.11-4.84 1.39-7.06 3.61-.22.22-.43.46-.6.7C6.11 28.91 2.5 24 2.5 24s3.61-4.91 8.22-5.51c.3-.04.6-.06.91-.06 3.14 0 5.91.97 7.55 2.44"></path>
        <path d="M20.87 28.82c-1.47 1.64-2.44 4.41-2.44 7.55 0 .31.02.61.06.91C14.8 40.12 8.8 39.2 8.8 39.2s-.92-6 1.92-9.69c.17-.24.38-.48.6-.7 2.22-2.22 4.86-3.5 7.06-3.61m.8-4.33c-1.64-1.47-4.41-2.44-7.55-2.44-.31 0-.61.02-.91.06C7.88 14.8 8.8 8.8 8.8 8.8s6-.92 9.69 1.92c.24.17.48.38.7.6 2.22 2.22 3.5 4.86 3.61 7.06m6.02 8.75c1.64 1.47 4.41 2.44 7.55 2.44.31 0 .61-.02.91-.06 2.84 3.69 1.92 9.69 1.92 9.69s-6 .92-9.69-1.92c-.24-.17-.48-.38-.7-.6-2.22-2.22-3.5-4.86-3.61-7.06"></path>
        <path d="M22.8 18.38c-.11-2.2-1.39-4.84-3.61-7.06-.22-.22-.46-.43-.7-.6C19.09 6.11 24 2.5 24 2.5s4.91 3.61 5.51 8.22c.04.3.06.6.06.91 0 3.14-.97 5.91-2.44 7.55"></path>
        <path d="M27.13 19.18c1.47-1.64 2.44-4.41 2.44-7.55 0-.31-.02-.61-.06-.91C33.2 7.88 39.2 8.8 39.2 8.8s.92 6-1.92 9.69c-.17.24-.38.48-.6.7-2.22 2.22-4.86 3.5-7.06 3.61"></path>
        <path d="M29.62 22.8c2.2-.11 4.84-1.39 7.06-3.61.22-.22.43-.46.6-.7 4.61.6 8.22 5.51 8.22 5.51s-3.61 4.91-8.22 5.51c-.3.04-.6.06-.91.06-3.14 0-5.91-.97-7.55-2.44"></path>
      </svg>
      <span></span>
    </div>

    <p class="collector-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="collector-reviews__title" id="CollectorReviewsTitle-{{ section.id }}">
      {{ section.settings.title | escape }}
    </h2>
  </header>

  <div class="collector-reviews__carousel">
    {% for block in section.blocks %}
      {% render block %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .collector-reviews {
    --collector-reviews-max-width: calc(var(--layout-max-width) + (var(--sp-12)));
    --collector-reviews-card-background: color-mix(in srgb, var(--color-cream) 92%, transparent);
    --collector-reviews-hairline: var(--border-width);

    overflow: hidden;
    padding: var(--sp-7) var(--layout-padding-desktop) var(--sp-0);
    background-color: var(--color-cream);
    background-image: var(--collector-reviews-background);
    background-position: center;
    background-size: cover;
    color: var(--color-earth-brown);
  }

  .collector-reviews__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: var(--layout-max-width);
    margin-inline: auto;
    text-align: center;
  }

  .collector-reviews__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--sp-12) + var(--sp-7));
    color: var(--color-clay);
  }

  .collector-reviews__ornament span {
    flex: 1;
    border-block-start: var(--collector-reviews-hairline) solid var(--border-dark);
  }

  .collector-reviews__ornament svg {
    width: var(--sp-6);
    height: var(--sp-6);
    margin-inline: var(--sp-4);
    fill: none;
    stroke: currentcolor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .collector-reviews__eyebrow {
    margin: var(--sp-5) 0 0;
    font: var(--type-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 5);
    text-transform: uppercase;
    color: var(--color-bark);
  }

  .collector-reviews__title {
    max-width: var(--layout-max-width);
    margin: var(--sp-3) 0 0;
    font-family: var(--font-display);
    font-size: var(--font-size-display-xl);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    text-wrap: balance;
    color: var(--color-earth-brown);
  }

  .collector-reviews__carousel {
    margin-block-start: var(--sp-4);
  }

  .collector-reviews .jdgm-cards-carousel {
    --max-width: var(--collector-reviews-max-width) !important;
    --width-xs: calc((var(--sp-12) * 2) + var(--sp-7)) !important;
    --width-sm: calc((var(--sp-12) * 2) + var(--sp-7)) !important;
    --width-md: calc((var(--sp-12) * 2) + var(--sp-7)) !important;
    --width-lg: calc((var(--sp-12) * 2) + var(--sp-7)) !important;
    --width-xl: calc((var(--sp-12) * 2) + var(--sp-7)) !important;
    --text-color: var(--color-earth-brown) !important;
    --card-color: var(--collector-reviews-card-background) !important;
    --header-color: var(--color-earth-brown) !important;
    --border-radius: var(--radius-xl) !important;
    --arrows-color: var(--color-earth-brown) !important;

    max-width: var(--collector-reviews-max-width) !important;
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-header {
    margin-block-end: var(--sp-7) !important;
  }

  .collector-reviews .jdgm-title {
    display: none !important;
  }

  .collector-reviews .jdgm-header-info {
    gap: var(--sp-5) !important;
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-average-rating {
    gap: var(--sp-4) !important;
  }

  .collector-reviews .jdgm-header .jdgm-stars {
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-header .jdgm-star {
    color: inherit !important;
  }

  .collector-reviews .jdgm-rating-text,
  .collector-reviews .jdgm-verified-text {
    font-family: var(--font-body) !important;
    font-size: var(--font-size-body-lg) !important;
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-rating-star {
    display: none !important;
  }

  .collector-reviews .jdgm-verified-badge-header {
    gap: var(--sp-2) !important;
    padding-inline-start: var(--sp-5) !important;
    border-inline-start: var(--collector-reviews-hairline) solid var(--border-dark);
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-verified-checkmark {
    width: var(--sp-5) !important;
    height: var(--sp-5) !important;
    color: currentcolor !important;
  }

  .collector-reviews .jdgm-content {
    gap: var(--sp-4) !important;
  }

  .collector-reviews .jdgm-arrow {
    flex: 0 0 var(--sp-7) !important;
    width: var(--sp-7) !important;
    min-width: var(--sp-7) !important;
    height: var(--sp-7) !important;
    padding: var(--sp-4) !important;
    border: var(--collector-reviews-hairline) solid var(--border-dark) !important;
    border-radius: var(--radius-full) !important;
    background: color-mix(in srgb, var(--color-cream) 78%, transparent) !important;
    color: var(--color-earth-brown) !important;
    transition: var(--transition-fast) !important;
  }

  .collector-reviews .jdgm-content > button.jdgm-arrow {
    display: grid !important;
    place-items: center !important;
    box-sizing: border-box;
    padding: 0 !important;
    line-height: 0 !important;
  }

  .collector-reviews .jdgm-content > button.jdgm-arrow svg {
    display: block !important;
    width: var(--sp-5) !important;
    height: var(--sp-5) !important;
    margin: 0 !important;
  }

  .collector-reviews .jdgm-arrow:hover {
    border-color: var(--color-earth-brown) !important;
    background: var(--color-earth-brown) !important;
    color: var(--color-cream) !important;
  }

  .collector-reviews .jdgm-arrow:focus-visible {
    outline: none !important;
    box-shadow: var(--shadow-focus) !important;
  }

  .collector-reviews .jdgm-cards-wrapper {
    border-radius: var(--radius-xl);
  }

  .collector-reviews .jdgm-videos-container {
    gap: var(--sp-4) !important;
  }

  .collector-reviews .jdgm-card {
    overflow: hidden !important;
    border: var(--collector-reviews-hairline) solid color-mix(in srgb, var(--color-bark) 18%, transparent) !important;
    border-radius: var(--radius-xl) !important;
    background: var(--collector-reviews-card-background) !important;
    box-shadow: var(--shadow-card) !important;
    text-align: start !important;
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-card > img {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 4 / 3;
    object-fit: cover !important;
  }

  .collector-reviews .jdgm-card .jdgm-text {
    position: relative;
    flex: 1 1 auto !important;
    place-items: start !important;
    padding: var(--sp-5) var(--sp-5) var(--sp-3) !important;
    font-family: var(--font-body) !important;
    text-align: start !important;
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-card .jdgm-text::before {
    display: block;
    height: var(--sp-5);
    margin-block-end: var(--sp-1);
    font-family: var(--font-display);
    font-size: var(--font-size-display-md);
    line-height: var(--line-height-tight);
    content: '“';
    color: var(--color-clay);
  }

  .collector-reviews .jdgm-card .jdgm-text p {
    margin: 0 !important;
    font: var(--type-body-regular) !important;
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-card .jdgm-rating-section {
    align-items: flex-start !important;
    gap: var(--sp-2) !important;
    padding: 0 var(--sp-5) var(--sp-5) !important;
  }

  .collector-reviews .jdgm-card .jdgm-stars {
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-card .jdgm-star {
    color: inherit !important;
  }

  .collector-reviews .jdgm-reviewer-info {
    justify-content: flex-start !important;
    margin-block-start: var(--sp-2) !important;
  }

  .collector-reviews .jdgm-reviewer-name {
    font-family: var(--font-display) !important;
    font-size: var(--font-size-body-lg) !important;
    font-weight: var(--font-weight-regular) !important;
    color: var(--color-earth-brown) !important;
  }

  .collector-reviews .jdgm-product-name {
    margin-block-start: var(--sp-1) !important;
    font-family: var(--font-body) !important;
    font-size: var(--font-size-caption) !important;
    font-weight: var(--font-weight-semibold) !important;
    letter-spacing: var(--letter-spacing-wide) !important;
    text-transform: uppercase;
    color: var(--color-bark) !important;
  }

  .jdgm-cards-carousel .jdgm-cards-wrapper {
    max-width: var(--collector-reviews-max-width) !important;
  }

  @media (max-width: 1279px) {
    .collector-reviews {
      padding: var(--sp-8) var(--layout-padding-tablet) var(--sp-8);
    }

    .collector-reviews__title {
      font-size: var(--font-size-display-lg);
    }

    .collector-reviews .jdgm-cards-carousel {
      --width-xs: calc(var(--sp-12) * 2) !important;
      --width-sm: calc(var(--sp-12) * 2) !important;
      --width-md: calc(var(--sp-12) * 2) !important;
      --width-lg: calc(var(--sp-12) * 2) !important;
      --width-xl: calc(var(--sp-12) * 2) !important;
    }

    .collector-reviews .jdgm-header {
      margin-block-end: var(--sp-6) !important;
    }
  }

  @media (max-width: 721px) {
    .collector-reviews {
      padding: var(--sp-7) var(--layout-padding-mobile) var(--sp-0);
      background-position: left bottom;
      background-repeat: no-repeat;
      background-size: cover;
    }

    .collector-reviews__ornament {
      width: calc(var(--sp-9) + var(--sp-6));
    }

    .collector-reviews__ornament svg {
      width: var(--sp-5);
      height: var(--sp-5);
      margin-inline: var(--sp-3);
    }

    .collector-reviews__eyebrow {
      margin-block-start: var(--sp-4);
      letter-spacing: calc(var(--letter-spacing-wide) * 3);
    }

    .collector-reviews__title {
      margin-block-start: var(--sp-2);
      max-width: 100%;
      font-size: clamp(var(--font-size-body-2xl), 7vw, var(--font-size-display-sm));
      overflow-wrap: anywhere;
    }

    .collector-reviews__carousel {
      margin-block-start: var(--sp-0);
    }

    .collector-reviews .jdgm-cards-carousel {
      --width-xs: calc((var(--sp-12) * 2) - var(--sp-6)) !important;
      --width-sm: calc((var(--sp-12) * 2) - var(--sp-6)) !important;
      --width-md: calc((var(--sp-12) * 2) - var(--sp-6)) !important;
      --width-lg: calc((var(--sp-12) * 2) - var(--sp-6)) !important;
      --width-xl: calc((var(--sp-12) * 2) - var(--sp-6)) !important;
    }

    .collector-reviews .jdgm-header {
      margin-block-end: var(--sp-5) !important;
    }

    .collector-reviews .jdgm-header-info {
      flex-wrap: wrap !important;
      gap: var(--sp-3) !important;
    }

    .collector-reviews .jdgm-average-rating {
      gap: var(--sp-2) !important;
    }

    .collector-reviews .jdgm-rating-text,
    .collector-reviews .jdgm-verified-text {
      font-size: var(--font-size-body-sm) !important;
    }

    .collector-reviews .jdgm-verified-badge-header {
      padding-inline-start: var(--sp-3) !important;
    }

    .collector-reviews .jdgm-content {
      gap: var(--sp-2) !important;
    }

    .collector-reviews .jdgm-arrow {
      display: flex !important;
      position: absolute !important;
      z-index: var(--z-overlay);
      top: 50%;
      flex-basis: var(--sp-7) !important;
      width: var(--sp-7) !important;
      min-width: var(--sp-7) !important;
      height: var(--sp-7) !important;
      padding: var(--sp-3) !important;
      transform: translateY(-50%);
    }

    .collector-reviews .jdgm-content {
      position: relative;
    }

    .collector-reviews .jdgm-content > .jdgm-arrow:first-child {
      left: var(--sp-2);
    }

    .collector-reviews .jdgm-content > .jdgm-arrow:last-child {
      right: var(--sp-2);
    }

    .collector-reviews .jdgm-card .jdgm-text {
      padding: var(--sp-4) var(--sp-4) var(--sp-2) !important;
    }

    .collector-reviews .jdgm-card .jdgm-rating-section {
      padding: 0 var(--sp-4) var(--sp-4) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collector-reviews .jdgm-arrow {
      transition: none !important;
    }
  }

  body:has(.collector-reviews) .jdgm-modal.wrydeco-review-modal {
    --review-modal-max-width: calc(var(--layout-max-width) + var(--sp-12));
    --review-modal-surface: color-mix(in srgb, var(--color-cream) 96%, transparent);
    --review-modal-control-size: var(--sp-7);
    --review-modal-border-radius: var(--radius-xl);

    color: var(--color-earth-brown) !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jdgm-modal__overlay {
    background: color-mix(in srgb, var(--color-ebony) 88%, transparent) !important;
    backdrop-filter: blur(var(--sp-1));
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jdgm-modal__content {
    align-items: flex-start !important;
    box-sizing: border-box;
    overflow: hidden !important;
    padding: var(--sp-10) !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jdgm-modal__content > .jdgm-modal__container {
    align-items: flex-start !important;
    justify-content: center !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
  }

  body:has(.collector-reviews)
    .wrydeco-review-modal
    .jdgm-modal__content
    > .jdgm-modal__container
    > .jdgm-modal__container {
    width: min(100%, var(--review-modal-max-width)) !important;
    height: 100% !important;
    max-width: var(--review-modal-max-width) !important;
    max-height: 100% !important;
    align-self: stretch !important;
    background: var(--review-modal-surface) !important;
    border-radius: var(--review-modal-border-radius) !important;
    box-shadow: var(--shadow-modal) !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-slide {
    flex-direction: row !important;
    width: 100% !important;
    height: 100% !important;
    max-height: 100% !important;
    min-height: 0 !important;
    overflow: hidden !important;
    border-radius: inherit !important;
    background: var(--review-modal-surface) !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-indicator {
    position: absolute !important;
    z-index: var(--z-overlay);
    top: var(--sp-5) !important;
    right: var(--sp-5) !important;
    width: auto !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-indicator__close {
    display: grid !important;
    width: var(--review-modal-control-size) !important;
    min-width: var(--review-modal-control-size) !important;
    height: var(--review-modal-control-size) !important;
    min-height: var(--review-modal-control-size) !important;
    place-items: center !important;
    padding: 0 !important;
    border: calc(var(--border-width) * 2) solid var(--color-cream) !important;
    border-radius: var(--radius-full) !important;
    background: #1a181555 !important;
    color: var(--color-cream) !important;
    box-shadow: var(--shadow-card) !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-indicator__close svg {
    width: var(--sp-4) !important;
    height: var(--sp-4) !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-carousel {
    display: flex !important;
    flex-direction: column !important;
    position: relative !important;
    flex: 0 0 52% !important;
    width: 52% !important;
    height: 100% !important;
    min-height: 0 !important;
    overflow: visible !important;
    background: transparent !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-carousel__wrapper {
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: auto;
    overflow: hidden !important;
    border-radius: var(--review-modal-border-radius) 0 0 var(--review-modal-border-radius) !important;
    background: var(--color-dark-clay) !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-carousel__slide,
  body:has(.collector-reviews) .wrydeco-review-modal .jm-media {
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-media__image {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-media__blur {
    display: none !important;
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-thumbnails {
    position: absolute !important;
    z-index: var(--z-overlay);
    right: 0;
    bottom: 0;
    left: 0;
    box-sizing: border-box;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    padding: var(--sp-4) var(--sp-7) var(--sp-5) !important;
    background: color-mix(in srgb, var(--color-cream) 38%, transparent) !important;
    backdrop-filter: blur(var(--sp-1));
  }

  body:has(.collector-reviews) .wrydeco-review-modal .jm-media-grid {
    --thumbnail-size: var(--sp-10) !important;
    --thumbnail-spacing: var(--sp-3) !important;
    --thumbnail-border-radius: var(--radius-xl) !important;
    --thumbnail-active-border-color: var(--color-earth-brown) !important;

