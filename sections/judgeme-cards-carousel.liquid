{% javascript %}
  (() => {
    const modalSelector = '.jdgm-modal.jdgm-widget-revamp';
    const woodIcon = `
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
          <path d="M6 5.5a6 2.5 0 1 0 12 0a6 2.5 0 1 0-12 0"></path>
          <path d="M18 5.5v4.626a1.415 1.415 0 0 1 1.683 2.18l-.097.108L18 14v4c0 1.61-2.54 2.925-5.725 3H12c-3.314 0-6-1.343-6-3v-2l-1.586-1.586A1.414 1.414 0 0 1 6 12.127V5.5m4 7V14m4 2v1"></path>
        </g>
      </svg>`;
    const chevronIcon = `
      <svg class="wrydeco-review-modal__product-chevron" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 6 6 6-6 6"></path>
      </svg>`;

    const createDivider = (modifier = '') => {
      const divider = document.createElement('div');
      divider.className = `wrydeco-review-modal__divider ${modifier}`.trim();
      divider.setAttribute('aria-hidden', 'true');
      divider.innerHTML = woodIcon;
      return divider;
    };

    const decorateModal = (modal) => {
      modal.classList.add('wrydeco-review-modal');

      const content = modal.querySelector('.jm-content');
      const reviewItem = content?.querySelector('.jm-review-item');
      if (content && reviewItem && !content.querySelector('.wrydeco-review-modal__divider:not(.wrydeco-review-modal__divider--body)')) {
        content.insertBefore(createDivider(), reviewItem);
      }

      const titleWrapper = modal.querySelector('.jm-review-content__title-wrapper');
      const bodyWrapper = modal.querySelector('.jm-review-body-wrapper');
      if (titleWrapper && bodyWrapper && !modal.querySelector('.wrydeco-review-modal__divider--body')) {
        bodyWrapper.before(createDivider('wrydeco-review-modal__divider--body'));
      }

      const productCard = modal.querySelector('.jm-product-variant-card');
      const productCluster = productCard?.querySelector(':scope > .jm-cluster');
      const productContent = productCard?.querySelector('.jm-product-variant-card__content');
      const reviewImage = modal.querySelector('.jm-media__image');

      if (productCluster && reviewImage) {
        let productMedia = productCluster.querySelector('.wrydeco-review-modal__product-media');
        if (!productMedia) {
          productMedia = document.createElement('span');
          productMedia.className = 'wrydeco-review-modal__product-media';
          productMedia.setAttribute('aria-hidden', 'true');
          productMedia.innerHTML = '<img alt="">';
          productCluster.prepend(productMedia);
        }

        const productImage = productMedia.querySelector('img');
        if (productImage.src !== reviewImage.currentSrc) {
          productImage.src = reviewImage.currentSrc || reviewImage.src;
        }
      }

      if (productContent && !productContent.querySelector('.wrydeco-review-modal__product-eyebrow')) {
        const eyebrow = document.createElement('p');
        eyebrow.className = 'wrydeco-review-modal__product-eyebrow';
        eyebrow.textContent = 'View this piece';
        productContent.append(eyebrow);
      }

      if (productCard && !productCard.querySelector('.wrydeco-review-modal__product-chevron')) {
        productCard.insertAdjacentHTML('beforeend', chevronIcon);
      }
    };

    let animationFrame;
    const decorateVisibleModals = () => {
      animationFrame = undefined;
      document.querySelectorAll(modalSelector).forEach(decorateModal);
    };

    const observer = new MutationObserver(() => {
      if (animationFrame) return;
      animationFrame = requestAnimationFrame(decorateVisibleModals);
    });

    decorateVisibleModals();
    observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['src'] });
  })();
{% endjavascript %}

