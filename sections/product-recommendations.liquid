{% render 'plp-card-resources' %}
{% liquid
  assign rec_limit = section.settings.products_to_show | default: 6
%}
{% if recommendations.performed and recommendations.products_count > 0 %}
  <div class="product-recommendations page-width">
    <div class="product-recommendations__header">
      {% if section.settings.eyebrow != blank %}
        <p class="product-recommendations__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="product-recommendations__title">{{ section.settings.title | escape }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <p class="product-recommendations__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
    </div>

    <div class="product-recommendations__carousel" data-pairs-carousel>
      <div class="product-recommendations__slider" id="PairsSlider-{{ section.id }}" data-pairs-slider>
        {% for product in recommendations.products limit: rec_limit %}
          {% render 'plp-product-card', product: product, heading_tag: 'h3', class: 'pairs-card' %}
        {% endfor %}
      </div>

      <div class="product-recommendations__controls" data-pairs-controls hidden>
        <button
          class="product-recommendations__nav product-recommendations__nav--prev"
          type="button"
          aria-label="Previous recommendations"
          aria-controls="PairsSlider-{{ section.id }}"
          data-pairs-prev
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="product-recommendations__dots" role="group" aria-label="Choose recommendation page" data-pairs-dots></div>
        <button
          class="product-recommendations__nav product-recommendations__nav--next"
          type="button"
          aria-label="Next recommendations"
          aria-controls="PairsSlider-{{ section.id }}"
          data-pairs-next
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
{% else %}
  <div
    class="product-recommendations"
    id="recommendations-container-{{ section.id }}"
    data-product-id="{{ product.id }}"
  ></div>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const container = document.getElementById('recommendations-container-{{ section.id }}');
      const productId = container.dataset.productId;
      const productName = {{ product.title | split: ',' | first | strip | json }};
      const limit = {{ rec_limit }};

      if (productId) {
        fetch(`/recommendations/products?section_id={{ section.id }}&product_id=${productId}&limit=${limit}`)
          .then(r => r.text())
          .then(html => {
            const inner = new DOMParser()
              .parseFromString(html, 'text/html')
              .querySelector('.product-recommendations')?.innerHTML || '';
            container.innerHTML = inner;
            document.dispatchEvent(new CustomEvent('wrydeco:product-cards:loaded', { detail: { root: container } }));

            const subtitle = container.querySelector('.product-recommendations__subtitle');
            if (subtitle && subtitle.textContent.indexOf('{product}') !== -1) {
              subtitle.textContent = subtitle.textContent.replace('{product}', productName).replace(/\s+/g, ' ').trim();
            }

            // Content was injected via innerHTML (its <script> won't run), so wire
            // up the carousel that just landed in the DOM.
            if (window.initPairsCarousels) window.initPairsCarousels();
          });
      }
    });
  </script>
{% endif %}

{% style %}
  /* Desktop-first */
  .product-recommendations {
    width: 100%;
    margin-inline: auto;
    padding: var(--sp-7) 80px;
    background-color: #fbf4eb;
  }

  .product-recommendations__header {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto var(--sp-6);
  }
  .product-recommendations__eyebrow {
    margin: 0 0 var(--sp-3);
    font-family: var(--font-roboto);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-clay);
  }
  .product-recommendations__title {
    margin: 0 0 var(--sp-4);
    font-family: var(--font-display-light);
    font-size: var(--font-size-display-lg);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-display);
    letter-spacing: var(--letter-spacing-normal);
    color: var(--text-primary);
    text-wrap: balance;
  }
  .product-recommendations__subtitle {
    margin: 0;
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-relaxed);
    color: var(--text-secondary);
    text-wrap: balance;
  }

  /* Carousel */
  .product-recommendations__carousel {
    position: relative;
  }
  .product-recommendations__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: var(--sp-4);
  }
  .product-recommendations__controls[hidden] {
    display: none;
  }
  .product-recommendations__dots {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }
  .product-recommendations__dot {
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-earth-brown);
    cursor: pointer;
  }
  .product-recommendations__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: transparent;
    transition: background-color var(--timing-short) var(--ease-standard);
  }
  .product-recommendations__dot[aria-current='true']::before,
  .product-recommendations__dot:hover::before {
    background: currentColor;
  }
  .product-recommendations__dot:focus-visible {
    outline: 2px solid var(--color-sage);
    outline-offset: -2px;
    border-radius: var(--radius-full);
  }
  .product-recommendations__slider {
    display: flex;
    gap: var(--sp-5);
    overflow-x: auto;
    padding-bottom: var(--sp-3);
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    cursor: grab;
    scrollbar-width: none; /* Firefox */
    -webkit-overflow-scrolling: touch;
  }
  .product-recommendations__slider::-webkit-scrollbar {
    display: none; /* Chrome, Safari */
  }
  .product-recommendations__slider.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }
  /* While dragging, block text selection and hover/click on cards. */
  .product-recommendations__slider.is-dragging .pairs-card {
    user-select: none;
    pointer-events: none;
  }

  .pairs-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 calc((100% - (var(--sp-5) * 3)) / 4);
    min-width: 0;
    scroll-snap-align: start;
  }
  .pairs-card__media {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background-color: var(--bg-secondary);
    box-shadow: var(--shadow-elevation-2);
  }
  .pairs-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
    user-select: none;
    transition: transform var(--timing-long) var(--ease-standard);
  }
  .pairs-card__media:hover .pairs-card__image {
    transform: scale(1.03);
  }

  .pairs-card__info {
    padding-top: var(--sp-4);
  }
  .pairs-card__title {
    margin: 0;
    font-family: var(--font-display-light);
    font-size: var(--font-size-body-xl);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-tight);
    color: var(--text-primary);
  }
  .pairs-card__title-link {
    color: inherit;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pairs-card__material {
    margin: var(--sp-2) 0 0;
    font-size: var(--font-size-body-sm);
    color: var(--color-clay);
  }
  .pairs-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border-default);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-medium);
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color var(--timing-short) var(--ease-standard),
      gap var(--timing-short) var(--ease-standard);
  }
  .pairs-card__link svg {
    width: 14px;
    height: 14px;
  }
  .pairs-card__link:hover {
    border-color: var(--color-clay);
    gap: var(--sp-3);
    color: var(--text-primary);
  }

  /* Prev / Next navigation */
  .product-recommendations__nav {
    position: relative;
    flex: 0 0 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface-elevated) 88%, transparent);
    color: var(--color-earth-brown);
    cursor: pointer;
    box-shadow: none;
    transition: background-color var(--timing-short) var(--ease-standard),
      border-color var(--timing-short) var(--ease-standard),
      opacity var(--timing-short) var(--ease-standard),
      transform var(--timing-short) var(--ease-standard);
  }
  .product-recommendations__nav:hover {
    background: var(--color-milk);
    border-color: var(--color-clay);
    transform: scale(1.05);
  }
  .product-recommendations__nav:focus-visible {
    outline: 2px solid var(--color-sage);
    outline-offset: var(--sp-1);
  }
  .product-recommendations__nav[disabled] {
    opacity: 0.32;
    cursor: default;
    pointer-events: none;
  }
  @media screen and (max-width: 1280px) {
    .product-recommendations {
      padding-inline: 64px;
    }
    .pairs-card {
      flex-basis: calc((100% - (var(--sp-5) * 3)) / 4);
    }
  }

  @media screen and (max-width: 1024px) {
    .product-recommendations {
      padding-inline: var(--layout-padding-tablet);
    }
    .product-recommendations__title {
      font-size: var(--font-size-display-md);
    }
    .product-recommendations__slider {
      gap: var(--sp-4);
    }
    .pairs-card {
      flex-basis: calc((100% - (var(--sp-4) * 3)) / 4);
    }
  }

  @media screen and (max-width: 768px) {
    .product-recommendations {
      padding: var(--section-spacing-mobile) var(--layout-padding-mobile);
    }
    .product-recommendations__title {
      font-size: var(--font-size-display-md);
    }
    .product-recommendations__subtitle {
      font-size: var(--font-size-body-md);
    }
    .product-recommendations__slider {
      gap: var(--sp-4);
    }
    .pairs-card {
      flex-basis: calc((100% - var(--sp-4)) / 2);
    }
  }

  @media screen and (max-width: 480px) {
    .product-recommendations__controls {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4px 16px;
    }
    .product-recommendations__nav--prev { justify-self: end; }
    .product-recommendations__nav--next { grid-column: 2; grid-row: 1; justify-self: start; }
    .product-recommendations__dots { grid-column: 1 / -1; grid-row: 2; }
    .pairs-card {
      flex-basis: 88%;
    }
    .pairs-card__title {
      font-size: var(--font-size-body-lg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-recommendations__slider { scroll-behavior: auto; }
    .product-recommendations__nav,
    .product-recommendations__dot::before { transition: none; }
  }
{% endstyle %}

{% javascript %}
  window.initPairsCarousels = function () {
    document.querySelectorAll('[data-pairs-carousel]').forEach(function (carousel) {
      if (carousel.dataset.pairsInit === 'true') return;

      var slider = carousel.querySelector('[data-pairs-slider]');
      var controls = carousel.querySelector('[data-pairs-controls]');
      var dots = carousel.querySelector('[data-pairs-dots]');
      if (!slider || !controls || !dots) return;
      carousel.dataset.pairsInit = 'true';
      var prev = carousel.querySelector('[data-pairs-prev]');
      var next = carousel.querySelector('[data-pairs-next]');
      var navFrame = null;

      function pageWidth() {
        var card = slider.querySelector('.pairs-card');
        var styles = getComputedStyle(slider);
        var gap = parseFloat(styles.columnGap || styles.gap) || 16;
        if (!card) return slider.clientWidth;
        var cardWidth = card.getBoundingClientRect().width + gap;
        var perView = Math.max(1, Math.round(slider.clientWidth / cardWidth));
        return cardWidth * perView;
      }

      function framePositions() {
        var maxScroll = Math.max(0, slider.scrollWidth - slider.clientWidth);
        var step = pageWidth();
        var positions = [0];

        if (maxScroll <= 1) return positions;
        if (step <= 1) return [0, maxScroll];

        for (var left = step; left < maxScroll - 1; left += step) {
          positions.push(left);
        }

        if (maxScroll - positions[positions.length - 1] > 1) {
          positions.push(maxScroll);
        }

        return positions;
      }

      function targetFrame(direction) {
        var positions = framePositions();
        var scrollLeft = slider.scrollLeft;

        if (direction > 0) {
          for (var nextIndex = 0; nextIndex < positions.length; nextIndex += 1) {
            if (positions[nextIndex] > scrollLeft + 1) return positions[nextIndex];
          }

          return positions[positions.length - 1];
        }

        for (var prevIndex = positions.length - 1; prevIndex >= 0; prevIndex -= 1) {
          if (positions[prevIndex] < scrollLeft - 1) return positions[prevIndex];
        }

        return positions[0];
      }

      function scrollToFrame(left) {
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        slider.scrollTo({ left: left, behavior: reducedMotion ? 'auto' : 'smooth' });
      }

      function updateNav() {
        var positions = framePositions();
        var maxScroll = slider.scrollWidth - slider.clientWidth;
        var hasOverflow = maxScroll > 1;
        carousel.classList.toggle('has-overflow', hasOverflow);
        controls.hidden = !hasOverflow;
        if (prev) prev.disabled = slider.scrollLeft <= 1;
        if (next) next.disabled = slider.scrollLeft >= maxScroll - 1;

        if (dots.children.length !== positions.length) {
          var focusedIndex = Array.prototype.indexOf.call(dots.children, document.activeElement);
          var fragment = document.createDocumentFragment();
          positions.forEach(function (_, index) {
            var dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'product-recommendations__dot';
            dot.dataset.pairsPage = index;
            dot.setAttribute('aria-label', 'Go to recommendation page ' + (index + 1) + ' of ' + positions.length);
            dot.setAttribute('aria-controls', slider.id);
            fragment.appendChild(dot);
          });
          dots.replaceChildren(fragment);
          if (focusedIndex >= 0 && hasOverflow) {
            dots.children[Math.min(focusedIndex, positions.length - 1)].focus({ preventScroll: true });
          }
        }

        var activeIndex = 0;
        positions.forEach(function (left, index) {
          if (Math.abs(left - slider.scrollLeft) < Math.abs(positions[activeIndex] - slider.scrollLeft)) activeIndex = index;
        });
        Array.prototype.forEach.call(dots.children, function (dot, index) {
          if (index === activeIndex) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      }

      function scheduleNavUpdate() {
        if (navFrame !== null) return;
        navFrame = window.requestAnimationFrame(function () {
          navFrame = null;
          updateNav();
        });
      }

      if (prev) prev.addEventListener('click', function () {
        scrollToFrame(targetFrame(-1));
      });
      if (next) next.addEventListener('click', function () {
        scrollToFrame(targetFrame(1));
      });

      dots.addEventListener('click', function (event) {
        var dot = event.target.closest('[data-pairs-page]');
        if (!dot) return;
        scrollToFrame(framePositions()[Number(dot.dataset.pairsPage)]);
      });

      slider.addEventListener('scroll', scheduleNavUpdate, { passive: true });
      window.addEventListener('resize', scheduleNavUpdate);
      if ('ResizeObserver' in window) {
        var resizeObserver = new ResizeObserver(scheduleNavUpdate);
        resizeObserver.observe(slider);
        if (slider.firstElementChild) resizeObserver.observe(slider.firstElementChild);
      }
      updateNav();

      // Press-and-drag to scroll (mouse). Uses a small threshold so a plain
      // click still activates the card link.
      var isDown = false;
      var startX = 0;
      var scrollLeft = 0;
      var isDragging = false;
      var THRESHOLD = 5;

      slider.addEventListener('mousedown', function (e) {
        isDown = true;
        isDragging = false;
        startX = e.pageX - slider.offsetLeft;
        scrollLeft = slider.scrollLeft;
      });

      function endDrag() {
        isDown = false;
        slider.classList.remove('is-dragging');
      }
      slider.addEventListener('mouseleave', endDrag);
      slider.addEventListener('mouseup', endDrag);

      slider.addEventListener('mousemove', function (e) {
        if (!isDown) return;
        var x = e.pageX - slider.offsetLeft;
        if (!isDragging && Math.abs(x - startX) > THRESHOLD) {
          isDragging = true;
          slider.classList.add('is-dragging');
        }
        if (!isDragging) return;
        e.preventDefault();
        slider.scrollLeft = scrollLeft - (x - startX) * 1.4;
      });

      // Suppress the click that follows a real drag so links don't navigate.
      slider.addEventListener(
        'click',
        function (e) {
          if (isDragging) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );

      // Never start a native image/link drag-and-drop.
      slider.addEventListener('dragstart', function (e) {
        e.preventDefault();
      });
    });
  };

  document.addEventListener('shopify:section:load', window.initPairsCarousels);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', window.initPairsCarousels);
  } else {
    window.initPairsCarousels();
  }
{% endjavascript %}

{% schema %}
{
  "name": "Product Recommendations",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated for harmony"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "You May Also Like"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "info": "Use {product} to insert the current product name."
    },
    {
      "type": "text",
      "id": "material_label",
      "label": "Material label (fallback)",
      "info": "Used when a product has no custom.material metafield.",
      "default": "Solid walnut"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Card link label",
      "default": "View Piece"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations"
    }
  ]
}
{% endschema %}
