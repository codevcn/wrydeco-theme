{% comment %}
  Workshop proof section sourced from the first store_media_info metaobject.
{% endcomment %}

{%- liquid
  assign store_media_info = metaobjects.store_media_info.values | first
  assign handcraft_video_url = store_media_info.proof_handcratf_video_url.value | default: store_media_info.proof_handcratf_video_url
  assign assembly_video_url = store_media_info.proof_assembly_video_url.value | default: store_media_info.proof_assembly_video_url
  assign packaging_image_urls_value = store_media_info.proof_packaging_image_urls.value | default: store_media_info.proof_packaging_image_urls
  assign packaging_image_urls = packaging_image_urls_value | split: ','
  assign packaging_image_count = 0

  for packaging_image_url in packaging_image_urls
    assign normalized_packaging_image_url = packaging_image_url | strip
    if normalized_packaging_image_url != blank
      assign packaging_image_count = packaging_image_count | plus: 1
    endif
  endfor

  assign has_workshop_media = false
  if handcraft_video_url != blank or assembly_video_url != blank or packaging_image_count > 0
    assign has_workshop_media = true
  endif
-%}

{% if has_workshop_media %}
  <section class="workshop-evidence" aria-labelledby="WorkshopEvidenceHeading-{{ section.id }}">
    <div class="workshop-evidence__inner">
      <header class="workshop-evidence__header">
        {% if section.settings.eyebrow != blank %}
          <p class="workshop-evidence__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2 class="workshop-evidence__heading" id="WorkshopEvidenceHeading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
        <span class="workshop-evidence__ornament" aria-hidden="true">
          <span></span>
        </span>
        {% if section.settings.subheading != blank %}
          <p class="workshop-evidence__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </header>

      <div class="workshop-evidence__media-grid" aria-label="Workshop process media">
        {% if handcraft_video_url != blank %}
          <article class="workshop-evidence__video-card workshop-evidence__video-card--handcraft workshop-evidence__proof-card workshop-evidence__proof-card--dark" data-workshop-video-card>
            <div class="workshop-evidence__video-frame">
              <video
                class="workshop-evidence__video"
                data-workshop-video-src="{{ handcraft_video_url | escape }}"
                preload="none"
                playsinline
              ></video>
              <button class="workshop-evidence__play" type="button" aria-label="Play handcrafting video" data-workshop-play>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
              </button>
            </div>
            <footer class="workshop-evidence__caption">
              <span class="workshop-evidence__caption-number">01</span>
              <span class="workshop-evidence__caption-divider" aria-hidden="true"></span>
              <span class="workshop-evidence__caption-label">{{ section.settings.handcraft_label | escape }}</span>
            </footer>
          </article>
        {% endif %}

        {% if assembly_video_url != blank %}
          <article class="workshop-evidence__video-card workshop-evidence__video-card--assembly workshop-evidence__proof-card workshop-evidence__proof-card--light" data-workshop-video-card>
            <div class="workshop-evidence__video-frame">
              <video
                class="workshop-evidence__video"
                data-workshop-video-src="{{ assembly_video_url | escape }}"
                preload="none"
                playsinline
              ></video>
              <button class="workshop-evidence__play" type="button" aria-label="Play assembly video" data-workshop-play>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
              </button>
            </div>
            <footer class="workshop-evidence__caption">
              <span class="workshop-evidence__caption-number">02</span>
              <span class="workshop-evidence__caption-divider" aria-hidden="true"></span>
              <span class="workshop-evidence__caption-label">{{ section.settings.assembly_label | escape }}</span>
            </footer>
          </article>
        {% endif %}

        {% if packaging_image_count > 0 %}
          <article class="workshop-evidence__packaging workshop-evidence__proof-card workshop-evidence__proof-card--dark" data-workshop-packaging>
            <div class="workshop-evidence__package-frame">
              <div class="workshop-evidence__package-track" data-workshop-package-track>
                {%- assign packaging_rendered_count = 0 -%}
                {%- for packaging_image_url in packaging_image_urls -%}
                  {%- assign normalized_packaging_image_url = packaging_image_url | strip -%}
                  {%- if normalized_packaging_image_url != blank -%}
                    {%- assign packaging_rendered_count = packaging_rendered_count | plus: 1 -%}
                    <button
                      class="workshop-evidence__package-slide{% if packaging_rendered_count == 1 %} is-active{% endif %}"
                      type="button"
                      aria-label="Open packaging image {{ packaging_rendered_count }}"
                      data-workshop-lightbox-open
                      data-workshop-lightbox-src="{{ normalized_packaging_image_url | escape }}"
                      data-workshop-lightbox-index="{{ packaging_rendered_count | minus: 1 }}"
                    >
                      <img
                        {% if packaging_rendered_count == 1 %}
                          src="{{ normalized_packaging_image_url | escape }}"
                        {% else %}
                          data-workshop-image-src="{{ normalized_packaging_image_url | escape }}"
                        {% endif %}
                        alt="{{ section.settings.packaging_alt | escape }} {{ packaging_rendered_count }}"
                        width="900"
                        height="1080"
                        loading="lazy"
                        decoding="async"
                      >
                    </button>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {% if packaging_image_count > 1 %}
                <button class="workshop-evidence__package-nav workshop-evidence__package-nav--prev" type="button" aria-label="Previous packaging image" data-workshop-package-prev>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18l-6-6l6-6"/></svg>
                </button>
                <button class="workshop-evidence__package-nav workshop-evidence__package-nav--next" type="button" aria-label="Next packaging image" data-workshop-package-next>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18l6-6l-6-6"/></svg>
                </button>
                <div class="workshop-evidence__package-dots" aria-label="Packaging image slides">
                  {%- assign packaging_dot_count = 0 -%}
                  {%- for packaging_image_url in packaging_image_urls -%}
                    {%- assign normalized_packaging_image_url = packaging_image_url | strip -%}
                    {%- if normalized_packaging_image_url != blank -%}
                      {%- assign packaging_dot_count = packaging_dot_count | plus: 1 -%}
                      <button
                        class="workshop-evidence__package-dot{% if packaging_dot_count == 1 %} is-active{% endif %}"
                        type="button"
                        aria-label="Show packaging image {{ packaging_dot_count }}"
                        data-workshop-package-dot
                        data-workshop-package-index="{{ packaging_dot_count | minus: 1 }}"
                      ></button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
            <footer class="workshop-evidence__caption workshop-evidence__caption--packaging">
              <span class="workshop-evidence__caption-number">03</span>
              <span class="workshop-evidence__caption-divider" aria-hidden="true"></span>
              <span class="workshop-evidence__caption-label">{{ section.settings.packaging_label | escape }}</span>
            </footer>
          </article>
        {% endif %}
      </div>

      {% if packaging_image_count > 0 %}
        <div
          class="workshop-evidence__lightbox"
          data-workshop-lightbox
          aria-hidden="true"
          role="dialog"
          aria-modal="true"
          aria-label="Packaging image preview"
        >
          <div class="workshop-evidence__lightbox-backdrop" data-workshop-lightbox-close></div>
          <button class="workshop-evidence__lightbox-close" type="button" aria-label="Close packaging image preview" data-workshop-lightbox-close>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
          {% if packaging_image_count > 1 %}
            <button class="workshop-evidence__lightbox-nav workshop-evidence__lightbox-nav--prev" type="button" aria-label="Previous packaging image" data-workshop-lightbox-prev>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18l-6-6l6-6"/></svg>
            </button>
            <button class="workshop-evidence__lightbox-nav workshop-evidence__lightbox-nav--next" type="button" aria-label="Next packaging image" data-workshop-lightbox-next>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18l6-6l-6-6"/></svg>
            </button>
          {% endif %}
          <img class="workshop-evidence__lightbox-image" src="" alt="{{ section.settings.packaging_alt | escape }}" width="900" height="1080" data-workshop-lightbox-image>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .workshop-evidence {
    display: block;
    padding: clamp(var(--sp-8), 7vw, var(--sp-11)) 0 clamp(var(--sp-7), 6vw, var(--sp-10));
    overflow: clip;
    background:
      linear-gradient(90deg, rgb(74 44 24 / 4%) 1px, transparent 1px),
      linear-gradient(180deg, var(--color-white-cream), var(--color-bg));
    background-size: 36px 36px, auto;
    color: var(--text-primary);
  }

  .workshop-evidence__inner {
    width: 100%;
    margin-inline: auto;
  }

  .workshop-evidence__header {
    display: grid;
    justify-items: center;
    max-width: calc(var(--layout-max-width) + var(--sp-8));
    margin: 0 auto var(--sp-6);
    padding-inline: var(--layout-padding-desktop);
    text-align: center;
  }

  .workshop-evidence__eyebrow {
    margin: var(--sp-0) var(--sp-0) var(--sp-3);
    color: var(--color-earth-brown);
    font-family: var(--font-body);
    font-size: clamp(var(--font-size-body-sm), 1.15vw, var(--font-size-body-lg));
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.32em;
    line-height: var(--line-height-tight);
    text-transform: uppercase;
  }

  .workshop-evidence__heading {
    margin: var(--sp-0);
    color: var(--color-earth-brown);
    font-family: var(--font-display-light);
    font-size: var(--section-heading-size);
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-normal);
    line-height: var(--line-height-display);
  }

  .workshop-evidence__ornament {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin-block: var(--sp-3);
    color: var(--color-earth-brown);
  }

  .workshop-evidence__ornament::before,
  .workshop-evidence__ornament::after {
    content: '';
    display: block;
    width: clamp(var(--sp-8), 7vw, var(--sp-11));
    height: var(--border-width);
    background: color-mix(in srgb, currentColor 54%, transparent);
  }

  .workshop-evidence__ornament span {
    display: block;
    width: 10px;
    height: 10px;
    border: var(--border-width) solid currentColor;
    background: color-mix(in srgb, var(--color-clay) 70%, var(--color-white-cream));
    transform: rotate(45deg);
  }

  .workshop-evidence__subheading {
    max-width: 760px;
    margin: var(--sp-0);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: clamp(var(--font-size-body-lg), 1.45vw, var(--font-size-body-xl));
    line-height: var(--line-height-relaxed);
  }

  .workshop-evidence__media-grid {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(var(--sp-4), 2.4vw, var(--sp-7));
    width: 100%;
    max-width: calc(var(--layout-max-width) + var(--sp-12) * 3);
    margin-inline: auto;
    padding: var(--sp-2) var(--layout-padding-desktop) var(--sp-4);
    overflow-x: auto;
    overflow-y: visible;
    scroll-behavior: smooth;
    scroll-padding-inline: var(--layout-padding-desktop);
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .workshop-evidence__media-grid.is-dragging {
    cursor: grabbing;
    user-select: none;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .workshop-evidence__media-grid::-webkit-scrollbar {
    display: none;
  }

  .workshop-evidence__video-card,
  .workshop-evidence__packaging {
    flex: 0 0 var(--workshop-card-width, clamp(360px, 28vw, 440px));
    width: var(--workshop-card-width, clamp(360px, 28vw, 440px));
    min-width: 0;
    scroll-snap-align: center;
  }

  .workshop-evidence__video-card--handcraft {
    --workshop-card-width: clamp(380px, 30vw, 440px);
  }

  .workshop-evidence__video-card--assembly {
    --workshop-card-width: clamp(340px, 26vw, 390px);
    margin-block: auto;
  }

  .workshop-evidence__packaging {
    --workshop-card-width: clamp(380px, 30vw, 440px);
    margin-block-start: 0;
  }

  .workshop-evidence__proof-card {
    position: relative;
    padding: clamp(8px, 0.72vw, 12px);
    border: var(--border-width) solid rgb(66 36 18 / 78%);
    border-radius: 4px;
    background:
      linear-gradient(90deg, rgb(255 246 224 / 5%), transparent 22% 80%, rgb(0 0 0 / 16%)),
      radial-gradient(ellipse at 22% 24%, rgb(138 82 40 / 16%), transparent 42%),
      radial-gradient(ellipse at 78% 72%, rgb(104 58 31 / 14%), transparent 48%),
      repeating-linear-gradient(0deg, transparent 0 18px, rgb(255 225 170 / 3%) 18px 19px, transparent 19px 42px),
      linear-gradient(180deg, rgb(68 38 19), rgb(42 24 13));
    box-shadow:
      0 24px 42px rgb(58 33 18 / 22%),
      inset 0 0 0 3px rgb(20 12 8 / 32%),
      inset 0 0 0 6px rgb(183 128 69 / 22%);
  }

  .workshop-evidence__proof-card::before {
    content: '';
    position: absolute;
    inset: 8px;
    z-index: 2;
    pointer-events: none;
    border: var(--border-width) solid rgb(230 174 106 / 34%);
  }

  .workshop-evidence__proof-card--light {
    border-color: rgb(167 118 60 / 72%);
    background:
      linear-gradient(180deg, rgb(255 249 242 / 95%), rgb(235 220 199 / 94%)),
      repeating-linear-gradient(100deg, rgb(139 93 48 / 8%) 0 12px, transparent 12px 26px);
    box-shadow:
      0 20px 34px rgb(74 44 24 / 16%),
      inset 0 0 0 3px rgb(177 125 67 / 24%);
  }

  .workshop-evidence__video-card--assembly::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 7px;
    z-index: 3;
    width: clamp(92px, 49%, 185px);
    height: 12px;
    background:
      linear-gradient(180deg, rgb(141 88 36 / 76%) 0 34%, rgb(204 151 82 / 88%) 34% 100%);
    clip-path: polygon(0 100%, 18% 100%, 31% 30%, 69% 30%, 82% 100%, 100% 100%);
    pointer-events: none;
    transform: translateX(-50%);
    box-shadow:
      inset 0 1px 0 rgb(255 241 214 / 36%),
      0 -1px 0 rgb(133 82 34 / 48%);
  }

  .workshop-evidence__video-frame,
  .workshop-evidence__package-frame {
    position: relative;
    z-index: 1;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-earth-brown);
    box-shadow:
      inset 0 0 0 var(--border-width) rgb(255 245 229 / 16%),
      0 1px 0 rgb(255 255 255 / 10%);
  }

  .workshop-evidence__video-card--assembly .workshop-evidence__video-frame {
    aspect-ratio: 9 / 16;
    border: 4px solid rgb(184 126 62 / 82%);
    box-shadow:
      0 0 0 var(--border-width) rgb(92 53 27 / 56%),
      0 0 0 7px rgb(226 177 110 / 20%),
      inset 0 0 0 var(--border-width) rgb(255 246 224 / 24%);
  }

  .workshop-evidence__video-frame {
    cursor: pointer;
  }

  .workshop-evidence__video-frame::after,
  .workshop-evidence__package-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 10%), transparent 28% 64%, rgb(0 0 0 / 26%)),
      linear-gradient(90deg, rgb(0 0 0 / 18%), transparent 18% 82%, rgb(0 0 0 / 20%));
  }

  .workshop-evidence__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
    user-drag: none;
  }

  .workshop-evidence__play {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: 2;
    display: inline-grid;
    place-items: center;
    width: clamp(var(--sp-8), 5vw, var(--sp-10));
    min-width: var(--touch-target-min);
    aspect-ratio: 1;
    border: var(--border-width) solid rgb(74 44 24 / 16%);
    border-radius: var(--radius-full);
    background: rgb(255 249 242 / 82%);
    color: var(--color-earth-brown);
    box-shadow: 0 14px 34px rgb(0 0 0 / 18%);
    backdrop-filter: blur(4px);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition:
      opacity var(--timing-base) var(--ease-out),
      transform var(--timing-base) var(--ease-out);
  }

  .workshop-evidence__video-card.is-playing .workshop-evidence__play {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.92);
  }

  .workshop-evidence__play svg {
    width: 38%;
    height: 38%;
    margin-inline-start: 4%;
  }

  .workshop-evidence__package-track {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .workshop-evidence__package-slide {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: var(--sp-0);
    border: 0;
    background: transparent;
    cursor: zoom-in;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity var(--timing-base) var(--ease-out),
      visibility var(--timing-base) var(--ease-out);
  }

  .workshop-evidence__package-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .workshop-evidence__package-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
    user-drag: none;
  }

  .workshop-evidence__package-nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: inline-grid;
    place-items: center;
    width: clamp(var(--sp-6), 3.3vw, var(--sp-7));
    min-width: var(--touch-target-min);
    aspect-ratio: 1;
    border: var(--border-width) solid rgb(255 249 242 / 34%);
    border-radius: var(--radius-full);
    background: rgb(24 14 8 / 34%);
    color: var(--color-white-cream);
    box-shadow: 0 10px 22px rgb(0 0 0 / 18%);
    backdrop-filter: blur(6px);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .workshop-evidence__package-nav--prev {
    left: var(--sp-3);
  }

  .workshop-evidence__package-nav--next {
    right: var(--sp-3);
  }

  .workshop-evidence__package-nav svg {
    width: 54%;
    height: 54%;
  }

  .workshop-evidence__package-dots {
    position: absolute;
    right: var(--sp-4);
    bottom: var(--sp-5);
    left: var(--sp-4);
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: var(--sp-2);
  }

  .workshop-evidence__package-dot {
    width: var(--sp-2);
    min-width: var(--sp-2);
    height: var(--sp-2);
    padding: var(--sp-0);
    border: var(--border-width) solid rgb(255 249 242 / 76%);
    border-radius: var(--radius-full);
    background: rgb(255 249 242 / 34%);
    cursor: pointer;
  }

  .workshop-evidence__package-dot.is-active {
    width: var(--sp-5);
    background: var(--color-white-cream);
  }

  .workshop-evidence__caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(var(--sp-3), 1.4vw, var(--sp-5));
    min-height: clamp(86px, 7vw, 112px);
    margin: 0;
    padding: var(--sp-4) var(--sp-5);
    color: rgb(237 186 117);
    font-family: var(--font-body);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .workshop-evidence__proof-card--light .workshop-evidence__caption {
    color: var(--color-earth-brown);
  }

  .workshop-evidence__proof-card--dark .workshop-evidence__caption {
    background:
      radial-gradient(ellipse at 26% 48%, rgb(137 80 38 / 16%), transparent 46%),
      repeating-linear-gradient(0deg, transparent 0 16px, rgb(255 224 166 / 4%) 16px 17px, transparent 17px 36px),
      linear-gradient(180deg, rgb(54 30 15), rgb(35 20 11));
    box-shadow: inset 0 var(--border-width) 0 rgb(230 174 106 / 22%);
  }

  .workshop-evidence__caption-number {
    flex: 0 0 auto;
    font-family: var(--font-body);
    font-size: clamp(var(--font-size-body-lg), 1.55vw, 26px);
    letter-spacing: 0.08em;
  }

  .workshop-evidence__caption-divider {
    display: block;
    width: var(--border-width);
    height: clamp(var(--sp-5), 3vw, var(--sp-7));
    background: currentColor;
    opacity: 0.55;
  }

  .workshop-evidence__caption-label {
    font-size: clamp(var(--font-size-caption), 1.1vw, var(--font-size-body-sm));
  }

  .workshop-evidence__lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: clamp(var(--sp-5), 4vw, var(--sp-8));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--timing-base) var(--ease-out), visibility var(--timing-base) var(--ease-out);
  }

  html.workshop-evidence-lightbox-open {
    overflow: hidden;
  }

  .workshop-evidence__lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .workshop-evidence__lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 72%);
  }

  .workshop-evidence__lightbox-image {
    position: relative;
    z-index: 1;
    display: block;
    width: auto;
    max-width: min(100%, calc(100vw - clamp(112px, 12vw, 180px)));
    max-height: calc(100vh - clamp(var(--sp-10), 10vw, var(--sp-12)));
    object-fit: contain;
    background: transparent;
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity var(--timing-base) var(--ease-out),
      transform var(--timing-base) var(--ease-out);
  }

  .workshop-evidence__lightbox.is-open .workshop-evidence__lightbox-image {
    opacity: 1;
    transform: scale(1);
  }

  .workshop-evidence__lightbox-close {
    position: absolute;
    top: clamp(var(--sp-4), 3vw, var(--sp-6));
    right: clamp(var(--sp-4), 3vw, var(--sp-6));
    z-index: 2;
    display: inline-grid;
    place-items: center;
    width: clamp(var(--sp-8), 3.8vw, var(--sp-10));
    min-width: var(--touch-target-min);
    aspect-ratio: 1;
    border: var(--border-width) solid color-mix(in srgb, var(--color-white-cream) 58%, transparent);
    border-radius: var(--radius-full);
    background: rgb(0 0 0 / 18%);
    color: var(--color-white-cream);
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition:
      background-color var(--timing-base) var(--ease-out),
      transform var(--timing-base) var(--ease-out);
  }

  .workshop-evidence__lightbox-close:hover,
  .workshop-evidence__lightbox-close:focus-visible,
  .workshop-evidence__lightbox-nav:hover,
  .workshop-evidence__lightbox-nav:focus-visible {
    background: color-mix(in srgb, var(--color-white-cream) 18%, transparent);
    transform: scale(1.04);
  }

  .workshop-evidence__lightbox-close svg {
    width: 58%;
    height: 58%;
  }

  .workshop-evidence__lightbox-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-grid;
    place-items: center;
    width: clamp(var(--sp-9), 4.6vw, var(--sp-11));
    min-width: var(--touch-target-min);
    aspect-ratio: 1;
    border: var(--border-width) solid color-mix(in srgb, var(--color-white-cream) 52%, transparent);
    border-radius: var(--radius-full);
    background: rgb(0 0 0 / 18%);
    color: var(--color-white-cream);
    cursor: pointer;
    backdrop-filter: blur(8px);
    transform: translateY(-50%);
    transition:
      background-color var(--timing-base) var(--ease-out),
      transform var(--timing-base) var(--ease-out);
  }

  .workshop-evidence__lightbox-nav:hover,
  .workshop-evidence__lightbox-nav:focus-visible {
    transform: translateY(-50%) scale(1.04);
  }

  .workshop-evidence__lightbox-nav--prev {
    left: clamp(var(--sp-3), 3vw, var(--sp-6));
  }

  .workshop-evidence__lightbox-nav--next {
    right: clamp(var(--sp-3), 3vw, var(--sp-6));
  }

  .workshop-evidence__lightbox-nav svg {
    width: 56%;
    height: 56%;
  }

  @media screen and (max-width: 1199px) {
    .workshop-evidence__media-grid {
      justify-content: flex-start;
      padding-inline: var(--layout-padding-tablet);
      scroll-padding-inline: var(--layout-padding-tablet);
    }

    .workshop-evidence__video-card--handcraft,
    .workshop-evidence__packaging {
      --workshop-card-width: clamp(360px, 44vw, 440px);
    }

    .workshop-evidence__video-card--assembly {
      --workshop-card-width: clamp(340px, 41vw, 390px);
      margin-block-start: var(--sp-6);
    }
    
    .workshop-evidence__play {
      width: clamp(var(--sp-7), 4vw, var(--sp-9));
    }
  }

  @media screen and (max-width: 767px) {
    .workshop-evidence {
      padding: var(--sp-7) 0 var(--sp-6);
    }

    .workshop-evidence__header {
      padding-inline: var(--layout-padding-mobile);
      margin-block-end: var(--sp-5);
    }

    .workshop-evidence__media-grid {
      gap: var(--sp-4);
      padding-inline: var(--layout-padding-mobile);
      scroll-padding-inline: var(--layout-padding-mobile);
    }

    .workshop-evidence__video-card--handcraft,
    .workshop-evidence__video-card--assembly,
    .workshop-evidence__packaging {
      --workshop-card-width: clamp(286px, 82vw, 350px);
      margin-block-start: 0;
      scroll-snap-align: start;
    }

    .workshop-evidence__video-card--assembly {
      --workshop-card-width: clamp(268px, 74vw, 318px);
    }

    .workshop-evidence__video-frame,
    .workshop-evidence__package-frame {
      aspect-ratio: 9 / 16;
    }
    
    .workshop-evidence__package-frame {
      touch-action: pan-y;
    }

    .workshop-evidence__caption {
      min-height: 82px;
      padding: var(--sp-3) var(--sp-4);
      gap: var(--sp-3);
    }

    .workshop-evidence__package-nav--prev {
      left: var(--sp-2);
    }

    .workshop-evidence__package-nav--next {
      right: var(--sp-2);
    }

    .workshop-evidence__lightbox {
      padding: var(--sp-4);
    }

    .workshop-evidence__lightbox-image {
      max-width: calc(100vw - var(--sp-4));
      max-height: calc(100vh - var(--sp-12));
    }

    .workshop-evidence__lightbox-close {
      top: var(--sp-3);
      right: var(--sp-3);
    }

    .workshop-evidence__lightbox-nav {
      top: auto;
      bottom: var(--sp-4);
      transform: none;
    }

    .workshop-evidence__lightbox-nav:hover,
    .workshop-evidence__lightbox-nav:focus-visible {
      transform: scale(1.04);
    }

    .workshop-evidence__lightbox-nav--prev {
      left: var(--sp-4);
    }

    .workshop-evidence__lightbox-nav--next {
      right: var(--sp-4);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var activeLightbox = null;

    function getPackagingSlides(packaging) {
      return packaging ? packaging.querySelectorAll('.workshop-evidence__package-slide') : [];
    }

    function loadPackageSlideImage(slide) {
      var image = slide ? slide.querySelector('img[data-workshop-image-src]') : null;
      if (!image) return;

      image.src = image.dataset.workshopImageSrc;
      image.removeAttribute('data-workshop-image-src');
    }

    function primeWorkshopVideoFrame(video) {
      if (!video || video.dataset.workshopPreviewPrimed === 'true') return;

      video.dataset.workshopPreviewPrimed = 'true';

      var seekPreviewFrame = function () {
        if (!video.paused || video.readyState === 0) return;

        try {
          if (video.duration > 0.16) {
            video.currentTime = 0.12;
          }
        } catch (error) {
          // Some browsers can reject early media seeks; the play button remains usable.
        }
      };

      if (video.readyState >= 1) {
        seekPreviewFrame();
      } else {
        video.addEventListener('loadedmetadata', seekPreviewFrame, { once: true });
      }
    }

    function loadWorkshopVideo(video) {
      if (!video) return;

      if (video.getAttribute('src')) {
        primeWorkshopVideoFrame(video);
        return;
      }

      video.src = video.dataset.workshopVideoSrc;
      video.removeAttribute('data-workshop-video-src');
      video.load();
      primeWorkshopVideoFrame(video);
    }

    function getSlideImageAlt(slide) {
      var image = slide ? slide.querySelector('img') : null;
      return image ? image.alt : '';
    }

    function setPackageIndex(packaging, index) {
      var slides = getPackagingSlides(packaging);
      if (!slides.length) return;

      var nextIndex = (index + slides.length) % slides.length;
      loadPackageSlideImage(slides[nextIndex]);
      packaging.dataset.workshopPackageIndex = nextIndex;
      packaging.style.setProperty('--workshop-package-index', nextIndex);

      slides.forEach(function (slide, slideIndex) {
        slide.classList.toggle('is-active', slideIndex === nextIndex);
      });

      packaging.querySelectorAll('[data-workshop-package-dot]').forEach(function (dot, dotIndex) {
        dot.classList.toggle('is-active', dotIndex === nextIndex);
      });
    }

    function setLightboxIndex(lightbox, index) {
      var section = lightbox ? lightbox.closest('.workshop-evidence') : null;
      var packaging = section ? section.querySelector('[data-workshop-packaging]') : null;
      var slides = getPackagingSlides(packaging);
      var image = lightbox ? lightbox.querySelector('[data-workshop-lightbox-image]') : null;
      if (!lightbox || !packaging || !slides.length || !image) return;

      var nextIndex = (index + slides.length) % slides.length;
      var nextSlide = slides[nextIndex];
      var nextSrc = nextSlide ? nextSlide.dataset.workshopLightboxSrc : '';
      if (!nextSrc) return;

      setPackageIndex(packaging, nextIndex);
      image.src = nextSrc;
      image.alt = getSlideImageAlt(nextSlide) || image.alt;
      lightbox.dataset.workshopLightboxIndex = nextIndex;
    }

    function openLightbox(section, index) {
      var lightbox = section ? section.querySelector('[data-workshop-lightbox]') : null;
      var image = lightbox ? lightbox.querySelector('[data-workshop-lightbox-image]') : null;
      if (!lightbox || !image) return;

      setLightboxIndex(lightbox, Number(index || 0));
      activeLightbox = lightbox;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('workshop-evidence-lightbox-open');

      var closeButton = lightbox.querySelector('[data-workshop-lightbox-close]');
      if (closeButton) closeButton.focus();
    }

    function closeLightbox(lightbox) {
      if (!lightbox) return;

      var image = lightbox.querySelector('[data-workshop-lightbox-image]');
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('workshop-evidence-lightbox-open');

      if (image) {
        setTimeout(function() {
          if (!lightbox.classList.contains('is-open')) {
            image.removeAttribute('src');
          }
        }, 300);
      }

      if (activeLightbox === lightbox) activeLightbox = null;
    }

    document.addEventListener('click', function (event) {
      var videoFrame = event.target.closest('.workshop-evidence__video-frame');
      if (videoFrame) {
        var card = videoFrame.closest('[data-workshop-video-card]');
        var video = card ? card.querySelector('video') : null;
        if (!video) return;

        loadWorkshopVideo(video);

        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
        return;
      }

      var prevButton = event.target.closest('[data-workshop-package-prev]');
      if (prevButton) {
        var prevPackaging = prevButton.closest('[data-workshop-packaging]');
        var prevIndex = Number(prevPackaging.dataset.workshopPackageIndex || 0);
        setPackageIndex(prevPackaging, prevIndex - 1);
        return;
      }

      var nextButton = event.target.closest('[data-workshop-package-next]');
      if (nextButton) {
        var nextPackaging = nextButton.closest('[data-workshop-packaging]');
        var nextIndex = Number(nextPackaging.dataset.workshopPackageIndex || 0);
        setPackageIndex(nextPackaging, nextIndex + 1);
        return;
      }

      var dotButton = event.target.closest('[data-workshop-package-dot]');
      if (dotButton) {
        var dotPackaging = dotButton.closest('[data-workshop-packaging]');
        setPackageIndex(dotPackaging, Number(dotButton.dataset.workshopPackageIndex || 0));
        return;
      }

      var lightboxPrevButton = event.target.closest('[data-workshop-lightbox-prev]');
      if (lightboxPrevButton) {
        var prevLightbox = lightboxPrevButton.closest('[data-workshop-lightbox]');
        var lightboxPrevIndex = Number(prevLightbox.dataset.workshopLightboxIndex || 0);
        setLightboxIndex(prevLightbox, lightboxPrevIndex - 1);
        return;
      }

      var lightboxNextButton = event.target.closest('[data-workshop-lightbox-next]');
      if (lightboxNextButton) {
        var nextLightbox = lightboxNextButton.closest('[data-workshop-lightbox]');
        var lightboxNextIndex = Number(nextLightbox.dataset.workshopLightboxIndex || 0);
        setLightboxIndex(nextLightbox, lightboxNextIndex + 1);
        return;
      }

      var lightboxButton = event.target.closest('[data-workshop-lightbox-open]');
      if (lightboxButton) {
        var section = lightboxButton.closest('.workshop-evidence');
        openLightbox(section, Number(lightboxButton.dataset.workshopLightboxIndex || 0));
        return;
      }

      var closeButton = event.target.closest('[data-workshop-lightbox-close]');
      if (closeButton) {
        closeLightbox(closeButton.closest('[data-workshop-lightbox]'));
      }
    });

    var touchStartX = 0;
    var touchEndX = 0;
    document.addEventListener('touchstart', function(e) {
      var track = e.target.closest('[data-workshop-package-track]');
      if (track && e.changedTouches && e.changedTouches.length > 0) {
        touchStartX = e.changedTouches[0].screenX;
      }
    }, {passive: true});

    document.addEventListener('touchend', function(e) {
      var packaging = e.target.closest('[data-workshop-packaging]');
      if (packaging && e.changedTouches && e.changedTouches.length > 0) {
        touchEndX = e.changedTouches[0].screenX;
        var diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          var currentIndex = Number(packaging.dataset.workshopPackageIndex || 0);
          if (diff > 0) {
            setPackageIndex(packaging, currentIndex + 1);
          } else {
            setPackageIndex(packaging, currentIndex - 1);
          }
        }
      }
    }, {passive: true});

    document.addEventListener('dragstart', function(e) {
      if (e.target.closest('.workshop-evidence__video') || e.target.closest('.workshop-evidence__package-slide img')) {
        e.preventDefault();
      }
    });

    document.querySelectorAll('.workshop-evidence__media-grid').forEach(function(slider) {
      var isDown = false;
      var startX;
      var scrollLeft;

      slider.addEventListener('mousedown', function(e) {
        // Prevent drag on packaging controls
        if (e.target.closest('.workshop-evidence__package-nav') || e.target.closest('.workshop-evidence__package-dot')) {
          return;
        }
        isDown = true;
        slider.classList.add('is-dragging');
        startX = e.pageX - slider.offsetLeft;
        scrollLeft = slider.scrollLeft;
      });
      slider.addEventListener('mouseleave', function() {
        isDown = false;
        slider.classList.remove('is-dragging');
      });
      slider.addEventListener('mouseup', function() {
        isDown = false;
        slider.classList.remove('is-dragging');
      });
      slider.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        e.preventDefault();
        var x = e.pageX - slider.offsetLeft;
        var walk = (x - startX) * 2;
        slider.scrollLeft = scrollLeft - walk;
      });
    });

    document.addEventListener('keydown', function (event) {
      if (!activeLightbox) return;

      if (event.key === 'Escape') {
        closeLightbox(activeLightbox);
      }

      if (event.key === 'ArrowLeft') {
        setLightboxIndex(activeLightbox, Number(activeLightbox.dataset.workshopLightboxIndex || 0) - 1);
      }

      if (event.key === 'ArrowRight') {
        setLightboxIndex(activeLightbox, Number(activeLightbox.dataset.workshopLightboxIndex || 0) + 1);
      }
    });

    document.querySelectorAll('[data-workshop-video-card] video').forEach(function (video) {
      video.addEventListener('play', function () {
        var card = video.closest('[data-workshop-video-card]');
        if (card) card.classList.add('is-playing');
      });

      video.addEventListener('pause', function () {
        var card = video.closest('[data-workshop-video-card]');
        if (card) card.classList.remove('is-playing');
      });
    });

    if ('IntersectionObserver' in window) {
      var videoObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;

          loadWorkshopVideo(entry.target);
          videoObserver.unobserve(entry.target);
        });
      }, { rootMargin: '520px 0px' });

      document.querySelectorAll('.workshop-evidence__video[data-workshop-video-src]').forEach(function (video) {
        videoObserver.observe(video);
      });
    }
  })();
{% endjavascript %}

