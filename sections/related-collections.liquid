{% comment %}
  Complementary Collections Slider Section
  Renders an editorial carousel of curated collections below the main collection content.
  4 cards visible simultaneously on desktop.
  Adheres strictly to Wrydeco Design System and CODING_RULES.md.
{% endcomment %}

{%- liquid
  assign related_list = collection.metafields.custom.related_collections.value
  assign candidate_handles = ''

  if related_list != blank
    for rel in related_list
      if rel.handle != collection.handle and rel.all_products_count > 0
        assign candidate_handles = candidate_handles | append: rel.handle | append: ','
      endif
    endfor
  endif

  if candidate_handles == blank
    assign col_h = collection.handle
    if col_h contains 'bookshelf' or col_h contains 'tree'
      assign fallback_pool = 'wall-mounted-tree-bookshelves,corner-bookshelf,standing-bookshelf,floating-bookshelf,bookshelf-modern,bookshelf-rustic' | split: ','
    elsif col_h contains 'table'
      assign fallback_pool = 'console-table,end-table,wooden-floor-sculpture,signature-pieces,floating-shelves' | split: ','
    elsif col_h contains 'wine'
      assign fallback_pool = 'wine-racks,wall-mounted-wine-rack,tree-wine-rack,signature-pieces' | split: ','
    elsif col_h contains 'bed'
      assign fallback_pool = 'bedside-table,wooden-floor-sculpture,floating-shelves,signature-pieces' | split: ','
    elsif col_h contains 'shelf' or col_h contains 'shelves'
      assign fallback_pool = 'floating-shelves,floating-bookshelf,wall-mounted-tree-bookshelves,corner-bookshelf' | split: ','
    else
      assign fallback_pool = 'wall-mounted-tree-bookshelves,corner-bookshelf,standing-bookshelf,coffee-tables,console-table,wooden-floor-sculpture,signature-pieces,floating-shelves' | split: ','
    endif

    for h in fallback_pool
      if h != col_h
        assign check_col = collections[h]
        if check_col != blank and check_col.all_products_count > 0
          assign candidate_handles = candidate_handles | append: h | append: ','
        endif
      endif
    endfor
  endif

  assign chosen_handles = candidate_handles | split: ','
-%}

{%- if chosen_handles.size > 0 -%}
  <section
    class="related-cols"
    id="RelatedCollections-{{ section.id }}"
    aria-labelledby="RelatedHeading-{{ section.id }}"
  >
    <div class="related-cols__inner page-width">
      <header class="related-cols__header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="related-cols__eyebrow-wrap">
            <span class="related-cols__eyebrow">{{ section.settings.eyebrow | escape }}</span>
            <span class="related-cols__eyebrow-line" aria-hidden="true"></span>
          </div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="RelatedHeading-{{ section.id }}" class="related-cols__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="related-cols__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>

      <div class="related-cols__carousel" data-related-slider>
        <button
          type="button"
          class="related-cols__nav-btn related-cols__nav-btn--prev"
          data-slider-prev
          aria-label="Previous collections"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m12 19-7-7 7-7m7 7H5"/>
          </svg>
        </button>

        <div class="related-cols__track-viewport">
          <div
            class="related-cols__track"
            data-slider-track
            role="region"
            aria-label="Complementary Collections Slider"
            tabindex="0"
          >
            {%- for h in chosen_handles -%}
              {%- assign item_col = collections[h] -%}
              {%- if item_col == blank or item_col.all_products_count == 0 -%}
                {%- continue -%}
              {%- endif -%}

              {%- liquid
                assign col_image = item_col.image
                if col_image == blank
                  assign col_image = item_col.featured_image
                endif
                if col_image == blank
                  assign col_image = item_col.products.first.featured_image
                endif
                assign col_image_alt = col_image.alt | default: item_col.title

                assign col_desc = item_col.description | strip_html | truncatewords: 16
                if col_desc == blank
                  assign handle_str = item_col.handle
                  if handle_str contains 'wall-mounted'
                    assign col_desc = 'Turn your walls into a living work of art with our handcrafted tree bookshelves.'
                  elsif handle_str contains 'corner'
                    assign col_desc = 'Make the most of every corner with nature-inspired designs.'
                  elsif handle_str contains 'standing'
                    assign col_desc = 'Bold, functional and artistic — a statement piece for any room.'
                  elsif handle_str contains 'floating-bookshelf'
                    assign col_desc = 'Elevated branch silhouettes designed to display your collection with effortless grace.'
                  elsif handle_str contains 'modern'
                    assign col_desc = 'Contemporary sculpted curves embodying refined organic minimalism.'
                  elsif handle_str contains 'rustic'
                    assign col_desc = 'Authentic natural wood grain celebrating pure artisanal craftsmanship.'
                  elsif handle_str contains 'coffee'
                    assign col_desc = 'Sculptural solid wood centerpieces shaped by nature and refined by hand.'
                  elsif handle_str contains 'console'
                    assign col_desc = 'Handcrafted solid wood console tables designed to transform entryways and living spaces.'
                  elsif handle_str contains 'sculpture'
                    assign col_desc = 'Tactile statement pieces celebrating the authentic organic movement of solid wood.'
                  elsif handle_str contains 'shelf' or handle_str contains 'shelves'
                    assign col_desc = 'Solid wood floating shelves designed for refined wall displays and functional warmth.'
                  else
                    assign col_desc = 'Thoughtfully curated pieces designed to harmonize with your space.'
                  endif
                endif
              -%}

              <article class="related-col-card" data-slide-card>
                <a
                  class="related-col-card__link"
                  href="{{ item_col.url }}"
                  aria-label="{{ item_col.title | escape }}"
                  draggable="false"
                >
                  <div class="related-col-card__media">
                    {%- if col_image != blank -%}
                      {{
                        col_image
                        | image_url: width: 800
                        | image_tag:
                          class: 'related-col-card__img',
                          loading: 'lazy',
                          widths: '320, 480, 640, 800',
                          sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 85vw',
                          alt: col_image_alt,
                          draggable: 'false'
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'related-col-card__img placeholder-svg' }}
                    {%- endif -%}
                  </div>

                  <div class="related-col-card__info">
                    <h3 class="related-col-card__title">{{ item_col.title | escape }}</h3>
                    {%- if section.settings.show_product_count -%}
                      <p class="related-col-card__count">
                        {{ item_col.all_products_count }}
                        {{ item_col.all_products_count | pluralize: 'piece', 'pieces' }}
                      </p>
                    {%- endif -%}

                    {%- if section.settings.show_description and col_desc != blank -%}
                      <p class="related-col-card__desc">{{ col_desc | escape }}</p>
                    {%- endif -%}

                    <div class="related-col-card__cta" aria-hidden="true">
                      <span class="related-col-card__cta-inner">
                        <span>Explore Collection</span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          width="15"
                          height="15"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="related-col-card__arrow"
                        >
                          <path d="M5 12h14m-7-7 7 7-7 7"/>
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              </article>
            {%- endfor -%}
          </div>
        </div>

        <button
          type="button"
          class="related-cols__nav-btn related-cols__nav-btn--next"
          data-slider-next
          aria-label="Next collections"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14m-7-7 7 7-7 7"/>
          </svg>
        </button>
      </div>

      <div class="related-cols__pagination" data-slider-pagination aria-label="Carousel pagination"></div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .related-cols {
    display: block;
    width: 100%;
    background-color: #faf7f2;
    padding-block: clamp(28px, 6vw, 44px);
    font-family: var(--font-body);
    color: var(--text-primary);
    overflow: hidden;
  }

  .related-cols__inner {
    margin-inline: auto;
    position: relative;
  }

  /* Header */
  .related-cols__header {
    text-align: center;
    max-width: 740px;
    margin-inline: auto;
    margin-bottom: clamp(18px, 3vw, 28px);
  }

  .related-cols__eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .related-cols__eyebrow {
    font-family: var(--font-roboto, sans-serif);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #63574c;
  }

  .related-cols__eyebrow-line {
    display: inline-block;
    width: 36px;
    height: 1px;
    background-color: #b8ada0;
  }

  .related-cols__heading {
    margin: 0 0 12px;
    font-family: var(--font-display, "Fraunces", Georgia, serif);
    font-size: clamp(32px, 3.8vw, 52px);
    font-weight: 400;
    line-height: 1.15;
    color: #2b1810;
    letter-spacing: -0.01em;
  }

  .related-cols__subheading {
    margin: 0 auto;
    font-size: 15px;
    line-height: 1.6;
    color: #635950;
    max-width: 60ch;
  }

  /* Carousel Layout */
  .related-cols__carousel {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    padding-inline: 64px; /* Comfortably clears circular side buttons */
  }

  .related-cols__nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #7d6f6363;
    background-color: #faf7f2;
    color: #2b1810;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
    box-shadow: 0 2px 8px rgba(43, 24, 16, 0.04);
  }

  .related-cols__nav-btn:hover:not(:disabled) {
    border-color: #2b181088;
    color: #2b1810;
    box-shadow: 0 4px 14px rgba(43, 24, 16, 0.12);
    transform: translateY(-50%) scale(1.05);
  }

  .related-cols__nav-btn:disabled,
  .related-cols__nav-btn[aria-disabled="true"] {
    opacity: 0.3;
    cursor: not-allowed;
    border-color: #c4b9ac;
  }

  .related-cols__nav-btn--prev {
    left: 10px;
  }

  .related-cols__nav-btn--next {
    right: 10px;
  }

  .related-cols__track-viewport {
    width: 100%;
    overflow: hidden;
  }

  .related-cols__track {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    padding: 8px 4px 16px;
    user-select: none;
    -webkit-user-select: none;
  }

  .related-cols__track::-webkit-scrollbar {
    display: none;
  }

  .related-cols__track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto !important;
  }

  /* Collection Card (Desktop: Exactly 4 cards visible in viewport) */
  .related-col-card {
    flex: 0 0 calc((100% - 3 * 22px) / 4);
    min-width: 0;
    background-color: var(--color-white-cream);
    border: 1px solid rgba(43, 24, 16, 0.08);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(43, 24, 16, 0.03);
    transition: transform 0.35s cubic-bezier(0.2, 0, 0, 1),
                box-shadow 0.35s cubic-bezier(0.2, 0, 0, 1),
                border-color 0.35s cubic-bezier(0.2, 0, 0, 1);
    display: flex;
    flex-direction: column;
  }

  .related-col-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(43, 24, 16, 0.08);
    border-color: rgba(43, 24, 16, 0.2);
  }

  .related-col-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    -webkit-user-drag: none;
    user-drag: none;
    user-select: none;
  }

  .related-col-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #ede7df;
    -webkit-user-drag: none;
    user-drag: none;
    user-select: none;
  }

  .related-col-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0, 0, 1);
    -webkit-user-drag: none;
    user-drag: none;
    user-select: none;
    pointer-events: none; /* Disables browser native drag on images */
  }

  .related-col-card:hover .related-col-card__img {
    transform: scale(1.04);
  }

  .related-col-card__info {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 20px 18px 22px;
  }

  .related-col-card__title {
    margin: 0;
    font-family: var(--font-display, "Fraunces", Georgia, serif);
    font-size: 18.5px;
    font-weight: 500;
    line-height: 1.25;
    color: #231815;
    transition: color 0.2s ease;
  }

  .related-col-card:hover .related-col-card__title {
    color: #4a2c18;
  }

  .related-col-card__count {
    margin: 5px 0 8px;
    font-size: 12.5px;
    color: #7d7268;
    font-weight: 400;
  }

  .related-col-card__desc {
    margin: 0 0 16px;
    font-size: 13px;
    line-height: 1.5;
    color: #595149;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-col-card__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
  }

  .related-col-card__cta-inner {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-roboto, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2b1810;
    padding-bottom: 3px;
    border-bottom: 1px solid #2b1810;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .related-col-card:hover .related-col-card__cta-inner {
    color: #4a2c18;
    border-color: #4a2c18;
  }

  .related-col-card__arrow {
    transition: transform 0.25s ease;
  }

  .related-col-card:hover .related-col-card__arrow {
    transform: translateX(3px);
  }

  /* Pagination Dots */
  .related-cols__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
  }

  .related-cols__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background-color: #d7cec5;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .related-cols__dot:hover {
    background-color: #a89c8f;
  }

  .related-cols__dot.is-active {
    background-color: #3c2415;
    transform: scale(1.15);
  }

  /* Responsive: Tablet Breakpoint */
  @media screen and (max-width: 1024px) {
    .related-cols {
      padding-block: clamp(40px, 5vw, 64px);
    }

    .related-cols__carousel {
      padding-inline: 46px;
    }

    .related-cols__nav-btn {
      width: 40px;
      height: 40px;
    }

    .related-cols__track {
      gap: 18px;
    }

    .related-col-card {
      flex: 0 0 calc((100% - 18px) / 2);
    }

    .related-col-card__info {
      padding: 18px 16px 16px;
    }

    .related-col-card__title {
      font-size: 19px;
    }
  }

  /* Responsive: Mobile Breakpoint */
  @media screen and (max-width: 640px) {
    .related-cols {
      padding-block: 36px;
    }

    .related-cols__carousel {
      padding-inline: 0;
    }

    .related-cols__header {
      margin-bottom: 28px;
    }

    .related-cols__nav-btn {
      display: none; /* Touch swipe is natural on mobile */
    }

    .related-cols__track {
      gap: 14px;
      padding-inline: 4px;
    }

    .related-col-card {
      flex: 0 0 65%; /* Peek effect for intuitive swipe */
    }

    .related-col-card__info {
      padding: 18px 16px 16px;
    }

    .related-col-card__title {
      font-size: 18.5px;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function setupRelatedSliders() {
      const sliders = document.querySelectorAll('[data-related-slider]');
      sliders.forEach(slider => {
        if (slider.dataset.sliderInitialized === 'true') return;
        slider.dataset.sliderInitialized = 'true';

        const track = slider.querySelector('[data-slider-track]');
        const prevBtn = slider.querySelector('[data-slider-prev]');
        const nextBtn = slider.querySelector('[data-slider-next]');
        const sectionEl = slider.closest('.related-cols');
        const pagination = sectionEl ? sectionEl.querySelector('[data-slider-pagination]') : null;
        const cards = track ? track.querySelectorAll('[data-slide-card]') : [];

        if (!track || cards.length === 0) return;

        // Prevent HTML5 native drag on all images and elements inside track
        track.addEventListener('dragstart', function(e) {
          e.preventDefault();
          return false;
        });

        function getStep() {
          const firstCard = cards[0];
          const gap = parseFloat(window.getComputedStyle(track).gap) || 22;
          return (firstCard ? firstCard.offsetWidth : 280) + gap;
        }

        function getVisibleCardsCount() {
          const w = window.innerWidth;
          if (w <= 640) return 1;
          if (w <= 1024) return 2;
          return 4;
        }

        function getDotTargetScroll(index, totalDots, maxScroll, step) {
          if (totalDots <= 1) return 0;
          if (index >= totalDots - 1) return maxScroll;
          return Math.min(maxScroll, index * step);
        }

        function updatePaginationAndArrows() {
          const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
          const current = track.scrollLeft;

          if (prevBtn) {
            const isAtStart = current <= 4;
            prevBtn.disabled = isAtStart;
            prevBtn.setAttribute('aria-disabled', isAtStart ? 'true' : 'false');
          }
          if (nextBtn) {
            const isAtEnd = current >= maxScroll - 4;
            nextBtn.disabled = isAtEnd;
            nextBtn.setAttribute('aria-disabled', isAtEnd ? 'true' : 'false');
          }

          if (pagination) {
            const dots = pagination.querySelectorAll('.related-cols__dot');
            const dotsCount = dots.length;
            if (dotsCount > 0) {
              const step = getStep();
              let activeIndex = 0;
              if (current >= maxScroll - 4) {
                activeIndex = dotsCount - 1;
              } else if (current <= 4) {
                activeIndex = 0;
              } else {
                let minDiff = Infinity;
                for (let i = 0; i < dotsCount; i++) {
                  const target = getDotTargetScroll(i, dotsCount, maxScroll, step);
                  const diff = Math.abs(current - target);
                  if (diff < minDiff) {
                    minDiff = diff;
                    activeIndex = i;
                  }
                }
              }

              dots.forEach((dot, idx) => {
                const isActive = idx === activeIndex;
                dot.classList.toggle('is-active', isActive);
                dot.setAttribute('aria-current', isActive ? 'true' : 'false');
              });
            }
          }
        }

        // Arrow Buttons
        if (prevBtn) {
          prevBtn.addEventListener('click', function() {
            const target = Math.max(0, track.scrollLeft - getStep());
            track.scrollTo({ left: target, behavior: 'smooth' });
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', function() {
            const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
            const target = Math.min(maxScroll, track.scrollLeft + getStep());
            track.scrollTo({ left: target, behavior: 'smooth' });
          });
        }

        // Mouse Drag to Slide (Hold and drag)
        let isMouseDown = false;
        let startX = 0;
        let startScrollLeft = 0;
        let hasDragged = false;

        track.addEventListener('mousedown', function(e) {
          if (e.button !== 0) return; // Only left click
          isMouseDown = true;
          hasDragged = false;
          startX = e.clientX;
          startScrollLeft = track.scrollLeft;
          track.classList.add('is-dragging');
        });

        window.addEventListener('mousemove', function(e) {
          if (!isMouseDown) return;
          const currentX = e.clientX;
          const delta = currentX - startX;
          if (Math.abs(delta) > 5) {
            hasDragged = true;
          }
          track.scrollLeft = startScrollLeft - delta;
        });

        function endDrag() {
          if (!isMouseDown) return;
          isMouseDown = false;
          track.classList.remove('is-dragging');
        }

        window.addEventListener('mouseup', endDrag);
        track.addEventListener('mouseleave', function() {
          if (isMouseDown) endDrag();
        });

        // Prevent opening collection links if the user dragged
        cards.forEach(card => {
          const link = card.querySelector('a');
          if (link) {
            link.addEventListener('click', function(e) {
              if (hasDragged) {
                e.preventDefault();
                e.stopPropagation();
                hasDragged = false;
              }
            });
          }
        });

        // Track Scroll listener for dots and arrows
        let ticking = false;
        track.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(function() {
              updatePaginationAndArrows();
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // Build pagination dots
        function renderDots() {
          if (!pagination) return;
          pagination.innerHTML = '';
          const visible = getVisibleCardsCount();
          const dotsCount = Math.max(1, cards.length - visible + 1);
          if (dotsCount <= 1) return;

          for (let i = 0; i < dotsCount; i++) {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'related-cols__dot' + (i === 0 ? ' is-active' : '');
            dot.setAttribute('aria-label', 'Go to collection group ' + (i + 1));
            dot.addEventListener('click', function() {
              const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
              const target = getDotTargetScroll(i, dotsCount, maxScroll, getStep());
              track.scrollTo({ left: target, behavior: 'smooth' });
            });
            pagination.appendChild(dot);
          }
        }

        renderDots();
        window.addEventListener('resize', function() {
          renderDots();
          updatePaginationAndArrows();
        });

        updatePaginationAndArrows();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupRelatedSliders);
    } else {
      setupRelatedSliders();
    }
    document.addEventListener('shopify:section:load', setupRelatedSliders);
  })();
</script>

