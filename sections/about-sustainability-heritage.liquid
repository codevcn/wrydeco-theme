{%- liquid
  assign consultation_url = section.settings.consultation_url | default: pages['customization'].url | default: routes.root_url
  assign contact_url = section.settings.contact_url | default: pages['contact'].url | default: routes.root_url
-%}

<section class="about-heritage" aria-labelledby="about-heritage-heading-{{ section.id }}">
  <div class="about-mission">
    <div class="about-mission__media" aria-hidden="true">
      <img src="{{ 'about-us-M-4.png' | file_url }}" width="1672" height="941" alt="" loading="lazy">
    </div>

    <div class="about-mission__inner">
      <div class="about-mission__content">
        <header class="about-mission__header">
          <p class="about-mission__eyebrow">{{ section.settings.mission_eyebrow | escape }}</p>
          <span class="about-mission__eyebrow-rule" aria-hidden="true"></span>
          <h2 id="about-heritage-heading-{{ section.id }}">
            <span>{{ section.settings.mission_heading_first_line | escape }}</span>
            <span>{{ section.settings.mission_heading_second_line | escape }}</span>
          </h2>
          <div class="about-mission__intro rte">{{ section.settings.mission_intro }}</div>
        </header>

        <div class="about-mission__values">
        {%- for block in section.blocks -%}
          {%- if block.type == 'mission_value' -%}
            <article class="about-mission-value" {{ block.shopify_attributes }}>
              <span class="about-mission-value__icon" aria-hidden="true">
                {% render 'about-craft-icon', icon: block.settings.icon %}
              </span>
              <div class="about-mission-value__copy">
                <h3>{{ block.settings.heading | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <div class="about-heritage__inner">
    <section class="about-design" aria-labelledby="about-design-heading-{{ section.id }}">
      <div class="about-design__gallery">
        <div class="about-design__image about-design__image--one">
          <img
            src="{{ 'about-us-M-5--1.png' | file_url }}"
            width="800"
            height="800"
            alt="{{ section.settings.design_image_one_alt | escape }}"
            loading="lazy"
          >
        </div>
        <div class="about-design__image about-design__image--two">
          <img
            src="{{ 'about-us-M-5--2.png' | file_url }}"
            width="1200"
            height="800"
            alt="{{ section.settings.design_image_two_alt | escape }}"
            loading="lazy"
          >
        </div>
        <div class="about-design__image about-design__image--three">
          <img
            src="{{ 'about-us-M-5--3.png' | file_url }}"
            width="1000"
            height="1000"
            alt="{{ section.settings.design_image_three_alt | escape }}"
            loading="lazy"
          >
        </div>
        <div class="about-design__image about-design__image--four">
          <img
            src="{{ 'about-us-M-5--4.png' | file_url }}"
            width="1000"
            height="1000"
            alt="{{ section.settings.design_image_four_alt | escape }}"
            loading="lazy"
          >
        </div>
      </div>

      <div class="about-design__copy">
        <p class="about-design__eyebrow">{{ section.settings.design_eyebrow | escape }}</p>
        <h2 id="about-design-heading-{{ section.id }}">
          <span>{{ section.settings.design_heading_first_line | escape }}</span>
          <span>{{ section.settings.design_heading_second_line | escape }}</span>
          <span>{{ section.settings.design_heading_third_line | escape }}</span>
        </h2>
        <div class="about-design__text rte">{{ section.settings.design_text }}</div>

        <ul class="about-design__principles" aria-label="Design principles">
          <li><span aria-hidden="true"></span>{{ section.settings.design_principle_one | escape }}</li>
          <li><span aria-hidden="true"></span>{{ section.settings.design_principle_two | escape }}</li>
          <li><span aria-hidden="true"></span>{{ section.settings.design_principle_three | escape }}</li>
        </ul>
      </div>
    </section>
  </div>

  <section class="about-craft-story" aria-labelledby="about-craft-story-heading-{{ section.id }}">
    <div class="about-craft-story__media">
      <img
        src="{{ 'about-us-M-6.png' | file_url }}"
        width="941"
        height="941"
        alt="{{ section.settings.craft_image_alt | escape }}"
        loading="lazy"
      >
    </div>

    <div class="about-craft-story__content">
      <div class="about-craft-story__copy">
        <p class="about-craft-story__section-label">{{ section.settings.craft_section_label | escape }}</p>
        <span class="about-craft-story__section-rule" aria-hidden="true"></span>
        <p class="about-craft-story__eyebrow">{{ section.settings.craft_eyebrow | escape }}</p>
        <h2 id="about-craft-story-heading-{{ section.id }}">
          <span>{{ section.settings.craft_heading_first_line | escape }}</span>
          <span>{{ section.settings.craft_heading_second_line | escape }}</span>
        </h2>
        <span class="about-craft-story__heading-rule" aria-hidden="true"></span>
        <div class="about-craft-story__text rte">{{ section.settings.craft_text }}</div>

        <ul class="about-craft-story__features" aria-label="Craftsmanship qualities">
          <li>
            <span class="about-craft-story__feature-icon" aria-hidden="true">
              {% render 'about-craft-icon', icon: 'organic-curve' %}
            </span>
            <span>{{ section.settings.craft_feature_one | escape }}</span>
          </li>
          <li>
            <span class="about-craft-story__feature-icon" aria-hidden="true">
              {% render 'about-craft-icon', icon: 'balanced-proportion' %}
            </span>
            <span>{{ section.settings.craft_feature_two | escape }}</span>
          </li>
          <li>
            <span class="about-craft-story__feature-icon" aria-hidden="true">
              {% render 'about-craft-icon', icon: 'handmade' %}
            </span>
            <span>{{ section.settings.craft_feature_three | escape }}</span>
          </li>
          <li>
            <span class="about-craft-story__feature-icon" aria-hidden="true">
              {% render 'about-craft-icon', icon: 'purpose-wood' %}
            </span>
            <span>{{ section.settings.craft_feature_four | escape }}</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="about-heritage__cta" aria-labelledby="about-heritage-cta-heading-{{ section.id }}">
    <div class="about-heritage__cta-media" aria-hidden="true">
      <img src="{{ 'faq--faq-img.png' | file_url }}" width="1792" height="1024" alt="" loading="lazy">
    </div>
    <div class="about-heritage__cta-content">
      <h2 id="about-heritage-cta-heading-{{ section.id }}">{{ section.settings.cta_heading | escape }}</h2>
      <p>{{ section.settings.cta_text | escape }}</p>
      <div class="about-heritage__actions">
        <a class="about-heritage__button about-heritage__button--primary" href="{{ consultation_url }}#custom-inquiry__story-telling">
          {{ section.settings.consultation_button_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="about-heritage__button about-heritage__button--secondary" href="{{ contact_url }}">
          {{ section.settings.contact_button_label | escape }}
        </a>
      </div>
    </div>
  </section>
</section>

{% stylesheet %}
  .about-heritage {
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
  }

  .about-mission {
    position: relative;
    display: grid;
    min-block-size: var(--layout-hero-wide-height);
    overflow: hidden;
    background: var(--color-ebony);
    color: var(--text-inverse);
  }

  .about-mission__media {
    position: absolute;
    inset: var(--sp-0);
  }

  .about-mission__media::after {
    position: absolute;
    inset: var(--sp-0);
    background:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-ebony) 94%, transparent),
        color-mix(in srgb, var(--color-ebony) 82%, transparent) 34%,
        color-mix(in srgb, var(--color-ebony) 22%, transparent) 72%,
        transparent
      ),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-ebony) 10%, transparent), color-mix(in srgb, var(--color-ebony) 30%, transparent));
    content: '';
  }

  .about-mission__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-mission__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    inline-size: 100%;
    padding-block: var(--sp-6-bigger);
    padding-inline: calc(var(--sp-11) - var(--sp-1));
  }

  .about-mission__content {
    inline-size: min(100%, var(--layout-hero-copy-width));
  }

  .about-mission__eyebrow,
  .about-heritage__eyebrow {
    margin: var(--sp-0);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 6);
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .about-mission__eyebrow {
    color: var(--color-orange);
  }

  .about-mission__eyebrow-rule {
    display: block;
    inline-size: calc(var(--sp-7) + var(--sp-1));
    block-size: calc(var(--border-width) * 2);
    margin-block: var(--sp-6);
    background: var(--color-orange);
  }

  .about-mission h2,
  .about-design h2,
  .about-craft-story h2,
  .about-heritage__cta h2 {
    margin: var(--sp-0);
    font-family: var(--font-display-light);
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-snug);
    line-height: var(--line-height-tight);
  }

  .about-mission h2 {
    color: var(--text-inverse);
    font-size: clamp(var(--font-size-display-lg), 4vw, var(--font-size-display-xl));
  }

  .about-mission h2 span {
    display: block;
  }

  .about-mission__intro {
    max-inline-size: 48ch;
    margin-block-start: var(--sp-5);
    color: var(--color-cream);
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-generous);
  }

  .about-mission__intro p,
  .about-mission-value p {
    margin: var(--sp-0);
  }

  .about-mission__values {
    max-inline-size: calc(var(--layout-hero-copy-width) - (var(--sp-12) * 2));
    margin-block-start: var(--sp-5);
    border-block-start: var(--border-width) solid color-mix(in srgb, var(--color-orange) 58%, transparent);
  }

  .about-mission-value {
    display: grid;
    grid-template-columns: calc(var(--sp-10) + var(--sp-2)) minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-5);
    padding-block: var(--sp-5);
    border-block-end: var(--border-width) solid color-mix(in srgb, var(--color-orange) 58%, transparent);
  }

  .about-mission-value__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: calc(var(--sp-10) + var(--sp-2));
    block-size: calc(var(--sp-10) + var(--sp-2));
    padding: var(--sp-4);
    border: var(--border-width) solid var(--color-orange);
    border-radius: var(--radius-full);
    color: var(--color-orange);
  }

  .about-mission-value__icon svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .about-mission-value__copy {
    padding-inline-start: var(--sp-5);
    border-inline-start: var(--border-width) solid var(--color-orange);
  }

  .about-mission-value h3 {
    margin: var(--sp-0) var(--sp-0) var(--sp-1);
    color: var(--color-cream);
    font-family: var(--font-display-light);
    font-size: var(--font-size-body-2xl);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-tight);
  }

  .about-mission-value p {
    color: var(--color-cream);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-relaxed);
  }

  .about-heritage__inner {
    inline-size: min(calc(100% - (var(--sp-8) * 2)), var(--layout-showcase-max-width));
    margin-inline: auto;
    padding-block: var(--sp-7) var(--sp-5);
  }

  .about-design h2,
  .about-craft-story h2,
  .about-heritage__cta h2 {
    color: var(--color-ebony);
  }

  .about-design {
    display: grid;
    grid-template-columns: minmax(0, 56%) minmax(0, 44%);
    align-items: center;
    gap: var(--sp-8);
  }

  .about-design__gallery {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-rows: repeat(4, minmax(0, 1fr));
    gap: var(--sp-2);
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .about-design__image {
    min-inline-size: var(--sp-0);
    min-block-size: var(--sp-0);
    overflow: hidden;
  }

  .about-design__image--one {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }

  .about-design__image--two {
    grid-column: 3 / 6;
    grid-row: 1 / 3;
  }

  .about-design__image--three {
    grid-column: 1 / 4;
    grid-row: 3 / 5;
  }

  .about-design__image--four {
    grid-column: 4 / 6;
    grid-row: 3 / 5;
  }

  .about-design__image img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .about-design__copy {
    padding-inline: var(--sp-5);
  }

  .about-design__eyebrow {
    margin: var(--sp-0) var(--sp-0) var(--sp-6);
    color: var(--color-earth-brown);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 5);
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .about-design h2 {
    font-size: var(--font-size-display-xl);
  }

  .about-design h2 span {
    display: block;
  }

  .about-design__text {
    display: grid;
    gap: var(--sp-3);
    max-inline-size: 52ch;
    margin-block-start: var(--sp-5);
    color: var(--color-charcoal);
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-generous);
  }

  .about-design__text p {
    margin: var(--sp-0);
  }

  .about-design__principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5);
    margin: var(--sp-8) var(--sp-0) var(--sp-0);
    padding: var(--sp-0);
    color: var(--color-earth-brown);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 2);
    line-height: var(--line-height-generous);
    list-style: none;
    text-transform: uppercase;
  }

  .about-design__principles li > span {
    position: relative;
    display: block;
    block-size: var(--border-width);
    margin-block-end: var(--sp-4);
    background: var(--color-linen);
  }

  .about-design__principles li > span::before {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: var(--sp-0);
    inline-size: var(--sp-2);
    block-size: var(--sp-2);
    border: var(--border-width) solid var(--color-bark);
    border-radius: var(--radius-full);
    background: var(--color-cream);
    content: '';
    transform: translateY(-50%);
  }

  .about-craft-story {
    display: grid;
    grid-template-columns: minmax(0, 56%) minmax(0, 44%);
    min-block-size: var(--layout-hero-wide-height);
    overflow: hidden;
    margin-block-start: var(--sp-5);
    border-block: var(--border-width) solid var(--border-light);
    background: var(--color-cream);
    color: var(--color-ebony);
  }

  .about-craft-story__media {
    min-inline-size: var(--sp-0);
    overflow: hidden;
  }

  .about-craft-story__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-craft-story__content {
    display: flex;
    align-items: center;
    padding: var(--sp-7) var(--sp-8);
  }

  .about-craft-story__copy {
    inline-size: min(100%, var(--layout-hero-copy-width));
    margin-inline: auto;
  }

  .about-craft-story__section-label,
  .about-craft-story__eyebrow {
    margin: var(--sp-0);
    color: var(--color-earth-brown);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: calc(var(--letter-spacing-wide) * 4);
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .about-craft-story__section-rule {
    display: block;
    inline-size: 100%;
    block-size: var(--border-width);
    margin-block: var(--sp-4) var(--sp-8);
    background: var(--color-linen);
  }

  .about-craft-story__eyebrow {
    margin-block-end: var(--sp-5);
  }

  .about-craft-story h2 {
    font-size: var(--font-size-display-lg);
  }

  .about-craft-story h2 span {
    display: block;
  }

  .about-craft-story__heading-rule {
    display: block;
    inline-size: calc(var(--sp-11) * 2);
    block-size: var(--border-width);
    margin-block: var(--sp-5);
    background: var(--color-linen);
  }

  .about-craft-story__text {
    max-inline-size: 46ch;
    color: var(--color-charcoal);
    font-size: var(--font-size-body-md);
    line-height: var(--line-height-generous);
  }

  .about-craft-story__text p {
    margin: var(--sp-0);
  }

  .about-craft-story__features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: var(--sp-8) var(--sp-0) var(--sp-0);
    padding: var(--sp-0);
    color: var(--color-earth-brown);
    list-style: none;
    text-align: center;
  }

  .about-craft-story__features li {
    display: grid;
    grid-template-rows: var(--sp-8) auto;
    justify-items: center;
    gap: var(--sp-3);
    padding-inline: var(--sp-3);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-relaxed);
  }

  .about-craft-story__features li + li {
    border-inline-start: var(--border-width) solid var(--color-linen);
  }

  .about-craft-story__feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--sp-8);
    block-size: var(--sp-8);
  }

  .about-craft-story__feature-icon svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .about-heritage__cta {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: calc(var(--sp-8) * 3);
    overflow: hidden;
    border-block: var(--border-width) solid var(--border-light);
  }

  .about-heritage__cta-media {
    position: absolute;
    inset: var(--sp-0);
  }

  .about-heritage__cta-media::after {
    position: absolute;
    inset: var(--sp-0);
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--bg-primary) 35%, transparent),
      color-mix(in srgb, var(--bg-primary) 90%, transparent) 42%,
      color-mix(in srgb, var(--bg-primary) 96%, transparent)
    );
    content: '';
  }

  .about-heritage__cta-media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: left 68%;
  }

  .about-heritage__cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--sp-5);
    text-align: center;
  }

  .about-heritage__cta h2 {
    font-size: var(--font-size-display-lg);
  }

  .about-heritage__cta-content > p {
    margin: var(--sp-1) var(--sp-0) var(--sp-4);
    color: var(--text-secondary);
    font-size: var(--font-size-body-sm);
  }

  .about-heritage__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(calc(var(--sp-8) * 3), 1fr));
    gap: var(--sp-3);
  }

  .about-heritage__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-5);
    min-block-size: var(--sp-8);
    padding: var(--sp-3) var(--sp-6);
    border: var(--border-width) solid var(--color-earth-brown);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color var(--timing-short) var(--ease-standard),
      color var(--timing-short) var(--ease-standard),
      transform var(--timing-short) var(--ease-standard);
  }

  .about-heritage__button--primary {
    background: var(--color-earth-brown);
    color: var(--text-inverse);
  }

  .about-heritage__button--secondary {
    background: color-mix(in srgb, var(--bg-primary) 72%, transparent);
    color: var(--color-earth-brown);
  }

  .about-heritage__button:hover {
    background: var(--color-charcoal);
    color: var(--text-inverse);
  }

  .about-heritage__button:active {
    transform: translateY(var(--border-width));
  }

  .about-heritage__button:focus-visible {
    outline: calc(var(--border-width) * 2) solid var(--color-sage);
    outline-offset: var(--sp-1);
  }

  @media screen and (max-width: 75rem) {
    .about-heritage__inner {
      inline-size: min(calc(100% - (var(--layout-padding-desktop) * 2)), var(--layout-showcase-max-width));
    }

    .about-mission__inner {
      padding-inline: var(--sp-8);
    }
  }

  @media screen and (max-width: 64rem) {
    .about-mission__media::after {
      background:
        linear-gradient(
          to right,
          color-mix(in srgb, var(--color-ebony) 96%, transparent),
          color-mix(in srgb, var(--color-ebony) 59%, transparent) 58%,
          color-mix(in srgb, var(--color-ebony) 30%, transparent)
        ),
        color-mix(in srgb, var(--color-ebony) 18%, transparent);
    }

    .about-mission__content {
      inline-size: min(68%, var(--layout-hero-copy-width));
    }

    .about-design {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-6);
      min-block-size: auto;
    }

    .about-design__copy {
      order: 1;
      padding-inline: var(--sp-0);
    }

    .about-design__gallery {
      order: 2;
    }

    .about-craft-story {
      grid-template-columns: minmax(0, 1fr);
      min-block-size: auto;
    }

    .about-craft-story__content {
      order: 1;
      padding: var(--sp-8);
    }

    .about-craft-story__media {
      order: 2;
      aspect-ratio: 4 / 3;
    }
  }

  @media screen and (max-width: 48rem) {
    .about-mission {
      min-block-size: auto;
    }

    .about-mission__media::after {
      background:
        linear-gradient(
          to bottom,
          color-mix(in srgb, var(--color-ebony) 88%, transparent),
          color-mix(in srgb, var(--color-ebony) 76%, transparent)
        ),
        color-mix(in srgb, var(--color-ebony) 34%, transparent);
    }

    .about-mission__media img {
      object-position: 62% center;
    }

    .about-mission__inner {
      padding: var(--sp-8) var(--layout-padding-mobile);
    }

    .about-mission__content {
      inline-size: 100%;
    }

    .about-mission__eyebrow-rule {
      margin-block: var(--sp-5);
    }

    .about-mission h2 {
      font-size: var(--font-size-display-md);
    }

    .about-mission__intro {
      margin-block-start: var(--sp-4);
      font-size: var(--font-size-body-md);
    }

    .about-mission__values {
      margin-block-start: var(--sp-4);
    }

    .about-mission-value {
      grid-template-columns: var(--sp-8) minmax(0, 1fr);
      gap: var(--sp-4);
      padding-block: var(--sp-4);
    }

    .about-mission-value__icon {
      inline-size: var(--sp-8);
      block-size: var(--sp-8);
      padding: var(--sp-2);
    }

    .about-mission-value__copy {
      padding-inline-start: var(--sp-4);
    }

    .about-mission-value h3 {
      font-size: var(--font-size-body-xl);
    }

    .about-mission-value p {
      font-size: var(--font-size-body-sm);
    }

    .about-heritage__inner {
      inline-size: min(calc(100% - (var(--layout-padding-mobile) * 2)), var(--layout-showcase-max-width));
      padding-block: var(--sp-7) var(--sp-4);
    }

    .about-design h2,
    .about-craft-story h2,
    .about-heritage__cta h2 {
      font-size: var(--font-size-display-md);
    }

    .about-design {
      gap: var(--sp-5);
    }

    .about-design__eyebrow {
      margin-block-end: var(--sp-5);
    }

    .about-design__text {
      margin-block-start: var(--sp-4);
      font-size: var(--font-size-body-sm);
    }

    .about-design__principles {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-4);
      margin-block-start: var(--sp-7);
    }

    .about-design__principles li > span {
      margin-block-end: var(--sp-3);
    }

    .about-craft-story__content {
      padding: var(--sp-8) var(--layout-padding-mobile);
    }

    .about-craft-story__section-rule {
      margin-block-end: var(--sp-7);
    }

    .about-craft-story__eyebrow {
      margin-block-end: var(--sp-4);
    }

    .about-craft-story__text {
      font-size: var(--font-size-body-sm);
    }

    .about-craft-story__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--sp-6);
      margin-block-start: var(--sp-7);
    }

    .about-craft-story__features li:nth-child(3) {
      border-inline-start: none;
    }

    .about-craft-story__media {
      aspect-ratio: 1 / 1;
    }

    .about-heritage__cta {
      min-block-size: calc(var(--sp-8) * 5);
    }

    .about-heritage__cta-media::after {
      background: color-mix(in srgb, var(--bg-primary) 82%, transparent);
    }

    .about-heritage__actions {
      grid-template-columns: minmax(0, 1fr);
      inline-size: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
