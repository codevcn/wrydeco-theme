<section class="signature-pieces" aria-labelledby="SignaturePiecesHeading-{{ section.id }}">
  <div class="signature-pieces__inner">
    <header class="signature-pieces__header">
      <h2 class="signature-pieces__heading" id="SignaturePiecesHeading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    </header>

    {%- assign collection = section.settings.collection -%}
    {%- if collection == blank -%}
      {%- assign collection = collections['signature-pieces'] -%}
    {%- endif -%}

    {%- comment -%}
      Sort by price ascending first. On desktop, the ninth sorted product is
      pinned to the top-right grid position with CSS order.
    {%- endcomment -%}
    {%- assign sorted_products = collection.products | sort: 'price' -%}

    <div class="signature-pieces__carousel">
      <div
        class="signature-pieces__controls"
        data-signature-carousel-controls
        role="group"
        aria-label="Carousel navigation"
      >
        <button
          type="button"
          class="signature-pieces__control signature-pieces__control--previous"
          data-signature-carousel-previous
          aria-controls="SignaturePiecesCarousel-{{ section.id }}"
          aria-label="View previous signature pieces"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="signature-pieces__control signature-pieces__control--next"
          data-signature-carousel-next
          aria-controls="SignaturePiecesCarousel-{{ section.id }}"
          aria-label="View next signature pieces"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div
        id="SignaturePiecesCarousel-{{ section.id }}"
        class="signature-pieces__grid"
        data-signature-carousel
        role="list"
      >
      {%- for product in sorted_products limit: 12 -%}
        {%- assign display_title = product.metafields.custom.artwork_name.value | default: product.title -%}
        {%- liquid
          assign artist = ''
          assign author = product.metafields.custom.author_info.value
          if author != blank and author.author_name.value != blank
            assign artist = author.author_name.value
          elsif product.vendor != blank and product.vendor != shop.name
            assign artist = product.vendor
          endif
        -%}
        {%- assign material = product.metafields.custom.product_material.value
          | default: section.settings.material_default
        -%}
        {%- assign finish = product.metafields.custom.finish.value | default: section.settings.finish_default -%}
        {%- comment -%} Show a "Best Seller" badge for products in the "signature-pieces" collection. {%- endcomment -%}
        {%- assign is_best_seller = false -%}
        {%- for coll in product.collections -%}
          {%- if coll.handle == 'signature-pieces' -%}
            {%- assign is_best_seller = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- liquid
          assign desktop_order = forloop.index | times: 10
          if forloop.index == 9
            assign desktop_order = 35
          endif
        -%}

        <article
          class="signature-pieces__card"
          role="listitem"
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle | escape }}"
          data-variant-id="{{ product.variants.first.id }}"
          data-product-url="{{ product.url | escape }}"
          style="--signature-piece-order: {{ forloop.index | times: 10 }}; --signature-piece-desktop-order: {{ desktop_order }};"
        >
          <div class="signature-pieces__media">
            <a
              class="signature-pieces__image-link"
              href="{{ product.url }}"
              aria-label="{{ display_title | escape }}"
              data-sp-hover-gallery
            >
              {%- if product.featured_media != blank -%}
                {%- assign featured_media_alt = product.featured_media.alt | default: display_title -%}
                {{
                  product.featured_media.preview_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'signature-pieces__image is-active',
                    loading: 'lazy',
                    widths: '360, 540, 720, 900',
                    sizes: '(min-width: 80rem) 23vw, (min-width: 48rem) 46vw, 88vw',
                    draggable: false,
                    alt: featured_media_alt
                }}
                {%- comment -%}
                  Extra frames cycled while the pointer is over the card (PLP parity).
                  Capped at 4 so a media-heavy product doesn't bloat the homepage.
                {%- endcomment -%}
                {%- assign hover_count = 0 -%}
                {%- for media in product.media -%}
                  {%- if media.media_type != 'image' -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- if media.id == product.featured_media.id -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- assign hover_media_alt = media.alt | default: display_title -%}
                  {{
                    media.preview_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'signature-pieces__image',
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 80rem) 23vw, (min-width: 48rem) 46vw, 88vw',
                      draggable: false,
                      alt: hover_media_alt
                  }}
                  {%- assign hover_count = hover_count | plus: 1 -%}
                  {%- if hover_count >= 4 -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- assign fallback_asset = 'sli-' | append: forloop.index | append: '.webp' -%}
                <img
                  class="signature-pieces__image is-active"
                  src="{{ fallback_asset | file_url }}"
                  alt="{{ display_title | escape }}"
                  width="900"
                  height="1080"
                  loading="lazy"
                  draggable="false"
                >
              {%- endif -%}
            </a>

            {%- comment -%}
              Every card carries a badge: "Best Seller" for the curated collection,
              otherwise the "Most Loved" fallback.
            {%- endcomment -%}
            {%- if is_best_seller -%}
              <span class="signature-pieces__badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="m12 17.275l-4.15 2.5q-.275.175-.575.15t-.525-.2t-.35-.437t-.05-.588l1.1-4.725L3.775 10.8q-.25-.225-.312-.513t.037-.562t.3-.45t.55-.225l4.85-.425l1.875-4.45q.125-.3.388-.45t.537-.15t.537.15t.388.45l1.875 4.45l4.85.425q.35.05.55.225t.3.45t.038.563t-.313.512l-3.675 3.175l1.1 4.725q.075.325-.05.588t-.35.437t-.525.2t-.575-.15z"/></svg>
                {{ section.settings.best_seller_badge | escape }}
              </span>
            {%- else -%}
              <span class="signature-pieces__badge signature-pieces__badge--loved">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M11.288 20.2q-.363-.125-.638-.4l-1.725-1.575q-2.65-2.425-4.787-4.812T2 8.15Q2 5.8 3.575 4.225T7.5 2.65q1.325 0 2.5.562t2 1.538q.825-.975 2-1.537t2.5-.563q2.35 0 3.925 1.575T22 8.15q0 2.875-2.125 5.275T15.05 18.25l-1.7 1.55q-.275.275-.637.4t-.713.125t-.712-.125"/></svg>
                {{ section.settings.most_loved_badge | escape }}
              </span>
            {%- endif -%}

            <div
              class="signature-pieces__quick signature-pieces__wishlist Vtl-WishlistIcon__Wrapper Vtl-WishlistIcon__Wrapper--Id-{{ product.id }}-{{ product.handle | escape }} Vtl-CollectionCardWidget"
              data-signature-wishlist
              data-source="os2"
              data-app-block="wishlist-button"
              data-product-id="{{ product.id }}"
              data-product-handle="{{ product.handle | escape }}"
              data-variant-id="{{ product.variants.first.id }}"
              aria-label="Add {{ display_title | escape }} to wishlist"
            >
              <span class="signature-pieces__wishlist-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="m12 21.35l-1.45-1.32C5.4 15.36 2 12.27 2 8.5C2 5.41 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.08C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.41 22 8.5c0 3.77-3.4 6.86-8.55 11.53z"/></svg>
              </span>
            </div>
          </div>

          <div class="signature-pieces__content">
            <h3 class="signature-pieces__title">
              <a href="{{ product.url }}">{{ display_title | escape }}</a>
            </h3>
            {%- if artist != blank -%}
              <p class="signature-pieces__artist">by {{ artist | escape }}</p>
            {%- endif -%}
            {%- comment -%}
              Loox rating summary rendered from product metafields so it appears
              in the initial server-rendered HTML. Loox-specific metafields are
              preferred, with Shopify standard review metafields as the fallback.
            {%- endcomment -%}
            {%- liquid
              assign loox_average_rating = product.metafields.loox.avg_rating.value | default: product.metafields.loox.avg_rating | plus: 0
              assign loox_review_count = product.metafields.loox.num_reviews.value | default: product.metafields.loox.num_reviews | plus: 0
              if loox_average_rating <= 0
                assign loox_average_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: product.metafields.reviews.rating | plus: 0
              endif
              if loox_review_count <= 0
                assign loox_review_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0
              endif
              assign loox_average_rating = loox_average_rating | round: 1
              assign loox_rating_fill_percent = loox_average_rating | times: 20 | at_most: 100 | at_least: 0
              assign loox_review_label = 'reviews'
              if loox_review_count == 1
                assign loox_review_label = 'review'
              endif
            -%}
            {%- if loox_review_count > 0 and loox_average_rating > 0 -%}
              <div
                class="signature-pieces__rating"
                aria-label="{{ loox_average_rating }} out of 5 stars from {{ loox_review_count }} {{ loox_review_label }}"
              >
                <span
                  class="signature-pieces__rating-stars"
                  style="--rating-fill: {{ loox_rating_fill_percent }}%;"
                  aria-hidden="true"
                >
                  <span class="signature-pieces__rating-stars-base">
                    {%- for star_index in (1..5) -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false">
                        <path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.62L12 2L9.19 8.62L2 9.24l5.45 4.73L5.82 21z"/>
                      </svg>
                    {%- endfor -%}
                  </span>
                  <span class="signature-pieces__rating-stars-fill">
                    {%- for star_index in (1..5) -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false">
                        <path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.62L12 2L9.19 8.62L2 9.24l5.45 4.73L5.82 21z"/>
                      </svg>
                    {%- endfor -%}
                  </span>
                </span>
                <span class="signature-pieces__rating-score">{{ loox_average_rating }}</span>
                <span class="signature-pieces__rating-count">({{ loox_review_count }} {{ loox_review_label }})</span>
              </div>
            {%- endif -%}
            <p class="signature-pieces__price">
              {{ section.settings.price_prefix | escape }}
              <span class="signature-pieces__price-value">
                {{ product.price | money_without_trailing_zeros }}
              </span>
            </p>
            <div class="signature-pieces__actions">
              {%- if product.available -%}
                <button
                  type="button"
                  class="signature-pieces__primary"
                  data-quick-customize
                  data-product-handle="{{ product.handle | escape }}"
                >
                  {{- section.settings.customize_label | escape -}}
                </button>
              {%- else -%}
                <a class="signature-pieces__primary" href="{{ product.url }}">
                  {{- section.settings.customize_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </div>

        </article>
      {%- else -%}
        {%- for i in (1..4) -%}
          {%- assign card_badge_loved = false -%}
          {%- case i -%}
            {%- when 1 -%}
              {%- assign card_title = 'Walnut Lounge Chair' -%}
              {%- assign card_artist = 'Huan Ngo' -%}
              {%- assign card_price = '$2,650' -%}
              {%- assign card_badge = section.settings.best_seller_badge -%}
            {%- when 2 -%}
              {%- assign card_title = 'Live Edge Dining Table' -%}
              {%- assign card_artist = 'Trung Le' -%}
              {%- assign card_price = '$5,900' -%}
              {%- assign card_badge = section.settings.made_to_order_badge -%}
            {%- when 3 -%}
              {%- assign card_title = 'Sculpted Console Table' -%}
              {%- assign card_artist = 'Alex Nguyen' -%}
              {%- assign card_price = '$3,250' -%}
              {%- assign card_badge = section.settings.most_loved_badge -%}
              {%- assign card_badge_loved = true -%}
            {%- else -%}
              {%- assign card_title = 'Treeform Bookshelf' -%}
              {%- assign card_artist = 'Dien Luc' -%}
              {%- assign card_price = '$3,850' -%}
              {%- assign card_badge = section.settings.best_seller_badge -%}
          {%- endcase -%}

          {%- liquid
            assign desktop_order = i | times: 10
            if i == 9
              assign desktop_order = 35
            endif
          -%}
          <article
            class="signature-pieces__card"
            role="listitem"
            style="--signature-piece-order: {{ i }}; --signature-piece-desktop-order: {{ desktop_order }};"
          >
            <div class="signature-pieces__media">
              <span class="signature-pieces__image-link">
                <img
                  class="signature-pieces__image is-active"
                  src="{{ 'sli-' | append: i | append: '.webp' | file_url }}"
                  alt="{{ card_title | escape }}"
                  width="900"
                  height="1080"
                  loading="lazy"
                  draggable="false"
                >
              </span>

              {%- if card_badge != blank -%}
                {%- if card_badge_loved -%}
                  <span class="signature-pieces__badge signature-pieces__badge--loved">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M11.288 20.2q-.363-.125-.638-.4l-1.725-1.575q-2.65-2.425-4.787-4.812T2 8.15Q2 5.8 3.575 4.225T7.5 2.65q1.325 0 2.5.562t2 1.538q.825-.975 2-1.537t2.5-.563q2.35 0 3.925 1.575T22 8.15q0 2.875-2.125 5.275T15.05 18.25l-1.7 1.55q-.275.275-.637.4t-.713.125t-.712-.125"/></svg>
                    {{ card_badge | escape }}
                  </span>
                {%- else -%}
                  <span class="signature-pieces__badge">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="m12 17.275l-4.15 2.5q-.275.175-.575.15t-.525-.2t-.35-.437t-.05-.588l1.1-4.725L3.775 10.8q-.25-.225-.312-.513t.037-.562t.3-.45t.55-.225l4.85-.425l1.875-4.45q.125-.3.388-.45t.537-.15t.537.15t.388.45l1.875 4.45l4.85.425q.35.05.55.225t.3.45t.038.563t-.313.512l-3.675 3.175l1.1 4.725q.075.325-.05.588t-.35.437t-.525.2t-.575-.15z"/></svg>
                    {{ card_badge | escape }}
                  </span>
                {%- endif -%}
              {%- endif -%}

              <span class="signature-pieces__quick signature-pieces__wishlist" aria-hidden="true">
                <span class="signature-pieces__wishlist-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="m12 21.35l-1.45-1.32C5.4 15.36 2 12.27 2 8.5C2 5.41 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.08C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.41 22 8.5c0 3.77-3.4 6.86-8.55 11.53z"/></svg>
                </span>
              </span>
            </div>

            <div class="signature-pieces__content">
              <h3 class="signature-pieces__title">{{ card_title }}</h3>
              <p class="signature-pieces__artist">by {{ card_artist }}</p>
              <p class="signature-pieces__price">
                {{ section.settings.price_prefix | escape }}
                <span class="signature-pieces__price-value">
                  {{ card_price }}
                </span>
              </p>
              <div class="signature-pieces__actions">
                <span class="signature-pieces__primary">{{ section.settings.customize_label | escape }}</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="signature-pieces__footer">
        <a
          class="signature-pieces__button"
          href="{{ section.settings.button_link | default: collection.url | default: routes.collections_url }}"
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Shared quick-customize dialog (variant picker + price + add to cart). {%- endcomment -%}
  {% render 'quick-customize',
    eyebrow: section.settings.quick_eyebrow,
    add_label: section.settings.quick_add_label,
    buy_label: section.settings.quick_buy_label,
    buy_note: section.settings.quick_buy_note,
    details_label: section.settings.details_label
  %}
</section>

{% stylesheet %}
  .signature-pieces {
    width: 100%;
    padding: var(--section-padding-y) var(--container-padding-x);
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0) 42%),
      linear-gradient(180deg, #f7f3ee 0%, #f5f1ed 100%);
    color: var(--text-primary);
    overflow: hidden;
  }

  .signature-pieces__inner {
    /* Match the visible content width of sections that carry their padding
       inside a page-max-width box (collections, projects, FAQ). */
    width: min(100%, calc(var(--page-max-width, 1440px) - var(--container-padding-x, 48px) * 2));
    margin-inline: auto;
  }

  .signature-pieces__header {
    max-width: 660px;
    margin: 0 auto clamp(26px, 3vw, 38px);
    text-align: center;
  }

  .signature-pieces__heading {
    margin: 0 0 18px;
    font-family: var(--font-heading);
    font-size: var(--section-heading-size, 48px);
    font-weight: var(--font-weight-light);
    line-height: var(--section-heading-line, 1.02);
    letter-spacing: var(--section-heading-tracking, -0.02em);
    color: var(--color-text, #2e1d14);
    text-wrap: balance;
  }

  .signature-pieces__carousel {
    position: relative;
  }

  .signature-pieces__controls {
    position: absolute;
    inset: var(--sp-0);
    z-index: 3;
    display: none;
    pointer-events: none;
  }

  .signature-pieces__controls[hidden] {
    display: none;
  }

  .signature-pieces__control {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    inline-size: var(--sp-7);
    block-size: var(--sp-7);
    padding: var(--sp-0);
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-full);
    background-color: var(--surface-elevated);
    box-shadow: var(--shadow-elevation-1);
    color: var(--color-earth-brown);
    cursor: pointer;
    pointer-events: auto;
    transform: translateY(-50%);
    transition: background-color var(--timing-short) var(--ease-standard),
      color var(--timing-short) var(--ease-standard),
      opacity var(--timing-short) var(--ease-standard);
  }

  .signature-pieces__control:disabled {
    cursor: default;
    opacity: 0.35;
  }

  .signature-pieces__control svg {
    inline-size: var(--sp-4-bigger);
    block-size: var(--sp-4-bigger);
  }

  .signature-pieces__control--previous svg {
    transform: rotate(180deg);
  }

  .signature-pieces__control--previous {
    inset-inline-start: var(--sp-3);
  }

  .signature-pieces__control--next {
    inset-inline-end: var(--sp-3);
  }

  .signature-pieces__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    overflow: visible;
    padding: var(--sp-0);
  }

  .signature-pieces__grid::-webkit-scrollbar {
    display: none;
  }

  .signature-pieces__grid.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .signature-pieces__card {
    order: var(--signature-piece-order, 0);
    display: flex;
    flex-direction: column;
    flex: 0 1 calc((100% - var(--sp-3) * 3) / 4);
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border, rgba(76, 48, 30, 0.14));
    border-radius: var(--card-radius, 6px);
    background: rgba(255, 252, 248, 0.72);
    box-shadow: 0 18px 42px rgba(62, 39, 25, 0.05);
    transition: transform var(--timing-base) var(--ease-standard), box-shadow var(--timing-base) var(--ease-standard),
      border-color var(--timing-base) var(--ease-standard);
  }

  .signature-pieces__card[data-product-url] {
    cursor: pointer;
  }

  .signature-pieces__media {
    position: relative;
    aspect-ratio: 1 / 1.08;
    overflow: hidden;
    background: #e5dbd0;
  }

  .signature-pieces__image-link {
    display: block;
    position: relative;
    /* Must form its own stacking context: without it the stacked frames' z-index
       would compete with — and cover — the badge and wishlist overlays. */
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  /* The card stacks every image frame; only `is-active` (and the outgoing
     `is-prev`) is visible, so hovering cross-fades through the gallery. */
  .signature-pieces__image {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    z-index: 0;
    user-select: none;
    -webkit-user-drag: none;
    transition: transform 700ms var(--ease-standard), opacity var(--timing-base) var(--ease-standard);
  }

  .signature-pieces__image.is-prev {
    opacity: 1;
    z-index: 1;
  }

  .signature-pieces__image.is-active {
    opacity: 1;
    z-index: 2;
  }

  .signature-pieces__badge {
    position: absolute;
    top: 13px;
    left: 13px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 24px;
    padding: 0 8px;
    border: 1px solid rgba(74, 44, 24, 0.1);
    border-radius: 999px;
    background: rgba(255, 252, 247, 0.9);
    box-shadow: 0 8px 22px rgba(42, 28, 18, 0.08);
    color: #4a2c18;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    backdrop-filter: blur(8px);
  }

  .signature-pieces__badge svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
    flex: 0 0 auto;
  }

  /* Fallback badge shown on every card that isn't a best seller. Same pill, with
     a warm clay heart so the two badges stay distinguishable at a glance. */
  .signature-pieces__badge--loved svg {
    color: var(--color-clay, #8a5d37);
  }

  .signature-pieces__quick {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: rgba(255, 252, 247, 0.94);
    color: #4a2c18;
    text-decoration: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color var(--timing-short) var(--ease-standard),
      color var(--timing-short) var(--ease-standard), transform var(--timing-short) var(--ease-standard);
    overflow: hidden;
  }

  .signature-pieces__quick.is-loading {
    pointer-events: none;
    opacity: 0.7;
  }

  .signature-pieces__quick svg {
    width: 18px;
    height: 18px;
  }

  .signature-pieces__wishlist-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-body-lg);
    line-height: 1;
    transform: translateY(-1px);
  }

  .signature-pieces__wishlist:has(.Vtl-WishlistButton) .signature-pieces__wishlist-icon {
    display: none;
  }

  .signature-pieces__wishlist[aria-pressed='true'] {
    background: var(--color-earth-brown);
    color: var(--color-cream);
  }

  .signature-pieces__wishlist .Vtl-WishlistButton,
  .signature-pieces__wishlist .Vtl-WishlistButton__AddToWishlist {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .signature-pieces__wishlist .Vtl-WishlistButton__AddToWishlist {
    align-items: center;
    background: transparent;
    border: 0;
    color: currentColor;
    display: flex;
    justify-content: center;
    padding: 0;
  }

  .signature-pieces__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 10px 15px 15px;
  }

  .signature-pieces__title {
    margin: 0 0 8px;
    font-family: var(--font-heading);
    font-size: clamp(20px, 1.5vw, 24px);
    font-weight: var(--font-weight-regular);
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-text, #352117);
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .signature-pieces__title a {
    color: inherit;
    text-decoration: none;
    font-size: 15px;
  }

  .signature-pieces__artist {
    margin: 0 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    font-weight: var(--font-weight-regular);
    line-height: 1.2;
    color: var(--color-muted, #6a625c);
  }

  .signature-pieces__rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 8px 0 0;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1;
    color: var(--color-muted, #6a625c);
  }

  .signature-pieces__rating-stars {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: none;
    color: rgba(138, 93, 55, 0.22);
  }

  .signature-pieces__rating-stars-base,
  .signature-pieces__rating-stars-fill {
    display: inline-flex;
    gap: 1px;
  }

  .signature-pieces__rating-stars-fill {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    overflow: hidden;
    width: var(--rating-fill);
    color: var(--color-star-rating, #8a5d37);
    white-space: nowrap;
  }

  .signature-pieces__rating-stars svg {
    flex: none;
    width: 18px;
    height: 18px;
  }

  .signature-pieces__rating-score {
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
    color: #352117;
  }

  .signature-pieces__rating-count {
    font-size: 14px;
    color: var(--color-muted, #6a625c);
  }

  .signature-pieces__price {
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--color-border, rgba(74, 44, 24, 0.16));
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
    color: #352117;
    font-variant-numeric: tabular-nums;
  }
  .signature-pieces__price-value {
    font-size: 18px;
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    color: #352117;
  }

  .signature-pieces__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    margin-top: 18px;
  }

  .signature-pieces__primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--timing-short) var(--ease-standard),
      color var(--timing-short) var(--ease-standard), border-color var(--timing-short) var(--ease-standard),
      transform var(--timing-short) var(--ease-standard);
  }

  .signature-pieces__primary {
    padding: 0 18px;
    border: 1px solid #4a2c18;
    border-radius: 3px;
    background: #4a2c18;
    color: #fff8f0;
  }

  .signature-pieces__footer {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }

  .signature-pieces__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-width: 260px;
    min-height: var(--btn-height, 52px);
    padding: 0 var(--btn-padding-x, 32px);
    border-radius: var(--btn-radius, 4px);
    background: var(--color-brown, #4a2c18);
    color: #fff8f0;
    font-family: var(--font-body);
    font-size: var(--btn-font-size, 14px);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    box-shadow: 0 14px 30px rgba(59, 31, 15, 0.13);
    transition: transform var(--timing-short) var(--ease-standard),
      background-color var(--timing-short) var(--ease-standard), box-shadow var(--timing-short) var(--ease-standard);
  }

  .signature-pieces__button svg {
    width: 20px;
    height: 20px;
    transition: transform var(--timing-short) var(--ease-standard);
  }

  .signature-pieces :is(a, button):focus-visible {
    outline: 3px solid rgba(122, 137, 104, 0.38);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .signature-pieces__card:hover {
      transform: translateY(-4px);
      border-color: rgba(74, 44, 24, 0.24);
      box-shadow: 0 22px 54px rgba(62, 39, 25, 0.11);
    }

    .signature-pieces__card:hover .signature-pieces__image {
      transform: scale(1.025);
    }

    .signature-pieces__quick:hover {
      transform: scale(1.05);
    }

    .signature-pieces__control:not(:disabled):hover {
      background-color: var(--color-earth-brown);
      color: var(--color-cream);
    }

    .signature-pieces__primary:hover,
    .signature-pieces__button:hover {
      transform: translateY(-2px);
    }

    .signature-pieces__primary:hover {
      background: #2f1a0d;
      border-color: #2f1a0d;
      color: #fff8f0;
    }

    .signature-pieces__button:hover {
      color: #fff8f0;
      background: var(--color-brown-dark, #2f1a0d);
      box-shadow: 0 18px 34px rgba(59, 31, 15, 0.18);
    }

    .signature-pieces__button:hover svg {
      transform: translateX(4px);
    }
  }

  @media screen and (min-width: 75rem) {
    .signature-pieces__card {
      order: var(--signature-piece-desktop-order, var(--signature-piece-order, 0));
    }
  }

  @media screen and (max-width: 74.999rem) {
    .signature-pieces {
      padding-inline: var(--sp-6);
    }

    .signature-pieces__controls {
      display: block;
    }

    .signature-pieces__grid {
      flex-wrap: nowrap;
      gap: var(--sp-4);
      overflow-x: auto;
      padding-block-end: var(--sp-3);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      cursor: grab;
      overscroll-behavior-inline: contain;
      touch-action: pan-y;
      user-select: none;
    }

    .signature-pieces__card {
      flex-basis: 40%;
      flex-shrink: 0;
    }

    .signature-pieces__card[data-product-url] {
      cursor: grab;
    }

    .signature-pieces__grid.is-dragging .signature-pieces__card[data-product-url] {
      cursor: grabbing;
    }
  }

  @media screen and (max-width: 47.999rem) {
    .signature-pieces {
      padding-inline: var(--sp-4);
    }

    .signature-pieces__grid {
      gap: var(--sp-3);
    }

    .signature-pieces__card {
      flex-basis: max(calc(var(--sp-12) * 2 + var(--sp-4)), 48vw);
    }
  }

  @media screen and (max-width: 28rem) {
    .signature-pieces__actions {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .signature-pieces__button {
      width: 100%;
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-pieces__card,
    .signature-pieces__image,
    .signature-pieces__quick,
    .signature-pieces__primary,
    .signature-pieces__control,
    .signature-pieces__button,
    .signature-pieces__button svg {
      transition-duration: 0s;
    }
  }

{% endstylesheet %}

{% javascript %}
  (function () {
    // Nudge the Vitals wishlist app to (re)render its heart icons on the cards.
    function requestWishlistRender() {
      document.dispatchEvent(new CustomEvent('vitals:ProductCardsDetected'));
      document.dispatchEvent(new CustomEvent('vitals:RenderWishlistIcons'));
      window.dispatchEvent(new CustomEvent('vitals:ProductCardsDetected'));
      window.dispatchEvent(new CustomEvent('vitals:RenderWishlistIcons'));
    }

    function initWishlist(root) {
      var scope = root && root.querySelectorAll ? root : document;
      scope.querySelectorAll('[data-signature-wishlist]').forEach(function (btn) {
        if (btn.dataset.init === 'true') return;
        btn.dataset.init = 'true';
        btn.addEventListener('click', function () {
          requestWishlistRender();
        });
      });
      requestWishlistRender();
    }

    // Hover gallery: cycle through the card's images while the pointer is over
    // it, cross-fading each frame. Mirrors the collection (PLP) product card.
    function initHoverGallery(root) {
      var scope = root && root.querySelectorAll ? root : document;
      scope.querySelectorAll('[data-sp-hover-gallery]').forEach(function (gallery) {
        if (gallery.dataset.initHover === 'true') return;
        gallery.dataset.initHover = 'true';

        var images = gallery.querySelectorAll('.signature-pieces__image');
        if (images.length <= 1) return;

        var intervalId = null;
        var currentIndex = 0;

        function showImage(index) {
          images.forEach(function (img) {
            img.classList.remove('is-prev');
            if (img.classList.contains('is-active')) {
              img.classList.remove('is-active');
              img.classList.add('is-prev');
            }
          });
          images[index].classList.add('is-active');
        }

        gallery.addEventListener('mouseenter', function () {
          currentIndex = 1;
          showImage(currentIndex);

          intervalId = setInterval(function () {
            currentIndex = (currentIndex + 1) % images.length;
            showImage(currentIndex);
          }, 2000);
        });

        gallery.addEventListener('mouseleave', function () {
          clearInterval(intervalId);
          currentIndex = 0;
          showImage(0);
        });
      });
    }

    function initCardLinks(root) {
      var scope = root && root.querySelectorAll ? root : document;
      scope.querySelectorAll('.signature-pieces__card[data-product-url]').forEach(function (card) {
        if (card.dataset.cardLinkInit === 'true') return;
        card.dataset.cardLinkInit = 'true';

        card.addEventListener('click', function (event) {
          if (event.defaultPrevented) return;
          if (event.target.closest('a, button, input, select, textarea, [role="button"], [data-signature-wishlist]')) {
            return;
          }

          window.location.assign(card.dataset.productUrl);
        });
      });
    }

    function initCarousel(root) {
      var scope = root && root.querySelectorAll ? root : document;
      scope.querySelectorAll('[data-signature-carousel]').forEach(function (carousel) {
        if (carousel.dataset.carouselInit === 'true') return;

        var section = carousel.closest('.signature-pieces');
        var controls = section && section.querySelector('[data-signature-carousel-controls]');
        var previousButton = controls && controls.querySelector('[data-signature-carousel-previous]');
        var nextButton = controls && controls.querySelector('[data-signature-carousel-next]');
        if (!section || !controls || !previousButton || !nextButton) return;

        carousel.dataset.carouselInit = 'true';
        var isPointerDown = false;
        var didDrag = false;
        var preventClick = false;
        var pointerStartX = 0;
        var scrollStart = 0;
        var updateFrame = null;

        carousel.querySelectorAll('img').forEach(function (image) {
          image.draggable = false;
        });

        function isSliderViewport() {
          return window.matchMedia('(max-width: 74.999rem)').matches;
        }

        function updateControls() {
          var maxScrollLeft = Math.max(0, carousel.scrollWidth - carousel.clientWidth);
          var hasOverflow = isSliderViewport() && maxScrollLeft > 1;
          controls.hidden = !hasOverflow;
          previousButton.disabled = !hasOverflow || carousel.scrollLeft <= 1;
          nextButton.disabled = !hasOverflow || carousel.scrollLeft >= maxScrollLeft - 1;
        }

        function scheduleControlsUpdate() {
          if (updateFrame !== null) return;
          updateFrame = window.requestAnimationFrame(function () {
            updateFrame = null;
            updateControls();
          });
        }

        function getScrollDistance() {
          var card = carousel.querySelector('.signature-pieces__card');
          if (!card) return carousel.clientWidth;

          var styles = window.getComputedStyle(carousel);
          var gap = parseFloat(styles.columnGap) || 0;
          return card.getBoundingClientRect().width + gap;
        }

        function scrollCarousel(direction) {
          var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          carousel.scrollBy({
            left: getScrollDistance() * direction,
            behavior: reduceMotion ? 'auto' : 'smooth',
          });
        }

        function finishDrag(event) {
          if (!isPointerDown) return;
          isPointerDown = false;

          if (carousel.hasPointerCapture(event.pointerId)) {
            carousel.releasePointerCapture(event.pointerId);
          }

          carousel.classList.remove('is-dragging');
          if (didDrag) {
            preventClick = true;
            window.setTimeout(function () {
              preventClick = false;
            }, 0);
          }
          scheduleControlsUpdate();
        }

        previousButton.addEventListener('click', function () {
          scrollCarousel(-1);
        });

        nextButton.addEventListener('click', function () {
          scrollCarousel(1);
        });

        carousel.addEventListener('scroll', scheduleControlsUpdate, { passive: true });
        carousel.addEventListener('dragstart', function (event) {
          if (event.target.closest('img')) event.preventDefault();
        });

        carousel.addEventListener('pointerdown', function (event) {
          if (!isSliderViewport()) return;
          if (event.button !== 0) return;
          if (event.target.closest('button, input, select, textarea')) return;

          isPointerDown = true;
          didDrag = false;
          pointerStartX = event.clientX;
          scrollStart = carousel.scrollLeft;
        });

        carousel.addEventListener('pointermove', function (event) {
          if (!isPointerDown) return;

          var distance = event.clientX - pointerStartX;
          var dragThreshold = event.pointerType === 'touch' ? 10 : 6;
          if (!didDrag && Math.abs(distance) > dragThreshold) {
            didDrag = true;
            carousel.classList.add('is-dragging');
            carousel.setPointerCapture(event.pointerId);
          }
          if (!didDrag) return;

          event.preventDefault();
          carousel.scrollLeft = scrollStart - distance;
        });

        carousel.addEventListener('pointerup', finishDrag);
        carousel.addEventListener('pointercancel', finishDrag);
        carousel.addEventListener(
          'click',
          function (event) {
            if (!preventClick) return;
            event.preventDefault();
            event.stopPropagation();
          },
          true
        );

        if ('ResizeObserver' in window) {
          var resizeObserver = new ResizeObserver(scheduleControlsUpdate);
          resizeObserver.observe(carousel);
        }
        window.addEventListener('resize', scheduleControlsUpdate);

        updateControls();
      });
    }

    function init(root) {
      initWishlist(root);
      initHoverGallery(root);
      initCardLinks(root);
      initCarousel(root);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        init(document);
      });
    } else {
      init(document);
    }

    // Theme editor: re-wire the card hooks when the section is (re)rendered.
    document.addEventListener('shopify:section:load', function (e) {
      init(e.target);
    });
  })();
{% endjavascript %}

