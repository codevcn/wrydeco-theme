<section class="real-spaces-cta" aria-labelledby="RealSpacesCta-{{ section.id }}">
  <p class="real-spaces-cta__eyebrow">Made for your space</p>
  <h2 id="RealSpacesCta-{{ section.id }}">Inspired by something you’ve seen?</h2>
  <p>Let us shape a piece around your room, your dimensions, and the way you live.</p>
  <div class="real-spaces-cta__actions">
    <a class="real-spaces-cta__button real-spaces-cta__button--primary" href="/pages/customization">Start a Custom Project</a>
    <a class="real-spaces-cta__button real-spaces-cta__button--secondary" href="/collections/all">Explore the Collection</a>
  </div>
</section>

{% stylesheet %}
  .real-spaces-cta {
    padding: clamp(62px, 10vw, 84px) 32px;
    background: var(--color-cream, #f7f2ec);
    color: var(--color-earth-brown, #4a2c18);
    text-align: center;
  }

  .real-spaces-cta__eyebrow {
    margin: 0 0 22px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .real-spaces-cta h2 {
    max-width: 820px;
    margin: 0 auto;
    font-family: var(--font-heading, var(--font-body));
    font-size: clamp(44px, 5.3vw, 78px);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .real-spaces-cta > p:not(.real-spaces-cta__eyebrow) {
    max-width: 650px;
    margin: 30px auto 0;
    font-size: 18px;
    line-height: 1.65;
  }

  .real-spaces-cta__actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 42px;
  }

  .real-spaces-cta__button {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    padding: 15px 28px;
    border: 1px solid var(--color-earth-brown, #4a2c18);
    color: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .real-spaces-cta__button--primary {
    background: var(--color-earth-brown, #4a2c18);
    color: #fff;
  }

  @media screen and (max-width: 767px) {
    .real-spaces-cta {
      padding: 42px 20px;
    }

    .real-spaces-cta h2 {
      font-size: 45px;
    }

    .real-spaces-cta__eyebrow {
      margin-bottom: 16px;
      font-size: 10px;
    }

    .real-spaces-cta__actions {
      flex-direction: column;
    }

    .real-spaces-cta__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Real Spaces CTA",
  "tag": "section",
  "class": "section section-real-spaces-cta",
  "settings": [],
  "presets": [
    {
      "name": "Real Spaces CTA"
    }
  ]
}
{% endschema %}
